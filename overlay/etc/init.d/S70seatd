#!/bin/sh
# Provide DRM/VT access to unprivileged Wayland sessions on MAN's BusyBox init.

DAEMON=/usr/bin/seatd
PIDFILE=/run/seatd.pid

case "${1:-}" in
    start)
        [ -x "$DAEMON" ] || exit 0
        # The minimal live image always contains the video group, and OOBE
        # assigns it to each desktop user.  Do not depend on Buildroot's
        # optional seat service account being present in the installer.
        start-stop-daemon -S -x "$DAEMON" -p "$PIDFILE" -m -b -- -g video
        ;;
    stop)
        start-stop-daemon -K -x "$DAEMON" -p "$PIDFILE" 2>/dev/null || true
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 2
        ;;
esac
