#!/bin/sh
# Re-create the installed recovery initramfs while already running Recovery.
# The output must be under /run so it is not included inside itself.

set -eu

output=${1:-/run/man-recovery.cpio.gz}
case "$output" in /run/*) ;; *) echo "Recovery output must be under /run" >&2; exit 2 ;; esac

rm -f "$output"
(
    cd /
    find bin etc lib lib64 root sbin usr var -xdev -print0 2>/dev/null |
        cpio -0 -o -H newc 2>/dev/null
) | gzip -9 >"$output"

[ -s "$output" ] || { echo "Could not create the recovery image" >&2; exit 1; }
