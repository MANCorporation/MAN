#!/bin/sh
# Run the visible greeter as its locked service account.  WAYLAND_SOCKET is an
# inherited file descriptor on some compositors and a socket path on others.
# Permit only the greeter group to traverse the compositor runtime directory
# and connect to that socket; it still receives no direct DRM or VT access.
set -eu

runtime_dir=${XDG_RUNTIME_DIR:-/run/user/0}
wayland_socket="$runtime_dir/${WAYLAND_DISPLAY:-wayland-0}"
chgrp cosmic-greeter "$runtime_dir" "$wayland_socket" "$wayland_socket.lock" 2>/dev/null || true
chmod 0710 "$runtime_dir" 2>/dev/null || true
chmod 0770 "$wayland_socket" 2>/dev/null || true
chmod 0660 "$wayland_socket.lock" 2>/dev/null || true

# greetd creates GREETD_SOCK for the account that owns the compositor.  MAN
# deliberately keeps cosmic-comp as root so it can own the VT/DRM devices, but
# runs the visible UI as the locked cosmic-greeter account.  Give that account
# access to this one authentication socket before dropping privileges.
if [ -n "${GREETD_SOCK:-}" ]; then
    socket_tries=0
    while [ ! -S "$GREETD_SOCK" ] && [ "$socket_tries" -lt 50 ]; do
        sleep 0.1
        socket_tries=$((socket_tries + 1))
    done
    if [ ! -S "$GREETD_SOCK" ]; then
        echo "MAN Greeter: authentication socket is unavailable: $GREETD_SOCK" >&2
        exit 1
    fi
    chgrp cosmic-greeter "$GREETD_SOCK"
    chmod 0660 "$GREETD_SOCK"
fi

exec /bin/su -m -s /bin/sh cosmic-greeter \
    -c 'exec /usr/bin/cosmic-greeter'
