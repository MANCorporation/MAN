#!/bin/sh
# MAN's copy of asahi-scripts' init-top/asahi (MIT, The Asahi Linux Contributors):
# loads the Mac firmware (vendorfw/firmware.cpio on the EFI partition) into the
# initramfs. Changed: the EFI partition is found with util-linux blkid (BusyBox's
# mount does not understand PARTUUID=, so the original never found it), with a wait
# until the disk's partitions have appeared. Overrides the packaged script of the
# same name (initramfs-tools copies /etc/initramfs-tools/scripts last).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in prereqs) prereqs; exit 0 ;; esac

. /scripts/functions

if [ -e /lib/firmware/vendor ]; then
	log_failure_msg "Vendor firmware was loaded by the bootloader"
	exit 0
fi
esp=$(tr -d '\000' < /proc/device-tree/chosen/asahi,efi-system-partition 2>/dev/null)
if [ -z "$esp" ]; then
	log_failure_msg "Missing asahi,efi-system-partition variable, firmware will not be loaded!"
	exit 0
fi

modprobe -q apple-mailbox 2>/dev/null
modprobe -q nvme-apple 2>/dev/null
dev=
i=0
while [ $i -lt 100 ]; do
	dev=$(blkid -t "PARTUUID=$esp" -o device 2>/dev/null | head -n 1)
	[ -n "$dev" ] && break
	i=$((i + 1))
	sleep 0.1
done
if [ -z "$dev" ]; then
	log_failure_msg "Asahi: EFI partition $esp not found, firmware not loaded"
	exit 0
fi

mkdir -p /run/.system-efi
if ! mount -t vfat -o ro "$dev" /run/.system-efi; then
	log_failure_msg "Asahi: could not mount $dev"
	exit 0
fi
if [ -e /run/.system-efi/vendorfw/firmware.cpio ]; then
	( cd /; cpio -i < /run/.system-efi/vendorfw/firmware.cpio )
	log_success_msg "Asahi: Vendor firmware unpacked successfully"
else
	log_failure_msg "Vendor firmware not available in ESP!"
fi
umount /run/.system-efi
exit 0
