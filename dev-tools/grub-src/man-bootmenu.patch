+/* MAN: with "menu_layout=horizontal" (a row of icons) Left and Right move
+   between entries.  The modifier held with Enter is passed to the entry in
+   "menu_mod" (shift, ctrl, alt or empty), so an entry can, for example, open
+   its options with Shift+Enter or become the default with Ctrl+Enter.  */
+static int
+menu_is_horizontal (void)
+{
+  const char *layout = grub_env_get ("menu_layout");
+  return layout && grub_strcmp (layout, "horizontal") == 0;
+}
+
+static void
+menu_note_modifier (int key)
+{
+  int mods = grub_getkeystatus ();
+  const char *mod = "";
+
+  if ((key & GRUB_TERM_SHIFT)
+      || (mods & (GRUB_TERM_STATUS_LSHIFT | GRUB_TERM_STATUS_RSHIFT)))
+    mod = "shift";
+  else if ((key & GRUB_TERM_CTRL)
+	   || (mods & (GRUB_TERM_STATUS_LCTRL | GRUB_TERM_STATUS_RCTRL)))
+    mod = "ctrl";
+  else if ((key & GRUB_TERM_ALT)
+	   || (mods & (GRUB_TERM_STATUS_LALT | GRUB_TERM_STATUS_RALT)))
+    mod = "alt";
+  grub_env_set ("menu_mod", mod);
+  grub_env_export ("menu_mod");
+}
