+/* MAN: the horizontal picker.  Every item is a square cell: the icon, with
+   the selected item's box (selected_item_pixmap_style) behind it, the title
+   centred below and the marker (an image) below the selected title.  */
+static void
+draw_title_centered (const char *title, grub_font_t font,
+		     grub_video_color_t color, int center_x, int baseline,
+		     int max_width)
+{
+  int width = grub_font_get_string_width (font, title);
+  char *cut = 0;
+
+  if (width > max_width)
+    {
+      grub_size_t len = grub_strlen (title);
+      cut = grub_malloc (len + 4);
+      if (!cut)
+	return;
+      while (len > 0)
+	{
+	  len--;
+	  /* Do not cut inside a UTF-8 sequence.  */
+	  while (len > 0 && (title[len] & 0xc0) == 0x80)
+	    len--;
+	  grub_memcpy (cut, title, len);
+	  grub_strcpy (cut + len, "...");
+	  width = grub_font_get_string_width (font, cut);
+	  if (width <= max_width)
+	    break;
+	}
+      title = cut;
+    }
+  grub_font_draw_string (title, font, color, center_x - width / 2, baseline);
+  grub_free (cut);
+}
+
+static struct grub_video_bitmap *
+get_marker (list_impl_t self, int size)
+{
+  if (!self->marker_name || size <= 0)
+    return 0;
+  if (!self->marker && !self->marker_tried && self->theme_dir)
+    {
+      char *path = grub_resolve_relative_path (self->theme_dir,
+					       self->marker_name);
+      self->marker_tried = 1;
+      if (path)
+	{
+	  grub_video_bitmap_load (&self->marker, path);
+	  grub_errno = GRUB_ERR_NONE;
+	  grub_free (path);
+	}
+    }
+  if (!self->marker)
+    return 0;
+  if (self->marker_scaled
+      && (int) grub_video_bitmap_get_width (self->marker_scaled) != size)
+    {
+      grub_video_bitmap_destroy (self->marker_scaled);
+      self->marker_scaled = 0;
+    }
+  if (!self->marker_scaled)
+    {
+      grub_video_bitmap_create_scaled (&self->marker_scaled, size, size,
+				       self->marker,
+				       GRUB_VIDEO_BITMAP_SCALE_METHOD_BEST);
+      grub_errno = GRUB_ERR_NONE;
+    }
+  return self->marker_scaled;
+}
+
+static void
+draw_menu_horizontal (list_impl_t self)
+{
+  grub_video_rect_t vp;
+  int n = self->view->menu->size;
+  int screen_h = self->view->screen.height;
+  int icon, pad, cell, gap, pitch, shown, first, total, x0, i;
+  int ascent, descent, label_base, marker_size, marker_top;
+  grub_font_t font = self->item_font;
+  grub_font_t sel_font = self->selected_item_font;
+  grub_gfxmenu_box_t selbox = self->selected_item_box;
+  grub_video_color_t item_color, sel_color;
+  struct grub_video_bitmap *marker;
+
+  if (n <= 0)
+    return;
+  grub_video_get_viewport ((unsigned *) &vp.x, (unsigned *) &vp.y,
+			   &vp.width, &vp.height);
+
+  icon = screen_h * self->icon_percent / 100;
+  if (icon < self->icon_min)
+    icon = self->icon_min;
+  if (icon > self->icon_max)
+    icon = self->icon_max;
+  if (icon != self->icon_width || icon != self->icon_height)
+    {
+      self->icon_width = icon;
+      self->icon_height = icon;
+      grub_gfxmenu_icon_manager_set_icon_size (self->icon_manager, icon, icon);
+    }
+  if (self->large_item_font && screen_h >= self->large_font_from_height)
+    {
+      font = self->large_item_font;
+      sel_font = self->large_item_font;
+    }
+
+  /* item_padding: room around the icon inside the selection box, and
+     item_spacing: room between two cells, both in percent of the icon.  */
+  pad = icon * self->item_padding / 100;
+  cell = icon + 2 * pad;
+  gap = icon * self->item_spacing / 100;
+  pitch = cell + gap;
+
+  /* Too many for one row: closer together first, then smaller icons (down
+     to icon_min); only after that does the row scroll.  */
+  if (n * pitch - gap > (int) vp.width)
+    {
+      int fit_gap = ((int) vp.width - n * cell) / (n > 1 ? n - 1 : 1);
+      int min_gap = icon * 25 / 100;
+      gap = fit_gap > min_gap ? fit_gap : min_gap;
+      if (gap > icon * self->item_spacing / 100)
+	gap = icon * self->item_spacing / 100;
+      while (n * (cell + gap) - gap > (int) vp.width && icon > self->icon_min)
+	{
+	  icon -= 4;
+	  if (icon < self->icon_min)
+	    icon = self->icon_min;
+	  pad = icon * self->item_padding / 100;
+	  cell = icon + 2 * pad;
+	  gap = icon * 25 / 100;
+	}
+      pitch = cell + gap;
+      if (icon != self->icon_width)
+	{
+	  self->icon_width = icon;
+	  self->icon_height = icon;
+	  grub_gfxmenu_icon_manager_set_icon_size (self->icon_manager,
+						   icon, icon);
+	}
+    }
+
+  shown = ((int) vp.width + gap) / pitch;
+  if (shown < 1)
+    shown = 1;
+  if (shown > n)
+    shown = n;
+  first = self->first_shown_index;
+  if (self->view->selected >= 0)
+    {
+      if (self->view->selected < first)
+	first = self->view->selected;
+      else if (self->view->selected >= first + shown)
+	first = self->view->selected - shown + 1;
+    }
+  if (first > n - shown)
+    first = n - shown;
+  if (first < 0)
+    first = 0;
+  self->first_shown_index = first;
+
+  total = shown * pitch - gap;
+  x0 = ((int) vp.width - total) / 2;
+
+  ascent = grub_font_get_ascent (font);
+  descent = grub_font_get_descent (font);
+  label_base = cell + icon / 10 + ascent;
+  marker_size = icon * 28 / 100;
+  marker_top = label_base + descent + icon / 8;
+
+  item_color = grub_video_map_rgba_color (self->item_color);
+  sel_color = grub_video_map_rgba_color (self->selected_item_color);
+  marker = get_marker (self, marker_size);
+
+  for (i = first; i < first + shown; i++)
+    {
+      int x = x0 + (i - first) * pitch;
+      int is_selected = (i == self->view->selected);
+      grub_menu_entry_t entry = grub_menu_get_entry (self->view->menu, i);
+      struct grub_video_bitmap *bmp;
+
+      if (!entry)
+	continue;
+      if (is_selected && selbox)
+	{
+	  int l = selbox->get_left_pad (selbox);
+	  int r = selbox->get_right_pad (selbox);
+	  int t = selbox->get_top_pad (selbox);
+	  int b = selbox->get_bottom_pad (selbox);
+	  if (cell > l + r && cell > t + b)
+	    {
+	      selbox->set_content_size (selbox, cell - l - r, cell - t - b);
+	      selbox->draw (selbox, x, 0);
+	    }
+	}
+      bmp = get_item_icon (self, i);
+      if (bmp)
+	grub_video_blit_bitmap (bmp, GRUB_VIDEO_BLIT_BLEND, x + pad, pad,
+				0, 0, icon, icon);
+      draw_title_centered (entry->title, is_selected ? sel_font : font,
+			   is_selected ? sel_color : item_color,
+			   x + cell / 2, label_base, pitch - 8);
+      if (is_selected && marker)
+	grub_video_blit_bitmap (marker, GRUB_VIDEO_BLIT_BLEND,
+				x + cell / 2 - marker_size / 2, marker_top,
+				0, 0, marker_size, marker_size);
+    }
+
+  /* More items to the left or right than fit on the screen.  */
+  if (first > 0)
+    grub_font_draw_string ("<", font, item_color,
+			   x0 - gap / 2 - grub_font_get_string_width (font, "<"),
+			   cell / 2 + ascent / 2);
+  if (first + shown < n)
+    grub_font_draw_string (">", font, item_color, x0 + total + gap / 2,
+			   cell / 2 + ascent / 2);
+}
