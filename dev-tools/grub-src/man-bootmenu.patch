+/* MAN: "man_connect" asks the firmware to start the drivers of all devices
+   below the PCI root bridges and lists the disks again.  With "fast boot" many firmwares only start the
+   disk they boot from, so USB drives stay invisible until then.  Known
+   disks keep their names; new ones come after them.  The old list entries
+   are not freed (open disks may still point at them), and scripts still
+   find their own disks again by UUID afterwards in case one went away.  */
+/* The new list with the disks already known first, in their old order, so
+   their names (hd0, ...) and anything open on them stay right.  */
+static struct grub_efidisk_data *
+keep_order (struct grub_efidisk_data *old, struct grub_efidisk_data *fresh)
+{
+  struct grub_efidisk_data *head = 0, **tail = &head, *o, **pp;
+
+  for (o = old; o; o = o->next)
+    for (pp = &fresh; *pp; pp = &(*pp)->next)
+      if ((*pp)->handle == o->handle)
+	{
+	  struct grub_efidisk_data *d = *pp;
+	  *pp = d->next;
+	  d->next = 0;
+	  *tail = d;
+	  tail = &d->next;
+	  break;
+	}
+  *tail = fresh;
+  return head;
+}
+
+static grub_err_t
+grub_cmd_man_connect (grub_command_t cmd __attribute__ ((unused)),
+		      int argc __attribute__ ((unused)),
+		      char **args __attribute__ ((unused)))
+{
+  static grub_guid_t root_guid = GRUB_EFI_PCI_ROOT_IO_GUID;
+  grub_efi_handle_t *handles;
+  grub_efi_uintn_t n = 0, i;
+  grub_efi_boot_services_t *b = grub_efi_system_table->boot_services;
+
+  /* Like "connectefi pciroot" elsewhere: everything below the PCI root
+     bridges (USB controllers, their hubs and drives, other disks).  */
+  handles = grub_efi_locate_handle (GRUB_EFI_BY_PROTOCOL, &root_guid, NULL, &n);
+  if (!handles)
+    return grub_errno;
+  for (i = 0; i < n; i++)
+    b->connect_controller (handles[i], NULL, NULL, 1);
+  grub_free (handles);
+
+  {
+    struct grub_efidisk_data *old_fd = fd_devices, *old_hd = hd_devices;
+    struct grub_efidisk_data *old_cd = cd_devices;
+
+    fd_devices = 0;
+    hd_devices = 0;
+    cd_devices = 0;
+    enumerate_disks ();
+    fd_devices = keep_order (old_fd, fd_devices);
+    hd_devices = keep_order (old_hd, hd_devices);
+    cd_devices = keep_order (old_cd, cd_devices);
+  }
+  grub_disk_cache_invalidate_all ();
+  return GRUB_ERR_NONE;
+}
