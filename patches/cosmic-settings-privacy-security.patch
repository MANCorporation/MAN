diff --git a/cosmic-settings/src/pages/privacy_security.rs b/cosmic-settings/src/pages/privacy_security.rs
new file mode 100644
index 0000000..2bbb61c
--- /dev/null
+++ b/cosmic-settings/src/pages/privacy_security.rs
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+use cosmic::Task;
+use cosmic::widget::{button, settings};
+use cosmic_settings_page::{self as page, Section, section};
+use slotmap::SlotMap;
+use std::process::Command;
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    Select(String),
+    ToggleHome(bool),
+    ToggleNetwork(bool),
+    Reset,
+    Refresh,
+}
+
+pub struct Page {
+    entity: page::Entity,
+    apps: Vec<FlatpakApp>,
+    selected: Option<String>,
+}
+
+#[derive(Clone)]
+struct FlatpakApp {
+    id: String,
+    name: String,
+    home: bool,
+    network: bool,
+}
+
+impl Default for Page {
+    fn default() -> Self {
+        Self {
+            entity: page::Entity::default(),
+            apps: flatpak_apps(),
+            selected: None,
+        }
+    }
+}
+
+impl page::AutoBind<crate::pages::Message> for Page {}
+
+impl page::Page<crate::pages::Message> for Page {
+    fn set_id(&mut self, entity: page::Entity) {
+        self.entity = entity;
+    }
+
+    fn content(
+        &self,
+        sections: &mut SlotMap<section::Entity, Section<crate::pages::Message>>,
+    ) -> Option<page::Content> {
+        Some(vec![sections.insert(app_permissions())])
+    }
+
+    fn info(&self) -> page::Info {
+        page::Info::new("privacy-security", "preferences-system-privacy-symbolic")
+            .title("Privacy and Security")
+            .description("Privacy controls and application permissions")
+    }
+}
+
+impl Page {
+    pub fn update(&mut self, message: Message) -> Task<crate::Message> {
+        match message {
+            Message::Select(id) => self.selected = Some(id),
+            Message::ToggleHome(enabled) => {
+                self.override_permission("--filesystem=home", "--nofilesystem=home", enabled)
+            }
+            Message::ToggleNetwork(enabled) => {
+                self.override_permission("--share=network", "--unshare=network", enabled)
+            }
+            Message::Reset => {
+                if let Some(id) = &self.selected {
+                    let _ = Command::new("flatpak")
+                        .args(["override", "--user", "--reset", id])
+                        .status();
+                }
+                self.reload();
+            }
+            Message::Refresh => self.reload(),
+        }
+        Task::none()
+    }
+
+    fn override_permission(&mut self, allow: &str, deny: &str, enabled: bool) {
+        if let Some(id) = &self.selected {
+            let _ = Command::new("flatpak")
+                .args(["override", "--user", if enabled { allow } else { deny }, id])
+                .status();
+        }
+        self.reload();
+    }
+
+    fn reload(&mut self) {
+        let selected = self.selected.clone();
+        self.apps = flatpak_apps();
+        self.selected = selected.filter(|id| self.apps.iter().any(|app| &app.id == id));
+    }
+}
+
+fn app_permissions() -> Section<crate::pages::Message> {
+    Section::default()
+        .title("App Permissions")
+        .view::<Page>(move |_binder, page, section| {
+            let mut content = settings::section().title(&section.title);
+            for app in &page.apps {
+                content = content.add(settings::item(
+                    &app.name,
+                    button::standard("Manage").on_press(crate::pages::Message::PrivacySecurity(
+                        Message::Select(app.id.clone()),
+                    )),
+                ));
+            }
+            if page.apps.is_empty() {
+                content = content.add(settings::item(
+                    "No Flatpak apps installed",
+                    button::standard("Refresh")
+                        .on_press(crate::pages::Message::PrivacySecurity(Message::Refresh)),
+                ));
+            }
+            if let Some(app) = page
+                .apps
+                .iter()
+                .find(|app| Some(&app.id) == page.selected.as_ref())
+            {
+                content = content
+                    .add(settings::item::builder("Network access").toggler(
+                        app.network,
+                        |enabled| {
+                            crate::pages::Message::PrivacySecurity(Message::ToggleNetwork(enabled))
+                        },
+                    ))
+                    .add(settings::item::builder("Home folder access").toggler(
+                        app.home,
+                        |enabled| {
+                            crate::pages::Message::PrivacySecurity(Message::ToggleHome(enabled))
+                        },
+                    ))
+                    .add(settings::item(
+                        "Reset this app's permissions",
+                        button::standard("Reset")
+                            .on_press(crate::pages::Message::PrivacySecurity(Message::Reset)),
+                    ));
+            }
+            content.into()
+        })
+}
+
+fn flatpak_apps() -> Vec<FlatpakApp> {
+    let Ok(output) = Command::new("flatpak")
+        .args(["list", "--app", "--columns=application,name"])
+        .output()
+    else {
+        return Vec::new();
+    };
+    String::from_utf8_lossy(&output.stdout)
+        .lines()
+        .filter_map(|line| {
+            let (id, name) = line.split_once('\t')?;
+            let permissions = Command::new("flatpak")
+                .args(["info", "--show-permissions", id])
+                .output()
+                .ok()?;
+            let permissions = String::from_utf8_lossy(&permissions.stdout);
+            Some(FlatpakApp {
+                id: id.into(),
+                name: if name.is_empty() {
+                    id.into()
+                } else {
+                    name.into()
+                },
+                home: permissions.contains("filesystems=home"),
+                network: permissions.contains("shared=network"),
+            })
+        })
+        .collect()
+}
