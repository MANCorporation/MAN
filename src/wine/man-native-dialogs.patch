 /***********************************************************************
+ *      man_ofn_pick
+ *
+ * MAN: the desktop's file picker instead of the dialog below. Programs that
+ * customize the dialog (hooks, templates) or use the pre-Explorer list format
+ * keep Wine's dialog.
+ */
+static int man_ofn_pick(FileOpenDlgInfos *info, UINT dlg_type)
+{
+    OPENFILENAMEW *ofn = info->ofnInfos;
+    UINT flags = dlg_type == SAVE_DIALOG ? MAN_PICK_SAVE : 0;
+    struct man_buf b = {0};
+    WCHAR *paths = NULL, *p, *leaf;
+    UINT count = 0, offset = 0, ext = 0, needed;
+    int res;
+
+    if (ofn->Flags & (OFN_ENABLEHOOK | OFN_ENABLETEMPLATE | OFN_ENABLETEMPLATEHANDLE))
+        return MAN_PICK_UNAVAILABLE;
+    if (!ofn->lpstrFile) return MAN_PICK_UNAVAILABLE;
+    if (ofn->Flags & OFN_ALLOWMULTISELECT)
+    {
+        if (!(ofn->Flags & OFN_EXPLORER)) return MAN_PICK_UNAVAILABLE;
+        if (dlg_type == OPEN_DIALOG) flags |= MAN_PICK_MULTI;
+    }
+
+    res = man_pick(ofn->hwndOwner, info->title, info->filter, ofn->nFilterIndex, info->initdir,
+                   info->filename, flags, &paths);
+    if (res != MAN_PICK_OK) return res;
+
+    for (p = paths; *p; p += lstrlenW(p) + 1) count++;
+    leaf = wcsrchr(paths, '\\');
+    leaf = leaf ? leaf + 1 : paths;
+    offset = leaf - paths;
+    if (count > 1)
+    {
+        /* "folder\0name\0name\0\0" */
+        man_add(&b, paths, offset - 1);
+        man_add(&b, L"", 1);
+        for (p = paths; *p; p += lstrlenW(p) + 1)
+        {
+            leaf = wcsrchr(p, '\\');
+            leaf = leaf ? leaf + 1 : p;
+            man_add(&b, leaf, lstrlenW(leaf) + 1);
+        }
+    }
+    else
+    {
+        WCHAR *dot;
+
+        man_adds(&b, paths);
+        dot = wcsrchr(b.s + offset, '.');
+        if (!dot && dlg_type == SAVE_DIALOG && info->defext && *info->defext)
+        {
+            man_adds(&b, L".");
+            man_adds(&b, info->defext);
+            dot = wcsrchr(b.s + offset, '.');
+        }
+        if (dot) ext = dot - b.s + 1;
+        man_add(&b, L"", 0);
+    }
+
+    /* The folder, for the program's next file operations. */
+    {
+        WCHAR saved = b.s[offset ? offset - 1 : 0];
+        if (offset)
+        {
+            b.s[offset - 1] = 0;
+            SetCurrentDirectoryW(b.s);
+            b.s[offset - 1] = saved;
+        }
+    }
+
+    needed = b.len + 1;
+    if (info->unicode)
+    {
+        if (needed > ofn->nMaxFile)
+        {
+            if (ofn->nMaxFile >= 2) *(WORD *)ofn->lpstrFile = needed;
+            COMDLG32_SetCommDlgExtendedError(FNERR_BUFFERTOOSMALL);
+            HeapFree(GetProcessHeap(), 0, b.s);
+            HeapFree(GetProcessHeap(), 0, paths);
+            return MAN_PICK_CANCEL;
+        }
+        memcpy(ofn->lpstrFile, b.s, needed * sizeof(WCHAR));
+        if (ofn->lpstrFileTitle && ofn->nMaxFileTitle)
+            lstrcpynW(ofn->lpstrFileTitle, b.s + offset, ofn->nMaxFileTitle);
+    }
+    else
+    {
+        OPENFILENAMEA *ofna = (OPENFILENAMEA *)ofn;
+        int len = WideCharToMultiByte(CP_ACP, 0, b.s, needed, NULL, 0, NULL, NULL);
+
+        if ((DWORD)len > ofna->nMaxFile)
+        {
+            if (ofna->nMaxFile >= 2) *(WORD *)ofna->lpstrFile = len;
+            COMDLG32_SetCommDlgExtendedError(FNERR_BUFFERTOOSMALL);
+            HeapFree(GetProcessHeap(), 0, b.s);
+            HeapFree(GetProcessHeap(), 0, paths);
+            return MAN_PICK_CANCEL;
+        }
+        WideCharToMultiByte(CP_ACP, 0, b.s, needed, ofna->lpstrFile, len, NULL, NULL);
+        if (ofna->lpstrFileTitle && ofna->nMaxFileTitle)
+        {
+            if (!WideCharToMultiByte(CP_ACP, 0, b.s + offset, -1, ofna->lpstrFileTitle, ofna->nMaxFileTitle, NULL, NULL))
+                ofna->lpstrFileTitle[ofna->nMaxFileTitle - 1] = 0;
+        }
+        if (ext) ext = WideCharToMultiByte(CP_ACP, 0, b.s, ext, NULL, 0, NULL, NULL);
+        offset = WideCharToMultiByte(CP_ACP, 0, b.s, offset, NULL, 0, NULL, NULL);
+    }
+    ofn->nFileOffset = offset;
+    ofn->nFileExtension = ext;
+    ofn->Flags &= ~OFN_READONLY;
+    COMDLG32_SetCommDlgExtendedError(0);
+
+    HeapFree(GetProcessHeap(), 0, b.s);
+    HeapFree(GetProcessHeap(), 0, paths);
+    return MAN_PICK_OK;
+}
