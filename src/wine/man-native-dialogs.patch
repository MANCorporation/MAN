+/* MAN: the desktop's file picker instead of the dialog below. Programs that add
+ * their own controls to the dialog keep Wine's. TRUE: handled, the result in *ret. */
+static BOOL man_itemdlg_show(FileDialogImpl *This, HWND parent, HRESULT *ret)
+{
+    UINT flags = 0, i;
+    struct man_buf filters = {0};
+    WCHAR *dir = NULL;
+    IShellItem *folder = This->psi_setfolder ? This->psi_setfolder : This->psi_defaultfolder;
+    BOOL handled = TRUE;
+
+    if (!list_empty(&This->cctrls))
+        return FALSE;
+    if (This->dlg_type == ITEMDLG_TYPE_SAVE) flags |= MAN_PICK_SAVE;
+    if (This->options & FOS_PICKFOLDERS) flags |= MAN_PICK_FOLDER;
+    if (This->options & FOS_ALLOWMULTISELECT) flags |= MAN_PICK_MULTI;
+    for (i = 0; i < This->filterspec_count; i++)
+    {
+        man_add(&filters, This->filterspecs[i].pszName, lstrlenW(This->filterspecs[i].pszName) + 1);
+        man_add(&filters, This->filterspecs[i].pszSpec, lstrlenW(This->filterspecs[i].pszSpec) + 1);
+    }
+    if (folder) IShellItem_GetDisplayName(folder, SIGDN_FILESYSPATH, &dir);
+
+    for (;;)
+    {
+        WCHAR *paths = NULL, *p;
+        LPITEMIDLIST *pidls;
+        IShellItemArray *array = NULL;
+        UINT count = 0;
+        HRESULT hr;
+        int res = man_pick(parent, This->custom_title, filters.s, This->filetypeindex + 1, dir,
+                           This->set_filename, flags, &paths);
+
+        if (res == MAN_PICK_UNAVAILABLE)
+        {
+            handled = FALSE;
+            break;
+        }
+        if (res == MAN_PICK_CANCEL)
+        {
+            *ret = HRESULT_FROM_WIN32(ERROR_CANCELLED);
+            break;
+        }
+
+        for (p = paths; *p; p += lstrlenW(p) + 1) count++;
+        pidls = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, count * sizeof(*pidls));
+        for (i = 0, p = paths; *p; p += lstrlenW(p) + 1, i++)
+        {
+            struct man_buf name = {0};
+            WCHAR *leaf = wcsrchr(p, '\\');
+
+            man_adds(&name, p);
+            if (flags & MAN_PICK_SAVE && This->default_ext && *This->default_ext &&
+                !wcschr(leaf ? leaf : p, '.'))
+            {
+                man_adds(&name, L".");
+                man_adds(&name, This->default_ext);
+            }
+            /* A file to save may not exist yet. */
+            if (FAILED(SHParseDisplayName(name.s, NULL, &pidls[i], 0, NULL)))
+                pidls[i] = SHSimpleIDListFromPath(name.s);
+            HeapFree(GetProcessHeap(), 0, name.s);
+        }
+        hr = SHCreateShellItemArrayFromIDLists(count, (PCIDLIST_ABSOLUTE_ARRAY)pidls, &array);
+        for (i = 0; i < count; i++) ILFree(pidls[i]);
+        HeapFree(GetProcessHeap(), 0, pidls);
+        HeapFree(GetProcessHeap(), 0, paths);
+        if (FAILED(hr))
+        {
+            *ret = hr;
+            break;
+        }
+
+        if (This->psia_results) IShellItemArray_Release(This->psia_results);
+        This->psia_results = array;
+        if (events_OnFileOk(This) == S_OK)
+        {
+            *ret = S_OK;
+            break;
+        }
+        /* The program refused this choice: ask again. */
+    }
+    CoTaskMemFree(dir);
+    HeapFree(GetProcessHeap(), 0, filters.s);
+    return handled;
+}
