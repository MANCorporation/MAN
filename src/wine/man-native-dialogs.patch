+/* MAN: the desktop's folder picker instead of the dialog below. A callback only
+ * gets to preselect a folder there, so it is not needed here. TRUE: handled. */
+static BOOL man_browse_folder(LPBROWSEINFOW lpbi, LPITEMIDLIST *ret)
+{
+    WCHAR root[MAX_PATH], *dir = NULL, *paths = NULL;
+    int res;
+
+    if (lpbi->ulFlags & (BIF_BROWSEFORCOMPUTER | BIF_BROWSEFORPRINTER | BIF_BROWSEINCLUDEFILES))
+        return FALSE;
+    if (lpbi->pidlRoot && SHGetPathFromIDListW(lpbi->pidlRoot, root)) dir = root;
+    res = man_pick(lpbi->hwndOwner, lpbi->lpszTitle, NULL, 0, dir, NULL, MAN_PICK_FOLDER, &paths);
+    if (res == MAN_PICK_UNAVAILABLE) return FALSE;
+
+    *ret = NULL;
+    if (res == MAN_PICK_OK)
+    {
+        if (FAILED(SHParseDisplayName(paths, NULL, ret, 0, NULL)))
+            *ret = NULL;
+        if (*ret && lpbi->pszDisplayName)
+        {
+            WCHAR *leaf = wcsrchr(paths, '\\');
+            lstrcpynW(lpbi->pszDisplayName, leaf ? leaf + 1 : paths, MAX_PATH);
+        }
+        HeapFree(GetProcessHeap(), 0, paths);
+    }
+    return TRUE;
+}
