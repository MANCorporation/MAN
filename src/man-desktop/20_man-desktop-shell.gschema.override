# The desktop as MAN ships it (man-desktop-shell). Settings > Appearance and
# Multitasking change these.
[org.gnome.shell]
# Window Tiling is off until it is turned on in Settings > Multitasking.
enabled-extensions=['man-look@man.invalid', 'man-dock@man.invalid', 'man-blur@man.invalid']

[com.man.desktop.dock]
dock-position='BOTTOM'
dash-max-icon-size=48
dock-fixed=false
intellihide=true
autohide=true
extend-height=false
show-trash=false
show-mounts=false
disable-overview-on-startup=false
hot-keys=false
apply-custom-theme=false
custom-theme-shrink=true
transparency-mode='DYNAMIC'
# Touchscreens, tablets and virtual machines cannot push against the screen edge.
require-pressure-to-show=false

[com.man.desktop.blur.man-dock]
# Live blur: what is behind the dock, windows too, not only the wallpaper.
static-blur=false
