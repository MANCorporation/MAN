msgid "Show Extended Input Sources"
msgstr "விரிவாக்கப்பட்ட உள்ளீட்டு மூலங்களைக் காட்டு"

#: panels/common/cc-man-tweaks.c:734
msgid "Offer more layouts when adding an input source"
msgstr "உள்ளீட்டு மூலத்தைச் சேர்க்கும்போது மேலும் தளவமைப்புகளைக் காட்டு"

#: panels/common/cc-man-tweaks.c:737
msgid "Emacs Input"
msgstr "Emacs உள்ளீடு"

#: panels/common/cc-man-tweaks.c:738
msgid "Emacs key bindings in text fields"
msgstr "உரைப் புலங்களில் Emacs விசைக் கட்டுகள்"

