msgid "Middle Click Paste"
msgstr "நடுச் சொடுக்கால் ஒட்டு"

#: panels/common/cc-man-tweaks.c:759
msgid "Paste the selected text with the middle button"
msgstr "தேர்ந்தெடுத்த உரையை நடுப் பொத்தானால் ஒட்டு"

#: panels/common/cc-man-tweaks.c:762
msgid "Locate Pointer"
msgstr "சுட்டியைக் கண்டறி"

#: panels/common/cc-man-tweaks.c:762
msgid "Press Ctrl to show where the pointer is"
msgstr "சுட்டி எங்கே என்று காட்ட Ctrl அழுத்தவும்"

#: panels/common/cc-man-tweaks.c:820
msgid "Laptop Lid"
msgstr "மடிக்கணினி மூடி"

#: panels/common/cc-man-tweaks.c:822
msgid "Suspend When Lid Is Closed"
msgstr "மூடியை மூடும்போது இடைநிறுத்து"

#: panels/common/cc-man-tweaks.c:823
msgid "Turn off to keep the computer running, for example with an external screen"
msgstr "கணினி தொடர்ந்து இயங்க அணைக்கவும், எ.கா. வெளித் திரையுடன்"

#: panels/common/cc-man-tweaks.c:913
msgid "No startup apps"
msgstr "தொடக்கச் செயலிகள் இல்லை"

