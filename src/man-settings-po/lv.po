msgstr "“%s” darbojas ārpus smilškastes. Pārstartējiet to, lai piemērotu."

#: panels/applications/cc-applications-panel.c:1571
msgid "The sandbox of “%s” was restored."
msgstr "“%s” smilškaste ir atjaunota."

