msgstr "Programi Flatpak delujejo ločeno od preostanka sistema."

#: panels/applications/cc-applications-panel.c:2071
msgid "_Unsandbox App…"
msgstr "_Vzemi iz peskovnika …"

#: panels/applications/cc-applications-panel.c:2072
