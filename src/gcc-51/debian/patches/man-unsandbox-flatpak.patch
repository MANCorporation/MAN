+/* --- MAN: unsandbox Flatpak apps --- */
+
+#define MAN_SANDBOX_HELPER "/usr/libexec/man/man-flatpak-sandbox"
+#define MAN_UNSANDBOXED_DIR "/var/lib/man/unsandboxed"
+
+typedef struct {
+    CcApplicationsPanel *self;
+    gchar *op;
+    gchar *app_id;
+    gchar *app_name;
+} ManSandboxOp;
+
+static void
+man_sandbox_op_free (ManSandboxOp *op)
+{
+    g_object_unref (op->self);
+    g_free (op->op);
+    g_free (op->app_id);
+    g_free (op->app_name);
+    g_free (op);
+}
+
+static gboolean
+man_is_unsandboxed (const gchar *flatpak_id)
+{
+    g_autofree gchar *path = g_build_filename (MAN_UNSANDBOXED_DIR, flatpak_id, NULL);
+    return g_file_test (path, G_FILE_TEST_EXISTS);
+}
+
+static void
+man_update_sandbox_group (CcApplicationsPanel *self)
+{
+    gboolean flatpak = self->man_flatpak_id != NULL;
+    gboolean open = flatpak && man_is_unsandboxed (self->man_flatpak_id);
+
+    gtk_widget_set_visible (GTK_WIDGET (self->man_sandbox_group), flatpak);
+    if (!flatpak)
+        return;
+
+    adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->man_sandbox_status_row),
+                                   open ? _("Unsandboxed") : _("Sandboxed"));
+    adw_action_row_set_subtitle (self->man_sandbox_status_row,
+                                 open ? _("The app has full access to your files, devices and the system")
+                                      : _("The app can only use the permissions it was given"));
+    gtk_image_set_from_icon_name (self->man_sandbox_status_icon,
+                                  open ? "channel-insecure-symbolic" : "security-high-symbolic");
+    if (open)
+        gtk_widget_add_css_class (GTK_WIDGET (self->man_sandbox_status_icon), "warning");
+    else
+        gtk_widget_remove_css_class (GTK_WIDGET (self->man_sandbox_status_icon), "warning");
+    gtk_widget_set_visible (GTK_WIDGET (self->man_unsandbox_row), !open);
+    gtk_widget_set_visible (GTK_WIDGET (self->man_restore_sandbox_row), open);
+}
+
+static void
+man_toast (CcApplicationsPanel *self, const gchar *text)
+{
+    adw_toast_overlay_add_toast (self->toast_overlay, adw_toast_new (text));
+}
+
+static void man_run_helper (CcApplicationsPanel *self, const gchar *op, const gchar *app_id, const gchar *app_name);
+
+static void
+man_confirm_response_cb (AdwAlertDialog *dialog, GAsyncResult *result, ManSandboxOp *op)
+{
+    const gchar *response = adw_alert_dialog_choose_finish (dialog, result);
+
+    if (g_strcmp0 (response, "proceed") == 0)
+        man_run_helper (op->self, "unsandbox", op->app_id, op->app_name);
+    man_sandbox_op_free (op);
+}
+
+static void
+man_show_warning (ManSandboxOp *op)
+{
+    AdwDialog *dialog;
+    g_autofree gchar *heading = g_strdup_printf (_("Unsandbox “%s”?"), op->app_name);
+
+    dialog = adw_alert_dialog_new (heading,
+        _("The app will get full access to this computer: all your files and the system files, "
+          "every device, the network, and all system services. It can run commands outside its "
+          "container and read or change anything your account can.\n\n"
+          "Only do this for apps you completely trust. A harmful or buggy app could damage your "
+          "system or steal your data.\n\n"
+          "You can restore the sandbox here at any time. The app needs to be restarted for the "
+          "change to apply."));
+    adw_alert_dialog_add_responses (ADW_ALERT_DIALOG (dialog),
+                                    "cancel", _("_Cancel"),
+                                    "proceed", _("_Proceed"),
+                                    NULL);
+    adw_alert_dialog_set_response_appearance (ADW_ALERT_DIALOG (dialog), "proceed", ADW_RESPONSE_DESTRUCTIVE);
+    adw_alert_dialog_set_default_response (ADW_ALERT_DIALOG (dialog), "cancel");
+    adw_alert_dialog_set_close_response (ADW_ALERT_DIALOG (dialog), "cancel");
+    /* Take the parent before handing over op: argument order is unspecified. */
+    GtkWidget *parent = GTK_WIDGET (op->self);
+    adw_alert_dialog_choose (ADW_ALERT_DIALOG (dialog), parent, NULL,
+                             (GAsyncReadyCallback) man_confirm_response_cb, op);
+}
+
+static void
+man_helper_done_cb (GObject *source, GAsyncResult *result, gpointer user_data)
+{
+    ManSandboxOp *op = user_data;
+    GSubprocess *proc = G_SUBPROCESS (source);
+    g_autoptr(GError) error = NULL;
+    gint status;
+
+    g_subprocess_wait_finish (proc, result, &error);
+    status = g_subprocess_get_if_exited (proc) ? g_subprocess_get_exit_status (proc) : -1;
+
+    gtk_widget_set_sensitive (GTK_WIDGET (op->self->man_sandbox_group), TRUE);
+
+    if (error != NULL || status != 0) {
+        /* pkexec: 126 = dialog dismissed, 127 = not authorized */
+        if (status == 126 || status == 127)
+            man_toast (op->self, _("Authentication failed. Nothing was changed."));
+        else
+            man_toast (op->self, _("The sandbox could not be changed."));
+        man_sandbox_op_free (op);
+        return;
+    }
+
+    if (g_str_equal (op->op, "auth")) {
+        /* Password accepted: now ask for confirmation. */
+        man_show_warning (op);
+        return;
+    }
+
+    if (g_strcmp0 (op->app_id, op->self->man_flatpak_id) == 0)
+        man_update_sandbox_group (op->self);
+
+    if (g_str_equal (op->op, "unsandbox")) {
+        g_autofree gchar *text = g_strdup_printf (_("“%s” is unsandboxed. Restart it to apply."), op->app_name);
+        man_toast (op->self, text);
+    } else {
+        g_autofree gchar *text = g_strdup_printf (_("The sandbox of “%s” was restored."), op->app_name);
+        man_toast (op->self, text);
+    }
+    man_sandbox_op_free (op);
+}
+
+static void
+man_run_helper (CcApplicationsPanel *self, const gchar *op_name, const gchar *app_id, const gchar *app_name)
+{
+    g_autoptr(GError) error = NULL;
+    g_autoptr(GSubprocess) proc = NULL;
+    ManSandboxOp *op;
+
+    if (g_str_equal (op_name, "auth"))
+        proc = g_subprocess_new (G_SUBPROCESS_FLAGS_STDOUT_SILENCE | G_SUBPROCESS_FLAGS_STDERR_SILENCE, &error,
+                                 "pkexec", MAN_SANDBOX_HELPER, "auth", NULL);
+    else
+        proc = g_subprocess_new (G_SUBPROCESS_FLAGS_STDOUT_SILENCE | G_SUBPROCESS_FLAGS_STDERR_SILENCE, &error,
+                                 "pkexec", MAN_SANDBOX_HELPER, op_name, app_id, NULL);
+    if (proc == NULL) {
+        g_warning ("Failed to run %s: %s", MAN_SANDBOX_HELPER, error->message);
+        man_toast (self, _("The sandbox could not be changed."));
+        return;
+    }
+
+    op = g_new0 (ManSandboxOp, 1);
+    op->self = g_object_ref (self);
+    op->op = g_strdup (op_name);
+    op->app_id = g_strdup (app_id);
+    op->app_name = g_strdup (app_name);
+    gtk_widget_set_sensitive (GTK_WIDGET (self->man_sandbox_group), FALSE);
+    g_subprocess_wait_async (proc, NULL, man_helper_done_cb, op);
+}
+
+static const gchar *
+man_current_app_name (CcApplicationsPanel *self)
+{
+    return self->current_app_info ? g_app_info_get_display_name (self->current_app_info) : self->man_flatpak_id;
+}
+
+static void
+man_unsandbox_cb (CcApplicationsPanel *self)
+{
+    if (self->man_flatpak_id)
+        man_run_helper (self, "auth", self->man_flatpak_id, man_current_app_name (self));
+}
+
+static void
+man_restore_sandbox_cb (CcApplicationsPanel *self)
+{
+    if (self->man_flatpak_id)
+        man_run_helper (self, "restore", self->man_flatpak_id, man_current_app_name (self));
+}
+
