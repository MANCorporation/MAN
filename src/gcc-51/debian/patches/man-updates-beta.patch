+/* Switching the channel changes what is offered: look again (unless an
+ * update is already on its way). */
+static void
+beta_changed_cb (CcManUpdatesPanel *self)
+{
+  switch (self->state)
+    {
+    case STATE_CHECKING:
+    case STATE_CURRENT:
+    case STATE_AVAILABLE:
+    case STATE_CHECK_ERROR:
+    case STATE_DOWNLOAD_ERROR:
+    case STATE_INVALID:
+      /* The checker reads the setting itself: write it out first. */
+      g_settings_sync ();
+      g_cancellable_cancel (self->cancellable);
+      g_clear_object (&self->cancellable);
+      self->cancellable = g_cancellable_new ();
+      start_check (self);
+      break;
+    default:
+      break;
+    }
+}
