+}
+
+/* XKB option groups that allow several options at once (rules XML). */
+static GHashTable *
+xkb_multi_groups (void)
+{
+  GHashTable *set = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  g_autofree char *xml = NULL;
+  g_autoptr(GRegex) re = g_regex_new ("<group\\s+allowMultipleSelection=\"true\">\\s*<configItem>\\s*<name>([^<]+)</name>",
+                                      0, 0, NULL);
+  g_autoptr(GMatchInfo) m = NULL;
+  if (!g_file_get_contents ("/usr/share/X11/xkb/rules/evdev.xml", &xml, NULL, NULL))
+    return set;
+  g_regex_match (re, xml, 0, &m);
+  while (g_match_info_matches (m))
+    {
+      g_hash_table_add (set, g_match_info_fetch (m, 1));
+      g_match_info_next (m, NULL);
+    }
+  return set;
+}
+
+typedef struct {
+  GSettings *settings;
+  GnomeXkbInfo *info;
+  GHashTable *multi;
+  gboolean updating;
+} XkbData;
+
+static void
+xkb_data_free (XkbData *d)
+{
+  g_object_unref (d->settings);
+  g_object_unref (d->info);
+  g_hash_table_unref (d->multi);
+  g_free (d);
+}
+
+static void
+xkb_option_toggled_cb (GtkCheckButton *check, XkbData *d)
+{
+  const char *group = g_object_get_data (G_OBJECT (check), "xkb-group");
+  const char *option = g_object_get_data (G_OBJECT (check), "xkb-option");
+  gboolean active = gtk_check_button_get_active (check);
+  g_auto(GStrv) current = g_settings_get_strv (d->settings, "xkb-options");
+  g_autoptr(GStrvBuilder) b = g_strv_builder_new ();
+  g_autofree char *prefix = g_strconcat (group, ":", NULL);
+  gboolean single = !g_hash_table_contains (d->multi, group);
+  g_auto(GStrv) result = NULL;
+
+  if (d->updating)
+    return;
+  /* Radio buttons also report the one being switched off; only the newly
+   * chosen one counts (the order of the two signals is not defined). */
+  if (single && !active)
+    return;
+  for (guint i = 0; current[i]; i++)
+    {
+      if (option && g_str_equal (current[i], option))
+        continue;
+      if (single && g_str_has_prefix (current[i], prefix))
+        continue;
+      g_strv_builder_add (b, current[i]);
+    }
+  if (active && option)
+    g_strv_builder_add (b, option);
+  result = g_strv_builder_end (b);
+  g_settings_set_strv (d->settings, "xkb-options", (const char * const *) result);
+}
+
+static int
+compare_group_desc (gconstpointer a, gconstpointer b, gpointer info)
+{
+  return g_utf8_collate (gnome_xkb_info_description_for_group (info, a),
+                         gnome_xkb_info_description_for_group (info, b));
+}
+
+static void
+show_xkb_dialog (GtkWidget *parent)
+{
+  AdwDialog *dialog = adw_preferences_dialog_new ();
+  GtkWidget *page = adw_preferences_page_new ();
+  GtkWidget *group = adw_preferences_group_new ();
+  XkbData *d = g_new0 (XkbData, 1);
+  g_autoptr(GList) groups = NULL;
+  g_auto(GStrv) current = NULL;
+
+  d->settings = g_settings_new (INPUT_SOURCES_SCHEMA);
+  d->info = gnome_xkb_info_new ();
+  d->multi = xkb_multi_groups ();
+  g_object_set_data_full (G_OBJECT (dialog), "man-xkb", d, (GDestroyNotify) xkb_data_free);
+  current = g_settings_get_strv (d->settings, "xkb-options");
+
+  adw_dialog_set_title (dialog, _("Additional Layout Options"));
+  adw_dialog_set_content_width (dialog, 640);
+  adw_dialog_set_content_height (dialog, 720);
+  adw_preferences_dialog_set_search_enabled (ADW_PREFERENCES_DIALOG (dialog), TRUE);
+  adw_preferences_group_set_description (ADW_PREFERENCES_GROUP (group),
+                                         _("Extra behavior for keys on all keyboard layouts"));
+
+  groups = g_list_sort_with_data (gnome_xkb_info_get_all_option_groups (d->info), compare_group_desc, d->info);
+  for (GList *l = groups; l; l = l->next)
+    {
+      const char *gid = l->data;
+      GtkWidget *expander = adw_expander_row_new ();
+      g_autoptr(GList) options = gnome_xkb_info_get_options_for_group (d->info, gid);
+      gboolean single = !g_hash_table_contains (d->multi, gid);
+      GtkCheckButton *first = NULL;
+      guint selected = 0;
+
+      adw_preferences_row_set_title (ADW_PREFERENCES_ROW (expander), gnome_xkb_info_description_for_group (d->info, gid));
+      adw_preferences_row_set_use_markup (ADW_PREFERENCES_ROW (expander), FALSE);
+
+      if (single)
+        {
+          /* "Default" clears the group. */
+          GtkWidget *row = adw_action_row_new ();
+          GtkWidget *check = gtk_check_button_new ();
+          adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), _("Default"));
+          adw_action_row_add_prefix (ADW_ACTION_ROW (row), check);
+          adw_action_row_set_activatable_widget (ADW_ACTION_ROW (row), check);
+          g_object_set_data_full (G_OBJECT (check), "xkb-group", g_strdup (gid), g_free);
+          first = GTK_CHECK_BUTTON (check);
+          g_signal_connect (check, "toggled", G_CALLBACK (xkb_option_toggled_cb), d);
+          adw_expander_row_add_row (ADW_EXPANDER_ROW (expander), row);
+        }
+
+      options = g_list_sort (options, (GCompareFunc) g_strcmp0);
+      for (GList *o = options; o; o = o->next)
+        {
+          const char *oid = o->data;
+          GtkWidget *row = adw_action_row_new ();
+          GtkWidget *check = gtk_check_button_new ();
+          gboolean on = g_strv_contains ((const char * const *) current, oid);
+
+          adw_preferences_row_set_use_markup (ADW_PREFERENCES_ROW (row), FALSE);
+          adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), gnome_xkb_info_description_for_option (d->info, gid, oid));
+          adw_action_row_add_prefix (ADW_ACTION_ROW (row), check);
+          adw_action_row_set_activatable_widget (ADW_ACTION_ROW (row), check);
+          if (first)
+            gtk_check_button_set_group (GTK_CHECK_BUTTON (check), first);
+          gtk_check_button_set_active (GTK_CHECK_BUTTON (check), on);
+          if (on)
+            selected++;
+          g_object_set_data_full (G_OBJECT (check), "xkb-group", g_strdup (gid), g_free);
+          g_object_set_data_full (G_OBJECT (check), "xkb-option", g_strdup (oid), g_free);
+          g_signal_connect (check, "toggled", G_CALLBACK (xkb_option_toggled_cb), d);
+          adw_expander_row_add_row (ADW_EXPANDER_ROW (expander), row);
+        }
+      if (first && selected == 0)
+        gtk_check_button_set_active (first, TRUE);
+      if (selected > 0)
+        {
+          g_autofree char *sub = g_strdup_printf (ngettext ("%u option on", "%u options on", selected), selected);
+          adw_expander_row_set_subtitle (ADW_EXPANDER_ROW (expander), sub);
+        }
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), expander);
+    }
+
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (group));
+  adw_preferences_dialog_add (ADW_PREFERENCES_DIALOG (dialog), ADW_PREFERENCES_PAGE (page));
+  adw_dialog_present (dialog, parent);
+}
