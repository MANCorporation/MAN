@@ -0,0 +1,1043 @@
+/* cc-man-tweaks.c
+ *
+ * MAN: the GNOME Tweaks options, built into the Settings panels where they
+ * belong. Every row writes the same GSettings keys GNOME Tweaks writes.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#define GNOME_DESKTOP_USE_UNSTABLE_API
+#include <config.h>
+#include <stdlib.h>
+#include <string.h>
+#include <glib/gi18n.h>
+#include <glib/gstdio.h>
+#include <gio/gdesktopappinfo.h>
+#include <libgnome-desktop/gnome-xkb-info.h>
+
+#include "cc-man-tweaks.h"
+
+#define INTERFACE_SCHEMA "org.gnome.desktop.interface"
+#define WM_SCHEMA "org.gnome.desktop.wm.preferences"
+#define MUTTER_SCHEMA "org.gnome.mutter"
+#define INPUT_SOURCES_SCHEMA "org.gnome.desktop.input-sources"
+#define SOUND_SCHEMA "org.gnome.desktop.sound"
+
+/* ───────────────────────────── helpers ───────────────────────────── */
+
+/* Keeps the GSettings object alive as long as the widget. */
+static GSettings *
+settings_for (GtkWidget *widget, const char *schema)
+{
+  GSettings *settings = g_settings_new (schema);
+  g_object_set_data_full (G_OBJECT (widget), schema, settings, g_object_unref);
+  return settings;
+}
+
+static gboolean
+schema_has_key (const char *schema, const char *key)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr(GSettingsSchema) s = g_settings_schema_source_lookup (source, schema, TRUE);
+  return s != NULL && g_settings_schema_has_key (s, key);
+}
+
+static GtkWidget *
+switch_row (const char *title, const char *subtitle, const char *schema, const char *key)
+{
+  GtkWidget *row = adw_switch_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), title);
+  if (subtitle)
+    adw_action_row_set_subtitle (ADW_ACTION_ROW (row), subtitle);
+  g_settings_bind (settings_for (row, schema), key, row, "active", G_SETTINGS_BIND_DEFAULT);
+  return row;
+}
+
+/* A combo row choosing one string value (or enum nick) of a key. */
+typedef struct {
+  GSettings *settings;
+  char *key;
+  GStrv values;
+  gboolean updating;
+} ComboData;
+
+static void
+combo_data_free (ComboData *d)
+{
+  g_object_unref (d->settings);
+  g_free (d->key);
+  g_strfreev (d->values);
+  g_free (d);
+}
+
+static void
+combo_sync_from_settings (AdwComboRow *row, ComboData *d)
+{
+  g_autofree char *value = g_settings_get_string (d->settings, d->key);
+  guint i = g_strv_length (d->values);
+  if (value && g_strv_contains ((const char * const *) d->values, value))
+    for (i = 0; d->values[i] && g_strcmp0 (d->values[i], value) != 0; i++);
+  d->updating = TRUE;
+  adw_combo_row_set_selected (row, i < g_strv_length (d->values) ? i : GTK_INVALID_LIST_POSITION);
+  d->updating = FALSE;
+}
+
+static void
+combo_settings_changed_cb (GSettings *settings, const char *key, AdwComboRow *row)
+{
+  combo_sync_from_settings (row, g_object_get_data (G_OBJECT (row), "man-combo"));
+}
+
+static void
+combo_selected_cb (AdwComboRow *row, GParamSpec *pspec, ComboData *d)
+{
+  guint i = adw_combo_row_get_selected (row);
+  if (d->updating || i == GTK_INVALID_LIST_POSITION || i >= g_strv_length (d->values))
+    return;
+  g_settings_set_string (d->settings, d->key, d->values[i]);
+}
+
+static GtkWidget *
+combo_row (const char *title, const char *subtitle, const char *schema, const char *key,
+           const char * const *labels, const char * const *values)
+{
+  GtkWidget *row = adw_combo_row_new ();
+  ComboData *d = g_new0 (ComboData, 1);
+  g_autofree char *signal = g_strdup_printf ("changed::%s", key);
+
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), title);
+  if (subtitle)
+    adw_action_row_set_subtitle (ADW_ACTION_ROW (row), subtitle);
+  d->settings = g_settings_new (schema);
+  d->key = g_strdup (key);
+  d->values = g_strdupv ((char **) values);
+  adw_combo_row_set_model (ADW_COMBO_ROW (row), G_LIST_MODEL (gtk_string_list_new (labels)));
+  g_object_set_data_full (G_OBJECT (row), "man-combo", d, (GDestroyNotify) combo_data_free);
+  combo_sync_from_settings (ADW_COMBO_ROW (row), d);
+  g_signal_connect_object (d->settings, signal, G_CALLBACK (combo_settings_changed_cb), row, 0);
+  g_signal_connect (row, "notify::selected", G_CALLBACK (combo_selected_cb), d);
+  return row;
+}
+
+/* ─────────────────────────────── fonts ─────────────────────────────── */
+
+typedef struct {
+  GSettings *settings;
+  char *key;
+  gboolean updating;
+} FontData;
+
+static void
+font_data_free (FontData *d)
+{
+  g_object_unref (d->settings);
+  g_free (d->key);
+  g_free (d);
+}
+
+static void
+font_sync (GtkFontDialogButton *button, FontData *d)
+{
+  g_autofree char *value = g_settings_get_string (d->settings, d->key);
+  PangoFontDescription *desc = pango_font_description_from_string (value);
+  d->updating = TRUE;
+  gtk_font_dialog_button_set_font_desc (button, desc);
+  d->updating = FALSE;
+  pango_font_description_free (desc);
+}
+
+static void
+font_settings_changed_cb (GSettings *settings, const char *key, GtkFontDialogButton *button)
+{
+  font_sync (button, g_object_get_data (G_OBJECT (button), "man-font"));
+}
+
+static void
+font_chosen_cb (GtkFontDialogButton *button, GParamSpec *pspec, FontData *d)
+{
+  PangoFontDescription *desc = gtk_font_dialog_button_get_font_desc (button);
+  g_autofree char *value = NULL;
+  if (d->updating || desc == NULL)
+    return;
+  value = pango_font_description_to_string (desc);
+  g_settings_set_string (d->settings, d->key, value);
+}
+
+static GtkWidget *
+font_row (const char *title, const char *schema, const char *key)
+{
+  GtkWidget *row = adw_action_row_new ();
+  GtkFontDialog *dialog = gtk_font_dialog_new ();
+  GtkWidget *button = gtk_font_dialog_button_new (dialog);
+  FontData *d = g_new0 (FontData, 1);
+  g_autofree char *signal = g_strdup_printf ("changed::%s", key);
+
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), title);
+  gtk_font_dialog_set_title (dialog, title);
+  gtk_font_dialog_button_set_level (GTK_FONT_DIALOG_BUTTON (button), GTK_FONT_LEVEL_FONT);
+  gtk_font_dialog_button_set_use_font (GTK_FONT_DIALOG_BUTTON (button), TRUE);
+  gtk_widget_set_valign (button, GTK_ALIGN_CENTER);
+  adw_action_row_add_suffix (ADW_ACTION_ROW (row), button);
+  adw_action_row_set_activatable_widget (ADW_ACTION_ROW (row), button);
+
+  d->settings = g_settings_new (schema);
+  d->key = g_strdup (key);
+  g_object_set_data_full (G_OBJECT (button), "man-font", d, (GDestroyNotify) font_data_free);
+  font_sync (GTK_FONT_DIALOG_BUTTON (button), d);
+  g_signal_connect_object (d->settings, signal, G_CALLBACK (font_settings_changed_cb), button, 0);
+  g_signal_connect (button, "notify::font-desc", G_CALLBACK (font_chosen_cb), d);
+  return row;
+}
+
+static void
+rendering_changed_cb (GSettings *settings, const char *key, GtkWidget **rows)
+{
+  g_autofree char *mode = g_settings_get_string (settings, "font-rendering");
+  gboolean manual = g_strcmp0 (mode, "manual") == 0;
+  for (guint i = 0; rows[i]; i++)
+    gtk_widget_set_sensitive (rows[i], manual);
+}
+
+static AdwPreferencesGroup *
+fonts_group (void)
+{
+  GtkWidget *group = adw_preferences_group_new ();
+  GtkWidget *scaling;
+  GtkAdjustment *adj;
+  static const char *rendering_labels[] = { N_("Automatic"), N_("Manual"), NULL };
+  static const char *rendering_values[] = { "automatic", "manual", NULL };
+  static const char *hinting_labels[] = { N_("None"), N_("Slight"), N_("Medium"), N_("Full"), NULL };
+  static const char *hinting_values[] = { "none", "slight", "medium", "full", NULL };
+  static const char *aa_labels[] = { N_("None"), N_("Standard (Grayscale)"), N_("Subpixel (for LCD Screens)"), NULL };
+  static const char *aa_values[] = { "none", "grayscale", "rgba", NULL };
+
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (group), _("Fonts"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), font_row (_("Interface Text"), INTERFACE_SCHEMA, "font-name"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), font_row (_("Document Text"), INTERFACE_SCHEMA, "document-font-name"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), font_row (_("Monospace Text"), INTERFACE_SCHEMA, "monospace-font-name"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), font_row (_("Legacy Window Titles"), WM_SCHEMA, "titlebar-font"));
+
+  if (schema_has_key (INTERFACE_SCHEMA, "font-rendering"))
+    {
+      GtkWidget **manual_rows = g_new0 (GtkWidget *, 3);
+      GtkWidget *rendering = combo_row (_("Rendering"), _("Manual uses the hinting and antialiasing below"),
+                                        INTERFACE_SCHEMA, "font-rendering", rendering_labels, rendering_values);
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), rendering);
+      manual_rows[0] = combo_row (_("Hinting"), NULL, INTERFACE_SCHEMA, "font-hinting", hinting_labels, hinting_values);
+      manual_rows[1] = combo_row (_("Antialiasing"), NULL, INTERFACE_SCHEMA, "font-antialiasing", aa_labels, aa_values);
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), manual_rows[0]);
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), manual_rows[1]);
+      g_object_set_data_full (G_OBJECT (rendering), "man-manual-rows", manual_rows, g_free);
+      {
+        GSettings *s = settings_for (rendering, INTERFACE_SCHEMA);
+        g_signal_connect (s, "changed::font-rendering", G_CALLBACK (rendering_changed_cb), manual_rows);
+        rendering_changed_cb (s, "font-rendering", manual_rows);
+      }
+    }
+  else
+    {
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (group),
+                                 combo_row (_("Hinting"), NULL, INTERFACE_SCHEMA, "font-hinting", hinting_labels, hinting_values));
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (group),
+                                 combo_row (_("Antialiasing"), NULL, INTERFACE_SCHEMA, "font-antialiasing", aa_labels, aa_values));
+    }
+
+  adj = gtk_adjustment_new (1.0, 0.5, 3.0, 0.05, 0.25, 0);
+  scaling = adw_spin_row_new (adj, 0.05, 2);
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (scaling), _("Scaling Factor"));
+  adw_action_row_set_subtitle (ADW_ACTION_ROW (scaling), _("Makes all text larger or smaller"));
+  g_settings_bind (settings_for (scaling, INTERFACE_SCHEMA), "text-scaling-factor", scaling, "value", G_SETTINGS_BIND_DEFAULT);
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), scaling);
+  return ADW_PREFERENCES_GROUP (group);
+}
+
+/* ────────────────────────────── themes ────────────────────────────── */
+
+typedef gboolean (*ThemeFilter) (const char *path);
+
+static gboolean
+is_cursor_theme (const char *path)
+{
+  g_autofree char *cursors = g_build_filename (path, "cursors", NULL);
+  return g_file_test (cursors, G_FILE_TEST_IS_DIR);
+}
+
+static gboolean
+is_icon_theme (const char *path)
+{
+  g_autofree char *index = g_build_filename (path, "index.theme", NULL);
+  g_autofree char *text = NULL;
+  g_autofree char *base = g_path_get_basename (path);
+  if (g_str_equal (base, "default") || g_str_equal (base, "hicolor") || !g_file_get_contents (index, &text, NULL, NULL))
+    return FALSE;
+  /* Cursor-only themes have no icon directories. */
+  return strstr (text, "\nDirectories=") != NULL;
+}
+
+static gboolean
+is_gtk3_theme (const char *path)
+{
+  g_autofree char *gtk3 = g_build_filename (path, "gtk-3.0", NULL);
+  return g_file_test (gtk3, G_FILE_TEST_IS_DIR);
+}
+
+static gboolean
+is_sound_theme (const char *path)
+{
+  g_autofree char *index = g_build_filename (path, "index.theme", NULL);
+  return g_file_test (index, G_FILE_TEST_EXISTS);
+}
+
+static int
+compare_names (const void *a, const void *b)
+{
+  return g_utf8_collate (*(const char **) a, *(const char **) b);
+}
+
+/* Theme names found in ~/.<legacy>, the user and the system data dirs. */
+static GStrv
+collect_themes (const char *subdir, const char *legacy, ThemeFilter filter, const char * const *builtin)
+{
+  g_autoptr(GPtrArray) dirs = g_ptr_array_new_with_free_func (g_free);
+  g_autoptr(GHashTable) seen = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  g_autoptr(GStrvBuilder) builder = g_strv_builder_new ();
+  const char * const *sys = g_get_system_data_dirs ();
+  GStrv names;
+
+  if (legacy)
+    g_ptr_array_add (dirs, g_build_filename (g_get_home_dir (), legacy, NULL));
+  g_ptr_array_add (dirs, g_build_filename (g_get_user_data_dir (), subdir, NULL));
+  for (guint i = 0; sys[i]; i++)
+    g_ptr_array_add (dirs, g_build_filename (sys[i], subdir, NULL));
+
+  for (guint i = 0; builtin && builtin[i]; i++)
+    if (g_hash_table_add (seen, g_strdup (builtin[i])))
+      g_strv_builder_add (builder, builtin[i]);
+
+  for (guint i = 0; i < dirs->len; i++)
+    {
+      g_autoptr(GDir) dir = g_dir_open (dirs->pdata[i], 0, NULL);
+      const char *name;
+      while (dir && (name = g_dir_read_name (dir)))
+        {
+          g_autofree char *path = g_build_filename (dirs->pdata[i], name, NULL);
+          if (!g_hash_table_contains (seen, name) && filter (path))
+            {
+              g_hash_table_add (seen, g_strdup (name));
+              g_strv_builder_add (builder, name);
+            }
+        }
+    }
+  names = g_strv_builder_end (builder);
+  qsort (names, g_strv_length (names), sizeof (char *), compare_names);
+  return names;
+}
+
+static GtkWidget *
+theme_row (const char *title, const char *subtitle, const char *schema, const char *key, GStrv names)
+{
+  g_autoptr(GSettings) s = g_settings_new (schema);
+  g_autofree char *current = g_settings_get_string (s, key);
+  g_autoptr(GStrvBuilder) b = g_strv_builder_new ();
+  g_auto(GStrv) all = NULL;
+
+  g_strv_builder_addv (b, (const char **) names);
+  /* Keep a value set elsewhere selectable even if it is not installed. */
+  if (current && *current && !g_strv_contains ((const char * const *) names, current))
+    g_strv_builder_add (b, current);
+  all = g_strv_builder_end (b);
+  qsort (all, g_strv_length (all), sizeof (char *), compare_names);
+  return combo_row (title, subtitle, schema, key, (const char * const *) all, (const char * const *) all);
+}
+
+static AdwPreferencesGroup *
+themes_group (void)
+{
+  GtkWidget *group = adw_preferences_group_new ();
+  static const char *gtk_builtin[] = { "Adwaita", "Adwaita-dark", "HighContrast", "HighContrastInverse", NULL };
+  g_auto(GStrv) cursors = collect_themes ("icons", ".icons", is_cursor_theme, NULL);
+  g_auto(GStrv) icons = collect_themes ("icons", ".icons", is_icon_theme, NULL);
+  g_auto(GStrv) gtk3 = collect_themes ("themes", ".themes", is_gtk3_theme, gtk_builtin);
+  g_auto(GStrv) sounds = collect_themes ("sounds", NULL, is_sound_theme, NULL);
+
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (group), _("Themes"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group),
+                             theme_row (_("Cursor"), NULL, INTERFACE_SCHEMA, "cursor-theme", cursors));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group),
+                             theme_row (_("Icons"), NULL, INTERFACE_SCHEMA, "icon-theme", icons));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group),
+                             theme_row (_("Legacy Applications"), _("Apps that still use GTK 3"), INTERFACE_SCHEMA, "gtk-theme", gtk3));
+  if (sounds[0])
+    adw_preferences_group_add (ADW_PREFERENCES_GROUP (group),
+                               theme_row (_("Sounds"), NULL, SOUND_SCHEMA, "theme-name", sounds));
+  return ADW_PREFERENCES_GROUP (group);
+}
