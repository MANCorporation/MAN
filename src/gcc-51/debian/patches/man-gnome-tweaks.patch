+/* cc-man-tweaks.h
+ *
+ * MAN: the GNOME Tweaks options, built into the Settings panels where they
+ * belong (Appearance, Multitasking, Keyboard, Mouse & Touchpad, Power, Apps).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
