+
+/* Window behavior, appended to the Multitasking page. */
+void cc_man_tweaks_add_multitasking (AdwPreferencesPage *page);
+
+/* Overview key, extended input sources, Emacs input and the additional
+ * XKB layout options, appended to the Keyboard page. */
+void cc_man_tweaks_add_keyboard (AdwPreferencesPage *page);
+
+/* Middle-click paste and locate pointer, added to the mouse "General" group. */
+void cc_man_tweaks_add_mouse (AdwPreferencesGroup *group);
+
