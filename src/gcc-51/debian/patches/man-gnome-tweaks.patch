+/* ───────────────────────────── titlebars ───────────────────────────── */
+
+typedef struct {
+  GSettings *settings;
+  GtkWidget *maximize, *minimize, *placement;
+  gboolean updating;
+} TitlebarData;
+
+static void
+titlebar_data_free (TitlebarData *d)
+{
+  g_object_unref (d->settings);
+  g_free (d);
+}
+
+static void
+titlebar_read (TitlebarData *d)
+{
+  g_autofree char *layout = g_settings_get_string (d->settings, "button-layout");
+  const char *colon = strchr (layout, ':');
+  const char *close = strstr (layout, "close");
+  gboolean left = colon && close && close < colon;
+  d->updating = TRUE;
+  adw_switch_row_set_active (ADW_SWITCH_ROW (d->maximize), strstr (layout, "maximize") != NULL);
+  adw_switch_row_set_active (ADW_SWITCH_ROW (d->minimize), strstr (layout, "minimize") != NULL);
+  adw_combo_row_set_selected (ADW_COMBO_ROW (d->placement), left ? 0 : 1);
+  d->updating = FALSE;
+}
+
+static void
+titlebar_write (TitlebarData *d)
+{
+  gboolean max = adw_switch_row_get_active (ADW_SWITCH_ROW (d->maximize));
+  gboolean min = adw_switch_row_get_active (ADW_SWITCH_ROW (d->minimize));
+  gboolean left = adw_combo_row_get_selected (ADW_COMBO_ROW (d->placement)) == 0;
+  g_autofree char *layout = NULL;
+  if (d->updating)
+    return;
+  if (left)
+    layout = g_strdup_printf ("close%s%s:appmenu", min ? ",minimize" : "", max ? ",maximize" : "");
+  else
+    layout = g_strdup_printf ("appmenu:%s%sclose", min ? "minimize," : "", max ? "maximize," : "");
+  g_settings_set_string (d->settings, "button-layout", layout);
+}
+
+static void
+titlebar_changed_cb (GObject *object, GParamSpec *pspec, TitlebarData *d)
+{
+  titlebar_write (d);
+}
+
+static void
+titlebar_settings_cb (GSettings *settings, const char *key, TitlebarData *d)
+{
+  titlebar_read (d);
+}
+
+static AdwPreferencesGroup *
+titlebars_group (void)
+{
+  GtkWidget *group = adw_preferences_group_new ();
+  TitlebarData *d = g_new0 (TitlebarData, 1);
+  static const char *placement_labels[] = { N_("Left"), N_("Right"), NULL };
+  static const char *action_labels[] = { N_("Toggle Maximize"), N_("Maximize Horizontally"), N_("Maximize Vertically"),
+                                         N_("Minimize"), N_("Lower"), N_("Menu"), N_("None"), NULL };
+  static const char *action_values[] = { "toggle-maximize", "toggle-maximize-horizontally", "toggle-maximize-vertically",
+                                         "minimize", "lower", "menu", "none", NULL };
+
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (group), _("Window Titlebars"));
+  d->settings = g_settings_new (WM_SCHEMA);
+  d->maximize = adw_switch_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (d->maximize), _("Maximize Button"));
+  d->minimize = adw_switch_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (d->minimize), _("Minimize Button"));
+  d->placement = adw_combo_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (d->placement), _("Button Placement"));
+  adw_combo_row_set_model (ADW_COMBO_ROW (d->placement), G_LIST_MODEL (gtk_string_list_new (placement_labels)));
+  g_object_set_data_full (G_OBJECT (group), "man-titlebar", d, (GDestroyNotify) titlebar_data_free);
+  titlebar_read (d);
+  g_signal_connect (d->maximize, "notify::active", G_CALLBACK (titlebar_changed_cb), d);
+  g_signal_connect (d->minimize, "notify::active", G_CALLBACK (titlebar_changed_cb), d);
+  g_signal_connect (d->placement, "notify::selected", G_CALLBACK (titlebar_changed_cb), d);
+  g_signal_connect_object (d->settings, "changed::button-layout", G_CALLBACK (titlebar_settings_cb), d, 0);
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), d->maximize);
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), d->minimize);
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), d->placement);
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group),
+                             combo_row (_("Double-Click"), NULL, WM_SCHEMA, "action-double-click-titlebar", action_labels, action_values));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group),
+                             combo_row (_("Middle-Click"), NULL, WM_SCHEMA, "action-middle-click-titlebar", action_labels, action_values));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group),
+                             combo_row (_("Secondary-Click"), NULL, WM_SCHEMA, "action-right-click-titlebar", action_labels, action_values));
+  return ADW_PREFERENCES_GROUP (group);
+}
