+static gboolean
+has_lid (void)
+{
+  g_autoptr(GDir) dir = g_dir_open ("/proc/acpi/button/lid", 0, NULL);
+  if (g_getenv ("MAN_SETTINGS_FAKE_LID"))
+    return TRUE;
+  return dir != NULL && g_dir_read_name (dir) != NULL;
+}
+
+static void
+lid_switch_cb (AdwSwitchRow *row, GParamSpec *pspec)
+{
+  g_autofree char *path = lid_autostart_path ();
+  /* Like GNOME Tweaks: a logind inhibitor started at every login keeps the
+   * computer awake when the lid is closed. */
+  const char *command = "systemd-inhibit --what=handle-lid-switch --who=Settings --why=" LID_INHIBITOR
+                        " --mode=block sleep infinity";
+
+  if (adw_switch_row_get_active (row))
+    {
+      g_unlink (path);
+      g_spawn_command_line_async ("pkill -f -- --why=" LID_INHIBITOR, NULL);
+    }
+  else
+    {
+      g_autofree char *dir = g_path_get_dirname (path);
+      g_autofree char *text = g_strdup_printf ("[Desktop Entry]\nType=Application\nName=Keep Running With the Lid Closed\n"
+                                               "Exec=%s\nNoDisplay=true\nX-GNOME-Autostart-Phase=Initialization\n", command);
+      g_mkdir_with_parents (dir, 0755);
+      if (g_file_set_contents (path, text, -1, NULL))
+        g_spawn_command_line_async (command, NULL);
+    }
+}
+
+void
+cc_man_tweaks_add_power (AdwPreferencesPage *page)
+{
+  GtkWidget *group, *row;
+  g_autofree char *path = NULL;
+
+  if (!has_lid ())
+    return;
+  path = lid_autostart_path ();
+  group = adw_preferences_group_new ();
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (group), _("Laptop Lid"));
+  row = adw_switch_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), _("Suspend When Lid Is Closed"));
+  adw_action_row_set_subtitle (ADW_ACTION_ROW (row), _("Turn off to keep the computer running, for example with an external screen"));
+  adw_switch_row_set_active (ADW_SWITCH_ROW (row), !g_file_test (path, G_FILE_TEST_EXISTS));
+  g_signal_connect (row, "notify::active", G_CALLBACK (lid_switch_cb), NULL);
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), row);
+  adw_preferences_page_add (page, ADW_PREFERENCES_GROUP (group));
+}
+
+/* ──────────────────────────── startup apps ──────────────────────────── */
+
+static char *
+autostart_dir (void)
+{
+  return g_build_filename (g_get_user_config_dir (), "autostart", NULL);
+}
+
+static void fill_startup_list (GtkListBox *list);
+
+static void
+remove_startup_cb (GtkButton *button, GtkListBox *list)
+{
+  const char *path = g_object_get_data (G_OBJECT (button), "path");
+  g_unlink (path);
+  fill_startup_list (list);
+}
+
+static int
+compare_app_names (gconstpointer a, gconstpointer b)
+{
+  return g_utf8_collate (g_app_info_get_display_name (G_APP_INFO (*(gpointer *) a)),
+                         g_app_info_get_display_name (G_APP_INFO (*(gpointer *) b)));
+}
+
+/* User autostart entries that are enabled and not our own helpers. */
+static GPtrArray *
+startup_apps (void)
+{
+  GPtrArray *apps = g_ptr_array_new_with_free_func (g_object_unref);
+  g_autofree char *dir_path = autostart_dir ();
+  g_autoptr(GDir) dir = g_dir_open (dir_path, 0, NULL);
+  const char *name;
+
+  while (dir && (name = g_dir_read_name (dir)))
+    {
+      g_autofree char *path = NULL;
+      GDesktopAppInfo *info;
+      if (!g_str_has_suffix (name, ".desktop") || g_str_has_prefix (name, "man-"))
+        continue;
+      path = g_build_filename (dir_path, name, NULL);
+      info = g_desktop_app_info_new_from_filename (path);
+      if (info == NULL)
+        continue;
+      if (g_desktop_app_info_get_is_hidden (info) ||
+          (g_desktop_app_info_has_key (info, "X-GNOME-Autostart-enabled") &&
+           !g_desktop_app_info_get_boolean (info, "X-GNOME-Autostart-enabled")))
+        {
+          g_object_unref (info);
+          continue;
+        }
+      g_ptr_array_add (apps, info);
+    }
+  g_ptr_array_sort (apps, compare_app_names);
+  return apps;
+}
+
+static GtkWidget *
+app_row (GAppInfo *app)
+{
+  GtkWidget *row = adw_action_row_new ();
+  GIcon *gicon = g_app_info_get_icon (app);
+  GtkWidget *image = gicon ? gtk_image_new_from_gicon (gicon) : gtk_image_new_from_icon_name ("application-x-executable");
+  const char *desc = g_app_info_get_description (app);
+
+  gtk_image_set_icon_size (GTK_IMAGE (image), GTK_ICON_SIZE_LARGE);
+  adw_preferences_row_set_use_markup (ADW_PREFERENCES_ROW (row), FALSE);
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), g_app_info_get_display_name (app));
+  if (desc)
+    adw_action_row_set_subtitle (ADW_ACTION_ROW (row), desc);
+  adw_action_row_set_subtitle_lines (ADW_ACTION_ROW (row), 1);
+  adw_action_row_add_prefix (ADW_ACTION_ROW (row), image);
+  return row;
+}
+
+static void
+fill_startup_list (GtkListBox *list)
+{
+  g_autoptr(GPtrArray) apps = startup_apps ();
+  gtk_list_box_remove_all (list);
+  if (apps->len == 0)
+    {
+      GtkWidget *row = adw_action_row_new ();
+      adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), _("No startup apps"));
+      gtk_widget_add_css_class (row, "dim-label");
+      gtk_list_box_append (list, row);
+      return;
+    }
+  for (guint i = 0; i < apps->len; i++)
+    {
+      GtkWidget *row = app_row (apps->pdata[i]);
+      GtkWidget *button = gtk_button_new_from_icon_name ("user-trash-symbolic");
+      gtk_widget_set_tooltip_text (button, _("Remove"));
+      gtk_widget_set_valign (button, GTK_ALIGN_CENTER);
+      gtk_widget_add_css_class (button, "flat");
+      g_object_set_data_full (G_OBJECT (button), "path",
+                              g_strdup (g_desktop_app_info_get_filename (apps->pdata[i])), g_free);
+      g_signal_connect (button, "clicked", G_CALLBACK (remove_startup_cb), list);
+      adw_action_row_add_suffix (ADW_ACTION_ROW (row), button);
+      gtk_list_box_append (list, row);
+    }
+}
+
+static void
+add_app_activated_cb (GtkListBox *box, GtkListBoxRow *row, GtkListBox *startup_list)
+{
+  GDesktopAppInfo *app = g_object_get_data (G_OBJECT (row), "app");
+  const char *src = g_desktop_app_info_get_filename (app);
+  g_autofree char *dir = autostart_dir ();
+  g_autofree char *base = g_path_get_basename (src);
+  g_autofree char *dest = g_build_filename (dir, base, NULL);
+  g_autoptr(GKeyFile) kf = g_key_file_new ();
+
+  g_mkdir_with_parents (dir, 0755);
+  if (g_key_file_load_from_file (kf, src, G_KEY_FILE_KEEP_TRANSLATIONS, NULL))
+    {
+      g_key_file_remove_key (kf, G_KEY_FILE_DESKTOP_GROUP, "Hidden", NULL);
+      g_key_file_set_boolean (kf, G_KEY_FILE_DESKTOP_GROUP, "X-GNOME-Autostart-enabled", TRUE);
+      g_key_file_save_to_file (kf, dest, NULL);
+    }
+  fill_startup_list (startup_list);
+  adw_dialog_close (ADW_DIALOG (gtk_widget_get_ancestor (GTK_WIDGET (box), ADW_TYPE_DIALOG)));
+}
+
+static gboolean
+app_filter_cb (GtkListBoxRow *row, GtkSearchEntry *entry)
+{
+  const char *text = gtk_editable_get_text (GTK_EDITABLE (entry));
+  GAppInfo *app = g_object_get_data (G_OBJECT (row), "app");
+  g_autofree char *needle = g_utf8_casefold (text, -1);
+  g_autofree char *hay = g_utf8_casefold (g_app_info_get_display_name (app), -1);
+  return *needle == '\0' || strstr (hay, needle) != NULL;
+}
+
+static void
+search_changed_cb (GtkSearchEntry *entry, GtkListBox *list)
+{
+  gtk_list_box_invalidate_filter (list);
+}
+
+static void
+show_add_app_dialog (GtkWidget *parent, GtkListBox *startup_list)
+{
+  AdwDialog *dialog = adw_dialog_new ();
+  GtkWidget *view = adw_toolbar_view_new ();
+  GtkWidget *search = gtk_search_entry_new ();
+  GtkWidget *list = gtk_list_box_new ();
+  GtkWidget *clamp = adw_clamp_new ();
+  GtkWidget *scroll = gtk_scrolled_window_new ();
+  GtkWidget *search_bar = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  g_autolist(GAppInfo) all = g_app_info_get_all ();
+  g_autoptr(GPtrArray) apps = g_ptr_array_new ();
+
+  adw_dialog_set_title (dialog, _("Add Startup App"));
+  adw_dialog_set_content_width (dialog, 480);
+  adw_dialog_set_content_height (dialog, 600);
+  adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (view), adw_header_bar_new ());
+  gtk_search_entry_set_placeholder_text (GTK_SEARCH_ENTRY (search), _("Search Apps"));
+  gtk_widget_set_hexpand (search, TRUE);
+  gtk_widget_set_margin_start (search_bar, 12);
+  gtk_widget_set_margin_end (search_bar, 12);
+  gtk_widget_set_margin_bottom (search_bar, 6);
+  gtk_box_append (GTK_BOX (search_bar), search);
+  adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (view), search_bar);
+
+  gtk_list_box_set_selection_mode (GTK_LIST_BOX (list), GTK_SELECTION_NONE);
+  gtk_widget_add_css_class (list, "boxed-list");
+  gtk_widget_set_valign (list, GTK_ALIGN_START);
+  for (GList *l = all; l; l = l->next)
+    if (g_app_info_should_show (l->data) && G_IS_DESKTOP_APP_INFO (l->data))
+      g_ptr_array_add (apps, l->data);
+  g_ptr_array_sort (apps, compare_app_names);
+  for (guint i = 0; i < apps->len; i++)
+    {
+      GtkWidget *row = app_row (apps->pdata[i]);
+      gtk_list_box_row_set_activatable (GTK_LIST_BOX_ROW (row), TRUE);
+      g_object_set_data_full (G_OBJECT (row), "app", g_object_ref (apps->pdata[i]), g_object_unref);
+      gtk_list_box_append (GTK_LIST_BOX (list), row);
+    }
+  gtk_list_box_set_filter_func (GTK_LIST_BOX (list), (GtkListBoxFilterFunc) app_filter_cb, search, NULL);
+  g_signal_connect (search, "search-changed", G_CALLBACK (search_changed_cb), list);
+  g_signal_connect (list, "row-activated", G_CALLBACK (add_app_activated_cb), startup_list);
+
+  gtk_widget_set_margin_start (clamp, 12);
+  gtk_widget_set_margin_end (clamp, 12);
+  gtk_widget_set_margin_top (clamp, 6);
+  gtk_widget_set_margin_bottom (clamp, 12);
+  adw_clamp_set_child (ADW_CLAMP (clamp), list);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scroll), GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (scroll), clamp);
+  gtk_widget_set_vexpand (scroll, TRUE);
+  adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (view), scroll);
+  adw_dialog_set_child (dialog, view);
+  adw_dialog_present (dialog, parent);
+  gtk_widget_grab_focus (search);
+}
+
+static void
+add_button_clicked_cb (GtkButton *button, GtkListBox *list)
+{
+  show_add_app_dialog (GTK_WIDGET (button), list);
+}
+
+static void
+startup_row_activated_cb (AdwActionRow *row)
+{
+  AdwDialog *dialog = adw_dialog_new ();
+  GtkWidget *view = adw_toolbar_view_new ();
+  GtkWidget *header = adw_header_bar_new ();
+  GtkWidget *add = gtk_button_new_from_icon_name ("list-add-symbolic");
+  GtkWidget *page = adw_preferences_page_new ();
+  GtkWidget *group = adw_preferences_group_new ();
+  GtkWidget *list = gtk_list_box_new ();
+
+  adw_dialog_set_title (dialog, _("Startup Apps"));
+  adw_dialog_set_content_width (dialog, 520);
+  adw_dialog_set_content_height (dialog, 560);
+  gtk_widget_set_tooltip_text (add, _("Add App"));
+  adw_header_bar_pack_start (ADW_HEADER_BAR (header), add);
+  adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (view), header);
+
+  adw_preferences_group_set_description (ADW_PREFERENCES_GROUP (group), _("These apps start automatically when you log in"));
+  gtk_list_box_set_selection_mode (GTK_LIST_BOX (list), GTK_SELECTION_NONE);
+  gtk_widget_add_css_class (list, "boxed-list");
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), list);
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (group));
+  fill_startup_list (GTK_LIST_BOX (list));
+  g_signal_connect (add, "clicked", G_CALLBACK (add_button_clicked_cb), list);
+
+  adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (view), page);
+  adw_dialog_set_child (dialog, view);
+  adw_dialog_present (dialog, GTK_WIDGET (row));
+}
+
+void
+cc_man_tweaks_add_startup_apps (AdwPreferencesGroup *group)
+{
+  GtkWidget *row = adw_action_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), _("_Startup Apps"));
+  adw_preferences_row_set_use_underline (ADW_PREFERENCES_ROW (row), TRUE);
+  adw_action_row_set_subtitle (ADW_ACTION_ROW (row), _("Choose apps that start when you log in"));
+  adw_action_row_add_suffix (ADW_ACTION_ROW (row), gtk_image_new_from_icon_name ("go-next-symbolic"));
+  gtk_list_box_row_set_activatable (GTK_LIST_BOX_ROW (row), TRUE);
+  g_signal_connect (row, "activated", G_CALLBACK (startup_row_activated_cb), NULL);
+  adw_preferences_group_add (group, row);
+}
