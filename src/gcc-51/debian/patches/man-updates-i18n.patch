diff -ruN '--exclude=.pc' '--exclude=*.orig' a/panels/common/cc-man-i18n.h b/panels/common/cc-man-i18n.h
--- a/panels/common/cc-man-i18n.h	1970-01-01 01:00:00.000000000 +0100
+++ b/panels/common/cc-man-i18n.h	2026-10-24 12:52:46.168783049 +0200
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * MAN's own strings in Settings (the GNOME Tweaks options and the Updates
+ * panel) are translated in the "man-settings" gettext domain; anything not
+ * found there falls back to Settings' own catalog. */
+#pragma once
+
+#include <config.h>
+#include <glib/gi18n.h>
+
+#define MAN_GETTEXT_DOMAIN "man-settings"
+
+#ifndef GNOMELOCALEDIR
+#define GNOMELOCALEDIR "/usr/share/locale"
+#endif
+
+static inline void
+cc_man_i18n_init (void)
+{
+  static gsize done = 0;
+
+  if (g_once_init_enter (&done))
+    {
+      bindtextdomain (MAN_GETTEXT_DOMAIN, GNOMELOCALEDIR);
+      bind_textdomain_codeset (MAN_GETTEXT_DOMAIN, "UTF-8");
+      g_once_init_leave (&done, 1);
+    }
+}
+
+static inline const char *
+cc_man_gettext (const char *msgid)
+{
+  const char *t;
+
+  cc_man_i18n_init ();
+  t = g_dgettext (MAN_GETTEXT_DOMAIN, msgid);
+  return t != msgid ? t : g_dgettext (GETTEXT_PACKAGE, msgid);
+}
+
+static inline const char *
+cc_man_ngettext (const char *msgid, const char *msgid_plural, gulong n)
+{
+  const char *t;
+
+  cc_man_i18n_init ();
+  t = g_dngettext (MAN_GETTEXT_DOMAIN, msgid, msgid_plural, n);
+  return (t != msgid && t != msgid_plural) ? t : g_dngettext (GETTEXT_PACKAGE, msgid, msgid_plural, n);
+}
