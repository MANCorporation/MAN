+static void
+show_failure (Setup *s, const char *message)
+{
+  GtkWidget *status = adw_status_page_new ();
+  GtkWidget *back = pill (_("_Back"), TRUE);
+
+  if (s->remote && !s->finished)
+    {
+      const char *del[] = { RCLONE, "config", "delete", s->remote, NULL };
+      spawn_quiet (del);
+      pending_mark (s->remote, FALSE);
+    }
+  adw_status_page_set_icon_name (ADW_STATUS_PAGE (status), "dialog-warning-symbolic");
+  adw_status_page_set_title (ADW_STATUS_PAGE (status), _("Could Not Add the Drive"));
+  {
+    g_autofree char *m = g_markup_escape_text (message && *message ? message : _("Check what you entered and your internet connection, then try again."), -1);
+    adw_status_page_set_description (ADW_STATUS_PAGE (status), m);
+  }
+  g_signal_connect_swapped (back, "clicked", G_CALLBACK (back_to_form), s->self);
+  replace_top (s->self, subpage (s->ptitle, "failed", status, bottom_bar (back, NULL)), "form");
+}
