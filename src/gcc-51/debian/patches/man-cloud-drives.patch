+  "service_account_file", "env_auth", "key_pem", "pubkey", "pubkey_file", "ssh", NULL,
+};
+
+static const struct { const char *name; const char *label; } labels[] = {
+  { "url", N_("Server Address") }, { "host", N_("Server") }, { "user", N_("User Name") },
+  { "username", N_("User Name") }, { "pass", N_("Password") }, { "password", N_("Password") },
+  { "2fa", N_("Two-Factor Code") }, { "provider", N_("Provider") }, { "vendor", N_("Server Type") },
+  { "region", N_("Region") }, { "endpoint", N_("Endpoint") }, { "access_key_id", N_("Access Key ID") },
+  { "secret_access_key", N_("Secret Access Key") }, { "account", N_("Account") }, { "key", N_("Key") },
+  { "api_key", N_("API Key") }, { "email", N_("Email") }, { "apple_id", N_("Apple ID") },
+  { "domain", N_("Domain") }, { "port", N_("Port") }, { "scope", N_("Access") },
+};
+
+static char *
+field_label (const char *name)
+{
+  g_autofree char *s = NULL;
+
+  for (guint i = 0; i < G_N_ELEMENTS (labels); i++)
+    if (g_strcmp0 (labels[i].name, name) == 0)
+      return g_strdup (_(labels[i].label));
+  s = g_strdup (name);
+  for (char *p = s; *p; p++)
+    if (*p == '_')
+      *p = ' ';
+  if (*s)
+    *s = g_ascii_toupper (*s);
+  return g_steal_pointer (&s);
+}
+
+/* First sentence of rclone's help text (English; rclone has no translations). */
+static char *
+short_help (const char *help)
+{
+  const char *end;
+
+  if (!help)
+    return NULL;
+  end = strpbrk (help, "\n");
+  return end ? g_strndup (help, end - help) : g_strdup (help);
+}
+
+static const char *
+field_value (Field *f)
+{
+  switch (f->kind)
+    {
+    case FIELD_SWITCH:
+      return adw_switch_row_get_active (ADW_SWITCH_ROW (f->row)) ? "true" : "false";
+    case FIELD_COMBO:
+      {
+        guint i = adw_combo_row_get_selected (ADW_COMBO_ROW (f->row));
+        return i < f->values->len ? g_ptr_array_index (f->values, i) : "";
+      }
+    default:
+      return gtk_editable_get_text (GTK_EDITABLE (f->row));
+    }
+}
+
+static gboolean
+cond_matches (const char *cond, const char *provider)
+{
+  gboolean negate;
+  g_auto(GStrv) items = NULL;
+  gboolean found;
+
+  if (!cond || !*cond)
+    return TRUE;
+  negate = cond[0] == '!';
+  items = g_strsplit (cond + negate, ",", -1);
+  found = provider && g_strv_contains ((const char * const *) items, provider);
+  return negate ? !found : found;
+}
+
+static const char *
+chosen_provider (Setup *s)
+{
+  for (guint i = 0; i < s->fields->len; i++)
+    {
+      Field *f = g_ptr_array_index (s->fields, i);
+      if (g_strcmp0 (f->name, "provider") == 0 && (!f->provider_cond || !*f->provider_cond))
+        return field_value (f);
+    }
+  return NULL;
+}
+
+static void
+validate_form (Setup *s)
+{
+  const char *provider = chosen_provider (s);
+  g_autofree char *name = g_strstrip (g_strdup (gtk_editable_get_text (GTK_EDITABLE (s->name_row))));
+  gboolean ok = *name != '\0';
+  g_autoptr(GHashTable) shown = g_hash_table_new (g_str_hash, g_str_equal);
+
+  for (guint i = 0; i < s->fields->len; i++)
+    {
+      Field *f = g_ptr_array_index (s->fields, i);
+      /* rclone lists some options once per provider; show the one that applies. */
+      gboolean visible = cond_matches (f->provider_cond, provider) && !g_hash_table_contains (shown, f->name);
+
+      gtk_widget_set_visible (f->row, visible);
+      if (visible)
+        g_hash_table_add (shown, f->name);
+      if (visible && f->required && f->kind != FIELD_SWITCH && !*field_value (f))
+        ok = FALSE;
+    }
+  gtk_widget_set_sensitive (s->go, ok);
+}
+
+static Field *
+make_field (JsonObject *o)
+{
+  Field *f = g_new0 (Field, 1);
+  JsonArray *ex = jarr (o, "Examples");
+  const char *type = jstr (o, "Type");
+  g_autofree char *label = field_label (jstr (o, "Name"));
+  g_autofree char *help = short_help (jstr (o, "Help"));
+  gboolean exclusive = jbool (o, "Exclusive");
+  guint n_ex = ex ? json_array_get_length (ex) : 0;
+
+  f->name = g_strdup (jstr (o, "Name"));
+  f->provider_cond = g_strdup (jstr (o, "Provider"));
+  f->default_str = g_strdup (jstr (o, "DefaultStr") ? jstr (o, "DefaultStr") : "");
+  f->required = jbool (o, "Required");
+
+  if (g_strcmp0 (type, "bool") == 0)
+    {
+      f->kind = FIELD_SWITCH;
+      f->row = adw_switch_row_new ();
+      adw_switch_row_set_active (ADW_SWITCH_ROW (f->row), g_strcmp0 (f->default_str, "true") == 0);
+      if (help)
+        adw_action_row_set_subtitle (ADW_ACTION_ROW (f->row), help);
+    }
+  else if (n_ex > 0 && (exclusive || g_strcmp0 (f->name, "provider") == 0 || g_strcmp0 (f->name, "vendor") == 0))
+    {
+      g_autoptr(GtkStringList) list = gtk_string_list_new (NULL);
+      guint selected = 0;
+
+      f->kind = FIELD_COMBO;
+      f->values = g_ptr_array_new_with_free_func (g_free);
+      if (!f->required && !exclusive)
+        {
+          /* "Other" leaves the option to rclone's default. */
+          g_ptr_array_add (f->values, g_strdup (""));
+          gtk_string_list_append (list, _("Other"));
+        }
+      for (guint i = 0; i < n_ex; i++)
+        {
+          JsonObject *e = json_array_get_object_element (ex, i);
+          const char *v = jstr (e, "Value") ? jstr (e, "Value") : "";
+          g_autofree char *h = short_help (jstr (e, "Help"));
+
+          if (g_strcmp0 (v, f->default_str) == 0)
+            selected = f->values->len;
+          g_ptr_array_add (f->values, g_strdup (v));
+          gtk_string_list_append (list, h && *h ? h : v);
+        }
+      f->row = adw_combo_row_new ();
+      adw_combo_row_set_model (ADW_COMBO_ROW (f->row), G_LIST_MODEL (list));
+      adw_combo_row_set_selected (ADW_COMBO_ROW (f->row), selected);
+      adw_combo_row_set_enable_search (ADW_COMBO_ROW (f->row), n_ex > 8);
+    }
+  else if (jbool (o, "IsPassword"))
+    {
+      f->kind = FIELD_PASSWORD;
+      f->row = adw_password_entry_row_new ();
+    }
+  else
+    {
+      f->kind = FIELD_ENTRY;
+      f->row = adw_entry_row_new ();
+      gtk_editable_set_text (GTK_EDITABLE (f->row), f->default_str);
+    }
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (f->row), label);
+  adw_preferences_row_set_use_markup (ADW_PREFERENCES_ROW (f->row), FALSE);
+  if (help && f->kind != FIELD_SWITCH)
+    gtk_widget_set_tooltip_text (f->row, help);
+  return f;
+}
+
+/* A remote name rclone accepts and systemd needs no escaping for. */
+static char *
+remote_name (const char *title)
+{
+  g_autoptr(GPtrArray) drives = list_drives ();
+  g_autoptr(GString) s = g_string_new (NULL);
+  g_autofree char *ascii = g_str_to_ascii (title, NULL);
+  char *base;
+  char *name;
+
+  for (const char *p = ascii; *p; p++)
+    {
+      if (g_ascii_isalnum (*p))
+        g_string_append_c (s, *p);
+      else if (s->len && s->str[s->len - 1] != '_')
+        g_string_append_c (s, '_');
+    }
+  while (s->len && s->str[s->len - 1] == '_')
+    g_string_truncate (s, s->len - 1);
+  if (!s->len)
+    g_string_append (s, "Cloud");
+  base = g_string_free (g_steal_pointer (&s), FALSE);
+  name = g_strdup (base);
+  for (int n = 2;; n++)
+    {
+      gboolean taken = FALSE;
+
+      for (guint i = 0; i < drives->len; i++)
+        if (g_ascii_strcasecmp (((Drive *) g_ptr_array_index (drives, i))->remote, name) == 0)
+          taken = TRUE;
+      if (!taken)
+        break;
+      g_free (name);
+      name = g_strdup_printf ("%s_%d", base, n);
+    }
+  g_free (base);
+  return name;
+}
+
+/* A folder name not used by another drive. */
+static char *
+unique_mount (const char *title)
+{
+  g_autofree char *root = g_build_filename (g_get_home_dir (), _("Cloud Drives"), NULL);
+  g_autofree char *clean = g_strdelimit (g_strdup (title), "/", '-');
+  char *path = g_build_filename (root, clean, NULL);
+
+  for (int n = 2; g_file_test (path, G_FILE_TEST_EXISTS); n++)
+    {
+      g_autofree char *alt = g_strdup_printf ("%s %d", clean, n);
+      g_free (path);
+      path = g_build_filename (root, alt, NULL);
+    }
+  return path;
+}
