--- a/panels/man-cloud/cc-man-cloud-panel.c
+++ b/panels/man-cloud/cc-man-cloud-panel.c
@@ -0,0 +1,1800 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*-
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * MAN: Settings → Cloud Drives. Every storage provider rclone supports, set up
+ * without a terminal and shown in Files:
+ *
+ *   Add Cloud Drive… → provider list (rclone config providers) → a short form
+ *   with the fields that matter (the rest under More Options) → rclone's own
+ *   setup steps (rclone config create/update --non-interactive): providers with
+ *   a browser login open it and rclone waits for it; anything else rclone needs
+ *   is asked on a page of its own → the drive is mounted.
+ *
+ * A drive is the rclone remote NAME in ~/.config/rclone/rclone.conf, the file
+ * ~/.config/man-cloud/NAME.env (its title and folder) and the systemd user unit
+ * man-cloud@NAME.service, which mounts it in ~/Cloud Drives/TITLE at every login
+ * and retries while offline; Files shows the mounted drive in its sidebar. All
+ * of it is in the home folder, so MAN updates keep it.
+ */
+
+#include <config.h>
+#include <signal.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <glib/gstdio.h>
+#include <json-glib/json-glib.h>
+
+#include "cc-man-cloud-panel.h"
+#include "cc-man-i18n.h"
+
+#undef _
+#define _(s) cc_man_gettext (s)
+
+#define RCLONE "/usr/bin/rclone"
+#define UNIT_FMT "man-cloud@%s.service"
+
+static char *run_sync (const char * const *argv, int *status);
+
+struct _CcManCloudPanel
+{
+  CcPanel     parent_instance;
+
+  GtkWidget  *drives_group;
+  GPtrArray  *drive_rows;
+  GtkWidget  *empty_row;
+  GtkWidget  *add_row;
+
+  JsonParser *providers;      /* rclone config providers */
+  guint       refresh_id;
+  char       *last_sig;
+  GCancellable *cancellable;
+};
+
+G_DEFINE_TYPE (CcManCloudPanel, cc_man_cloud_panel, CC_TYPE_PANEL)
+
+/* ───────────────────────────── helpers ───────────────────────────── */
+
+static GtkWidget *
+pill (const char *mnemonic, gboolean suggested)
+{
+  GtkWidget *b = gtk_button_new_with_mnemonic (mnemonic);
+
+  gtk_widget_add_css_class (b, "pill");
+  if (suggested)
+    gtk_widget_add_css_class (b, "suggested-action");
+  return b;
+}
+
+/* The fixed bar at the bottom of a page, with its buttons centered. */
+static GtkWidget *
+bottom_bar (GtkWidget *first, ...)
+{
+  GtkWidget *bar = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+  GtkWidget *w;
+  va_list ap;
+
+  gtk_widget_set_margin_top (bar, 12);
+  gtk_widget_set_margin_bottom (bar, 12);
+  gtk_widget_set_halign (bar, GTK_ALIGN_CENTER);
+  va_start (ap, first);
+  for (w = first; w; w = va_arg (ap, GtkWidget *))
+    {
+      gtk_widget_set_size_request (w, 200, -1);
+      gtk_box_append (GTK_BOX (bar), w);
+    }
+  va_end (ap);
+  return bar;
+}
+
+static AdwNavigationPage *
+subpage (const char *title, const char *tag, GtkWidget *content, GtkWidget *bar)
+{
+  GtkWidget *toolbar = adw_toolbar_view_new ();
+  AdwNavigationPage *page;
+
+  adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (toolbar), adw_header_bar_new ());
+  adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (toolbar), content);
+  if (bar)
+    {
+      adw_toolbar_view_add_bottom_bar (ADW_TOOLBAR_VIEW (toolbar), bar);
+      adw_toolbar_view_set_bottom_bar_style (ADW_TOOLBAR_VIEW (toolbar), ADW_TOOLBAR_RAISED);
+    }
+  page = adw_navigation_page_new (toolbar, title);
+  adw_navigation_page_set_tag (page, tag);
+  return page;
+}
+
+static void
+pop_subpages (CcManCloudPanel *self)
+{
+  GtkWidget *nav = gtk_widget_get_ancestor (GTK_WIDGET (self), ADW_TYPE_NAVIGATION_VIEW);
+
+  if (nav)
+    adw_navigation_view_pop_to_page (ADW_NAVIGATION_VIEW (nav), ADW_NAVIGATION_PAGE (self));
+}
+
+static void
+replace_top (CcManCloudPanel *self, AdwNavigationPage *page, const char *keep_tag)
+{
+  GtkWidget *nav = gtk_widget_get_ancestor (GTK_WIDGET (self), ADW_TYPE_NAVIGATION_VIEW);
+
+  AdwNavigationPage *keep = nav && keep_tag ? adw_navigation_view_find_page (ADW_NAVIGATION_VIEW (nav), keep_tag) : NULL;
+
+  /* pop_to_tag() returns FALSE when that page is already the visible one. */
+  if (keep)
+    adw_navigation_view_pop_to_page (ADW_NAVIGATION_VIEW (nav), keep);
+  else
+    pop_subpages (self);
+  cc_panel_push_subpage (CC_PANEL (self), page);
+}
+
+static const char *
+jstr (JsonObject *o, const char *member)
+{
+  JsonNode *n = o ? json_object_get_member (o, member) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_STRING ? json_node_get_string (n) : NULL;
+}
+
+static gboolean
+jbool (JsonObject *o, const char *member)
+{
+  JsonNode *n = o ? json_object_get_member (o, member) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_BOOLEAN && json_node_get_boolean (n);
+}
+
+static gint64
+jint (JsonObject *o, const char *member)
+{
+  JsonNode *n = o ? json_object_get_member (o, member) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_INT64 ? json_node_get_int (n) : 0;
+}
+
+static JsonArray *
+jarr (JsonObject *o, const char *member)
+{
+  JsonNode *n = o ? json_object_get_member (o, member) : NULL;
+  return n && JSON_NODE_HOLDS_ARRAY (n) ? json_node_get_array (n) : NULL;
+}
+
+static char *
+config_dir (const char *sub)
+{
+  return g_build_filename (g_get_user_config_dir (), sub, NULL);
+}
+
+static char *
+env_path (const char *remote)
+{
+  g_autofree char *dir = config_dir ("man-cloud");
+  g_autofree char *file = g_strdup_printf ("%s.env", remote);
+  return g_build_filename (dir, file, NULL);
+}
+
+/* ~/.config/man-cloud/NAME.pending exists while a drive is being set up. */
+static void
+pending_mark (const char *remote, gboolean on)
+{
+  g_autofree char *dir = config_dir ("man-cloud");
+  g_autofree char *file = g_strdup_printf ("%s.pending", remote ? remote : "");
+  g_autofree char *path = g_build_filename (dir, file, NULL);
+
+  if (!remote)
+    return;
+  if (on)
+    {
+      g_mkdir_with_parents (dir, 0700);
+      g_file_set_contents (path, "", 0, NULL);
+    }
+  else
+    g_unlink (path);
+}
+
+/* A setup that did not finish (Settings was closed during it) leaves a half
+ * made remote: remove it. */
+static void
+clean_unfinished (void)
+{
+  g_autofree char *dir = config_dir ("man-cloud");
+  g_autoptr(GDir) d = g_dir_open (dir, 0, NULL);
+  const char *name;
+
+  while (d && (name = g_dir_read_name (d)))
+    if (g_str_has_suffix (name, ".pending"))
+      {
+        g_autofree char *remote = g_strndup (name, strlen (name) - strlen (".pending"));
+        g_autofree char *path = g_build_filename (dir, name, NULL);
+        const char *del[] = { RCLONE, "config", "delete", remote, NULL };
+
+        g_free (run_sync (del, NULL));
+        g_unlink (path);
+      }
+}
+
+/* A value of a NAME="..." line written by write_env(). */
+static char *
+env_value (const char *remote, const char *key)
+{
+  g_autofree char *path = env_path (remote);
+  g_autofree char *text = NULL;
+  g_auto(GStrv) lines = NULL;
+  g_autofree char *prefix = g_strdup_printf ("%s=", key);
+
+  if (!g_file_get_contents (path, &text, NULL, NULL))
+    return NULL;
+  lines = g_strsplit (text, "\n", -1);
+  for (char **l = lines; *l; l++)
+    if (g_str_has_prefix (*l, prefix))
+      {
+        const char *v = *l + strlen (prefix);
+        GString *out = g_string_new (NULL);
+        gboolean quoted = *v == '"';
+
+        for (v += quoted; *v && !(quoted && *v == '"'); v++)
+          {
+            if (quoted && *v == '\\' && v[1])
+              v++;
+            g_string_append_c (out, *v);
+          }
+        return g_string_free (out, FALSE);
+      }
+  return NULL;
+}
+
+static void
+env_quote (GString *s, const char *key, const char *value)
+{
+  g_string_append_printf (s, "%s=\"", key);
+  for (const char *p = value; *p; p++)
+    {
+      if (*p == '"' || *p == '\\' || *p == '$' || *p == '`')
+        g_string_append_c (s, '\\');
+      g_string_append_c (s, *p);
+    }
+  g_string_append (s, "\"\n");
+}
+
+static gboolean
+write_env (const char *remote, const char *title, const char *mount, GError **error)
+{
+  g_autofree char *dir = config_dir ("man-cloud");
+  g_autofree char *path = env_path (remote);
+  g_autoptr(GString) s = g_string_new ("# MAN Cloud Drives (Settings → Cloud Drives)\n");
+
+  env_quote (s, "NAME", title);
+  env_quote (s, "MOUNT", mount);
+  g_mkdir_with_parents (dir, 0700);
+  return g_file_set_contents_full (path, s->str, s->len, G_FILE_SET_CONTENTS_CONSISTENT, 0600, error);
+}
+
+/* The Files sidebar: ~/.config/gtk-3.0/bookmarks, "URI LABEL" per line. */
+static void
+set_bookmark (const char *mount, const char *title, gboolean add)
+{
+  g_autofree char *dir = config_dir ("gtk-3.0");
+  g_autofree char *path = g_build_filename (dir, "bookmarks", NULL);
+  g_autofree char *text = NULL;
+  g_autofree char *uri = g_filename_to_uri (mount, NULL, NULL);
+  g_autoptr(GString) out = g_string_new (NULL);
+  g_auto(GStrv) lines = NULL;
+
+  if (!uri)
+    return;
+  g_file_get_contents (path, &text, NULL, NULL);
+  lines = g_strsplit (text ? text : "", "\n", -1);
+  for (char **l = lines; *l; l++)
+    {
+      if (!**l)
+        continue;
+      if (g_strcmp0 (*l, uri) == 0 || (g_str_has_prefix (*l, uri) && (*l)[strlen (uri)] == ' '))
+        continue;
+      g_string_append_printf (out, "%s\n", *l);
+    }
+  if (add)
+    g_string_append_printf (out, "%s %s\n", uri, title);
+  g_mkdir_with_parents (dir, 0700);
+  g_file_set_contents (path, out->str, out->len, NULL);
+}
+
+static void
+spawn_quiet (const char * const *argv)
+{
+  g_autoptr(GSubprocess) p = g_subprocess_newv (argv, G_SUBPROCESS_FLAGS_STDOUT_SILENCE | G_SUBPROCESS_FLAGS_STDERR_SILENCE, NULL);
+}
+
+/* Synchronous: only used for quick local commands (systemctl, rclone listing). */
+static char *
+run_sync (const char * const *argv, int *status)
+{
+  g_autofree char *out = NULL;
+  int st = -1;
+
+  if (!g_spawn_sync (NULL, (char **) argv, NULL, G_SPAWN_SEARCH_PATH | G_SPAWN_STDERR_TO_DEV_NULL, NULL, NULL, &out, NULL, &st, NULL))
+    st = -1;
+  if (status)
+    *status = st;
+  return g_steal_pointer (&out);
+}
+
+/* ─────────────────────────── providers ─────────────────────────── */
+
+/* Not storage services: they wrap other drives, or are this computer. */
+static const char *const not_providers[] = {
+  "alias", "archive", "cache", "chunker", "combine", "compress", "crypt", "hasher",
+  "union", "local", "memory", "tardigrade", NULL,
+};
+
+/* The most used ones come first in the list. */
+static const char *const popular[] = {
+  "drive", "onedrive", "dropbox", "iclouddrive", "protondrive", "mega", "pcloud", "box",
+  "webdav", "s3", "sftp", "smb", "ftp", NULL,
+};
+
+static const struct { const char *name; const char *title; } nice_titles[] = {
+  { "drive", "Google Drive" },
+  { "onedrive", "Microsoft OneDrive" },
+  { "iclouddrive", "iCloud Drive" },
+  { "pcloud", "pCloud" },
+  { "webdav", N_("WebDAV (Nextcloud, ownCloud and others)") },
+  { "s3", N_("Amazon S3 and Compatible Storage") },
+  { "sftp", "SFTP (SSH)" },
+  { "smb", N_("Windows Share (SMB)") },
+  { "seafile", "Seafile" },
+  { "google cloud storage", "Google Cloud Storage" },
+};
+
+static JsonArray *
+provider_list (CcManCloudPanel *self)
+{
+  if (!self->providers)
+    {
+      const char *argv[] = { RCLONE, "config", "providers", NULL };
+      g_autofree char *out = run_sync (argv, NULL);
+
+      self->providers = json_parser_new ();
+      if (!out || !json_parser_load_from_data (self->providers, out, -1, NULL))
+        g_clear_object (&self->providers);
+    }
+  if (!self->providers || !JSON_NODE_HOLDS_ARRAY (json_parser_get_root (self->providers)))
+    return NULL;
+  return json_node_get_array (json_parser_get_root (self->providers));
+}
+
+static JsonObject *
+provider_by_name (CcManCloudPanel *self, const char *name)
+{
+  JsonArray *a = provider_list (self);
+
+  for (guint i = 0; a && i < json_array_get_length (a); i++)
+    {
+      JsonObject *p = json_array_get_object_element (a, i);
+      if (g_strcmp0 (jstr (p, "Name"), name) == 0)
+        return p;
+    }
+  return NULL;
+}
+
+static char *
+provider_title (JsonObject *p)
+{
+  const char *name = jstr (p, "Name");
+  const char *desc = jstr (p, "Description");
+  const char *cut;
+
+  for (guint i = 0; i < G_N_ELEMENTS (nice_titles); i++)
+    if (g_strcmp0 (name, nice_titles[i].name) == 0)
+      return g_strdup (_(nice_titles[i].title));
+  if (!desc || !*desc)
+    return g_strdup (name ? name : "");
+  cut = strstr (desc, " including ");
+  if (!cut)
+    cut = strstr (desc, " (");
+  return cut ? g_strndup (desc, cut - desc) : g_strdup (desc);
+}
+
+static gboolean
+is_provider (JsonObject *p)
+{
+  return p && !g_strv_contains (not_providers, jstr (p, "Name"));
+}
+
+static gboolean
+uses_browser (JsonObject *p)
+{
+  JsonArray *opts = jarr (p, "Options");
+
+  for (guint i = 0; opts && i < json_array_get_length (opts); i++)
+    if (g_strcmp0 (jstr (json_array_get_object_element (opts, i), "Name"), "token") == 0)
+      return TRUE;
+  return FALSE;
+}
+
+static int
+popular_rank (const char *name)
+{
+  for (int i = 0; popular[i]; i++)
+    if (g_strcmp0 (popular[i], name) == 0)
+      return i;
+  return G_N_ELEMENTS (popular);
+}
+
+/* ─────────────────────────── the drive list ─────────────────────────── */
+
+typedef struct {
+  char *remote;
+  char *type;
+} Drive;
+
+static void
+drive_free (Drive *d)
+{
+  g_free (d->remote);
+  g_free (d->type);
+  g_free (d);
+}
+
+static GPtrArray *
+list_drives (void)
+{
+  const char *argv[] = { RCLONE, "config", "dump", NULL };
+  g_autofree char *out = run_sync (argv, NULL);
+  g_autoptr(JsonParser) parser = json_parser_new ();
+  GPtrArray *drives = g_ptr_array_new_with_free_func ((GDestroyNotify) drive_free);
+  JsonNode *root;
+  g_autoptr(GList) names = NULL;
+
+  if (!out || !json_parser_load_from_data (parser, out, -1, NULL))
+    return drives;
+  root = json_parser_get_root (parser);
+  if (!JSON_NODE_HOLDS_OBJECT (root))
+    return drives;
+  names = json_object_get_members (json_node_get_object (root));
+  names = g_list_sort (names, (GCompareFunc) g_utf8_collate);
+  for (GList *l = names; l; l = l->next)
+    {
+      Drive *d = g_new0 (Drive, 1);
+      d->remote = g_strdup (l->data);
+      d->type = g_strdup (jstr (json_object_get_object_member (json_node_get_object (root), l->data), "type"));
+      g_ptr_array_add (drives, d);
+    }
+  return drives;
+}
+
+static char *
+drive_title (const char *remote)
+{
+  char *t = env_value (remote, "NAME");
+  return t ? t : g_strdup (remote);
+}
+
+static char *
+drive_mount (const char *remote)
+{
+  char *m = env_value (remote, "MOUNT");
+  g_autofree char *title = NULL;
+  g_autofree char *root = NULL;
+
+  if (m)
+    return m;
+  title = drive_title (remote);
+  root = g_build_filename (g_get_home_dir (), _("Cloud Drives"), NULL);
+  return g_build_filename (root, title, NULL);
+}
+
+/* ActiveState/SubState/UnitFileState of the drive's unit. */
+static void
+unit_state (const char *remote, char **active, char **sub, char **file_state)
+{
+  g_autofree char *unit = g_strdup_printf (UNIT_FMT, remote);
+  const char *argv[] = { "systemctl", "--user", "show", "-p", "ActiveState,SubState,UnitFileState", unit, NULL };
+  g_autofree char *out = run_sync (argv, NULL);
+  g_auto(GStrv) lines = g_strsplit (out ? out : "", "\n", -1);
+
+  *active = *sub = *file_state = NULL;
+  for (char **l = lines; *l; l++)
+    {
+      if (g_str_has_prefix (*l, "ActiveState="))
+        *active = g_strdup (*l + strlen ("ActiveState="));
+      else if (g_str_has_prefix (*l, "SubState="))
+        *sub = g_strdup (*l + strlen ("SubState="));
+      else if (g_str_has_prefix (*l, "UnitFileState="))
+        *file_state = g_strdup (*l + strlen ("UnitFileState="));
+    }
+}
+
+static void refresh_drives (CcManCloudPanel *self);
+static void start_add (CcManCloudPanel *self);
+
+static gboolean
+refresh_once (gpointer user_data)
+{
+  CcManCloudPanel *self = user_data;
+
+  if (self->drives_group)
+    {
+      g_clear_pointer (&self->last_sig, g_free);
+      refresh_drives (self);
+    }
+  return G_SOURCE_REMOVE;
+}
+
+static void
+refresh_later (CcManCloudPanel *self, guint seconds)
+{
+  g_timeout_add_seconds_full (G_PRIORITY_DEFAULT, seconds, refresh_once, g_object_ref (self), g_object_unref);
+}
+
+static void
+set_connected (const char *remote, gboolean on)
+{
+  g_autofree char *unit = g_strdup_printf (UNIT_FMT, remote);
+  const char *argv[] = { "systemctl", "--user", on ? "enable" : "disable", "--now", unit, NULL };
+
+  if (on)
+    {
+      g_autofree char *title = drive_title (remote);
+      g_autofree char *mount = drive_mount (remote);
+
+      g_autofree char *env = env_value (remote, "MOUNT");
+
+      if (!env)
+        write_env (remote, title, mount, NULL);
+    }
+  spawn_quiet (argv);
+}
+
+static void
+switch_toggled (GtkWidget *row, GParamSpec *pspec, CcManCloudPanel *self)
+{
+  const char *remote = g_object_get_data (G_OBJECT (row), "remote");
+
+  if (GPOINTER_TO_INT (g_object_get_data (G_OBJECT (row), "syncing")))
+    return;
+  set_connected (remote, adw_switch_row_get_active (ADW_SWITCH_ROW (row)));
+  refresh_later (self, 1);
+}
+
+static void
+open_in_files (GtkWidget *button, gpointer user_data)
+{
+  const char *remote = g_object_get_data (G_OBJECT (button), "remote");
+  g_autofree char *mount = drive_mount (remote);
+  g_autoptr(GFile) file = g_file_new_for_path (mount);
+  g_autoptr(GtkFileLauncher) launcher = gtk_file_launcher_new (file);
+
+  gtk_file_launcher_launch (launcher, GTK_WINDOW (gtk_widget_get_root (button)), NULL, NULL, NULL);
+}
+
+typedef struct {
+  CcManCloudPanel *self;
+  char *remote;
+} RemoveData;
+
+static void
+remove_response (AdwAlertDialog *dialog, const char *response, RemoveData *rd)
+{
+  if (g_strcmp0 (response, "remove") == 0)
+    {
+      g_autofree char *unit = g_strdup_printf (UNIT_FMT, rd->remote);
+      g_autofree char *title = drive_title (rd->remote);
+      g_autofree char *mount = drive_mount (rd->remote);
+      g_autofree char *env = env_path (rd->remote);
+      g_autofree char *cache = g_build_filename (g_get_user_cache_dir (), "rclone", "vfs", rd->remote, NULL);
+      g_autofree char *meta = g_build_filename (g_get_user_cache_dir (), "rclone", "vfsMeta", rd->remote, NULL);
+      const char *stop[] = { "systemctl", "--user", "disable", "--now", unit, NULL };
+      const char *umount[] = { "fusermount3", "-uz", mount, NULL };
+      const char *del[] = { RCLONE, "config", "delete", rd->remote, NULL };
+      const char *rm[] = { "rm", "-rf", "--", cache, meta, NULL };
+
+      g_free (run_sync (stop, NULL));
+      g_free (run_sync (umount, NULL));
+      g_free (run_sync (del, NULL));
+      g_free (run_sync (rm, NULL));
+      g_unlink (env);
+      g_rmdir (mount);
+      set_bookmark (mount, title, FALSE);
+      refresh_once (rd->self);
+    }
+  g_object_unref (rd->self);
+  g_free (rd->remote);
+  g_free (rd);
+}
+
+static void
+remove_clicked (GtkWidget *button, CcManCloudPanel *self)
+{
+  const char *remote = g_object_get_data (G_OBJECT (button), "remote");
+  g_autofree char *title = drive_title (remote);
+  g_autofree char *heading = g_strdup_printf (_("Remove “%s”?"), title);
+  AdwDialog *dialog = adw_alert_dialog_new (heading, _("Your files stay in the cloud. This computer stops showing them, and its copies of them are deleted."));
+  RemoveData *rd = g_new0 (RemoveData, 1);
+
+  rd->self = g_object_ref (self);
+  rd->remote = g_strdup (remote);
+  adw_alert_dialog_add_responses (ADW_ALERT_DIALOG (dialog), "cancel", _("_Cancel"), "remove", _("_Remove"), NULL);
+  adw_alert_dialog_set_response_appearance (ADW_ALERT_DIALOG (dialog), "remove", ADW_RESPONSE_DESTRUCTIVE);
+  adw_alert_dialog_set_default_response (ADW_ALERT_DIALOG (dialog), "cancel");
+  g_signal_connect (dialog, "response", G_CALLBACK (remove_response), rd);
+  adw_dialog_present (dialog, GTK_WIDGET (self));
+}
+
+static void
+refresh_drives (CcManCloudPanel *self)
+{
+  g_autoptr(GPtrArray) drives = list_drives ();
+
+  g_autoptr(GString) sig = g_string_new (NULL);
+  g_autoptr(GPtrArray) states = g_ptr_array_new_with_free_func (g_free);
+
+  if (!self->drives_group)
+    return;
+  for (guint i = 0; i < drives->len; i++)
+    {
+      Drive *d = g_ptr_array_index (drives, i);
+      g_autofree char *active = NULL, *sub = NULL, *file_state = NULL;
+      g_autofree char *title = drive_title (d->remote);
+
+      unit_state (d->remote, &active, &sub, &file_state);
+      g_ptr_array_add (states, g_strdup_printf ("%s|%s|%s", active ? active : "", sub ? sub : "", file_state ? file_state : ""));
+      g_string_append_printf (sig, "%s\x1f%s\x1f%s\x1e", d->remote, title, (char *) g_ptr_array_index (states, i));
+    }
+  if (self->last_sig && strcmp (self->last_sig, sig->str) == 0)
+    return;
+  g_free (self->last_sig);
+  self->last_sig = g_strdup (sig->str);
+  for (guint i = 0; i < self->drive_rows->len; i++)
+    adw_preferences_group_remove (ADW_PREFERENCES_GROUP (self->drives_group), g_ptr_array_index (self->drive_rows, i));
+  g_ptr_array_set_size (self->drive_rows, 0);
+  gtk_widget_set_visible (self->empty_row, drives->len == 0);
+
+  for (guint i = 0; i < drives->len; i++)
+    {
+      Drive *d = g_ptr_array_index (drives, i);
+      JsonObject *p = provider_by_name (self, d->type);
+      g_autofree char *title = drive_title (d->remote);
+      g_autofree char *ptitle = p ? provider_title (p) : g_strdup (d->type ? d->type : "");
+      g_auto(GStrv) st = g_strsplit (g_ptr_array_index (states, i), "|", 3);
+      const char *active = st[0], *sub = st[1], *file_state = st[2];
+      g_autofree char *subtitle = NULL;
+      const char *status;
+      GtkWidget *row = adw_switch_row_new ();
+      GtkWidget *open = gtk_button_new_from_icon_name ("folder-open-symbolic");
+      GtkWidget *remove = gtk_button_new_from_icon_name ("user-trash-symbolic");
+      gboolean on;
+
+      on = g_strcmp0 (file_state, "enabled") == 0 || g_strcmp0 (active, "active") == 0 || g_strcmp0 (active, "activating") == 0;
+      if (g_strcmp0 (active, "active") == 0)
+        status = _("Connected");
+      else if (g_strcmp0 (sub, "auto-restart") == 0 || g_strcmp0 (active, "failed") == 0)
+        status = _("Cannot connect. Trying again…");
+      else if (g_strcmp0 (active, "activating") == 0)
+        status = _("Connecting…");
+      else
+        status = _("Not shown in Files");
+      subtitle = g_strdup_printf ("%s · %s", ptitle, status);
+
+      adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), title);
+      adw_action_row_set_subtitle (ADW_ACTION_ROW (row), subtitle);
+      adw_preferences_row_set_use_markup (ADW_PREFERENCES_ROW (row), FALSE);
+      g_object_set_data_full (G_OBJECT (row), "remote", g_strdup (d->remote), g_free);
+      g_object_set_data (G_OBJECT (row), "syncing", GINT_TO_POINTER (TRUE));
+      adw_switch_row_set_active (ADW_SWITCH_ROW (row), on);
+      g_object_set_data (G_OBJECT (row), "syncing", GINT_TO_POINTER (FALSE));
+      g_signal_connect (row, "notify::active", G_CALLBACK (switch_toggled), self);
+
+      gtk_widget_set_tooltip_text (open, _("Open in Files"));
+      gtk_widget_set_valign (open, GTK_ALIGN_CENTER);
+      gtk_widget_add_css_class (open, "flat");
+      gtk_widget_set_sensitive (open, g_strcmp0 (active, "active") == 0);
+      g_object_set_data_full (G_OBJECT (open), "remote", g_strdup (d->remote), g_free);
+      g_signal_connect (open, "clicked", G_CALLBACK (open_in_files), NULL);
+      gtk_widget_set_tooltip_text (remove, _("Remove"));
+      gtk_widget_set_valign (remove, GTK_ALIGN_CENTER);
+      gtk_widget_add_css_class (remove, "flat");
+      g_object_set_data_full (G_OBJECT (remove), "remote", g_strdup (d->remote), g_free);
+      g_signal_connect (remove, "clicked", G_CALLBACK (remove_clicked), self);
+      adw_action_row_add_prefix (ADW_ACTION_ROW (row), gtk_image_new_from_icon_name ("folder-remote-symbolic"));
+      adw_action_row_add_suffix (ADW_ACTION_ROW (row), open);
+      adw_action_row_add_suffix (ADW_ACTION_ROW (row), remove);
+
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (self->drives_group), row);
+      g_ptr_array_add (self->drive_rows, row);
+    }
+  /* The add button stays last. */
+  g_object_ref (self->add_row);
+  adw_preferences_group_remove (ADW_PREFERENCES_GROUP (self->drives_group), self->add_row);
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (self->drives_group), self->add_row);
+  g_object_unref (self->add_row);
+}
