+static gboolean
+refresh_tick (gpointer user_data)
+{
+  CcManCloudPanel *self = user_data;
+
+  if (gtk_widget_get_mapped (GTK_WIDGET (self)))
+    refresh_drives (self);
+  return G_SOURCE_CONTINUE;
+}
