+/* ─────────────────────────── adding a drive ─────────────────────────── */
+
+typedef enum { FIELD_ENTRY, FIELD_PASSWORD, FIELD_SWITCH, FIELD_COMBO } FieldKind;
+
+typedef struct {
+  char *name;
+  char *provider_cond;   /* rclone's "Provider" condition, "" for all */
+  char *default_str;
+  gboolean required;
+  FieldKind kind;
+  GPtrArray *values;     /* FIELD_COMBO: the example values */
+  GtkWidget *row;
+} Field;
+
+typedef struct {
+  CcManCloudPanel *self;
+  char *type;
+  char *ptitle;
+  gboolean browser;
+  GPtrArray *fields;
+  GtkWidget *name_row;
+  GtkWidget *go;
+  GtkWidget *error;
+
+  /* rclone's setup steps */
+  char *remote;
+  char *title;
+  char *mount;
+  char *state;
+  char *last_state;
+  int repeats;
+  GSubprocess *proc;
+  GCancellable *cancel;
+  GString *out;
+  GString *err;
+  int pending;
+  gboolean cancelled;
+  char *login_url;
+  GtkWidget *login_again;
+  GtkWidget *answer;     /* the widget of a question page */
+  GPtrArray *answer_values;
+  gboolean finished;
+} Setup;
+
+static void
+field_free (Field *f)
+{
+  g_free (f->name);
+  g_free (f->provider_cond);
+  g_free (f->default_str);
+  if (f->values)
+    g_ptr_array_unref (f->values);
+  g_free (f);
+}
+
+static void
+setup_free (Setup *s)
+{
+  if (s->cancel)
+    g_cancellable_cancel (s->cancel);
+  g_clear_object (&s->cancel);
+  g_clear_object (&s->proc);
+  if (s->fields)
+    g_ptr_array_unref (s->fields);
+  if (s->answer_values)
+    g_ptr_array_unref (s->answer_values);
+  if (s->out)
+    g_string_free (s->out, TRUE);
+  if (s->err)
+    g_string_free (s->err, TRUE);
+  g_free (s->type);
+  g_free (s->ptitle);
+  g_free (s->remote);
+  g_free (s->title);
+  g_free (s->mount);
+  g_free (s->state);
+  g_free (s->last_state);
+  g_free (s->login_url);
+  g_object_unref (s->self);
+  g_free (s);
+}
