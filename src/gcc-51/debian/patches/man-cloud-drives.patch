+  "endpoint", "access_key_id", "secret_access_key", "account", "key", "api_key", "email",
+  "apple_id", "domain", "tenant", "site", "service", "namespace", "public_key", "private_key",
+  "cloud_name", "api_secret", "drive_id", "doi", "namenode", "secret", NULL,
+};
