+
+/* rclone needs something only the user knows (a code, a choice). */
+static void
+question_page (Setup *s, JsonObject *opt, const char *error)
+{
+  GtkWidget *page = adw_preferences_page_new ();
+  GtkWidget *group = adw_preferences_group_new ();
+  GtkWidget *go = pill (_("C_ontinue"), TRUE);
+  GtkWidget *cancel = pill (_("_Cancel"), FALSE);
+  JsonArray *ex = jarr (opt, "Examples");
+  guint n_ex = ex ? json_array_get_length (ex) : 0;
+  g_autofree char *label = field_label (jstr (opt, "Name"));
+  const char *help = jstr (opt, "Help");
+
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (group), _("One More Step"));
+  {
+    g_autofree char *h = g_markup_escape_text (help ? help : "", -1);
+    adw_preferences_group_set_description (ADW_PREFERENCES_GROUP (group), h);
+  }
+  g_clear_pointer (&s->answer_values, g_ptr_array_unref);
+  if (n_ex > 0)
+    {
+      g_autoptr(GtkStringList) list = gtk_string_list_new (NULL);
+      const char *def = jstr (opt, "DefaultStr");
+      guint selected = 0;
+
+      s->answer_values = g_ptr_array_new_with_free_func (g_free);
+      for (guint i = 0; i < n_ex; i++)
+        {
+          JsonObject *e = json_array_get_object_element (ex, i);
+          const char *v = jstr (e, "Value") ? jstr (e, "Value") : "";
+          g_autofree char *h = short_help (jstr (e, "Help"));
+
+          if (g_strcmp0 (v, def) == 0)
+            selected = i;
+          g_ptr_array_add (s->answer_values, g_strdup (v));
+          gtk_string_list_append (list, h && *h ? h : v);
+        }
+      s->answer = adw_combo_row_new ();
+      adw_combo_row_set_model (ADW_COMBO_ROW (s->answer), G_LIST_MODEL (list));
+      adw_combo_row_set_selected (ADW_COMBO_ROW (s->answer), selected);
+    }
+  else if (jbool (opt, "IsPassword"))
+    s->answer = adw_password_entry_row_new ();
+  else
+    {
+      s->answer = adw_entry_row_new ();
+      gtk_editable_set_text (GTK_EDITABLE (s->answer), jstr (opt, "DefaultStr") ? jstr (opt, "DefaultStr") : "");
+    }
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (s->answer), label);
+  adw_preferences_row_set_use_markup (ADW_PREFERENCES_ROW (s->answer), FALSE);
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), s->answer);
+  if (error && *error)
+    {
+      GtkWidget *err = gtk_label_new (error);
+      gtk_label_set_wrap (GTK_LABEL (err), TRUE);
+      gtk_label_set_xalign (GTK_LABEL (err), 0.0);
+      gtk_widget_add_css_class (err, "error");
+      gtk_widget_set_margin_top (err, 12);
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), err);
+    }
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (group));
+  if (ADW_IS_ENTRY_ROW (s->answer))
+    g_signal_connect (s->answer, "entry-activated", G_CALLBACK (answer_clicked), s);
+  g_signal_connect (go, "clicked", G_CALLBACK (answer_clicked), s);
+  g_signal_connect_swapped (cancel, "clicked", G_CALLBACK (question_cancel), s);
+  replace_top (s->self, subpage (s->ptitle, "question", page, bottom_bar (cancel, go, NULL)), "form");
+  gtk_widget_grab_focus (s->answer);
+}
+
+static void
+setup_done (Setup *s)
+{
+  g_autoptr(GError) error = NULL;
+  CcManCloudPanel *self = s->self;
+
+  s->finished = TRUE;
+  pending_mark (s->remote, FALSE);
+  if (!write_env (s->remote, s->title, s->mount, &error))
+    {
+      show_failure (s, error->message);
+      return;
+    }
+  g_mkdir_with_parents (s->mount, 0700);
+  set_connected (s->remote, TRUE);
+  pop_subpages (self);
+  refresh_once (self);
+  refresh_later (self, 2);
+}
+
+/* rclone's answer for questions MAN answers itself; NULL to ask the user. */
+static const char *
+auto_answer (Setup *s, JsonObject *opt, const char *error)
+{
+  const char *name = jstr (opt, "Name");
+  const char *def = jstr (opt, "DefaultStr");
+
+  if (g_strcmp0 (name, "config_is_local") == 0)
+    return "true";                      /* log in with this computer's browser */
+  if (g_strcmp0 (name, "config_shared_client_id") == 0)
+    return "true";                      /* keep rclone's own app registration */
+  if (g_str_has_prefix (name ? name : "", "config_fs_advanced") || g_strcmp0 (name, "config_change_team_drive") == 0)
+    return "false";
+  if (error && *error)
+    return NULL;
+  if (!jbool (opt, "Required"))
+    return def ? def : "";
+  if (def && *def)
+    return def;
+  return NULL;
+}
+
+static void
+cancel_setup (Setup *s)
+{
+  if (s->remote && !s->finished)
+    {
+      const char *del[] = { RCLONE, "config", "delete", s->remote, NULL };
+      spawn_quiet (del);
+    }
+  pending_mark (s->remote, FALSE);
+  if (gtk_widget_get_root (GTK_WIDGET (s->self)))
+    back_to_form (s->self);
+}
+
+/* One step of rclone's setup has ended: its stdout is the next question, or
+ * an empty State when the drive is ready. */
+static void
+parse_step (Setup *s, const char *out, const char *err)
+{
+  g_autoptr(JsonParser) parser = json_parser_new ();
+  JsonObject *root, *opt;
+  const char *state, *jerr, *answer;
+
+  if (!out || !*out || !json_parser_load_from_data (parser, out, -1, NULL) ||
+      !JSON_NODE_HOLDS_OBJECT (json_parser_get_root (parser)))
+    {
+      /* rclone stopped with an error message instead of a step. */
+      g_autofree char *msg = NULL;
+      if (err && *err)
+        {
+          g_autofree char *e = g_strstrip (g_strdup (err));
+          g_auto(GStrv) lines = g_strsplit (e, "\n", -1);
+          guint n = g_strv_length (lines);
+          const char *last = n ? lines[n - 1] : e;
+          const char *colon = strstr (last, "ERROR : ");
+          if (!colon)
+            colon = strstr (last, "Fatal error: ");
+          msg = g_strdup (colon ? strchr (colon, ':') + 2 : last);
+        }
+      show_failure (s, msg);
+      setup_free (s);
+      return;
+    }
+  root = json_node_get_object (json_parser_get_root (parser));
+  state = jstr (root, "State");
+  jerr = jstr (root, "Error");
+  opt = json_object_has_member (root, "Option") && JSON_NODE_HOLDS_OBJECT (json_object_get_member (root, "Option"))
+        ? json_object_get_object_member (root, "Option") : NULL;
+
+  if (!state || !*state)
+    {
+      if (jerr && *jerr)
+        show_failure (s, jerr);
+      else
+        setup_done (s);
+      setup_free (s);
+      return;
+    }
+
+  /* The same question again: what MAN answered did not work, so ask. */
+  if (g_strcmp0 (state, s->last_state) == 0)
+    s->repeats++;
+  else
+    s->repeats = 0;
+  g_free (s->last_state);
+  s->last_state = g_strdup (state);
+  g_free (s->state);
+  s->state = g_strdup (state);
+  if (s->repeats > 4)
+    {
+      show_failure (s, jerr);
+      setup_free (s);
+      return;
+    }
+
+  answer = s->repeats ? NULL : auto_answer (s, opt, jerr);
+  if (answer)
+    {
+      if (g_strcmp0 (jstr (opt, "Name"), "config_is_local") == 0)
+        login_page (s);
+      continue_with (s, answer);
+      return;
+    }
+  question_page (s, opt, jerr);
+}
+
+/* A step is done when rclone has exited and its output has been read. */
+static void
+step_part_done (Setup *s)
+{
+  g_autofree char *out = NULL;
+  g_autofree char *err = NULL;
+
+  if (--s->pending > 0)
+    return;
+  g_clear_object (&s->proc);
+  out = g_strdup (s->out->str);
+  err = g_strdup (s->err->str);
+  g_free (s->login_url);
+  s->login_url = NULL;
+  s->login_again = NULL;
+  if (s->cancelled)
+    {
+      cancel_setup (s);
+      setup_free (s);
+      return;
+    }
+  parse_step (s, out, err);
+}
+
+static void
+stdout_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  Setup *s = user_data;
+  GBytes *bytes;
+
+  g_output_stream_splice_finish (G_OUTPUT_STREAM (source), res, NULL);
+  bytes = g_memory_output_stream_steal_as_bytes (G_MEMORY_OUTPUT_STREAM (source));
+  g_string_assign (s->out, "");
+  g_string_append_len (s->out, g_bytes_get_data (bytes, NULL), g_bytes_get_size (bytes));
+  g_bytes_unref (bytes);
+  step_part_done (s);
+}
+
+/* stderr, line by line: the login address rclone prints while it waits for
+ * the browser, and its error messages. */
+static void
+stderr_line (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  Setup *s = user_data;
+  g_autofree char *line = g_data_input_stream_read_line_finish_utf8 (G_DATA_INPUT_STREAM (source), res, NULL, NULL);
+  const char *http;
+
+  if (!line)
+    {
+      g_object_unref (source);
+      step_part_done (s);
+      return;
+    }
+  g_string_append_printf (s->err, "%s\n", line);
+  http = strstr (line, "http://127.0.0.1:");
+  if (http && !s->login_url)
+    {
+      s->login_url = g_strndup (http, strcspn (http, " \t"));
+      if (s->login_again)
+        gtk_widget_set_sensitive (s->login_again, TRUE);
+    }
+  g_data_input_stream_read_line_async (G_DATA_INPUT_STREAM (source), G_PRIORITY_DEFAULT, NULL, stderr_line, s);
+}
+
+static void
+proc_exited (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  Setup *s = user_data;
+  g_autoptr(GError) error = NULL;
+
+  if (!g_subprocess_wait_finish (G_SUBPROCESS (source), res, &error) &&
+      g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    {
+      /* Cancel: stop rclone; its pipes close and the step ends. */
+      s->cancelled = TRUE;
+      g_subprocess_force_exit (G_SUBPROCESS (source));
+    }
+  step_part_done (s);
+}
+
+/* rclone waits for the browser login on a fixed port: it must not outlive
+ * Settings, or the next login could not start. */
+static void
+die_with_parent (gpointer data)
+{
+  prctl (PR_SET_PDEATHSIG, SIGTERM);
+}
+
+static void
+run_step (Setup *s, GPtrArray *argv)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GOutputStream) mem = NULL;
+  g_autoptr(GSubprocessLauncher) launcher = g_subprocess_launcher_new (G_SUBPROCESS_FLAGS_STDOUT_PIPE | G_SUBPROCESS_FLAGS_STDERR_PIPE);
+  GDataInputStream *errs;
+
+  g_ptr_array_add (argv, NULL);
+  g_clear_object (&s->cancel);
+  s->cancel = g_cancellable_new ();
+  pending_mark (s->remote, TRUE);
+  g_subprocess_launcher_set_child_setup (launcher, die_with_parent, NULL, NULL);
+  s->proc = g_subprocess_launcher_spawnv (launcher, (const char * const *) argv->pdata, &error);
+  g_ptr_array_unref (argv);
+  if (!s->proc)
+    {
+      show_failure (s, error->message);
+      setup_free (s);
+      return;
+    }
+  if (!s->out)
+    s->out = g_string_new (NULL);
+  if (!s->err)
+    s->err = g_string_new (NULL);
+  g_string_assign (s->out, "");
+  g_string_assign (s->err, "");
+  s->pending = 3;   /* stdout read, stderr read, process exit */
+  mem = g_memory_output_stream_new_resizable ();
+  g_output_stream_splice_async (mem, g_subprocess_get_stdout_pipe (s->proc),
+                                G_OUTPUT_STREAM_SPLICE_CLOSE_SOURCE | G_OUTPUT_STREAM_SPLICE_CLOSE_TARGET,
+                                G_PRIORITY_DEFAULT, NULL, stdout_done, s);
+  errs = g_data_input_stream_new (g_subprocess_get_stderr_pipe (s->proc));
+  g_data_input_stream_read_line_async (errs, G_PRIORITY_DEFAULT, NULL, stderr_line, s);
+  g_subprocess_wait_async (s->proc, s->cancel, proc_exited, s);
+}
+
+static void
+continue_with (Setup *s, const char *result)
+{
+  GPtrArray *argv = g_ptr_array_new_with_free_func (g_free);
+
+  if (!s->login_again)
+    busy_page (s, s->ptitle, _("Setting up the drive…"));
+  g_ptr_array_add (argv, g_strdup (RCLONE));
+  g_ptr_array_add (argv, g_strdup ("config"));
+  g_ptr_array_add (argv, g_strdup ("update"));
+  g_ptr_array_add (argv, g_strdup (s->remote));
+  g_ptr_array_add (argv, g_strdup ("--continue"));
+  g_ptr_array_add (argv, g_strdup ("--state"));
+  g_ptr_array_add (argv, g_strdup (s->state));
+  g_ptr_array_add (argv, g_strdup ("--result"));
+  g_ptr_array_add (argv, g_strdup (result ? result : ""));
+  g_ptr_array_add (argv, g_strdup ("--non-interactive"));
+  run_step (s, argv);
+}
+
+static void
+form_go (GtkWidget *button, Setup *s)
+{
+  GPtrArray *argv = g_ptr_array_new_with_free_func (g_free);
+  g_autofree char *title = g_strstrip (g_strdup (gtk_editable_get_text (GTK_EDITABLE (s->name_row))));
+  Setup *run = g_new0 (Setup, 1);
+
+  /* The form stays open below; each attempt is a setup of its own. */
+  run->self = g_object_ref (s->self);
+  run->type = g_strdup (s->type);
+  run->ptitle = g_strdup (s->ptitle);
+  run->browser = s->browser;
+  run->title = g_strdup (*title ? title : s->ptitle);
+  run->remote = remote_name (run->title);
+  run->mount = unique_mount (run->title);
+
+  g_ptr_array_add (argv, g_strdup (RCLONE));
+  g_ptr_array_add (argv, g_strdup ("config"));
+  g_ptr_array_add (argv, g_strdup ("create"));
+  g_ptr_array_add (argv, g_strdup (run->remote));
+  g_ptr_array_add (argv, g_strdup (s->type));
+  for (guint i = 0; i < s->fields->len; i++)
+    {
+      Field *f = g_ptr_array_index (s->fields, i);
+      const char *v = field_value (f);
+
+      if (!gtk_widget_get_visible (f->row) || !v || (!*v && f->kind != FIELD_SWITCH) || g_strcmp0 (v, f->default_str) == 0)
+        continue;
+      g_ptr_array_add (argv, g_strdup_printf ("%s=%s", f->name, v));
+    }
+  g_ptr_array_add (argv, g_strdup ("--non-interactive"));
+  g_ptr_array_add (argv, g_strdup ("--obscure"));
+  busy_page (run, run->ptitle, run->browser ? _("Opening the login page…") : _("Connecting…"));
+  run_step (run, argv);
+}
+
+static void
+form_changed (Setup *s)
+{
+  validate_form (s);
+}
+
+static void
+form_page_destroyed (gpointer data, GObject *where)
+{
+  setup_free (data);
+}
+
+static void
+show_form (CcManCloudPanel *self, JsonObject *p)
+{
+  Setup *s = g_new0 (Setup, 1);
+  GtkWidget *page = adw_preferences_page_new ();
+  GtkWidget *head = adw_preferences_group_new ();
+  GtkWidget *main = adw_preferences_group_new ();
+  GtkWidget *more_group = adw_preferences_group_new ();
+  GtkWidget *more = adw_expander_row_new ();
+  JsonArray *opts = jarr (p, "Options");
+  AdwNavigationPage *nav_page;
+  int n_main = 0, n_more = 0;
+
+  s->self = g_object_ref (self);
+  s->type = g_strdup (jstr (p, "Name"));
+  s->ptitle = provider_title (p);
+  s->browser = uses_browser (p);
+  s->fields = g_ptr_array_new_with_free_func ((GDestroyNotify) field_free);
+
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (head), s->ptitle);
+  adw_preferences_group_set_description (ADW_PREFERENCES_GROUP (head),
+    s->browser ? _("You log in with your web browser. Your password is never entered here.")
+               : _("Enter the details of your account. They are kept in your home folder."));
+  s->name_row = adw_entry_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (s->name_row), _("Name in Files"));
+  {
+    /* "WebDAV (Nextcloud, …)" → "WebDAV" as the folder name. */
+    const char *paren = strstr (s->ptitle, " (");
+    g_autofree char *short_name = paren ? g_strndup (s->ptitle, paren - s->ptitle) : g_strdup (s->ptitle);
+    gtk_editable_set_text (GTK_EDITABLE (s->name_row), short_name);
+  }
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (head), s->name_row);
+  g_signal_connect_swapped (s->name_row, "changed", G_CALLBACK (form_changed), s);
+
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (more), _("More Options"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (more_group), more);
+
+  for (guint i = 0; opts && i < json_array_get_length (opts); i++)
+    {
+      JsonObject *o = json_array_get_object_element (opts, i);
+      const char *name = jstr (o, "Name");
+      gboolean is_main;
+      Field *f;
+
+      if (!name || jbool (o, "Advanced") || jint (o, "Hide") != 0 || g_strv_contains (hidden_fields, name))
+        continue;
+      if (s->browser && (g_strcmp0 (name, "client_id") == 0 || g_strcmp0 (name, "client_secret") == 0 || g_strcmp0 (name, "access_token") == 0))
+        is_main = FALSE;
+      else
+        is_main = jbool (o, "Required") || g_strv_contains (main_fields, name);
+      f = make_field (o);
+      g_ptr_array_add (s->fields, f);
+      if (is_main)
+        {
+          adw_preferences_group_add (ADW_PREFERENCES_GROUP (main), f->row);
+          n_main++;
+        }
+      else
+        {
+          adw_expander_row_add_row (ADW_EXPANDER_ROW (more), f->row);
+          n_more++;
+        }
+      if (f->kind == FIELD_COMBO)
+        g_signal_connect_swapped (f->row, "notify::selected", G_CALLBACK (form_changed), s);
+      else if (f->kind == FIELD_SWITCH)
+        g_signal_connect_swapped (f->row, "notify::active", G_CALLBACK (form_changed), s);
+      else
+        g_signal_connect_swapped (f->row, "changed", G_CALLBACK (form_changed), s);
+    }
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (head));
+  if (n_main)
+    adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (main));
+  if (n_more)
+    adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (more_group));
+
+  s->go = pill (s->browser ? _("_Log In") : _("C_onnect"), TRUE);
+  g_signal_connect (s->go, "clicked", G_CALLBACK (form_go), s);
+  nav_page = subpage (s->ptitle, "form", page, bottom_bar (s->go, NULL));
+  g_object_weak_ref (G_OBJECT (nav_page), form_page_destroyed, s);
+  validate_form (s);
+  replace_top (self, nav_page, "providers");
+}
+
+/* ─────────────────────────── the provider list ─────────────────────────── */
+
+static int
+compare_providers (gconstpointer a, gconstpointer b, gpointer self)
+{
+  JsonObject *pa = *(JsonObject **) a, *pb = *(JsonObject **) b;
+  int ra = popular_rank (jstr (pa, "Name")), rb = popular_rank (jstr (pb, "Name"));
+  g_autofree char *ta = NULL, *tb = NULL;
+
+  if (ra != rb)
+    return ra - rb;
+  ta = provider_title (pa);
+  tb = provider_title (pb);
+  return g_utf8_collate (ta, tb);
+}
+
+static void
+provider_activated (GtkWidget *row, CcManCloudPanel *self)
+{
+  JsonObject *p = provider_by_name (self, g_object_get_data (G_OBJECT (row), "provider"));
+
+  if (p)
+    show_form (self, p);
+}
+
+static void
+search_changed (GtkSearchEntry *entry, GPtrArray *rows)
+{
+  g_autofree char *needle = g_utf8_casefold (gtk_editable_get_text (GTK_EDITABLE (entry)), -1);
+
+  for (guint i = 0; i < rows->len; i++)
+    {
+      GtkWidget *row = g_ptr_array_index (rows, i);
+      const char *hay = g_object_get_data (G_OBJECT (row), "search");
+      gtk_widget_set_visible (row, !*needle || strstr (hay, needle) != NULL);
+    }
+}
+
+static void
+rows_free (gpointer data, GClosure *closure)
+{
+  g_ptr_array_unref (data);
+}
+
+static void
+start_add (CcManCloudPanel *self)
+{
+  JsonArray *all = provider_list (self);
+  g_autoptr(GPtrArray) list = g_ptr_array_new ();
+  GPtrArray *rows = g_ptr_array_new ();
+  GtkWidget *page = adw_preferences_page_new ();
+  GtkWidget *top = adw_preferences_group_new ();
+  GtkWidget *popular_group = adw_preferences_group_new ();
+  GtkWidget *other_group = adw_preferences_group_new ();
+  GtkWidget *search = gtk_search_entry_new ();
+  AdwNavigationPage *nav_page;
+
+  if (!all)
+    {
+      AdwDialog *d = adw_alert_dialog_new (_("Cloud Drives Are Not Available"), _("rclone, which connects cloud drives, is not installed."));
+      adw_alert_dialog_add_response (ADW_ALERT_DIALOG (d), "ok", _("_OK"));
+      adw_dialog_present (d, GTK_WIDGET (self));
+      g_ptr_array_unref (rows);
+      return;
+    }
+  for (guint i = 0; i < json_array_get_length (all); i++)
+    if (is_provider (json_array_get_object_element (all, i)))
+      g_ptr_array_add (list, json_array_get_object_element (all, i));
+  g_ptr_array_sort_with_data (list, compare_providers, self);
+
+  gtk_search_entry_set_placeholder_text (GTK_SEARCH_ENTRY (search), _("Search providers"));
+  gtk_widget_set_margin_bottom (search, 6);
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (top), search);
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (popular_group), _("Popular"));
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (other_group), _("All Providers"));
+
+  for (guint i = 0; i < list->len; i++)
+    {
+      JsonObject *p = g_ptr_array_index (list, i);
+      g_autofree char *title = provider_title (p);
+      g_autofree char *hay = g_strdup_printf ("%s %s %s", title, jstr (p, "Name"), jstr (p, "Description"));
+      GtkWidget *row = adw_action_row_new ();
+
+      adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), title);
+      adw_preferences_row_set_use_markup (ADW_PREFERENCES_ROW (row), FALSE);
+      if (uses_browser (p))
+        adw_action_row_set_subtitle (ADW_ACTION_ROW (row), _("Log in with your browser"));
+      gtk_list_box_row_set_activatable (GTK_LIST_BOX_ROW (row), TRUE);
+      adw_action_row_add_suffix (ADW_ACTION_ROW (row), gtk_image_new_from_icon_name ("go-next-symbolic"));
+      g_object_set_data_full (G_OBJECT (row), "provider", g_strdup (jstr (p, "Name")), g_free);
+      g_object_set_data_full (G_OBJECT (row), "search", g_utf8_casefold (hay, -1), g_free);
+      g_signal_connect (row, "activated", G_CALLBACK (provider_activated), self);
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (popular_rank (jstr (p, "Name")) < (int) G_N_ELEMENTS (popular) ? popular_group : other_group), row);
+      g_ptr_array_add (rows, row);
+    }
+  g_signal_connect_data (search, "search-changed", G_CALLBACK (search_changed), rows, rows_free, 0);
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (top));
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (popular_group));
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (other_group));
+  nav_page = subpage (_("Add Cloud Drive"), "providers", page, NULL);
+  pop_subpages (self);
+  cc_panel_push_subpage (CC_PANEL (self), nav_page);
+  gtk_widget_grab_focus (search);
+}
+
+/* ─────────────────────────── the panel ─────────────────────────── */
+
+static void
+cc_man_cloud_panel_dispose (GObject *object)
+{
+  CcManCloudPanel *self = CC_MAN_CLOUD_PANEL (object);
+
+  g_clear_handle_id (&self->refresh_id, g_source_remove);
+  g_cancellable_cancel (self->cancellable);
+  g_clear_object (&self->cancellable);
+  g_clear_object (&self->providers);
+  g_clear_pointer (&self->drive_rows, g_ptr_array_unref);
+  g_clear_pointer (&self->last_sig, g_free);
+  self->drives_group = NULL;
+  G_OBJECT_CLASS (cc_man_cloud_panel_parent_class)->dispose (object);
+}
+
+static void
+cc_man_cloud_panel_class_init (CcManCloudPanelClass *klass)
+{
+  G_OBJECT_CLASS (klass)->dispose = cc_man_cloud_panel_dispose;
+}
+
+static void
+cc_man_cloud_panel_init (CcManCloudPanel *self)
+{
+  GtkWidget *toolbar = adw_toolbar_view_new ();
+  GtkWidget *page = adw_preferences_page_new ();
+
+  cc_man_i18n_init ();
+  self->cancellable = g_cancellable_new ();
+  self->drive_rows = g_ptr_array_new ();
+  adw_navigation_page_set_title (ADW_NAVIGATION_PAGE (self), _("Cloud Drives"));
+  adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (toolbar), adw_header_bar_new ());
+
+  self->drives_group = adw_preferences_group_new ();
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (self->drives_group), _("Cloud Drives"));
+  adw_preferences_group_set_description (ADW_PREFERENCES_GROUP (self->drives_group),
+    _("Your cloud storage, in Files. Each drive connects by itself every time you log in."));
+  self->empty_row = adw_action_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->empty_row), _("No cloud drives yet"));
+  gtk_widget_add_css_class (self->empty_row, "dim-label");
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (self->drives_group), self->empty_row);
+  self->add_row = adw_button_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->add_row), _("_Add Cloud Drive…"));
+  adw_preferences_row_set_use_underline (ADW_PREFERENCES_ROW (self->add_row), TRUE);
+  adw_button_row_set_start_icon_name (ADW_BUTTON_ROW (self->add_row), "list-add-symbolic");
+  g_signal_connect_swapped (self->add_row, "activated", G_CALLBACK (start_add), self);
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (self->drives_group), self->add_row);
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (self->drives_group));
+
+  adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (toolbar), page);
+  adw_navigation_page_set_child (ADW_NAVIGATION_PAGE (self), toolbar);
+
+  clean_unfinished ();
+  refresh_drives (self);
+  self->refresh_id = g_timeout_add_seconds (3, refresh_tick, self);
+}
