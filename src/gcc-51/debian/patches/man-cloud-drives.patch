+
+static void
+login_page (Setup *s)
+{
+  GtkWidget *status = adw_status_page_new ();
+  GtkWidget *spinner = adw_spinner_new ();
+  GtkWidget *cancel = pill (_("_Cancel"), FALSE);
+  g_autofree char *title = g_strdup_printf (_("Log In to %s"), s->ptitle);
+
+  s->login_again = pill (_("_Open Login Page Again"), FALSE);
+  gtk_widget_set_sensitive (s->login_again, s->login_url != NULL);
+  gtk_widget_set_size_request (spinner, 48, 48);
+  adw_status_page_set_icon_name (ADW_STATUS_PAGE (status), "web-browser-symbolic");
+  adw_status_page_set_title (ADW_STATUS_PAGE (status), title);
+  adw_status_page_set_description (ADW_STATUS_PAGE (status), _("Your web browser opened the login page. Log in there and allow access, then come back here. This page continues by itself."));
+  adw_status_page_set_child (ADW_STATUS_PAGE (status), spinner);
+  g_signal_connect (s->login_again, "clicked", G_CALLBACK (login_again), s);
+  g_signal_connect_swapped (cancel, "clicked", G_CALLBACK (cancel_clicked), s);
+  replace_top (s->self, subpage (s->ptitle, "login", status, bottom_bar (cancel, s->login_again, NULL)), "form");
+}
