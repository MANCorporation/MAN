+static void
+start_inspect (CcManUpdatesPanel *self, const char *path)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GSubprocess) proc = NULL;
+  g_autoptr(JsonBuilder) b = json_builder_new ();
+  g_autoptr(JsonGenerator) gen = json_generator_new ();
+  g_autoptr(JsonNode) root = NULL;
+  g_autofree char *request = NULL;
+
+  g_free (self->file);
+  self->file = g_strdup (path);
+  json_builder_begin_object (b);
+  json_builder_set_member_name (b, "op");
+  json_builder_add_string_value (b, "update_inspect");
+  json_builder_set_member_name (b, "path");
+  json_builder_add_string_value (b, path);
+  json_builder_end_object (b);
+  root = json_builder_get_root (b);
+  json_generator_set_root (gen, root);
+  request = json_generator_to_data (gen, NULL);
+
+  set_state (self, STATE_VERIFYING, NULL);
+  proc = g_subprocess_new (G_SUBPROCESS_FLAGS_STDIN_PIPE | G_SUBPROCESS_FLAGS_STDOUT_PIPE | G_SUBPROCESS_FLAGS_STDERR_SILENCE,
+                           &error, BACKEND, "request", NULL);
+  if (!proc)
+    {
+      show_invalid (self, error->message);
+      return;
+    }
+  g_subprocess_communicate_utf8_async (proc, request, self->cancellable, inspect_done_cb, self);
+}
