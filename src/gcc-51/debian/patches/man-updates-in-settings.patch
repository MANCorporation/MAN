+static void
+target_next_cb (CcManUpdatesPanel *self)
+{
+  if (self->device)
+    cc_panel_push_subpage (CC_PANEL (self), confirm_page (self));
+}
+
+static AdwNavigationPage *
+target_page (CcManUpdatesPanel *self)
+{
+  JsonObject *o = info_obj (self);
+  JsonArray *targets = json_object_get_array_member (o, "targets");
+  GtkWidget *page = adw_preferences_page_new ();
+  GtkWidget *group = adw_preferences_group_new ();
+  GtkWidget *anchor = NULL;
+  GtkWidget *next = pill (M_("_Next"), TRUE);
+  gboolean selected = FALSE;
+  guint i;
+
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (group), M_("Where Should the Update Be Installed?"));
+  adw_preferences_group_set_description (ADW_PREFERENCES_GROUP (group), M_("The system is replaced; files in your Home folder are not touched."));
+  for (i = 0; i < json_array_get_length (targets); i++)
+    {
+      JsonObject *t = json_array_get_object_element (targets, i);
+      GtkWidget *row = adw_action_row_new ();
+      GtkWidget *check = gtk_check_button_new ();
+      const char *problem = obj_str (t, "problem");
+      g_autofree char *title = NULL;
+      g_autofree char *free_size = g_format_size (obj_int (t, "free"));
+      g_autofree char *free_text = fill (M_("{size} free"), "size", free_size, NULL);
+      g_autoptr(GString) sub = g_string_new (NULL);
+
+      if (obj_bool (t, "running"))
+        title = fill (M_("{name} {version} on this computer"), "name", obj_str (manifest (self), "name"), "version", obj_str (o, "current_version"), NULL);
+      else
+        title = fill (M_("{name} on {model}"), "name", obj_str (manifest (self), "name"), "model", obj_str (t, "model"), NULL);
+      g_string_append_printf (sub, "%s (%s)", obj_str (t, "model"), obj_str (t, "disk"));
+      if (obj_bool (t, "running"))
+        g_string_append_printf (sub, "  ·  %s  ·  %s", M_("running now"), free_text);
+      if (*problem)
+        g_string_append_printf (sub, "\n%s", problem);
+      adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), title);
+      adw_preferences_row_set_use_markup (ADW_PREFERENCES_ROW (row), FALSE);
+      adw_action_row_set_subtitle (ADW_ACTION_ROW (row), sub->str);
+      if (anchor)
+        gtk_check_button_set_group (GTK_CHECK_BUTTON (check), GTK_CHECK_BUTTON (anchor));
+      else
+        anchor = check;
+      g_object_set_data_full (G_OBJECT (check), "device", g_strdup (obj_str (t, "device")), g_free);
+      g_signal_connect (check, "toggled", G_CALLBACK (target_toggled_cb), self);
+      adw_action_row_add_prefix (ADW_ACTION_ROW (row), check);
+      adw_action_row_set_activatable_widget (ADW_ACTION_ROW (row), check);
+      gtk_widget_set_sensitive (row, *problem == '\0');
+      if (!*problem && !selected)
+        {
+          gtk_check_button_set_active (GTK_CHECK_BUTTON (check), TRUE);
+          selected = TRUE;
+        }
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (group), row);
+    }
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (group));
+  gtk_widget_set_sensitive (next, selected);
+  g_signal_connect_swapped (next, "clicked", G_CALLBACK (target_next_cb), self);
+  return subpage (M_("Install Location"), "target", page, bottom_bar (next, NULL), TRUE);
+}
+
+/* After the license: choose where only when there is a choice. */
+static void
+continue_to_target (CcManUpdatesPanel *self)
+{
+  JsonArray *targets = json_object_get_array_member (info_obj (self), "targets");
+  guint i, usable = 0;
+
+  g_clear_pointer (&self->device, g_free);
+  for (i = 0; i < json_array_get_length (targets); i++)
+    {
+      JsonObject *t = json_array_get_object_element (targets, i);
+      if (*obj_str (t, "problem") == '\0')
+        {
+          usable++;
+          if (!self->device || obj_bool (t, "running"))
+            {
+              g_free (self->device);
+              self->device = g_strdup (obj_str (t, "device"));
+            }
+        }
+    }
+  if (usable > 1)
+    cc_panel_push_subpage (CC_PANEL (self), target_page (self));
+  else
+    cc_panel_push_subpage (CC_PANEL (self), confirm_page (self));
+}
