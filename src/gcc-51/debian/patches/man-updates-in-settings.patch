+static void
+start_install (CcManUpdatesPanel *self, gboolean snapshot)
+{
+  g_autoptr(GError) error = NULL;
+
+  if (!job_start (self, snapshot, &error))
+    {
+      AdwDialog *d = adw_alert_dialog_new (M_("Could not start the system helper."), error->message);
+
+      adw_alert_dialog_add_response (ADW_ALERT_DIALOG (d), "ok", M_("_Cancel"));
+      adw_dialog_present (d, GTK_WIDGET (self));
+      return;
+    }
+  set_state (self, STATE_PREPARING, NULL);
+  cc_panel_push_subpage (CC_PANEL (self), preparing_page (self));
+}
+
+static void
+snapshot_response_cb (AdwAlertDialog *dialog, GAsyncResult *res, CcManUpdatesPanel *self)
+{
+  const char *response = adw_alert_dialog_choose_finish (dialog, res);
+
+  if (g_str_equal (response, "snapshot"))
+    start_install (self, TRUE);
+  else if (g_str_equal (response, "skip"))
+    start_install (self, FALSE);
+  g_object_unref (self);
+}
+
+static void
+install_clicked_cb (CcManUpdatesPanel *self, GtkWidget *button)
+{
+  AdwDialog *dialog = adw_alert_dialog_new (M_("Create a Snapshot First?"),
+                                            M_("A snapshot saves the current system, so you can go back to it if something does not work after the update. This is recommended."));
+
+  adw_alert_dialog_add_responses (ADW_ALERT_DIALOG (dialog),
+                                  "cancel", M_("_Cancel"),
+                                  "skip", M_("_Don't Create"),
+                                  "snapshot", M_("_Create Snapshot"),
+                                  NULL);
+  adw_alert_dialog_set_response_appearance (ADW_ALERT_DIALOG (dialog), "snapshot", ADW_RESPONSE_SUGGESTED);
+  adw_alert_dialog_set_default_response (ADW_ALERT_DIALOG (dialog), "snapshot");
+  adw_alert_dialog_set_close_response (ADW_ALERT_DIALOG (dialog), "cancel");
+  adw_alert_dialog_choose (ADW_ALERT_DIALOG (dialog), button, NULL, (GAsyncReadyCallback) snapshot_response_cb, g_object_ref (self));
+}
