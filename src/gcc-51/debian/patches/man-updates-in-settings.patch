+static JsonObject *
+target_obj (CcManUpdatesPanel *self)
+{
+  JsonObject *o = info_obj (self);
+  JsonArray *targets = o && json_object_has_member (o, "targets") ? json_object_get_array_member (o, "targets") : NULL;
+  guint i;
+
+  for (i = 0; targets && i < json_array_get_length (targets); i++)
+    {
+      JsonObject *t = json_array_get_object_element (targets, i);
+      if (g_strcmp0 (obj_str (t, "device"), self->device) == 0)
+        return t;
+    }
+  return NULL;
+}
+
+static AdwNavigationPage *
+confirm_page (CcManUpdatesPanel *self)
+{
+  JsonObject *m = manifest (self);
+  JsonObject *t = target_obj (self);
+  const char *name = obj_str (m, "name");
+  const char *version = obj_str (m, "version");
+  GtkWidget *page = adw_preferences_page_new ();
+  GtkWidget *summary = adw_preferences_group_new ();
+  GtkWidget *kept = adw_preferences_group_new ();
+  GtkWidget *replaced = adw_preferences_group_new ();
+  GtkWidget *restart = adw_preferences_group_new ();
+  GtkWidget *row;
+  GtkWidget *go = pill (M_("_Install Update"), TRUE);
+  g_autofree char *update = g_strdup_printf ("%s %s → %s %s", name, obj_str (info_obj (self), "current_version"), name, version);
+  g_autofree char *where = g_strdup_printf ("%s (%s)", obj_str (t, "model"), obj_str (t, "disk"));
+  g_autofree char *signer = fill (M_("Verified, signed by “{signer}”"), "signer", obj_str (info_obj (self), "signed_by"), NULL);
+  g_autofree char *space = g_format_size (obj_int (m, "installed_size"));
+  g_autofree char *os = fill (M_("Replaced by {name} {version}. The current system can be restored from a snapshot."), "name", name, "version", version, NULL);
+  static const char *kept_rows[][3] = {
+    { MN_("Your Files"), MN_("Everything in your Home folder"), "user-home-symbolic" },
+    { MN_("Accounts and Passwords"), MN_("Users, groups, the computer name"), "system-users-symbolic" },
+    { MN_("Connections and Settings"), MN_("Wi-Fi, time zone, keyboard, look and snapshots"), "emblem-system-symbolic" },
+    { MN_("Flatpak Apps"), MN_("Plus anything in /usr/local and /opt"), "application-x-addon-symbolic" },
+  };
+  guint i;
+
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (summary), M_("Summary"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (summary), info_row (M_("Update"), update, "software-update-available-symbolic"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (summary), info_row (M_("Installation"), where, "drive-harddisk-symbolic"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (summary), info_row (M_("Authenticity"), signer, "security-high-symbolic"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (summary), info_row (M_("Space Needed"), space, "drive-harddisk-symbolic"));
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (summary));
+
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (kept), M_("Kept"));
+  for (i = 0; i < G_N_ELEMENTS (kept_rows); i++)
+    {
+      row = adw_action_row_new ();
+      adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), M_(kept_rows[i][0]));
+      adw_action_row_set_subtitle (ADW_ACTION_ROW (row), M_(kept_rows[i][1]));
+      adw_action_row_add_prefix (ADW_ACTION_ROW (row), gtk_image_new_from_icon_name (kept_rows[i][2]));
+      adw_action_row_add_suffix (ADW_ACTION_ROW (row), gtk_image_new_from_icon_name ("object-select-symbolic"));
+      adw_preferences_group_add (ADW_PREFERENCES_GROUP (kept), row);
+    }
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (kept));
+
+  adw_preferences_group_set_title (ADW_PREFERENCES_GROUP (replaced), M_("Replaced"));
+  adw_preferences_group_set_description (ADW_PREFERENCES_GROUP (replaced), M_("Software installed with apt and other changes to system files are replaced by the new system."));
+  row = adw_action_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), M_("The Operating System"));
+  adw_action_row_set_subtitle (ADW_ACTION_ROW (row), os);
+  adw_action_row_add_prefix (ADW_ACTION_ROW (row), gtk_image_new_from_icon_name ("view-refresh-symbolic"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (replaced), row);
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (replaced));
+
+  row = adw_action_row_new ();
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), M_("The computer restarts to install the update"));
+  adw_action_row_set_subtitle (ADW_ACTION_ROW (row), M_("After preparing, MAN restarts, installs the update in a few seconds and restarts again."));
+  adw_action_row_add_prefix (ADW_ACTION_ROW (row), gtk_image_new_from_icon_name ("dialog-information-symbolic"));
+  adw_preferences_group_add (ADW_PREFERENCES_GROUP (restart), row);
+  adw_preferences_page_add (ADW_PREFERENCES_PAGE (page), ADW_PREFERENCES_GROUP (restart));
+
+  g_signal_connect_swapped (go, "clicked", G_CALLBACK (install_clicked_cb), self);
+  return subpage (M_("Ready to Install"), "confirm", page, bottom_bar (go, NULL), TRUE);
