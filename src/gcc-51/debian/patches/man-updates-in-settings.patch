+static AdwNavigationPage *
+failed_page (CcManUpdatesPanel *self)
+{
+  GtkWidget *status = adw_status_page_new ();
+  GtkWidget *again = pill (M_("_Try Again"), TRUE);
+  GtkWidget *details = pill (M_("_Show Details"), FALSE);
+  g_autofree char *desc = g_strdup_printf ("%s\n\n%s", job && job->error ? job->error : "", M_("Nothing was changed on your system."));
+  g_autofree char *escaped = g_markup_escape_text (desc, -1);
+
+  adw_status_page_set_icon_name (ADW_STATUS_PAGE (status), "dialog-error-symbolic");
+  adw_status_page_set_title (ADW_STATUS_PAGE (status), M_("The Update Could Not Be Prepared"));
+  adw_status_page_set_description (ADW_STATUS_PAGE (status), escaped);
+  g_signal_connect_swapped (again, "clicked", G_CALLBACK (try_again_cb), self);
+  g_signal_connect (details, "clicked", G_CALLBACK (show_details_cb), NULL);
+  return subpage (M_("Failed"), "failed", status, bottom_bar (details, again, NULL), TRUE);
+}
+
+static void
+show_prepare_result (CcManUpdatesPanel *self)
+{
+  self->prep_bar = NULL;
+  if (job->ok)
+    {
+      replace_top (self, ready_page (self));
+      set_state (self, STATE_RESTART, NULL);
+    }
+  else
+    {
+      GtkWidget *nav = gtk_widget_get_ancestor (GTK_WIDGET (self), ADW_TYPE_NAVIGATION_VIEW);
+
+      /* Back to the summary, with the failure on top of it. */
+      if (!nav || !adw_navigation_view_pop_to_tag (ADW_NAVIGATION_VIEW (nav), "confirm"))
+        pop_subpages (self);
+      cc_panel_push_subpage (CC_PANEL (self), failed_page (self));
+      set_state (self, STATE_AVAILABLE, NULL);
+    }
+}
