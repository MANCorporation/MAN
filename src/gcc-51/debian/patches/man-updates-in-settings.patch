+/* Fill "{key}" placeholders (MAN Update's string style): fill (t, "k", "v", …, NULL). */
+static char *
+fill (const char *tmpl, ...)
+{
+  g_autoptr(GString) s = g_string_new (tmpl);
+  const char *key;
+  va_list ap;
+
+  va_start (ap, tmpl);
+  while ((key = va_arg (ap, const char *)) != NULL)
+    {
+      const char *value = va_arg (ap, const char *);
+      g_autofree char *needle = g_strdup_printf ("{%s}", key);
+      g_string_replace (s, needle, value ? value : "", 0);
+    }
+  va_end (ap);
+  return g_string_free (g_steal_pointer (&s), FALSE);
+}
+
+static const char *
+obj_str (JsonObject *o, const char *member)
+{
+  JsonNode *n = o ? json_object_get_member (o, member) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_STRING ? json_node_get_string (n) : "";
+}
+
+static gint64
+obj_int (JsonObject *o, const char *member)
+{
+  JsonNode *n = o ? json_object_get_member (o, member) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) ? json_node_get_int (n) : 0;
+}
+
+static gboolean
+obj_bool (JsonObject *o, const char *member)
+{
+  JsonNode *n = o ? json_object_get_member (o, member) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_boolean (n);
+}
