+/* ─────────────────────────── restart / failed pages ─────────────────────────── */
+
+static void
+reboot_now (void)
+{
+  g_autoptr(GSubprocess) p = g_subprocess_new (G_SUBPROCESS_FLAGS_NONE, NULL, "systemctl", "reboot", NULL);
+}
+
+static void
+stop_countdown (CcManUpdatesPanel *self)
+{
+  g_clear_handle_id (&self->countdown_id, g_source_remove);
+}
+
+static gboolean
+countdown_tick (gpointer user_data)
+{
+  CcManUpdatesPanel *self = user_data;
+  g_autofree char *r = NULL;
+  g_autofree char *text = NULL;
+
+  if (--self->countdown == 0)
+    {
+      self->countdown_id = 0;
+      reboot_now ();
+      return G_SOURCE_REMOVE;
+    }
+  r = g_strdup_printf ("%u", self->countdown);
+  text = fill (M_("Restarting automatically in {r} seconds"), "r", r, NULL);
+  gtk_label_set_text (GTK_LABEL (self->countdown_label), text);
+  return G_SOURCE_CONTINUE;
+}
