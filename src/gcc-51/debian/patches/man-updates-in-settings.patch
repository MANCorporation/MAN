+static AdwNavigationPage *
+ready_page (CcManUpdatesPanel *self)
+{
+  GtkWidget *status = adw_status_page_new ();
+  GtkWidget *now = pill (M_("_Restart Now"), TRUE);
+  GtkWidget *later = pill (M_("Restart _Later"), FALSE);
+  g_autofree char *desc = g_strdup_printf ("%s\n%s", job && job->message ? job->message : "", M_("The computer restarts twice. Your files are safe."));
+  AdwNavigationPage *page;
+
+  adw_status_page_set_icon_name (ADW_STATUS_PAGE (status), "system-reboot-symbolic");
+  adw_status_page_set_title (ADW_STATUS_PAGE (status), M_("Restart to Install"));
+  adw_status_page_set_description (ADW_STATUS_PAGE (status), desc);
+  self->countdown_label = gtk_label_new (NULL);
+  gtk_widget_add_css_class (self->countdown_label, "dim-label");
+  g_signal_connect_swapped (now, "clicked", G_CALLBACK (reboot_now), NULL);
+  g_signal_connect_swapped (later, "clicked", G_CALLBACK (restart_later_cb), self);
+  page = subpage (M_("Ready"), "ready", status, bottom_bar (self->countdown_label, later, now, NULL), FALSE);
+
+  /* Restart automatically after a short countdown, unless postponed. */
+  stop_countdown (self);
+  self->countdown = 31;
+  countdown_tick (self);
+  self->countdown_id = g_timeout_add_seconds (1, countdown_tick, self);
+  return page;
+}
