+/* ───────────────────── preparing the update (outlives the panel) ───────────────────── */
+
+/* Weight of each backend step in the overall progress bar (as MAN Update). */
+static const double WEIGHTS[] = { 2, 3, 2, 70, 8, 15 };
+
+typedef struct {
+  GSubprocess      *proc;
+  GDataInputStream *out;
+  char             *name;      /* "MAN" */
+  char             *version;   /* "10.9" */
+  char             *step;
+  char             *detail;
+  double            fraction;
+  guint             current;
+  GString          *log;
+  gboolean          done;
+  gboolean          ok;
+  char             *message;
+  char             *error;
+  char             *error_detail;
+  GWeakRef          panel;
+} StageJob;
+
+static StageJob *job;
+
+static void show_prepare_result (CcManUpdatesPanel *self);
+
+static void
+job_refresh (CcManUpdatesPanel *self)
+{
+  if (!job || !self->prep_bar)
+    return;
+  gtk_label_set_text (GTK_LABEL (self->prep_step), job->step ? job->step : M_("Starting…"));
+  gtk_label_set_text (GTK_LABEL (self->prep_detail), job->detail ? job->detail : "");
+  gtk_progress_bar_set_fraction (GTK_PROGRESS_BAR (self->prep_bar), job->fraction);
+  gtk_text_buffer_set_text (self->prep_log, job->log->str, -1);
+}
+
+static void
+job_finished (void)
+{
+  g_autoptr(CcManUpdatesPanel) self = g_weak_ref_get (&job->panel);
+
+  job->done = TRUE;
+  if (self)
+    {
+      show_prepare_result (self);
+      return;
+    }
+  /* The panel was closed: tell the user with a notification. */
+  if (job->ok && g_application_get_default ())
+    {
+      g_autoptr(GNotification) n = g_notification_new (M_("Restart to Install"));
+
+      g_notification_set_body (n, M_("The update is installed the next time you restart."));
+      g_notification_set_icon (n, G_ICON (g_themed_icon_new ("com.man.Updater")));
+      g_application_send_notification (g_application_get_default (), "man-update-ready", n);
+    }
+}
+
+static void
+job_wait_cb (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  int status;
+
+  g_subprocess_wait_finish (G_SUBPROCESS (source), res, NULL);
+  status = g_subprocess_get_if_exited (job->proc) ? g_subprocess_get_exit_status (job->proc) : -1;
+  if (!job->ok && !job->error)
+    {
+      /* pkexec: 126 = authorization dismissed, 127 = not authorized. */
+      if (status == 126 || status == 127)
+        {
+          job->error = g_strdup (M_("Authorization was cancelled."));
+          job->error_detail = g_strdup (M_("Administrator rights are needed for this action."));
+        }
+      else
+        {
+          job->error = g_strdup (M_("The system helper stopped unexpectedly."));
+          job->error_detail = g_strdup_printf ("Exit status %d", status);
+        }
+    }
+  job_finished ();
+}
+
+static void
+job_read_cb (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr(GError) error = NULL;
+  g_autofree char *line = g_data_input_stream_read_line_finish_utf8 (G_DATA_INPUT_STREAM (source), res, NULL, &error);
+  g_autoptr(JsonParser) parser = NULL;
+  g_autoptr(CcManUpdatesPanel) self = NULL;
+  JsonObject *ev;
+  const char *type;
+  double total = 0;
+  guint i;
+
+  if (!line)
+    {
+      g_subprocess_wait_async (job->proc, NULL, job_wait_cb, NULL);
+      return;
+    }
+
+  parser = json_parser_new ();
+  if (json_parser_load_from_data (parser, line, -1, NULL) && JSON_NODE_HOLDS_OBJECT (json_parser_get_root (parser)))
+    {
+      ev = json_node_get_object (json_parser_get_root (parser));
+      type = obj_str (ev, "type");
+      for (i = 0; i < G_N_ELEMENTS (WEIGHTS); i++)
+        total += WEIGHTS[i];
+
+      if (g_str_equal (type, "step"))
+        {
+          g_autofree char *index = g_strdup_printf ("%" G_GINT64_FORMAT, obj_int (ev, "index"));
+          g_autofree char *n = g_strdup_printf ("%" G_GINT64_FORMAT, obj_int (ev, "total"));
+          double before = 0;
+
+          job->current = MIN ((guint) MAX (obj_int (ev, "index") - 1, 0), G_N_ELEMENTS (WEIGHTS) - 1);
+          for (i = 0; i < job->current; i++)
+            before += WEIGHTS[i];
+          g_free (job->step);
+          job->step = fill (M_("Step {index} of {n}  ·  {title}"), "index", index, "n", n, "title", m_tr (obj_str (ev, "title")), NULL);
+          g_clear_pointer (&job->detail, g_free);
+          job->fraction = before / total;
+        }
+      else if (g_str_equal (type, "progress"))
+        {
+          double before = 0;
+
+          for (i = 0; i < job->current; i++)
+            before += WEIGHTS[i];
+          job->fraction = (before + WEIGHTS[job->current] * json_object_get_double_member_with_default (ev, "fraction", 0)) / total;
+          g_free (job->detail);
+          job->detail = g_strdup (m_tr (obj_str (ev, "detail")));
+        }
+      else if (g_str_equal (type, "log"))
+        {
+          g_string_append (job->log, obj_str (ev, "line"));
+          g_string_append_c (job->log, '\n');
+        }
+      else if (g_str_equal (type, "done"))
+        {
+          job->ok = TRUE;
+          job->message = g_strdup (m_tr (obj_str (ev, "message")));
+        }
+      else if (g_str_equal (type, "error"))
+        {
+          job->error = g_strdup (m_tr (obj_str (ev, "message")));
+          job->error_detail = g_strdup (obj_str (ev, "detail"));
+        }
+    }
+
+  self = g_weak_ref_get (&job->panel);
+  if (self)
+    job_refresh (self);
+  g_data_input_stream_read_line_async (job->out, G_PRIORITY_DEFAULT, NULL, job_read_cb, NULL);
+}
+
+static void
+job_free (void)
+{
+  if (!job)
+    return;
+  g_clear_object (&job->proc);
+  g_clear_object (&job->out);
+  g_free (job->name);
+  g_free (job->version);
+  g_free (job->step);
+  g_free (job->detail);
+  g_string_free (job->log, TRUE);
+  g_free (job->message);
+  g_free (job->error);
+  g_free (job->error_detail);
+  g_weak_ref_clear (&job->panel);
+  g_clear_pointer (&job, g_free);
+}
+
+static gboolean
+job_start (CcManUpdatesPanel *self, gboolean snapshot, GError **error)
+{
+  g_autoptr(JsonBuilder) b = json_builder_new ();
+  g_autoptr(JsonGenerator) gen = json_generator_new ();
+  g_autoptr(JsonNode) root = NULL;
+  g_autofree char *request = NULL;
+  g_autoptr(GBytes) input = NULL;
+  GOutputStream *in;
+
+  json_builder_begin_object (b);
+  json_builder_set_member_name (b, "op");
+  json_builder_add_string_value (b, "update_stage");
+  json_builder_set_member_name (b, "path");
+  json_builder_add_string_value (b, self->file);
+  json_builder_set_member_name (b, "device");
+  json_builder_add_string_value (b, self->device ? self->device : "");
+  json_builder_set_member_name (b, "snapshot");
+  json_builder_add_boolean_value (b, snapshot);
+  json_builder_end_object (b);
+  root = json_builder_get_root (b);
+  json_generator_set_root (gen, root);
+  request = json_generator_to_data (gen, NULL);
+
+  job_free ();
+  job = g_new0 (StageJob, 1);
+  job->log = g_string_new (NULL);
+  job->name = g_strdup (obj_str (manifest (self), "name"));
+  job->version = g_strdup (obj_str (manifest (self), "version"));
+  g_weak_ref_init (&job->panel, self);
+  job->proc = g_subprocess_new (G_SUBPROCESS_FLAGS_STDIN_PIPE | G_SUBPROCESS_FLAGS_STDOUT_PIPE | G_SUBPROCESS_FLAGS_STDERR_SILENCE,
+                                error, "pkexec", BACKEND, "request", NULL);
+  if (!job->proc)
+    {
+      job_free ();
+      return FALSE;
+    }
+  in = g_subprocess_get_stdin_pipe (job->proc);
+  g_output_stream_write_all (in, request, strlen (request), NULL, NULL, NULL);
+  g_output_stream_close (in, NULL, NULL);
+  job->out = g_data_input_stream_new (g_subprocess_get_stdout_pipe (job->proc));
+  g_data_input_stream_read_line_async (job->out, G_PRIORITY_DEFAULT, NULL, job_read_cb, NULL);
+  return TRUE;
+}
