+
+static void
+inspect_done_cb (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  CcManUpdatesPanel *self;
+  g_autoptr(GError) error = NULL;
+  g_autofree char *out = NULL;
+  g_auto(GStrv) lines = NULL;
+  const char *message = NULL;
+  JsonNode *info = NULL;
+  guint i;
+
+  if (!g_subprocess_communicate_utf8_finish (G_SUBPROCESS (source), res, &out, NULL, &error) &&
+      g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+  self = CC_MAN_UPDATES_PANEL (user_data);
+  lines = g_strsplit (out ? out : "", "\n", -1);
+  for (i = 0; lines[i]; i++)
+    {
+      g_autoptr(JsonParser) p = json_parser_new ();
+      JsonObject *ev;
+
+      if (!json_parser_load_from_data (p, lines[i], -1, NULL) || !JSON_NODE_HOLDS_OBJECT (json_parser_get_root (p)))
+        continue;
+      ev = json_node_get_object (json_parser_get_root (p));
+      if (g_str_equal (obj_str (ev, "type"), "update") && json_object_has_member (ev, "info"))
+        {
+          g_clear_pointer (&info, json_node_unref);
+          info = json_node_copy (json_object_get_member (ev, "info"));
+        }
+      else if (g_str_equal (obj_str (ev, "type"), "error"))
