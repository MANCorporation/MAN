+/// Follows the libraries file: what the Marquee app saves is shared within seconds.
+fn watch(state: Arc<Mutex<State>>) {
+    std::thread::spawn(move || {
+        let mut seen = modified();
+        loop {
+            std::thread::sleep(Duration::from_secs(2));
+            let now = modified();
+            if now != seen {
+                seen = now;
+                *state.lock().unwrap() = load();
+            }
+        }
+    });
 }
 
