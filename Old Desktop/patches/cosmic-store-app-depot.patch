diff --git a/src/backend/flatpak.rs b/src/backend/flatpak.rs
--- a/src/backend/flatpak.rs
+++ b/src/backend/flatpak.rs
@@ -279,3 +279,29 @@ impl Backend for Flatpak {
             .await
         });
+
+        // Fall back to Flathub's compact remote summary when its AppStream
+        // cache cannot be stored, instead of presenting an empty depot.
+        for cache in self.appstream_caches.iter_mut() {
+            if !cache.infos.is_empty() { continue; }
+            let source = cache.source_id.replace(" (system)", "");
+            let Ok(output) = std::process::Command::new("flatpak")
+                .args(["remote-ls", if self.user { "--user" } else { "--system" },
+                    "--columns=application,name,description,branch,arch", &source])
+                .output() else { continue; };
+            if !output.status.success() { continue; }
+            for line in String::from_utf8_lossy(&output.stdout).lines() {
+                let fields: Vec<_> = line.split('\t').collect();
+                if fields.len() != 5 || fields[0].is_empty() { continue; }
+                let id = AppId::new(fields[0]);
+                cache.infos.insert(id, Arc::new(AppInfo {
+                    source_id: cache.source_id.clone(),
+                    source_name: cache.source_name.clone(),
+                    name: if fields[1].is_empty() { fields[0].to_string() } else { fields[1].to_string() },
+                    summary: fields[2].to_string(),
+                    flatpak_refs: vec![format!("app/{}/{}/{}", fields[0], fields[4], fields[3])],
+                    ..Default::default()
+                }));
+            }
+        }
+
         Ok(())
     }
