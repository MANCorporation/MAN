msgstr "Prilagođene particije"

#: installer.rs:1005
msgid "Reinstall, keeping /home"
msgstr "Ponovo instaliraj, zadrži /home"

#: installer.rs:1006
msgid "Alongside Windows"
msgstr "Uz Windows"

#: installer.rs:1012
