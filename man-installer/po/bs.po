msgstr "{partition} (bit će formatirana)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Particija za pokretanje"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Prostor za MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} slobodnog prostora (stvaraju se particija za pokretanje i sistemska particija)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Bez promjena. Pojavljuje se u izborniku pokretanja MAN-a; EFI sistemska particija je zajednička."

#: installer.rs:983
msgid "Encryption"
msgstr "Šifriranje"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Uključeno (LUKS2)"

#: installer.rs:983
msgid "Off"
