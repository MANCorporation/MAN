#: installer.rs:985
msgid "File System"
msgstr "Fajl sistem"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system za MAN, @home za vaše datoteke, @snapshots za tačke vraćanja. Svi dijele slobodan prostor."

#: installer.rs:991
msgid "System"
msgstr "Sistem"

#: installer.rs:993
msgid "Your Account"
msgstr "Vaš račun"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Stvara se u MAN Setupu pri prvom pokretanju računara, zajedno s nazivom računara, izgledom i postavkama privatnosti."

#: installer.rs:998
msgid "Keyboard"
msgstr "Tastatura"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "Svi podaci na {model} ({path}) bit će obrisani."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Obriši i instaliraj"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Odabrane particije bit će formatirane. Ostale particije se ne mijenjaju."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Formatiraj i instaliraj"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "Trenutni sistem se zamjenjuje. Vaše datoteke u /home se zadržavaju, a stari sistem čuva se kao snimka."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "_Ponovo instaliraj"

#: installer.rs:1005
