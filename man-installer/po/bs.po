msgid "Website"
msgstr "Web stranica"

#: appinstaller.rs:902
msgid "File"
msgstr "Datoteka"

#: appinstaller.rs:912
msgid "This app is installed already. Installing it again replaces it."
msgstr "Ova aplikacija je već instalirana. Ponovna instalacija je zamjenjuje."

#: appinstaller.rs:915
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr "Aplikacije iz .deb paketa postaju dio sistema. MAN ažuriranje zamjenjuje sistem, pa se nakon ažuriranja ponovo instaliraju samo ako ih zadržite (sljedeći koraci)."

#: appinstaller.rs:918
msgid "Only install apps from sources you trust."
msgstr "Instalirajte samo aplikacije iz izvora kojima vjerujete."

#: appinstaller.rs:924
msgid "Where do you want to install {name}?"
msgstr "Gdje želite instalirati {name}?"

#: appinstaller.rs:929
msgid "Only your account can use the app."
msgstr "Samo vaš račun može koristiti aplikaciju."

#: appinstaller.rs:930
msgid "Needs administrator rights."
msgstr "Potrebna su administratorska prava."

#: appinstaller.rs:937
msgid "Only for Me"
msgstr "Samo za mene"

#: appinstaller.rs:937
msgid "For All Users of This Computer"
msgstr "Za sve korisnike ovog računara"

#: appinstaller.rs:952
msgid "This will take {size} of space on your computer."
msgstr "Ovo će zauzeti {size} prostora na računaru."

#: appinstaller.rs:954
msgid "The app is downloaded from {source}."
msgstr "Aplikacija se preuzima sa {source}."

#: appinstaller.rs:956
msgid "The app is installed for all users of this computer."
msgstr "Aplikacija se instalira za sve korisnike ovog računara."

#: appinstaller.rs:956
msgid "The app is installed only for you."
msgstr "Aplikacija se instalira samo za vas."

#: appinstaller.rs:959
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage se premješta u {folder} i dodaje među vaše aplikacije."

#: appinstaller.rs:965
msgid "Keep After MAN Updates"
msgstr "Zadrži nakon MAN ažuriranja"

#: appinstaller.rs:966
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "MAN ponovo instalira aplikaciju nakon svakog ažuriranja. Za to se čuvaju njene paketne datoteke."

#: appinstaller.rs:974
msgid "Click Install to install {name}."
msgstr "Kliknite Instaliraj da biste instalirali {name}."

#: appinstaller.rs:980
msgid "Checking what else the app needs…"
msgstr "Provjera šta još aplikacija treba…"

#: appinstaller.rs:990
msgid "Also installs the packages it needs: {list}"
msgstr "Instalira i potrebne pakete: {list}"

#: appinstaller.rs:996
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Neki paketi potrebni aplikaciji još nisu dostupni. Instalacija prvo preuzima najnovije liste paketa; ako i dalje nedostaju, aplikacija se ne može instalirati."

#: appinstaller.rs:1057
msgid "Installing {name}…"
msgstr "Instaliranje aplikacije {name}…"

#: appinstaller.rs:1063
msgid "Preparing…"
msgstr "Priprema…"

#: appinstaller.rs:1070
msgid "Details"
msgstr "Pojedinosti"

#: appinstaller.rs:1110
msgid "Installing the package…"
msgstr "Instaliranje paketa…"

#: appinstaller.rs:1129
msgid "Moving the app to its folder…"
msgstr "Premještanje aplikacije u njenu fasciklu…"

#: appinstaller.rs:1138
msgid "The app could not be installed."
msgstr "Aplikacija se ne može instalirati."

#: appinstaller.rs:1142
msgid "Installing the app with Flatpak…"
msgstr "Instaliranje aplikacije pomoću Flatpaka…"

#: appinstaller.rs:1166
msgid "Log"
msgstr "Zapis"

#: appinstaller.rs:1196
msgid "_Close"
msgstr "_Zatvori"

#: appinstaller.rs:1206
msgid "The Installation Was Successful"
msgstr "Instalacija je uspjela"

#: appinstaller.rs:1206
msgid "The app was installed."
msgstr "Aplikacija je instalirana."

#: appinstaller.rs:1211
msgid "The Installation Failed"
msgstr "Instalacija nije uspjela"

#: appinstaller.rs:1222
msgid "_Open"
msgstr "_Otvori"

#: appinstaller.rs:1232
msgid "_Show Details"
msgstr "_Prikaži pojedinosti"

#: appinstaller.rs:1235
msgid "Installation Log"
msgstr "Zapis instalacije"

#: appinstaller.rs:1262
msgid "App Installer"
msgstr "Instalater aplikacija"

#: appinstaller.rs:1283
msgid "Go _Back"
msgstr "_Nazad"

#: appinstaller.rs:1356
msgid "Reading the app…"
msgstr "Čitanje aplikacije…"

#: appinstaller.rs:1365
msgid "Install {name}"
msgstr "Instaliraj {name}"

#: appinstaller.rs:1384
msgid "Apps"
msgstr "Aplikacije"

#: appinstaller.rs:1390
msgid "Choose an App to Install"
msgstr "Odaberite aplikaciju za instalaciju"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "Sistemski pomoćnik ne može se pokrenuti."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "Nije moguće komunicirati sa sistemskim pomoćnikom."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Veza sa sistemskim pomoćnikom je prekinuta."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Ovjera je otkazana."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Za ovu radnju potrebna su administratorska prava."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "Sistemski pomoćnik neočekivano se zaustavio."

#: installer.rs:89
msgid "No EFI system partition"
msgstr "Nema EFI sistemske particije"

#: installer.rs:93
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Slobodno je samo {free}, MAN treba {need}. Oslobodite prostor pomoću DUHACH! u Windowsima."

#: installer.rs:94
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Nema slobodnog prostora. Pokrenite DUHACH! u Windowsima i oslobodite prostor za MAN."

#: installer.rs:103
msgid "MAN is running from this disk"
msgstr "MAN se pokreće s ovog diska"

#: installer.rs:107
msgid "In use: a partition is mounted"
msgstr "U upotrebi: particija je montirana"

#: installer.rs:109
msgid "Too small, MAN needs {need}"
msgstr "Premalen, MAN treba {need}"

#: installer.rs:119
msgid "Install MAN"
msgstr "Instaliraj MAN"

#: installer.rs:137
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN se instalira. Sačekajte da završi."

#: installer.rs:154
msgid "Language"
msgstr "Jezik"

#: installer.rs:166
msgid "_Restart in This Language"
msgstr "_Ponovo pokreni na ovom jeziku"

#: installer.rs:178
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Živa sesija ponovo se pokreće na odabranom jeziku, a MAN se instalira na njemu."

#: installer.rs:224
msgid "Welcome to MAN"
msgstr "Dobro došli u MAN"

#: installer.rs:225
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Brz, otvoren i potpuno prilagodljiv GNOME sistem.\n"
"Instalirajte ga na ovaj računar ili nastavite istraživati živu sesiju."

#: installer.rs:229
msgid "_Install MAN…"
msgstr "_Instaliraj MAN…"

#: installer.rs:231
msgid "_Keep Trying MAN"
msgstr "_Nastavi isprobavati MAN"

#: installer.rs:234
msgid "Looking for disks…"
msgstr "Traženje diskova…"

#: installer.rs:261
msgid "Welcome"
msgstr "Dobro došli"

#: installer.rs:276
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Ovaj računar je pokrenut u starom BIOS načinu. MAN se može instalirati samo na UEFI računare: ponovo pokrenite i odaberite UEFI mogućnost pokretanja."

#: installer.rs:294
msgid "The system helper returned no disk information."
msgstr "Sistemski pomoćnik nije vratio podatke o diskovima."

#: installer.rs:372
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:380
msgid "_Next"
msgstr "_Dalje"

#: installer.rs:388
msgid "Erase Disk and Install MAN"
msgstr "Obriši disk i instaliraj MAN"

#: installer.rs:389
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Sve na odabranom disku bit će obrisano, uključujući Windows."

#: installer.rs:389
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Preporučeno. Sve na odabranom disku bit će obrisano."

#: installer.rs:393
msgid "Install Alongside Windows"
msgstr "Instaliraj uz Windows"

#: installer.rs:394
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Preporučeno. MAN koristi slobodan prostor uz Windows; Windows i njegove datoteke ostaju. Sistem birate pri svakom pokretanju."

#: installer.rs:401
msgid "Reinstall MAN"
msgstr "Ponovo instaliraj MAN"

#: installer.rs:402
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Zamjenjuje sistem, ali zadržava osobne datoteke u /home. Trenutni sistem čuva se kao snimka."

#: installer.rs:407
msgid "Custom Partitions"
msgstr "Prilagođene particije"

#: installer.rs:407
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Za stručnjake: sami odaberite particije ili ih stvorite pomoću Diskova."

#: installer.rs:418
msgid "Erase an External Disk and Install MAN"
msgstr "Obriši vanjski disk i instaliraj MAN"

#: installer.rs:419
msgid "Everything on the chosen external disk is deleted. The Mac's internal disk is not shown and not changed."
msgstr "Sve na odabranom vanjskom disku se briše. Unutrašnji disk Maca se ne prikazuje i ne mijenja."

#: installer.rs:420
msgid "Install on This Mac"
msgstr "Instaliraj na ovaj Mac"

#: installer.rs:422
msgid "Recommended. Into the {size} prepared in macOS. macOS and its partitions are not changed."
msgstr "Preporučeno. U {size} pripremljenih u macOS-u. macOS i njegove particije se ne mijenjaju."

#: installer.rs:427
msgid "No space for MAN was prepared yet. In macOS, run MAN-Mac/install-man.sh from the MAN USB stick and choose “MAN boot loader + space for MAN”."
msgstr "Prostor za MAN još nije pripremljen. U macOS-u pokrenite MAN-Mac/install-man.sh s MAN USB sticka i odaberite “MAN boot loader + space for MAN”."

#: installer.rs:433
msgid "Disk"
msgstr "Disk"

#: installer.rs:433
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Odaberite disk koji će se obrisati. Diskovi koji se ne mogu koristiti prikazani su s razlogom."

#: installer.rs:459
msgid "No disks were found"
msgstr "Nisu pronađeni diskovi"

#: installer.rs:466
msgid "Free Space Next to Windows"
msgstr "Slobodan prostor uz Windows"

#: installer.rs:467
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Particije Windowsa ostaju netaknute. MAN dijeli EFI sistemsku particiju i dodaje Windows u svoj izbornik pokretanja."

#: installer.rs:473
msgid "{size} free"
msgstr "{size} slobodno"

#: installer.rs:473
msgid "no free space"
msgstr "nema slobodnog prostora"

#: installer.rs:478
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:497
msgid "Installation to Replace"
msgstr "Instalacija za zamjenu"

#: installer.rs:518
msgid "no home folders"
msgstr "nema osobnih mapa"

#: installer.rs:520
msgid "home folders: {list}"
msgstr "osobne mape: {list}"

#: installer.rs:522
msgid "snapshots: {n}"
msgstr "snimke: {n}"

#: installer.rs:526
msgid "MAN on {model}"
msgstr "MAN na {model}"

#: installer.rs:540
msgid "Passphrase for {device}"
msgstr "Lozinka za {device}"

#: installer.rs:541
msgid "Unlock"
msgstr "Otključaj"

#: installer.rs:578
msgid "The installation could not be inspected."
msgstr "Instalacija se nije mogla pregledati."

#: installer.rs:595
msgid "Partitions"
msgstr "Particije"

#: installer.rs:596
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Sistemska particija formatira se u Btrfs i sadrži @system, @home i @snapshots. Particije na disku s kojeg se MAN pokreće nisu prikazane."

#: installer.rs:598
msgid "Open Disks to create or resize partitions"
msgstr "Otvori Diskove za stvaranje ili promjenu veličine particija"

#: installer.rs:600
msgid "Refresh the partition list"
msgstr "Osvježi popis particija"

#: installer.rs:608
msgid "Choose a partition"
msgstr "Odaberite particiju"

#: installer.rs:620
msgid "EFI System Partition"
msgstr "EFI sistemska particija"

#: installer.rs:621
msgid "Format EFI System Partition"
msgstr "Formatiraj EFI sistemsku particiju"

#: installer.rs:621
msgid "Leave off to keep boot loaders of other systems"
msgstr "Ostavite isključeno da biste zadržali pokretače drugih sistema"

#: installer.rs:623
msgid "System Partition (formatted as Btrfs)"
msgstr "Sistemska particija (formatira se u Btrfs)"

#: installer.rs:624
msgid "Boot Partition (needed with encryption)"
msgstr "Particija za pokretanje (potrebna za šifriranje)"

#: installer.rs:683
msgid "Partition list refreshed"
msgstr "Popis particija je osvježen"

#: installer.rs:691
msgid "Security"
msgstr "Sigurnost"

#: installer.rs:693
msgid "Encrypt the System"
msgstr "Šifriraj sistem"

#: installer.rs:694
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Štiti vaše podatke ako se računar izgubi ili ukrade. Lozinka se traži pri svakom pokretanju."

#: installer.rs:697
msgid "Passphrase"
msgstr "Lozinka"

#: installer.rs:698
msgid "Confirm Passphrase"
msgstr "Potvrdi lozinku"

#: installer.rs:700
msgid "Keep this passphrase safe"
msgstr "Čuvajte ovu lozinku na sigurnom"

#: installer.rs:701
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Ako je izgubite, niko neće moći vratiti podatke. Jezgra i datoteke za pokretanje ostaju na maloj nešifriranoj particiji za pokretanje."

#: installer.rs:774
msgid "The passphrase needs at least 8 characters."
msgstr "Lozinka mora imati najmanje 8 znakova."

#: installer.rs:776
msgid "The passphrases do not match."
msgstr "Lozinke se ne podudaraju."

#: installer.rs:790
msgid "Choose a disk."
msgstr "Odaberite disk."

#: installer.rs:800
msgid "Choose the disk with Windows."
msgstr "Odaberite disk s Windowsima."

#: installer.rs:809
msgid "Choose the installation to replace."
msgstr "Odaberite instalaciju za zamjenu."

#: installer.rs:810
msgid "Unlock the encrypted installation first."
msgstr "Najprije otključajte šifriranu instalaciju."

#: installer.rs:811
msgid "This partition holds no MAN system."
msgstr "Ova particija ne sadrži sistem MAN."

#: installer.rs:818
msgid "Choose an EFI system partition."
msgstr "Odaberite EFI sistemsku particiju."

#: installer.rs:820
msgid "Choose the system partition."
msgstr "Odaberite sistemsku particiju."

#: installer.rs:822
msgid "The EFI and system partitions must be different."
msgstr "EFI i sistemska particija moraju biti različite."

#: installer.rs:824
msgid "Encryption needs a separate boot partition."
msgstr "Šifriranje zahtijeva zasebnu particiju za pokretanje."

#: installer.rs:833
msgid "The system partition must be at least {size}."
msgstr "Sistemska particija mora imati najmanje {size}."

#: installer.rs:835
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI particija nije formatirana u FAT; uključite formatiranje."

#: installer.rs:837
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Sistemska particija je montirana; najprije je odmontirajte u Diskovima."

#: installer.rs:859
msgid "Where Should MAN Be Installed?"
msgstr "Gdje instalirati MAN?"

