msgid "The installation could not be inspected."
msgstr "Instalacija se nije mogla pregledati."

#: installer.rs:554
msgid "Partitions"
msgstr "Particije"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Sistemska particija formatira se u Btrfs i sadrži @system, @home i @snapshots. Particije na disku s kojeg se MAN pokreće nisu prikazane."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Otvori Diskove za stvaranje ili promjenu veličine particija"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Osvježi popis particija"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Odaberite particiju"

