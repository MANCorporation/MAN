#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Ova datoteka nije aplikacija koja se ovdje može instalirati (.deb, .flatpak, .flatpakref ili AppImage)."

#: appinstaller.rs:134
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Ova aplikacija je napravljena za {arch} računare i ne radi na ovom (x86-64)."

#: appinstaller.rs:320
msgid "The file could not be read. It may be damaged."
msgstr "Datoteka se ne može pročitati. Možda je oštećena."

