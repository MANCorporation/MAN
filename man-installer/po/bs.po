msgstr "Web stranica"

#: appinstaller.rs:893
msgid "File"
msgstr "Datoteka"

#: appinstaller.rs:903
msgid "This app is installed already. Installing it again replaces it."
msgstr "Ova aplikacija je već instalirana. Ponovna instalacija je zamjenjuje."

#: appinstaller.rs:906
msgid "Apps from .deb packages become part of the system. When MAN is updated they are removed and need to be installed again. Flatpak apps and AppImages are kept."
msgstr "Aplikacije iz .deb paketa postaju dio sistema. Kada se MAN ažurira, one se uklanjaju i moraju se ponovo instalirati. Flatpak aplikacije i AppImage datoteke ostaju."

#: appinstaller.rs:909
msgid "Only install apps from sources you trust."
msgstr "Instalirajte samo aplikacije iz izvora kojima vjerujete."

#: appinstaller.rs:915
msgid "Where do you want to install {name}?"
msgstr "Gdje želite instalirati {name}?"

#: appinstaller.rs:920
msgid "Only your account can use the app."
msgstr "Samo vaš račun može koristiti aplikaciju."

#: appinstaller.rs:921
msgid "Needs administrator rights."
msgstr "Potrebna su administratorska prava."

#: appinstaller.rs:928
msgid "Only for Me"
msgstr "Samo za mene"

#: appinstaller.rs:928
msgid "For All Users of This Computer"
msgstr "Za sve korisnike ovog računara"

#: appinstaller.rs:943
msgid "This will take {size} of space on your computer."
msgstr "Ovo će zauzeti {size} prostora na računaru."

#: appinstaller.rs:945
msgid "The app is downloaded from {source}."
msgstr "Aplikacija se preuzima sa {source}."

#: appinstaller.rs:947
msgid "The app is installed for all users of this computer."
msgstr "Aplikacija se instalira za sve korisnike ovog računara."

#: appinstaller.rs:947
msgid "The app is installed only for you."
msgstr "Aplikacija se instalira samo za vas."

#: appinstaller.rs:950
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage se premješta u {folder} i dodaje među vaše aplikacije."

#: appinstaller.rs:952
msgid "Click Install to install {name}."
msgstr "Kliknite Instaliraj da biste instalirali {name}."

#: appinstaller.rs:958
msgid "Checking what else the app needs…"
msgstr "Provjera šta još aplikacija treba…"

#: appinstaller.rs:968
msgid "Also installs the packages it needs: {list}"
msgstr "Instalira i potrebne pakete: {list}"

#: appinstaller.rs:974
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Neki paketi potrebni aplikaciji još nisu dostupni. Instalacija prvo preuzima najnovije liste paketa; ako i dalje nedostaju, aplikacija se ne može instalirati."

#: appinstaller.rs:1035
msgid "Installing {name}…"
msgstr "Instaliranje aplikacije {name}…"

#: appinstaller.rs:1041
msgid "Preparing…"
msgstr "Priprema…"

#: appinstaller.rs:1048
msgid "Details"
