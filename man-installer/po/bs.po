msgid "EFI System Partition"
msgstr "EFI sistemska particija"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Formatiraj EFI sistemsku particiju"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Ostavite isključeno da biste zadržali pokretače drugih sistema"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Sistemska particija (formatira se u Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Particija za pokretanje (potrebna za šifriranje)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Popis particija je osvježen"

#: installer.rs:650
msgid "Security"
msgstr "Sigurnost"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Šifriraj sistem"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Štiti vaše podatke ako se računar izgubi ili ukrade. Lozinka se traži pri svakom pokretanju."

#: installer.rs:656
msgid "Passphrase"
msgstr "Lozinka"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Potvrdi lozinku"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Čuvajte ovu lozinku na sigurnom"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Ako je izgubite, niko neće moći vratiti podatke. Jezgra i datoteke za pokretanje ostaju na maloj nešifriranoj particiji za pokretanje."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Lozinka mora imati najmanje 8 znakova."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Lozinke se ne podudaraju."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Odaberite disk."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Odaberite disk s Windowsima."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Odaberite instalaciju za zamjenu."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Najprije otključajte šifriranu instalaciju."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Ova particija ne sadrži sistem MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Odaberite EFI sistemsku particiju."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Odaberite sistemsku particiju."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI i sistemska particija moraju biti različite."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Šifriranje zahtijeva zasebnu particiju za pokretanje."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Sistemska particija mora imati najmanje {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI particija nije formatirana u FAT; uključite formatiranje."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Sistemska particija je montirana; najprije je odmontirajte u Diskovima."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Gdje instalirati MAN?"

