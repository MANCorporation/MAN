msgstr "Veza sa sistemskim pomoćnikom je prekinuta."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Ovjera je otkazana."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Za ovu radnju potrebna su administratorska prava."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "Sistemski pomoćnik neočekivano se zaustavio."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Nema EFI sistemske particije"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Slobodno je samo {free}, MAN treba {need}. Oslobodite prostor pomoću DUHACH! u Windowsima."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Nema slobodnog prostora. Pokrenite DUHACH! u Windowsima i oslobodite prostor za MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN se pokreće s ovog diska"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "U upotrebi: particija je montirana"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Premalen, MAN treba {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Instaliraj MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN se instalira. Sačekajte da završi."

#: installer.rs:143
msgid "Language"
msgstr "Jezik"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Ponovo pokreni na ovom jeziku"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Živa sesija ponovo se pokreće na odabranom jeziku, a MAN se instalira na njemu."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Dobro došli u MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Brz, otvoren i potpuno prilagodljiv GNOME sistem.\n"
"Instalirajte ga na ovaj računar ili nastavite istraživati živu sesiju."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Instaliraj MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Nastavi isprobavati MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Traženje diskova…"

#: installer.rs:250
msgid "Welcome"
msgstr "Dobro došli"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Ovaj računar je pokrenut u starom BIOS načinu. MAN se može instalirati samo na UEFI računare: ponovo pokrenite i odaberite UEFI mogućnost pokretanja."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Sistemski pomoćnik nije vratio podatke o diskovima."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Dalje"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Obriši disk i instaliraj MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Sve na odabranom disku bit će obrisano, uključujući Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Preporučeno. Sve na odabranom disku bit će obrisano."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Instaliraj uz Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Preporučeno. MAN koristi slobodan prostor uz Windows; Windows i njegove datoteke ostaju. Sistem birate pri svakom pokretanju."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Ponovo instaliraj MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Zamjenjuje sistem, ali zadržava osobne datoteke u /home. Trenutni sistem čuva se kao snimka."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Prilagođene particije"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Za stručnjake: sami odaberite particije ili ih stvorite pomoću Diskova."

#: installer.rs:392
msgid "Disk"
msgstr "Disk"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Odaberite disk koji će se obrisati. Diskovi koji se ne mogu koristiti prikazani su s razlogom."

#: installer.rs:418
msgid "No disks were found"
msgstr "Nisu pronađeni diskovi"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Slobodan prostor uz Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Particije Windowsa ostaju netaknute. MAN dijeli EFI sistemsku particiju i dodaje Windows u svoj izbornik pokretanja."

