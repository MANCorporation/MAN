msgstr "AppImage"

#: appinstaller.rs:876
msgid "You will be guided through the steps necessary to install this software."
msgstr "Bit ćete vođeni kroz korake potrebne za instalaciju ovog softvera."

#: appinstaller.rs:887
msgid "Version"
msgstr "Verzija"

#: appinstaller.rs:890
msgid "Publisher"
msgstr "Izdavač"

#: appinstaller.rs:892
msgid "Type"
msgstr "Vrsta"

