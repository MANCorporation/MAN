msgstr "snimke: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN na {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Lozinka za {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Otključaj"

