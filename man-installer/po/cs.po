msgid "The confirmed disk does not hold the chosen system partition."
msgstr "Potvrzený disk neobsahuje zvolený systémový oddíl."

#: install.rs:157
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "Zaváděcí oddíl musí být oddělený od oddílu EFI a systémového oddílu."

#: install.rs:160
msgid "The boot partition must be at least 512 MB."
msgstr "Zaváděcí oddíl musí mít alespoň 512 MB."

#: install.rs:175
msgid "No installation chosen."
msgstr "Není zvolena instalace."

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "Potvrzený disk neobsahuje zvolenou instalaci."

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "Šifrovaná instalace nemá oddíl MAN_BOOT."

#: install.rs:695
msgid "No kernel with matching modules was found in /boot."
msgstr "V /boot nebylo nalezeno jádro s odpovídajícími moduly."

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "Jazyk musí změnit systémový pomocník."

