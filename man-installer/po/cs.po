msgstr "Odpojování"

#: install.rs:93
msgid "The installer backend must run as root."
msgstr "Pomocník instalátoru musí běžet jako root."

#: install.rs:121
msgid "This computer was not started in UEFI mode. MAN requires UEFI."
msgstr "Tento počítač nebyl spuštěn v režimu UEFI. MAN vyžaduje UEFI."

#: install.rs:125
msgid "The username is not valid."
msgstr "Uživatelské jméno není platné."

#: install.rs:128
msgid "A password is required."
msgstr "Je potřeba heslo."

#: install.rs:132
msgid "The computer name is not valid."
msgstr "Název počítače není platný."

#: install.rs:138
msgid "Unknown language."
msgstr "Neznámý jazyk."

#: install.rs:144
msgid "The encryption passphrase must have at least 8 characters."
msgstr "Heslo pro šifrování musí mít alespoň 8 znaků."

#: install.rs:155
msgid "The disk changed after you confirmed the installation. Nothing was modified; please review and confirm again."
msgstr "Disk se po potvrzení instalace změnil. Nic nebylo upraveno; zkontrolujte plán a potvrďte ho znovu."

#: install.rs:171
msgid "Choose a system partition."
msgstr "Zvolte systémový oddíl."

#: install.rs:178
msgid "The confirmed disk does not hold the chosen system partition."
msgstr "Potvrzený disk neobsahuje zvolený systémový oddíl."

#: install.rs:190
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "Zaváděcí oddíl musí být oddělený od oddílu EFI a systémového oddílu."

#: install.rs:193
msgid "The boot partition must be at least 512 MB."
msgstr "Zaváděcí oddíl musí mít alespoň 512 MB."

#: install.rs:208
msgid "No installation chosen."
msgstr "Není zvolena instalace."

#: install.rs:212
msgid "The confirmed disk does not hold the chosen installation."
msgstr "Potvrzený disk neobsahuje zvolenou instalaci."

#: install.rs:379
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "Šifrovaná instalace nemá oddíl MAN_BOOT."

#: install.rs:745
msgid "No kernel with matching modules was found in /boot."
msgstr "V /boot nebylo nalezeno jádro s odpovídajícími moduly."

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "Jazyk musí změnit systémový pomocník."

#: oobe.rs:205
msgid "Applying your settings"
msgstr "Použití vašich nastavení"

#: oobe.rs:213
msgid "Preparing disk encryption"
msgstr "Příprava šifrování disku"

#: oobe.rs:217
msgid "Finishing"
msgstr "Dokončování"

#: oobe.rs:101
msgid "MAN Setup must be finished by the system helper."
msgstr "MAN Setup musí dokončit systémový pomocník."

#: oobe.rs:104
msgid "MAN Setup has already been completed on this computer."
msgstr "MAN Setup už byl na tomto počítači dokončen."

#: oobe.rs:125
msgid "Unknown accent color."
msgstr "Neznámá barva zvýraznění."

#: oobe.rs:129
msgid "The chosen wallpaper is not available."
msgstr "Zvolená tapeta není k dispozici."

#: oobe.rs:147
msgid "This system cannot be encrypted."
msgstr "Tento systém nelze zašifrovat."

#: oobe.rs:258
msgid "The setup key is missing, so encryption cannot continue in the background."
msgstr "Chybí instalační klíč, takže šifrování nemůže pokračovat na pozadí."

#: recovery.rs:450
msgid "Downloading MAN"
msgstr "Stahuje se MAN"

#: recovery.rs:459
msgid "Opening the downloaded MAN"
msgstr "Otevírá se stažený MAN"

#: recovery.rs:85
msgid "Leaving out what Recovery does not need"
msgstr "Vynechává se, co Obnova nepotřebuje"

#: recovery.rs:87
msgid "Setting up the recovery system"
msgstr "Nastavuje se systém pro obnovu"

#: recovery.rs:89
msgid "Adding its start-up files"
msgstr "Přidávají se jeho spouštěcí soubory"

#: recovery.rs:104
msgid "MAN Recovery is ready"
msgstr "Obnova MAN je připravená"

#: recovery.rs:64
msgid "This MAN has no MAN Recovery program."
msgstr "Tento MAN nemá program Obnova MAN."

#: recovery.rs:82
msgid "MAN Recovery was not started."
msgstr "Obnova MAN nebyla zahájena."

#: recovery.rs:206
msgid "The installed system has no kernel for MAN Recovery."
msgstr "Nainstalovaný systém nemá jádro pro Obnovu MAN."

#: recovery.rs:234
msgid "MAN Recovery was not started from the boot menu."
msgstr "Obnova MAN nebyla spuštěna ze spouštěcí nabídky."

#: recovery.rs:235
msgid "The disk of this MAN was not found."
msgstr "Disk tohoto MAN nebyl nalezen."

#: recovery.rs:240
msgid "This works only in MAN Recovery."
msgstr "Toto funguje jen v Obnově MAN."

#: recovery.rs:290
msgid "The password is not correct."
msgstr "Heslo není správné."

#: recovery.rs:333
msgid "Invalid snapshot id."
msgstr "Neplatné ID snímku."

#: recovery.rs:405
msgid "No MAN for this computer was found on MAN's download page."
msgstr "Na stránce stahování MAN nebyl nalezen MAN pro tento počítač."

#: recovery.rs:434
msgid "The downloaded MAN is damaged (its checksum does not match). Try again."
msgstr "Stažený MAN je poškozený (kontrolní součet nesouhlasí). Zkuste to znovu."

#: recovery.rs:491
msgid "The partition of this MAN was not found."
msgstr "Oddíl tohoto MAN nebyl nalezen."

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "Systém není nainstalován na Btrfs, takže snímky nejsou k dispozici."

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "Obnova snímku čeká na restart. Nejprve ji dokončete restartem počítače."

