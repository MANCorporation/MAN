#: backend.rs:46
msgid "Could not start the system helper."
msgstr "Systémového pomocníka nelze spustit."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "Se systémovým pomocníkem nelze komunikovat."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "Spojení se systémovým pomocníkem bylo ztraceno."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "Ověření bylo zrušeno."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "K této akci jsou potřeba práva správce."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "Systémový pomocník se neočekávaně ukončil."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Chybí systémový oddíl EFI"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Volné je jen {free}, MAN potřebuje {need}. Uvolněte místo pomocí DUHACH! ve Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Žádné volné místo. Spusťte ve Windows DUHACH! a uvolněte místo pro MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "Z tohoto disku právě běží MAN"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Používá se: oddíl je připojen"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Příliš malý, MAN potřebuje {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Instalovat MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN se instaluje. Počkejte prosím na dokončení."

#: installer.rs:143
msgid "Language"
msgstr "Jazyk"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Restartovat v tomto jazyce"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Živá relace se restartuje ve zvoleném jazyce a MAN se v něm také nainstaluje."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Vítejte v MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Rychlý, otevřený a plně přizpůsobitelný systém GNOME.\n"
"Nainstalujte ho do tohoto počítače, nebo pokračujte ve zkoušení živé relace."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Instalovat MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Dál zkoušet MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Hledání disků…"

#: installer.rs:250
msgid "Welcome"
msgstr "Vítejte"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Tento počítač byl spuštěn v režimu legacy BIOS. MAN lze nainstalovat jen na počítače s UEFI: restartujte a zvolte možnost spuštění UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Systémový pomocník nevrátil žádné informace o discích."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Další"

#: installer.rs:361
msgid "Installation Type"
msgstr "Typ instalace"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Smazat disk a nainstalovat MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Vše na zvoleném disku bude smazáno, včetně Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Doporučeno. Vše na zvoleném disku bude smazáno."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Instalovat vedle Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Doporučeno. MAN využije volné místo vedle Windows; Windows i jeho soubory zůstanou. Systém si zvolíte při každém spuštění."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Přeinstalovat MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Nahradí systém, ale ponechá osobní soubory v /home. Současný systém se uloží jako snímek."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Vlastní oddíly"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Pro odborníky: zvolte oddíly sami, nebo je vytvořte v aplikaci Disky."

#: installer.rs:392
msgid "Disk"
msgstr "Disk"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Zvolte disk, který se smaže. Disky, které nelze použít, jsou zobrazeny s důvodem."

#: installer.rs:418
msgid "No disks were found"
msgstr "Nebyly nalezeny žádné disky"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Volné místo vedle Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Oddíly Windows zůstanou nedotčeny. MAN sdílí systémový oddíl EFI a přidá Windows do své nabídky při spuštění."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} volno"

#: installer.rs:432
msgid "no free space"
msgstr "žádné volné místo"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Instalace k nahrazení"

#: installer.rs:477
msgid "no home folders"
msgstr "žádné domovské složky"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "domovské složky: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "snímky: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN na {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Heslo pro {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Odemknout"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Instalaci se nepodařilo prozkoumat."

#: installer.rs:554
msgid "Partitions"
msgstr "Oddíly"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Systémový oddíl se naformátuje na Btrfs a obsahuje @system, @home a @snapshots. Oddíly na disku, ze kterého MAN běží, nejsou uvedeny."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Otevřít Disky pro vytvoření nebo změnu velikosti oddílů"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Obnovit seznam oddílů"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Zvolte oddíl"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "Systémový oddíl EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Naformátovat systémový oddíl EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Nechte vypnuté, aby zůstaly zavaděče jiných systémů"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Systémový oddíl (naformátuje se na Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Zaváděcí oddíl (potřebný pro šifrování)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Seznam oddílů byl obnoven"

#: installer.rs:650
msgid "Security"
msgstr "Zabezpečení"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Šifrovat systém"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Chrání vaše data, pokud počítač ztratíte nebo vám ho ukradnou. Heslo se zadává při každém spuštění."

#: installer.rs:656
msgid "Passphrase"
msgstr "Heslo"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Potvrzení hesla"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Uschovejte si toto heslo"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Pokud ho ztratíte, data už nikdo neobnoví. Jádro a zaváděcí soubory zůstanou na malém nešifrovaném zaváděcím oddílu."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Heslo musí mít alespoň 8 znaků."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Hesla se neshodují."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Zvolte disk."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Zvolte disk s Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Zvolte instalaci, která se nahradí."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Nejprve odemkněte šifrovanou instalaci."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Tento oddíl neobsahuje systém MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Zvolte systémový oddíl EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Zvolte systémový oddíl."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Oddíl EFI a systémový oddíl se musí lišit."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Šifrování potřebuje samostatný zaváděcí oddíl."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Systémový oddíl musí mít alespoň {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Oddíl EFI není ve formátu FAT; zapněte formátování."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Systémový oddíl je připojen; nejprve ho odpojte v aplikaci Disky."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Kam nainstalovat MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Čas a klávesnice"

#: installer.rs:829
msgid "Time Zone"
msgstr "Časové pásmo"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Rozložení klávesnice"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Vyzkoušejte klávesnici"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Pište sem a ověřte, že klávesy píšou správné znaky."

#: installer.rs:844
msgid "Type here"
msgstr "Pište sem"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Časové pásmo a klávesnice"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Není zvolen disk"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Není zvolen systémový oddíl"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Systémový oddíl zmizel"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Není zvolena instalace"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Disk zmizel"

#: installer.rs:955
msgid "Review"
msgstr "Shrnutí"

#: installer.rs:958
msgid "Destination"
msgstr "Cíl"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Smazat disk a nainstalovat"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Vlastní oddíly"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Přeinstalovat, ponechat /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Vedle Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (naformátuje se)"

#: installer.rs:969
msgid " (kept)"
msgstr " (ponechá se)"

#: installer.rs:970
msgid "System Partition"
msgstr "Systémový oddíl"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (naformátuje se)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Zaváděcí oddíl"

#: installer.rs:976
msgid "Installation"
msgstr "Instalace"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Místo pro MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} volného místa (vytvoří se zaváděcí a systémový oddíl)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Beze změny. Objeví se v nabídce při spuštění MAN; systémový oddíl EFI je sdílený."

#: installer.rs:983
msgid "Encryption"
msgstr "Šifrování"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Zapnuto (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Vypnuto"

#: installer.rs:985
msgid "File System"
msgstr "Souborový systém"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system pro MAN, @home pro vaše soubory, @snapshots pro body obnovení. Všechny sdílí volné místo."

#: installer.rs:991
msgid "System"
msgstr "Systém"

#: installer.rs:993
msgid "Your Account"
msgstr "Váš účet"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Vytvoří se v MAN Setup při prvním spuštění počítače, spolu s názvem počítače, vzhledem a nastavením soukromí."

#: installer.rs:998
msgid "Keyboard"
msgstr "Klávesnice"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "Všechna data na {model} ({path}) budou smazána."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Smazat a nainstalovat"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Zvolené oddíly budou naformátovány. Ostatní oddíly se nezmění."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Naformátovat a nainstalovat"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "Současný systém bude nahrazen. Vaše soubory v /home zůstanou a starý systém se uloží jako snímek."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "_Přeinstalovat"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN se nainstaluje do volného místa. Windows a jeho soubory se nezmění."

#: installer.rs:1005
msgid "_Install"
msgstr "_Instalovat"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "Připraveno k instalaci"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "Smazat {model}?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "Všechny soubory a oddíly na {path} ({size}) budou trvale smazány. Tuto akci nelze vrátit."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "Smazat a nainstalovat"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "Naformátovat zvolené oddíly?"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "Všechna data na zvolených oddílech budou trvale smazána. Ostatní oddíly se nezmění."

#: installer.rs:1037
msgid "Format and Install"
msgstr "Naformátovat a nainstalovat"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "Nainstalovat MAN vedle Windows?"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "MAN se nainstaluje do {free} volného místa na {model} ({path}). Windows a jeho soubory se nezmění."

#: installer.rs:1046
msgid "Install"
msgstr "Instalovat"

#: installer.rs:1050
msgid "Reinstall MAN?"
msgstr "Přeinstalovat MAN?"

#: installer.rs:1051
msgid "The installed system will be replaced by a fresh copy. Personal files in /home are kept and the old system remains available as a snapshot."
msgstr "Nainstalovaný systém bude nahrazen novou kopií. Osobní soubory v /home zůstanou a starý systém bude dostupný jako snímek."

#: installer.rs:1052
msgid "Reinstall"
msgstr "Přeinstalovat"

#: installer.rs:1057
msgid "_Cancel"
msgstr "_Zrušit"

#: installer.rs:1076
msgid "Installing MAN"
msgstr "Instalace MAN"

#: installer.rs:1077
msgid "Starting…"
msgstr "Spouštění…"

#: installer.rs:1085
msgid "Details"
msgstr "Podrobnosti"

#: installer.rs:1090
msgid "Installing"
msgstr "Instalace"

#: installer.rs:1103
msgid "Step {index} of {n}  ·  {title}"
msgstr "Krok {index} z {n}  ·  {title}"

#: installer.rs:1128
msgid "Log"
msgstr "Záznam"

#: installer.rs:1138
msgid "MAN Is Installed"
msgstr "MAN je nainstalován"

#: installer.rs:1143
msgid "Restart the computer to start using MAN. A menu at every start lets you choose MAN or Windows; the temporary MAN installer partition is removed by MAN on its first start."
msgstr "Restartujte počítač a začněte MAN používat. Při každém spuštění si v nabídce zvolíte MAN nebo Windows; dočasný oddíl instalátoru MAN odstraní při prvním spuštění."

#: installer.rs:1149
msgid "Restart the computer to start using MAN. You can remove the installation media; if it stays connected, MAN still starts from the new disk."
msgstr "Restartujte počítač a začněte MAN používat. Instalační médium můžete odpojit; pokud zůstane připojené, MAN se i tak spustí z nového disku."

#: installer.rs:1156
msgid "_Restart Now"
msgstr "_Restartovat nyní"

#: installer.rs:1171
msgid "Done"
msgstr "Hotovo"

#: installer.rs:1182
msgid "Installation Failed"
msgstr "Instalace se nezdařila"

#: installer.rs:1186
msgid "No other disk was changed, and the installer has released the target disk. You can review the plan and try again."
msgstr "Žádný jiný disk nebyl změněn a instalátor uvolnil cílový disk. Můžete plán zkontrolovat a zkusit to znovu."

#: installer.rs:1191
msgid "_Review and Try Again"
msgstr "_Zkontrolovat a zkusit znovu"

#: installer.rs:1193
msgid "_Show Details"
msgstr "_Zobrazit podrobnosti"

#: installer.rs:1208
msgid "Installation Log"
msgstr "Záznam instalace"

#: langui.rs:229
msgid "Search languages"
msgstr "Hledat jazyky"

#: langui.rs:269
msgid "Search countries"
msgstr "Hledat země"

#: oobe.rs:165
msgid "The system disk was not found."
msgstr "Systémový disk nebyl nalezen."

#: oobe.rs:173
msgid "Encryption needs the Btrfs layout created by the MAN installer."
msgstr "Šifrování vyžaduje rozložení Btrfs vytvořené instalátorem MAN."

#: oobe.rs:177
msgid "This installation has no separate boot partition, which encryption needs. Reinstall MAN with “Erase Disk” to use encryption."
msgstr "Tato instalace nemá samostatný zaváděcí oddíl, který šifrování potřebuje. Pro šifrování přeinstalujte MAN s volbou „Smazat disk“."

#: oobe.rs:501
msgid "MAN Setup"
msgstr "MAN Setup"

#: oobe.rs:554
msgid "Where Are You?"
msgstr "Kde se nacházíte?"

#: oobe.rs:554
msgid "Your country or region sets the date, time and number formats."
msgstr "Vaše země nebo oblast určuje formát data, času a čísel."

#: oobe.rs:572
msgid "Country"
msgstr "Země"

#: oobe.rs:587
msgid "GNU General Public License, version 2"
msgstr "GNU General Public License, verze 2"

#: oobe.rs:587
msgid "The Linux kernel and many system tools"
msgstr "Jádro Linux a mnoho systémových nástrojů"

#: oobe.rs:588
msgid "GNU General Public License, version 3"
msgstr "GNU General Public License, verze 3"

#: oobe.rs:588
msgid "Many GNU and GNOME programs"
msgstr "Mnoho programů GNU a GNOME"

#: oobe.rs:589
msgid "GNU Lesser General Public License, version 2.1"
msgstr "GNU Lesser General Public License, verze 2.1"

#: oobe.rs:589
msgid "GTK, GLib and many libraries"
msgstr "GTK, GLib a mnoho knihoven"

#: oobe.rs:590
msgid "GNU Lesser General Public License, version 3"
msgstr "GNU Lesser General Public License, verze 3"

#: oobe.rs:590
msgid "Libraries"
msgstr "Knihovny"

#: oobe.rs:591
msgid "Mozilla Public License 2.0"
msgstr "Mozilla Public License 2.0"

#: oobe.rs:591
msgid "Programs and libraries from Mozilla and others"
msgstr "Programy a knihovny od Mozilly a dalších"

#: oobe.rs:592
msgid "Apache License 2.0"
msgstr "Apache License 2.0"

#: oobe.rs:592
msgid "Libraries and tools"
msgstr "Knihovny a nástroje"

#: oobe.rs:597
msgid "License Agreement"
msgstr "Licenční smlouva"

#: oobe.rs:597
msgid "Please read and accept the terms under which MAN is provided."
msgstr "Přečtěte si a přijměte podmínky, za kterých je MAN poskytován."

#: oobe.rs:608
msgid "Licenses"
msgstr "Licence"

#: oobe.rs:616
msgid "The license text is not available ({path})."
msgstr "Text licence není k dispozici ({path})."

#: oobe.rs:622
msgid "I have read and accept the license terms"
msgstr "Přečetl(a) jsem si licenční podmínky a přijímám je"

#: oobe.rs:692
msgid "Wired"
msgstr "Kabelové"

#: oobe.rs:698
msgid "Not connected"
msgstr "Nepřipojeno"

#: oobe.rs:732
msgid "Connect to the Internet"
msgstr "Připojení k internetu"

#: oobe.rs:732
msgid "Connecting lets MAN set the time and keep your software up to date. You can also do this later."
msgstr "Díky připojení může MAN nastavit čas a udržovat software aktuální. Můžete to udělat i později."

#: oobe.rs:734
msgid "Checking the connection…"
msgstr "Kontrola připojení…"

#: oobe.rs:740
msgid "Wi-Fi Networks"
msgstr "Sítě Wi-Fi"

#: oobe.rs:742
msgid "Search Again"
msgstr "Hledat znovu"

#: oobe.rs:753
msgid "_Skip"
msgstr "_Přeskočit"

#: oobe.rs:754
msgid "You can connect later in Settings."
msgstr "Připojit se můžete později v Nastavení."

