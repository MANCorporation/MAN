#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Tento soubor není aplikace, kterou zde lze nainstalovat (.deb, .flatpak, .flatpakref nebo AppImage)."

#: appinstaller.rs:134
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Tato aplikace je určena pro počítače {arch} a na tomto počítači (x86-64) nefunguje."

#: appinstaller.rs:320
msgid "The file could not be read. It may be damaged."
msgstr "Soubor nelze přečíst. Může být poškozený."

#: appinstaller.rs:492
msgid "This is not an AppImage."
msgstr "Toto není AppImage."

