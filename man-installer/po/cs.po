#: update.rs:410
msgid "Preparing the new system"
msgstr "Příprava nového systému"

#: update.rs:168
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Soubor aktualizace je poškozený (kontrolní součet nesouhlasí). Stáhněte ho znovu."

#: update.rs:171
msgid "The update file could not be read completely."
msgstr "Soubor aktualizace se nepodařilo přečíst celý."

#: update.rs:312
msgid "The update contains no kernel."
msgstr "Aktualizace neobsahuje jádro."

#: update.rs:360
msgid "Updates must be installed by the system helper."
msgstr "Aktualizace musí instalovat systémový pomocník."

#: update.rs:369
msgid "The chosen installation was not found."
msgstr "Zvolená instalace nebyla nalezena."

#: update.rs:371
