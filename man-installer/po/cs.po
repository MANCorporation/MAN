msgstr "Systém není nainstalován na Btrfs, takže snímky nejsou k dispozici."

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "Obnova snímku čeká na restart. Nejprve ji dokončete restartem počítače."

#: snapshots.rs:99
msgid "Invalid snapshot id."
msgstr "Neplatné ID snímku."

