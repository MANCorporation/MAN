msgid "Unpacking the new system"
msgstr "Rozbalování nového systému"

#: update.rs:32
msgid "Moving your accounts and settings"
msgstr "Přenos vašich účtů a nastavení"

#: update.rs:32
msgid "Preparing the restart"
msgstr "Příprava restartu"

#: update.rs:195
msgid "Unpacked"
msgstr "Rozbaleno"

#: update.rs:285
msgid "Accounts"
msgstr "Účty"

#: update.rs:338
msgid "Reinstalling kept apps"
msgstr "Opětovná instalace zachovaných aplikací"

#: update.rs:404
msgid "Removing installer-only software"
msgstr "Odstraňování softwaru pouze pro instalátor"

#: update.rs:450
msgid "Building the update boot image"
msgstr "Sestavení zaváděcího obrazu aktualizace"

#: update.rs:453
msgid "Adding the one-time boot entry"
msgstr "Přidání jednorázové položky spuštění"

#: update.rs:488
msgid "The update is genuine"
msgstr "Aktualizace je pravá"

#: update.rs:494
msgid "Snapshot created"
msgstr "Snímek byl vytvořen"

#: update.rs:505
msgid "Update area ready"
msgstr "Oblast pro aktualizaci je připravena"

#: update.rs:528
msgid "Preparing the new system"
msgstr "Příprava nového systému"

#: update.rs:184
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Soubor aktualizace je poškozený (kontrolní součet nesouhlasí). Stáhněte ho znovu."

#: update.rs:187
msgid "The update file could not be read completely."
msgstr "Soubor aktualizace se nepodařilo přečíst celý."

#: update.rs:416
msgid "The update contains no kernel."
msgstr "Aktualizace neobsahuje jádro."

#: update.rs:470
msgid "Updates must be installed by the system helper."
msgstr "Aktualizace musí instalovat systémový pomocník."

#: update.rs:480
msgid "The chosen installation was not found."
msgstr "Zvolená instalace nebyla nalezena."

#: update.rs:482
msgid "Only the running MAN installation can be updated."
msgstr "Aktualizovat lze jen běžící instalaci MAN."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Toto není soubor aktualizace MAN (chybí manifest)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "Aktualizace není podepsaná, proto jí nelze důvěřovat."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "Podpis aktualizace je poškozený."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "Aktualizace není podepsaná MAN. Mohla být upravena nebo pochází z nedůvěryhodného zdroje."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "Manifest aktualizace je neplatný."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "Heslo není správné, nebo šifrovaný oddíl nelze otevřít."

