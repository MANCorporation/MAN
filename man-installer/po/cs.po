#: appinstaller.rs:876
msgid "You will be guided through the steps necessary to install this software."
msgstr "Provedeme vás kroky potřebnými k instalaci tohoto softwaru."

#: appinstaller.rs:887
msgid "Version"
msgstr "Verze"

#: appinstaller.rs:890
msgid "Publisher"
msgstr "Vydavatel"

#: appinstaller.rs:892
msgid "Type"
msgstr "Typ"

#: appinstaller.rs:894
msgid "Size"
msgstr "Velikost"

