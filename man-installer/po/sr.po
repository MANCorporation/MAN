#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Ова датотека није програм који се овде може инсталирати (.deb, .flatpak, .flatpakref или AppImage)."

#: appinstaller.rs:134
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Овај програм је направљен за рачунаре {arch} и не ради на овом (x86-64)."

#: appinstaller.rs:320
msgid "The file could not be read. It may be damaged."
msgstr "Датотека не може да се прочита. Можда је оштећена."

#: appinstaller.rs:492
msgid "This is not an AppImage."
msgstr "Ово није AppImage."

#: appinstaller.rs:686
msgid "Introduction"
msgstr "Увод"

#: appinstaller.rs:687
msgid "License"
msgstr "Лиценца"

#: appinstaller.rs:688
msgid "Destination Select"
msgstr "Избор одредишта"

#: appinstaller.rs:689
msgid "Installation Type"
msgstr "Врста инсталације"

#: appinstaller.rs:690
msgid "Installation"
msgstr "Инсталација"

#: appinstaller.rs:691
msgid "Summary"
msgstr "Сажетак"

#: appinstaller.rs:797
msgid "_Continue"
msgstr "_Настави"

#: appinstaller.rs:806
msgid "Welcome to the {name} Installer"
msgstr "Добро дошли у инсталатер програма {name}"

#: appinstaller.rs:810
msgid "Software License Agreement"
msgstr "Уговор о лиценци за софтвер"

#: appinstaller.rs:820
msgid "Do You Agree to the License?"
msgstr "Да ли прихватате лиценцу?"

#: appinstaller.rs:821
msgid "To continue installing, you must agree to the terms of the software license agreement."
msgstr "Да бисте наставили инсталацију, морате прихватити услове уговора о лиценци за софтвер."

#: appinstaller.rs:823
msgid "_Read License"
msgstr "_Прочитај лиценцу"

#: appinstaller.rs:824
msgid "_Agree"
msgstr "_Прихватам"

#: appinstaller.rs:837
msgid "Select a Destination"
msgstr "Изаберите одредиште"

#: appinstaller.rs:841
msgid "Standard Install"
msgstr "Стандардна инсталација"

#: appinstaller.rs:842
msgid "_Install"
msgstr "_Инсталирај"

#: appinstaller.rs:855
msgid "Debian package (.deb)"
msgstr "Debian пакет (.deb)"

#: appinstaller.rs:856
msgid "Flatpak app"
msgstr "Flatpak програм"

#: appinstaller.rs:857
msgid "Flatpak app from {source}"
msgstr "Flatpak програм са {source}"

#: appinstaller.rs:858
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:876
msgid "You will be guided through the steps necessary to install this software."
msgstr "Бићете вођени кроз кораке потребне за инсталацију овог софтвера."

#: appinstaller.rs:887
msgid "Version"
msgstr "Издање"

#: appinstaller.rs:890
msgid "Publisher"
msgstr "Издавач"

#: appinstaller.rs:892
msgid "Type"
msgstr "Врста"

#: appinstaller.rs:894
msgid "Size"
msgstr "Величина"

#: appinstaller.rs:900
msgid "Website"
msgstr "Веб-сајт"

#: appinstaller.rs:902
msgid "File"
msgstr "Датотека"

#: appinstaller.rs:912
msgid "This app is installed already. Installing it again replaces it."
msgstr "Овај програм је већ инсталиран. Поновна инсталација га замењује."

#: appinstaller.rs:915
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr "Програми из .deb пакета постају део система. Ажурирање MAN-а замењује систем, па се после ажурирања поново инсталирају само ако их задржите (следећи кораци)."

#: appinstaller.rs:918
msgid "Only install apps from sources you trust."
msgstr "Инсталирајте програме само из извора којима верујете."

#: appinstaller.rs:924
msgid "Where do you want to install {name}?"
msgstr "Где желите да инсталирате {name}?"

#: appinstaller.rs:929
msgid "Only your account can use the app."
msgstr "Само ваш налог може да користи програм."

#: appinstaller.rs:930
msgid "Needs administrator rights."
msgstr "Потребна су администраторска права."

#: appinstaller.rs:937
msgid "Only for Me"
msgstr "Само за мене"

#: appinstaller.rs:937
msgid "For All Users of This Computer"
msgstr "За све кориснике овог рачунара"

#: appinstaller.rs:952
msgid "This will take {size} of space on your computer."
msgstr "Ово ће заузети {size} простора на рачунару."

#: appinstaller.rs:954
msgid "The app is downloaded from {source}."
msgstr "Програм се преузима са {source}."

#: appinstaller.rs:956
msgid "The app is installed for all users of this computer."
msgstr "Програм се инсталира за све кориснике овог рачунара."

#: appinstaller.rs:956
msgid "The app is installed only for you."
msgstr "Програм се инсталира само за вас."

#: appinstaller.rs:959
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage се премешта у {folder} и додаје међу ваше програме."

#: appinstaller.rs:965
msgid "Keep After MAN Updates"
msgstr "Задржи после ажурирања MAN-а"

#: appinstaller.rs:966
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "MAN поново инсталира програм после сваког ажурирања. За то се чувају датотеке његовог пакета."

#: appinstaller.rs:974
msgid "Click Install to install {name}."
msgstr "Кликните на „Инсталирај“ да бисте инсталирали {name}."

#: appinstaller.rs:980
msgid "Checking what else the app needs…"
msgstr "Провера шта још програм треба…"

#: appinstaller.rs:990
msgid "Also installs the packages it needs: {list}"
msgstr "Инсталира и потребне пакете: {list}"

#: appinstaller.rs:996
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Неки пакети потребни програму још нису доступни. Инсталација прво преузима најновије спискове пакета; ако и даље недостају, програм не може да се инсталира."

#: appinstaller.rs:1057
msgid "Installing {name}…"
msgstr "Инсталирање програма {name}…"

#: appinstaller.rs:1063
msgid "Preparing…"
msgstr "Припрема…"

#: appinstaller.rs:1070
msgid "Details"
msgstr "Детаљи"

#: appinstaller.rs:1110
msgid "Installing the package…"
msgstr "Инсталирање пакета…"

#: appinstaller.rs:1129
msgid "Moving the app to its folder…"
msgstr "Премештање програма у његову фасциклу…"

#: appinstaller.rs:1138
msgid "The app could not be installed."
msgstr "Програм не може да се инсталира."

#: appinstaller.rs:1142
msgid "Installing the app with Flatpak…"
msgstr "Инсталирање програма помоћу Flatpak-а…"

#: appinstaller.rs:1166
msgid "Log"
msgstr "Дневник"

#: appinstaller.rs:1196
msgid "_Close"
msgstr "_Затвори"

#: appinstaller.rs:1206
msgid "The Installation Was Successful"
msgstr "Инсталација је успела"

#: appinstaller.rs:1206
msgid "The app was installed."
msgstr "Програм је инсталиран."

#: appinstaller.rs:1211
msgid "The Installation Failed"
msgstr "Инсталација није успела"

#: appinstaller.rs:1222
msgid "_Open"
msgstr "_Отвори"

#: appinstaller.rs:1232
msgid "_Show Details"
msgstr "_Прикажи детаље"

#: appinstaller.rs:1235
msgid "Installation Log"
msgstr "Дневник инсталације"

#: appinstaller.rs:1262
msgid "App Installer"
msgstr "Инсталатер програма"

#: appinstaller.rs:1283
msgid "Go _Back"
msgstr "_Назад"

#: appinstaller.rs:1356
msgid "Reading the app…"
msgstr "Читање програма…"

#: appinstaller.rs:1365
msgid "Install {name}"
msgstr "Инсталирај {name}"

#: appinstaller.rs:1384
msgid "Apps"
msgstr "Програми"

#: appinstaller.rs:1390
msgid "Choose an App to Install"
msgstr "Изаберите програм за инсталацију"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "Системски помоћник не може да се покрене."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "Није могуће комуницирати са системским помоћником."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Веза са системским помоћником је прекинута."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Овлашћење је отказано."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "За ову радњу су потребна администраторска права."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "Системски помоћник се неочекивано зауставио."

#: installer.rs:89
msgid "No EFI system partition"
msgstr "Нема EFI системске партиције"

#: installer.rs:93
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Слободно је само {free}, MAN-у треба {need}. Ослободите простор помоћу DUHACH! у Windows-у."

#: installer.rs:94
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Нема слободног простора. Покрените DUHACH! у Windows-у да ослободите место за MAN."

#: installer.rs:103
msgid "MAN is running from this disk"
msgstr "MAN ради са овог диска"

#: installer.rs:107
msgid "In use: a partition is mounted"
msgstr "У употреби: партиција је монтирана"

#: installer.rs:109
msgid "Too small, MAN needs {need}"
msgstr "Премали, MAN-у треба {need}"

#: installer.rs:119
msgid "Install MAN"
msgstr "Инсталирај MAN"

#: installer.rs:137
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN се инсталира. Сачекајте да се заврши."

#: installer.rs:154
msgid "Language"
msgstr "Језик"

#: installer.rs:166
msgid "_Restart in This Language"
msgstr "_Поново покрени на овом језику"

#: installer.rs:178
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Жива сесија се поново покреће на изабраном језику, и MAN се инсталира на њему."

#: installer.rs:224
msgid "Welcome to MAN"
msgstr "Добродошли у MAN"

#: installer.rs:225
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Брз, отворен и потпуно прилагодљив GNOME систем.\n"
"Инсталирајте га на овај рачунар или наставите да истражујете живу сесију."

#: installer.rs:229
msgid "_Install MAN…"
msgstr "_Инсталирај MAN…"

#: installer.rs:231
msgid "_Keep Trying MAN"
msgstr "_Настави са испробавањем MAN-а"

#: installer.rs:234
msgid "Looking for disks…"
msgstr "Тражење дискова…"

#: installer.rs:261
msgid "Welcome"
msgstr "Добродошли"

#: installer.rs:276
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Овај рачунар је покренут у старом BIOS режиму. MAN може да се инсталира само на UEFI рачунаре: поново покрените и изаберите UEFI опцију покретања."

#: installer.rs:294
msgid "The system helper returned no disk information."
msgstr "Системски помоћник није вратио податке о дисковима."

#: installer.rs:372
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:380
msgid "_Next"
msgstr "_Даље"

#: installer.rs:388
msgid "Erase Disk and Install MAN"
msgstr "Обриши диск и инсталирај MAN"

#: installer.rs:389
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Све на изабраном диску се брише, укључујући Windows."

#: installer.rs:389
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Препоручено. Све на изабраном диску се брише."

#: installer.rs:393
msgid "Install Alongside Windows"
msgstr "Инсталирај поред Windows-а"

#: installer.rs:394
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Препоручено. MAN користи слободан простор поред Windows-а; Windows и његове датотеке остају. Систем бирате при сваком покретању."

#: installer.rs:401
msgid "Reinstall MAN"
msgstr "Поново инсталирај MAN"

#: installer.rs:402
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Замењује систем, али задржава личне датотеке у /home. Тренутни систем се чува као снимак."

#: installer.rs:407
msgid "Custom Partitions"
msgstr "Прилагођене партиције"

#: installer.rs:407
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "За стручњаке: сами изаберите партиције или их направите помоћу Дискова."

#: installer.rs:418
msgid "Erase an External Disk and Install MAN"
msgstr "Обриши спољни диск и инсталирај MAN"

#: installer.rs:419
msgid "Everything on the chosen external disk is deleted. The Mac's internal disk is not shown and not changed."
msgstr "Све на изабраном спољном диску биће обрисано. Унутрашњи диск Мека се не приказује и не мења."

#: installer.rs:420
msgid "Install on This Mac"
msgstr "Инсталирај на овај Мек"

#: installer.rs:422
msgid "Recommended. Into the {size} prepared in macOS. macOS and its partitions are not changed."
msgstr "Препоручено. У {size} припремљених у macOS-у. macOS и његове партиције се не мењају."

#: installer.rs:427
msgid "No space for MAN was prepared yet. In macOS, run MAN-Mac/install-man.sh from the MAN USB stick and choose “MAN boot loader + space for MAN”."
msgstr "Простор за MAN још није припремљен. У macOS-у покрените MAN-Mac/install-man.sh са MAN USB меморије и изаберите “MAN boot loader + space for MAN”."

#: installer.rs:433
msgid "Disk"
msgstr "Диск"

#: installer.rs:433
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Изаберите диск који ће бити обрисан. Дискови који не могу да се користе приказани су са разлогом."

#: installer.rs:459
msgid "No disks were found"
msgstr "Нису пронађени дискови"

#: installer.rs:466
msgid "Free Space Next to Windows"
msgstr "Слободан простор поред Windows-а"

#: installer.rs:467
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Партиције Windows-а остају нетакнуте. MAN дели EFI системску партицију и додаје Windows у свој мени за покретање."

#: installer.rs:473
msgid "{size} free"
msgstr "{size} слободно"

#: installer.rs:473
msgid "no free space"
msgstr "нема слободног простора"

#: installer.rs:478
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:497
msgid "Installation to Replace"
msgstr "Инсталација за замену"

#: installer.rs:518
msgid "no home folders"
msgstr "нема личних фасцикли"

#: installer.rs:520
msgid "home folders: {list}"
msgstr "личне фасцикле: {list}"

#: installer.rs:522
msgid "snapshots: {n}"
msgstr "снимака: {n}"

#: installer.rs:526
msgid "MAN on {model}"
msgstr "MAN на {model}"

#: installer.rs:540
msgid "Passphrase for {device}"
msgstr "Лозинка за {device}"

#: installer.rs:541
msgid "Unlock"
msgstr "Откључај"

#: installer.rs:578
msgid "The installation could not be inspected."
msgstr "Инсталација није могла да се прегледа."

#: installer.rs:595
msgid "Partitions"
msgstr "Партиције"

#: installer.rs:596
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Системска партиција се форматира у Btrfs и садржи @system, @home и @snapshots. Партиције на диску са ког MAN ради нису приказане."

#: installer.rs:598
msgid "Open Disks to create or resize partitions"
msgstr "Отвори Дискове за прављење или промену величине партиција"

#: installer.rs:600
msgid "Refresh the partition list"
msgstr "Освежи списак партиција"

#: installer.rs:608
msgid "Choose a partition"
msgstr "Изаберите партицију"

#: installer.rs:620
msgid "EFI System Partition"
msgstr "EFI системска партиција"

#: installer.rs:621
msgid "Format EFI System Partition"
msgstr "Форматирај EFI системску партицију"

#: installer.rs:621
msgid "Leave off to keep boot loaders of other systems"
msgstr "Оставите искључено да бисте задржали покретаче других система"

#: installer.rs:623
msgid "System Partition (formatted as Btrfs)"
msgstr "Системска партиција (форматира се у Btrfs)"

#: installer.rs:624
msgid "Boot Partition (needed with encryption)"
msgstr "Партиција за покретање (потребна за шифровање)"

#: installer.rs:683
msgid "Partition list refreshed"
msgstr "Списак партиција је освежен"

#: installer.rs:691
msgid "Security"
msgstr "Безбедност"

#: installer.rs:693
msgid "Encrypt the System"
msgstr "Шифруј систем"

#: installer.rs:694
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Штити ваше податке ако се рачунар изгуби или украде. Лозинка се тражи при сваком покретању."

#: installer.rs:697
msgid "Passphrase"
msgstr "Лозинка"

#: installer.rs:698
msgid "Confirm Passphrase"
msgstr "Потврди лозинку"

#: installer.rs:700
msgid "Keep this passphrase safe"
msgstr "Чувајте ову лозинку на безбедном месту"

#: installer.rs:701
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Ако је изгубите, нико неће моћи да врати податке. Језгро и датотеке за покретање остају на малој нешифрованој партицији за покретање."

#: installer.rs:774
msgid "The passphrase needs at least 8 characters."
msgstr "Лозинка мора имати најмање 8 знакова."

#: installer.rs:776
msgid "The passphrases do not match."
msgstr "Лозинке се не поклапају."

#: installer.rs:790
msgid "Choose a disk."
msgstr "Изаберите диск."

#: installer.rs:800
msgid "Choose the disk with Windows."
msgstr "Изаберите диск са Windows-ом."

#: installer.rs:809
msgid "Choose the installation to replace."
msgstr "Изаберите инсталацију за замену."

#: installer.rs:810
msgid "Unlock the encrypted installation first."
msgstr "Прво откључајте шифровану инсталацију."

#: installer.rs:811
msgid "This partition holds no MAN system."
msgstr "Ова партиција не садржи MAN систем."

#: installer.rs:818
msgid "Choose an EFI system partition."
msgstr "Изаберите EFI системску партицију."

#: installer.rs:820
msgid "Choose the system partition."
msgstr "Изаберите системску партицију."

#: installer.rs:822
msgid "The EFI and system partitions must be different."
msgstr "EFI и системска партиција морају бити различите."

#: installer.rs:824
msgid "Encryption needs a separate boot partition."
msgstr "Шифровање захтева засебну партицију за покретање."

#: installer.rs:833
msgid "The system partition must be at least {size}."
msgstr "Системска партиција мора имати најмање {size}."

#: installer.rs:835
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI партиција није форматирана као FAT; укључите форматирање."

#: installer.rs:837
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Системска партиција је монтирана; прво је демонтирајте у Дисковима."

#: installer.rs:859
msgid "Where Should MAN Be Installed?"
msgstr "Где инсталирати MAN?"

#: installer.rs:866
msgid "Time and Keyboard"
msgstr "Време и тастатура"

#: installer.rs:871
msgid "Time Zone"
msgstr "Временска зона"

#: installer.rs:875
msgid "Keyboard Layout"
msgstr "Распоред тастатуре"

#: installer.rs:885
msgid "Test Your Keyboard"
msgstr "Испробајте тастатуру"

#: installer.rs:885
msgid "Type here to check that your keys produce the right characters."
msgstr "Куцајте овде да проверите да ли тастери дају исправне знакове."

#: installer.rs:886
msgid "Type here"
msgstr "Куцајте овде"

#: installer.rs:919
msgid "Time Zone and Keyboard"
msgstr "Временска зона и тастатура"

#: installer.rs:962
msgid "No disk chosen"
msgstr "Диск није изабран"

#: installer.rs:968
msgid "No system partition chosen"
msgstr "Системска партиција није изабрана"

#: installer.rs:970
msgid "The system partition disappeared"
msgstr "Системска партиција је нестала"

#: installer.rs:975
msgid "No installation chosen"
msgstr "Инсталација није изабрана"

#: installer.rs:986
msgid "The disk disappeared"
msgstr "Диск је нестао"

#: installer.rs:997
msgid "Review"
msgstr "Преглед"

#: installer.rs:1000
msgid "Destination"
msgstr "Одредиште"

#: installer.rs:1002
msgid "Erase disk and install"
