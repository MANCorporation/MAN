msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr "As aplicações de pacotes .deb passam a fazer parte do sistema. Uma atualização do MAN substitui o sistema, por isso só são instaladas novamente após uma atualização se as mantiver (passos seguintes)."

#: appinstaller.rs:918
msgid "Only install apps from sources you trust."
msgstr "Instale apenas aplicações de fontes em que confia."

#: appinstaller.rs:924
msgid "Where do you want to install {name}?"
msgstr "Onde quer instalar {name}?"

#: appinstaller.rs:929
msgid "Only your account can use the app."
msgstr "Só a sua conta pode usar a aplicação."

#: appinstaller.rs:930
msgid "Needs administrator rights."
msgstr "Requer direitos de administrador."

#: appinstaller.rs:937
msgid "Only for Me"
msgstr "Só para mim"

#: appinstaller.rs:937
msgid "For All Users of This Computer"
msgstr "Para todos os utilizadores deste computador"

#: appinstaller.rs:952
msgid "This will take {size} of space on your computer."
msgstr "Vai ocupar {size} de espaço no computador."

#: appinstaller.rs:954
msgid "The app is downloaded from {source}."
msgstr "A aplicação é transferida de {source}."

#: appinstaller.rs:956
msgid "The app is installed for all users of this computer."
msgstr "A aplicação é instalada para todos os utilizadores deste computador."

#: appinstaller.rs:956
msgid "The app is installed only for you."
msgstr "A aplicação é instalada só para si."

#: appinstaller.rs:959
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "O AppImage é movido para {folder} e adicionado às suas aplicações."

#: appinstaller.rs:965
msgid "Keep After MAN Updates"
msgstr "Manter após as atualizações do MAN"

#: appinstaller.rs:966
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "O MAN volta a instalar a aplicação após cada atualização. Para isso, os ficheiros do pacote são guardados."

#: appinstaller.rs:974
msgid "Click Install to install {name}."
msgstr "Clique em Instalar para instalar {name}."

