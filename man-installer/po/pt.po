msgid "Building the update boot image"
msgstr "A criar a imagem de arranque da atualização"

#: update.rs:453
msgid "Adding the one-time boot entry"
msgstr "A adicionar a entrada de arranque única"

#: update.rs:488
msgid "The update is genuine"
msgstr "A atualização é autêntica"

#: update.rs:494
msgid "Snapshot created"
msgstr "Instantâneo criado"

#: update.rs:505
msgid "Update area ready"
msgstr "Área de atualização pronta"

#: update.rs:528
msgid "Preparing the new system"
msgstr "A preparar o novo sistema"

#: update.rs:184
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "O ficheiro de atualização está danificado (soma de verificação incorreta). Transfira-o novamente."

#: update.rs:187
msgid "The update file could not be read completely."
msgstr "Não foi possível ler o ficheiro de atualização por completo."

#: update.rs:416
msgid "The update contains no kernel."
msgstr "A atualização não contém nenhum kernel."

#: update.rs:470
msgid "Updates must be installed by the system helper."
msgstr "As atualizações têm de ser instaladas pelo assistente do sistema."

#: update.rs:480
msgid "The chosen installation was not found."
msgstr "A instalação escolhida não foi encontrada."

#: update.rs:482
msgid "Only the running MAN installation can be updated."
msgstr "Só a instalação do MAN em execução pode ser atualizada."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Este não é um ficheiro de atualização do MAN (sem manifesto)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "A atualização não está assinada, por isso não é de confiança."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "A assinatura da atualização está danificada."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "A atualização não está assinada pelo MAN. Pode ter sido modificada ou vir de uma fonte não fidedigna."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "O manifesto da atualização é inválido."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "A frase de acesso não está correta ou não é possível abrir a partição encriptada."

