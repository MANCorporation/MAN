msgid "System Partition (formatted as Btrfs)"
msgstr "Partição de sistema (formatada como Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Partição de arranque (necessária com encriptação)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Lista de partições atualizada"

#: installer.rs:650
msgid "Security"
msgstr "Segurança"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Encriptar o sistema"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Protege os seus dados se o computador for perdido ou roubado. É pedida uma frase de acesso em cada arranque."

#: installer.rs:656
msgid "Passphrase"
msgstr "Frase de acesso"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Confirmar a frase de acesso"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Guarde esta frase de acesso em segurança"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Se a perder, ninguém poderá recuperar os dados. O kernel e os ficheiros de arranque ficam numa pequena partição de arranque não encriptada."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "A frase de acesso tem de ter pelo menos 8 caracteres."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "As frases de acesso não coincidem."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Escolha um disco."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Escolha o disco com o Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Escolha a instalação a substituir."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Desbloqueie primeiro a instalação encriptada."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Esta partição não contém um sistema MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Escolha uma partição de sistema EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Escolha a partição de sistema."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "A partição EFI e a partição de sistema têm de ser diferentes."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "A encriptação precisa de uma partição de arranque separada."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "A partição de sistema tem de ter pelo menos {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "A partição EFI não está formatada em FAT; ative a formatação."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "A partição de sistema está montada; desmonte-a primeiro no Discos."

