msgid "No installation chosen."
msgstr "ಸ್ಥಾಪನೆ ಆಯ್ಕೆ ಮಾಡಿಲ್ಲ."

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "ದೃಢೀಕರಿಸಿದ ಡಿಸ್ಕ್‌ನಲ್ಲಿ ಆಯ್ಕೆ ಮಾಡಿದ ಸ್ಥಾಪನೆ ಇಲ್ಲ."

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "ಗೂಢಲಿಪೀಕರಿಸಿದ ಸ್ಥಾಪನೆಯಲ್ಲಿ MAN_BOOT ವಿಭಾಗ ಇಲ್ಲ."

#: install.rs:695
