#: update.rs:447
msgid "Only the running MAN installation can be updated."
msgstr "ಚಾಲನೆಯಲ್ಲಿರುವ MAN ಸ್ಥಾಪನೆಯನ್ನು ಮಾತ್ರ ನವೀಕರಿಸಬಹುದು."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "ಇದು MAN ನವೀಕರಣ ಫೈಲ್ ಅಲ್ಲ (ಮ್ಯಾನಿಫೆಸ್ಟ್ ಇಲ್ಲ)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "ನವೀಕರಣಕ್ಕೆ ಸಹಿ ಇಲ್ಲ, ಆದ್ದರಿಂದ ಅದನ್ನು ನಂಬಲಾಗದು."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "ನವೀಕರಣದ ಸಹಿ ಹಾನಿಗೊಳಗಾಗಿದೆ."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "ನವೀಕರಣಕ್ಕೆ MAN ಸಹಿ ಇಲ್ಲ. ಅದನ್ನು ಬದಲಿಸಿರಬಹುದು ಅಥವಾ ನಂಬಲಾಗದ ಮೂಲದಿಂದ ಬಂದಿರಬಹುದು."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "ನವೀಕರಣದ ಮ್ಯಾನಿಫೆಸ್ಟ್ ಅಮಾನ್ಯ."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "ಪಾಸ್‌ಫ್ರೇಸ್ ತಪ್ಪಾಗಿದೆ, ಅಥವಾ ಗೂಢಲಿಪೀಕರಿಸಿದ ವಿಭಾಗವನ್ನು ತೆರೆಯಲಾಗದು."

