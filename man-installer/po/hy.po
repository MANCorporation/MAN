#: update.rs:377
msgid "The update is genuine"
msgstr "Թարմացումն իսկական է"

#: update.rs:383
msgid "Snapshot created"
msgstr "Պատկերահանը ստեղծվեց"

#: update.rs:385
msgid "Skipped"
msgstr "Բաց թողնված"

#: update.rs:394
msgid "Update area ready"
msgstr "Թարմացման տարածքը պատրաստ է"

#: update.rs:410
msgid "Preparing the new system"
msgstr "Նոր համակարգի նախապատրաստում"

#: update.rs:168
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Թարմացման ֆայլը վնասված է (ստուգիչ գումարը չի համընկնում)։ Ներբեռնեք այն նորից։"

#: update.rs:171
msgid "The update file could not be read completely."
msgstr "Չհաջողվեց ամբողջությամբ կարդալ թարմացման ֆայլը։"

#: update.rs:312
msgid "The update contains no kernel."
msgstr "Թարմացումը միջուկ չի պարունակում։"

#: update.rs:360
msgid "Updates must be installed by the system helper."
msgstr "Թարմացումները պետք է տեղադրի համակարգի օգնականը։"

#: update.rs:369
msgid "The chosen installation was not found."
msgstr "Ընտրված տեղադրումը չգտնվեց։"

#: update.rs:371
msgid "Only the running MAN installation can be updated."
msgstr "Կարելի է թարմացնել միայն աշխատող MAN տեղադրումը։"

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Սա MAN թարմացման ֆայլ չէ (մանիֆեստ չկա)։"

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "Թարմացումը ստորագրված չէ, ուստի դրան չի կարելի վստահել։"

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "Թարմացման ստորագրությունը վնասված է։"

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "Թարմացումը ստորագրված չէ MAN-ի կողմից։ Այն կարող է փոփոխված լինել կամ գալ անվստահելի աղբյուրից։"

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "Թարմացման մանիֆեստն անվավեր է։"

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "Արտահայտությունը սխալ է, կամ գաղտնագրված բաժինը հնարավոր չէ բացել։"

#: lib.rs:ACCENTS
msgid "Blue"
msgstr "Կապույտ"

#: lib.rs:ACCENTS
msgid "Teal"
msgstr "Փիրուզագույն"

#: lib.rs:ACCENTS
msgid "Green"
msgstr "Կանաչ"

#: lib.rs:ACCENTS
msgid "Yellow"
msgstr "Դեղին"

#: lib.rs:ACCENTS
msgid "Orange"
msgstr "Նարնջագույն"

#: lib.rs:ACCENTS
msgid "Red"
msgstr "Կարմիր"

#: lib.rs:ACCENTS
msgid "Pink"
msgstr "Վարդագույն"

#: lib.rs:ACCENTS
msgid "Purple"
msgstr "Մանուշակագույն"

#: lib.rs:ACCENTS
msgid "Slate"
msgstr "Թերթաքարային"

#: com.man.Installer.desktop
msgid "System Installer"
msgstr "Համակարգի տեղադրիչ"

#: com.man.Installer.desktop
msgid "Install MAN on this computer"
msgstr "Տեղադրել MAN այս համակարգչում"

#: com.man.Snapshots.desktop
msgid "System Restore"
msgstr "Համակարգի վերականգնում"

#: com.man.Snapshots.desktop
msgid "Create and restore snapshots of the system"
msgstr "Ստեղծել և վերականգնել համակարգի պատկերահաններ"

#: com.man.Updater.desktop
msgid "System Update Installer"
msgstr "Համակարգի թարմացումների տեղադրիչ"

#: com.man.Updater.desktop
msgid "Install a MAN system update file"
msgstr "Տեղադրել MAN համակարգի թարմացման ֆայլ"

#: com.man.Installer.desktop
msgid "Offer to install MAN when the live session starts"
msgstr "Առաջարկում է տեղադրել MAN-ը կենդանի աշխատաշրջանի մեկնարկին"

#: com.man.UpdateNotice.desktop
msgid "MAN Update Notice"
msgstr "MAN թարմացման ծանուցում"

#: com.man.UpdateNotice.desktop
msgid "Tells you once after logging in that MAN was updated"
msgstr "Մուտքից հետո մեկ անգամ տեղեկացնում է, որ MAN-ը թարմացվել է"

#: com.man.Oobe.desktop
msgid "Set up your new MAN computer"
msgstr "Կարգավորեք ձեր նոր MAN համակարգիչը"

#: man-oobe.desktop
msgid "First-start setup of MAN"
msgstr "MAN-ի առաջին կարգավորում"
