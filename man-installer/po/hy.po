#: backend.rs:46
msgid "Could not start the system helper."
msgstr "Չհաջողվեց գործարկել համակարգի օգնականը։"

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "Չհաջողվեց կապ հաստատել համակարգի օգնականի հետ։"

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "Կապը համակարգի օգնականի հետ կորավ։"

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "Թույլտվությունը չեղարկվեց։"

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "Այս գործողության համար անհրաժեշտ են ադմինիստրատորի իրավունքներ։"

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "Համակարգի օգնականն անսպասելիորեն կանգ առավ։"

#: installer.rs:78
msgid "No EFI system partition"
msgstr "EFI համակարգային բաժին չկա"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Ազատ է միայն {free}, MAN-ին պետք է {need}։ Տեղ ազատեք DUHACH!-ով Windows-ում։"

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Ազատ տեղ չկա։ Գործարկեք DUHACH!-ը Windows-ում՝ MAN-ի համար տեղ բացելու համար։"

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN-ն աշխատում է այս սկավառակից"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Օգտագործվում է՝ բաժինը միացված է"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Չափազանց փոքր է, MAN-ին պետք է {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Տեղադրել MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN-ը տեղադրվում է։ Խնդրում ենք սպասել մինչև ավարտը։"

#: installer.rs:143
msgid "Language"
msgstr "Լեզու"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Վերագործարկել այս լեզվով"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Կենդանի աշխատաշրջանը կվերագործարկվի ընտրված լեզվով, և MAN-ը կտեղադրվի այդ լեզվով։"

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Բարի գալուստ MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Արագ, բաց և ամբողջությամբ կարգավորելի GNOME համակարգ։\n"
"Տեղադրեք այն այս համակարգչում կամ շարունակեք ուսումնասիրել կենդանի աշխատաշրջանը։"

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Տեղադրել MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Շարունակել փորձել MAN-ը"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Սկավառակների որոնում…"

#: installer.rs:250
msgid "Welcome"
msgstr "Բարի գալուստ"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Այս համակարգիչը գործարկվել է հին BIOS ռեժիմով։ MAN-ը կարելի է տեղադրել միայն UEFI համակարգիչներում․ վերագործարկեք և ընտրեք UEFI բեռնման տարբերակը։"

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Համակարգի օգնականը սկավառակների մասին տեղեկություն չվերադարձրեց։"

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Հաջորդը"

#: installer.rs:361
msgid "Installation Type"
msgstr "Տեղադրման տեսակ"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Ջնջել սկավառակը և տեղադրել MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Ընտրված սկավառակի ամբողջ բովանդակությունը կջնջվի, այդ թվում Windows-ը։"

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Խորհուրդ է տրվում։ Ընտրված սկավառակի ամբողջ բովանդակությունը կջնջվի։"

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Տեղադրել Windows-ի կողքին"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Խորհուրդ է տրվում։ MAN-ն օգտագործում է Windows-ի կողքի ազատ տեղը. Windows-ը և նրա ֆայլերը մնում են։ Համակարգն ընտրում եք յուրաքանչյուր գործարկման ժամանակ։"

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Վերատեղադրել MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Փոխարինում է համակարգը, բայց պահում է /home-ի անձնական ֆայլերը։ Ընթացիկ համակարգը պահվում է որպես պատկերահան։"

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Անհատական բաժիններ"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Փորձագետների համար՝ ընտրեք բաժինները ինքներդ կամ ստեղծեք դրանք «Սկավառակներ»-ով։"

#: installer.rs:392
msgid "Disk"
msgstr "Սկավառակ"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Ընտրեք ջնջվող սկավառակը։ Չօգտագործվող սկավառակները ցուցադրվում են պատճառով։"

#: installer.rs:418
msgid "No disks were found"
msgstr "Սկավառակներ չգտնվեցին"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Ազատ տեղ Windows-ի կողքին"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows-ի բաժիններին չեն դիպչում։ MAN-ը կիսում է EFI համակարգային բաժինը և Windows-ն ավելացնում իր բեռնման ցանկին։"

#: installer.rs:432
msgid "{size} free"
msgstr "{size} ազատ"

#: installer.rs:432
msgid "no free space"
msgstr "ազատ տեղ չկա"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Փոխարինվող տեղադրում"

#: installer.rs:477
msgid "no home folders"
msgstr "տնային պանակներ չկան"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "տնային պանակներ՝ {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "պատկերահաններ՝ {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN {model}-ում"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Գաղտնաբառային արտահայտություն {device}-ի համար"

#: installer.rs:500
msgid "Unlock"
msgstr "Ապակողպել"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Չհաջողվեց ստուգել տեղադրումը։"

#: installer.rs:554
msgid "Partitions"
msgstr "Բաժիններ"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Համակարգային բաժինը ձևաչափվում է Btrfs-ով և պարունակում է @system, @home և @snapshots։ Այն սկավառակի բաժինները, որից աշխատում է MAN-ը, չեն ցուցադրվում։"

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Բացել «Սկավառակներ»-ը՝ բաժիններ ստեղծելու կամ չափափոխելու համար"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Թարմացնել բաժինների ցանկը"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Ընտրեք բաժին"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI համակարգային բաժին"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Ձևաչափել EFI համակարգային բաժինը"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Թողեք անջատված՝ այլ համակարգերի բեռնիչները պահելու համար"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Համակարգային բաժին (ձևաչափվում է Btrfs-ով)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Բեռնման բաժին (անհրաժեշտ է գաղտնագրման համար)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Բաժինների ցանկը թարմացվեց"

#: installer.rs:650
msgid "Security"
msgstr "Անվտանգություն"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Գաղտնագրել համակարգը"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Պաշտպանում է ձեր տվյալները, եթե համակարգիչը կորչի կամ գողացվի։ Յուրաքանչյուր գործարկման ժամանակ պահանջվում է գաղտնաբառային արտահայտություն։"

#: installer.rs:656
msgid "Passphrase"
msgstr "Գաղտնաբառային արտահայտություն"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Հաստատեք գաղտնաբառային արտահայտությունը"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Պահեք այս արտահայտությունն ապահով տեղում"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Եթե այն կորչի, ոչ ոք չի կարողանա վերականգնել տվյալները։ Միջուկը և բեռնման ֆայլերը մնում են փոքր, չգաղտնագրված բեռնման բաժնում։"

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Արտահայտությունը պետք է ունենա առնվազն 8 նիշ։"

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Արտահայտությունները չեն համընկնում։"

#: installer.rs:748
msgid "Choose a disk."
msgstr "Ընտրեք սկավառակ։"

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Ընտրեք Windows-ով սկավառակը։"

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Ընտրեք փոխարինվող տեղադրումը։"

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Նախ ապակողպեք գաղտնագրված տեղադրումը։"

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Այս բաժինը MAN համակարգ չի պարունակում։"

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Ընտրեք EFI համակարգային բաժին։"

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Ընտրեք համակարգային բաժինը։"

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI և համակարգային բաժինները պետք է տարբեր լինեն։"

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Գաղտնագրման համար անհրաժեշտ է առանձին բեռնման բաժին։"

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Համակարգային բաժինը պետք է լինի առնվազն {size}։"

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI բաժինը FAT ձևաչափով չէ. միացրեք ձևաչափումը։"

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Համակարգային բաժինը միացված է. նախ անջատեք այն «Սկավառակներ»-ում։"

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Որտե՞ղ տեղադրել MAN-ը"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Ժամ և ստեղնաշար"

#: installer.rs:829
msgid "Time Zone"
msgstr "Ժամային գոտի"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Ստեղնաշարի դասավորություն"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Փորձեք ստեղնաշարը"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Մուտքագրեք այստեղ՝ ստուգելու, որ ստեղները ճիշտ նիշեր են տալիս։"

#: installer.rs:844
msgid "Type here"
msgstr "Մուտքագրեք այստեղ"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Ժամային գոտի և ստեղնաշար"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Սկավառակ ընտրված չէ"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Համակարգային բաժին ընտրված չէ"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Համակարգային բաժինը անհետացավ"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Տեղադրում ընտրված չէ"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Սկավառակն անհետացավ"

#: installer.rs:955
msgid "Review"
msgstr "Ստուգում"

#: installer.rs:958
msgid "Destination"
msgstr "Նպատակակետ"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Ջնջել սկավառակը և տեղադրել"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Անհատական բաժիններ"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Վերատեղադրել՝ պահելով /home-ը"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Windows-ի կողքին"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (կձևաչափվի)"

#: installer.rs:969
msgid " (kept)"
msgstr " (պահվում է)"

#: installer.rs:970
msgid "System Partition"
msgstr "Համակարգային բաժին"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (կձևաչափվի)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Բեռնման բաժին"

#: installer.rs:976
msgid "Installation"
msgstr "Տեղադրում"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Տեղ MAN-ի համար"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
