msgid "System Partition (formatted as Btrfs)"
msgstr "Systempartition (formateras som Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Startpartition (krävs med kryptering)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Partitionslistan uppdaterades"

#: installer.rs:650
msgid "Security"
msgstr "Säkerhet"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Kryptera systemet"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Skyddar dina data om datorn tappas bort eller blir stulen. En lösenfras efterfrågas vid varje start."

#: installer.rs:656
msgid "Passphrase"
msgstr "Lösenfras"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Bekräfta lösenfras"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Förvara lösenfrasen säkert"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Om den förloras kan ingen återställa dina data. Kärnan och startfilerna ligger på en liten okrypterad startpartition."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Lösenfrasen måste ha minst 8 tecken."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Lösenfraserna stämmer inte överens."

