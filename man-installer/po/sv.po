msgstr "Välj installationen som ska ersättas."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Lås först upp den krypterade installationen."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Den här partitionen innehåller inget MAN-system."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Välj en EFI-systempartition."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Välj systempartitionen."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI-partitionen och systempartitionen måste vara olika."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Kryptering kräver en separat startpartition."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Systempartitionen måste vara minst {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI-partitionen är inte FAT-formaterad; slå på formatering."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Systempartitionen är monterad; avmontera den först i Diskar."

