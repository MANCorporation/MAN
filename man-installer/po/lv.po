#: backend.rs:46
msgid "Could not start the system helper."
msgstr "Neizdevās palaist sistēmas palīgu."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "Neizdevās sazināties ar sistēmas palīgu."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "Savienojums ar sistēmas palīgu tika zaudēts."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "Autorizācija atcelta."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "Šai darbībai vajadzīgas administratora tiesības."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "Sistēmas palīgs negaidīti apstājās."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Nav EFI sistēmas nodalījuma"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Brīvs tikai {free}, MAN vajag {need}. Atbrīvojiet vietu ar DUHACH! sistēmā Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Nav brīvas vietas. Palaidiet DUHACH! sistēmā Windows, lai atbrīvotu vietu MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN darbojas no šī diska"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Tiek lietots: nodalījums ir piemontēts"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Pārāk mazs, MAN vajag {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Instalēt MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN tiek instalēts. Lūdzu, uzgaidiet, līdz tas beidzas."

#: installer.rs:143
msgid "Language"
msgstr "Valoda"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Pārstartēt šajā valodā"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Tiešraides sesija tiek pārstartēta izvēlētajā valodā, un MAN tiek instalēts šajā valodā."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Laipni lūdzam MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Ātra, atvērta un pilnībā pielāgojama GNOME sistēma.\n"
"Instalējiet to šajā datorā vai turpiniet izpētīt tiešraides sesiju."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Instalēt MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Turpināt izmēģināt MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Meklē diskus…"

#: installer.rs:250
msgid "Welcome"
msgstr "Laipni lūdzam"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Šis dators tika palaists vecajā BIOS režīmā. MAN var instalēt tikai UEFI datoros: pārstartējiet un izvēlieties UEFI palaišanas iespēju."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Sistēmas palīgs neatgrieza informāciju par diskiem."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Tālāk"

#: installer.rs:361
msgid "Installation Type"
msgstr "Instalēšanas veids"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Dzēst disku un instalēt MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Viss izvēlētajā diskā tiks izdzēsts, arī Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Ieteicams. Viss izvēlētajā diskā tiks izdzēsts."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Instalēt blakus Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Ieteicams. MAN izmanto brīvo vietu blakus Windows; Windows un tā faili paliek. Sistēmu izvēlaties katrā palaišanas reizē."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Pārinstalēt MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Aizstāj sistēmu, bet patur personiskos failus mapē /home. Pašreizējā sistēma tiek saglabāta kā momentuzņēmums."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Pielāgoti nodalījumi"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Ekspertiem: izvēlieties nodalījumus paši vai izveidojiet tos lietotnē Diski."

#: installer.rs:392
msgid "Disk"
msgstr "Disks"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Izvēlieties dzēšamo disku. Diski, kurus nevar izmantot, tiek rādīti ar iemeslu."

#: installer.rs:418
msgid "No disks were found"
msgstr "Diski netika atrasti"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Brīvā vieta blakus Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows nodalījumi netiek aizskarti. MAN koplieto EFI sistēmas nodalījumu un pievieno Windows savai palaišanas izvēlnei."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} brīvs"

#: installer.rs:432
msgid "no free space"
msgstr "nav brīvas vietas"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Aizstājamā instalācija"

#: installer.rs:477
msgid "no home folders"
msgstr "nav mājas mapju"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "mājas mapes: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "momentuzņēmumi: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN diskā {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Paroles frāze ierīcei {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Atslēgt"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Instalāciju neizdevās pārbaudīt."

#: installer.rs:554
msgid "Partitions"
msgstr "Nodalījumi"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Sistēmas nodalījums tiek formatēts Btrfs un satur @system, @home un @snapshots. Diska, no kura darbojas MAN, nodalījumi netiek rādīti."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Atvērt Diskus, lai izveidotu nodalījumus vai mainītu to izmēru"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Atsvaidzināt nodalījumu sarakstu"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Izvēlieties nodalījumu"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI sistēmas nodalījums"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Formatēt EFI sistēmas nodalījumu"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Atstājiet izslēgtu, lai saglabātu citu sistēmu palaidējus"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Sistēmas nodalījums (formatēts kā Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Palaišanas nodalījums (vajadzīgs šifrēšanai)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Nodalījumu saraksts atsvaidzināts"

#: installer.rs:650
msgid "Security"
msgstr "Drošība"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Šifrēt sistēmu"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Aizsargā jūsu datus, ja dators tiek pazaudēts vai nozagts. Paroles frāze tiek prasīta katrā palaišanas reizē."

#: installer.rs:656
msgid "Passphrase"
msgstr "Paroles frāze"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Apstiprināt paroles frāzi"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Glabājiet šo paroles frāzi drošā vietā"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Ja tā tiek pazaudēta, neviens nevar atgūt datus. Kodols un palaišanas faili paliek mazā nešifrētā palaišanas nodalījumā."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Paroles frāzei jābūt vismaz 8 rakstzīmēm."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Paroles frāzes nesakrīt."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Izvēlieties disku."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Izvēlieties disku ar Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Izvēlieties aizstājamo instalāciju."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Vispirms atslēdziet šifrēto instalāciju."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Šajā nodalījumā nav MAN sistēmas."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Izvēlieties EFI sistēmas nodalījumu."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Izvēlieties sistēmas nodalījumu."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI un sistēmas nodalījumiem jābūt atšķirīgiem."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Šifrēšanai vajadzīgs atsevišķs palaišanas nodalījums."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Sistēmas nodalījumam jābūt vismaz {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI nodalījums nav FAT formātā; ieslēdziet formatēšanu."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Sistēmas nodalījums ir piemontēts; vispirms atmontējiet to lietotnē Diski."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Kur instalēt MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Laiks un tastatūra"

#: installer.rs:829
msgid "Time Zone"
msgstr "Laika josla"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Tastatūras izkārtojums"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Pārbaudiet tastatūru"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Rakstiet šeit, lai pārbaudītu, vai taustiņi ievada pareizās rakstzīmes."

#: installer.rs:844
msgid "Type here"
msgstr "Rakstiet šeit"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Laika josla un tastatūra"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Disks nav izvēlēts"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Sistēmas nodalījums nav izvēlēts"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Sistēmas nodalījums pazuda"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Instalācija nav izvēlēta"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Disks pazuda"

#: installer.rs:955
msgid "Review"
msgstr "Pārskats"

#: installer.rs:958
msgid "Destination"
msgstr "Mērķis"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Dzēst disku un instalēt"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Pielāgoti nodalījumi"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Pārinstalēt, paturot /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Blakus Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (tiks formatēts)"

#: installer.rs:969
msgid " (kept)"
msgstr " (tiek paturēts)"

#: installer.rs:970
msgid "System Partition"
msgstr "Sistēmas nodalījums"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (tiks formatēts)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Palaišanas nodalījums"

#: installer.rs:976
msgid "Installation"
msgstr "Instalācija"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Vieta MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} brīvas vietas (tiek izveidots palaišanas un sistēmas nodalījums)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Bez izmaiņām. Tas parādās MAN palaišanas izvēlnē; EFI sistēmas nodalījums ir kopīgs."

#: installer.rs:983
msgid "Encryption"
msgstr "Šifrēšana"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Ieslēgta (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Izslēgta"

#: installer.rs:985
msgid "File System"
msgstr "Datņu sistēma"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system priekš MAN, @home jūsu failiem, @snapshots atjaunošanas punktiem. Visi koplieto brīvo vietu."

#: installer.rs:991
msgid "System"
msgstr "Sistēma"

#: installer.rs:993
msgid "Your Account"
msgstr "Jūsu konts"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Tiek izveidots MAN Setup, kad dators tiek palaists pirmo reizi, kopā ar datora nosaukumu, izskatu un privātuma iestatījumiem."

#: installer.rs:998
msgid "Keyboard"
msgstr "Tastatūra"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "Visi dati diskā {model} ({path}) tiks izdzēsti."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Dzēst un instalēt"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Izvēlētie nodalījumi tiks formatēti. Citi nodalījumi nemainās."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Formatēt un instalēt"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "Pašreizējā sistēma tiek aizstāta. Jūsu faili mapē /home paliek, un vecā sistēma tiek saglabāta kā momentuzņēmums."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "_Pārinstalēt"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN tiek instalēts brīvajā vietā. Windows un tā faili nemainās."

#: installer.rs:1005
msgid "_Install"
msgstr "_Instalēt"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "Gatavs instalēšanai"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "Dzēst {model}?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "Visi faili un nodalījumi ierīcē {path} ({size}) tiks neatgriezeniski izdzēsti. To nevar atsaukt."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "Dzēst un instalēt"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "Formatēt izvēlētos nodalījumus?"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "Visi dati izvēlētajos nodalījumos tiks neatgriezeniski izdzēsti. Citi nodalījumi nemainās."

#: installer.rs:1037
msgid "Format and Install"
msgstr "Formatēt un instalēt"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "Instalēt MAN blakus Windows?"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "MAN tiek instalēts {free} brīvajā vietā diskā {model} ({path}). Windows un tā faili nemainās."

#: installer.rs:1046
msgid "Install"
msgstr "Instalēt"

#: installer.rs:1050
msgid "Reinstall MAN?"
msgstr "Pārinstalēt MAN?"

#: installer.rs:1051
msgid "The installed system will be replaced by a fresh copy. Personal files in /home are kept and the old system remains available as a snapshot."
msgstr "Instalētā sistēma tiks aizstāta ar jaunu kopiju. Personiskie faili mapē /home paliek, un vecā sistēma paliek pieejama kā momentuzņēmums."

#: installer.rs:1052
msgid "Reinstall"
msgstr "Pārinstalēt"

#: installer.rs:1057
msgid "_Cancel"
msgstr "_Atcelt"

#: installer.rs:1076
msgid "Installing MAN"
msgstr "Instalē MAN"

#: installer.rs:1077
msgid "Starting…"
msgstr "Sāk…"

#: installer.rs:1085
msgid "Details"
msgstr "Sīkāka informācija"

#: installer.rs:1090
msgid "Installing"
msgstr "Instalē"

#: installer.rs:1103
msgid "Step {index} of {n}  ·  {title}"
msgstr "Solis {index} no {n}  ·  {title}"

#: installer.rs:1128
msgid "Log"
msgstr "Žurnāls"

#: installer.rs:1138
msgid "MAN Is Installed"
msgstr "MAN ir instalēts"

#: installer.rs:1143
msgid "Restart the computer to start using MAN. A menu at every start lets you choose MAN or Windows; the temporary MAN installer partition is removed by MAN on its first start."
msgstr "Pārstartējiet datoru, lai sāktu lietot MAN. Katrā palaišanas reizē izvēlnē var izvēlēties MAN vai Windows; pagaidu instalētāja nodalījumu MAN noņem pirmajā palaišanas reizē."

#: installer.rs:1149
msgid "Restart the computer to start using MAN. You can remove the installation media; if it stays connected, MAN still starts from the new disk."
msgstr "Pārstartējiet datoru, lai sāktu lietot MAN. Instalācijas datu nesēju varat atvienot; ja tas paliek pievienots, MAN tik un tā palaižas no jaunā diska."

#: installer.rs:1156
msgid "_Restart Now"
msgstr "_Pārstartēt tagad"

#: installer.rs:1171
msgid "Done"
msgstr "Gatavs"

#: installer.rs:1182
msgid "Installation Failed"
msgstr "Instalēšana neizdevās"

#: installer.rs:1186
msgid "No other disk was changed, and the installer has released the target disk. You can review the plan and try again."
msgstr "Neviens cits disks netika mainīts, un instalētājs atbrīvoja mērķa disku. Varat pārskatīt plānu un mēģināt vēlreiz."

#: installer.rs:1191
msgid "_Review and Try Again"
msgstr "_Pārskatīt un mēģināt vēlreiz"

#: installer.rs:1193
msgid "_Show Details"
msgstr "_Rādīt sīkāku informāciju"

#: installer.rs:1208
msgid "Installation Log"
msgstr "Instalēšanas žurnāls"

#: langui.rs:229
msgid "Search languages"
msgstr "Meklēt valodas"

#: langui.rs:269
msgid "Search countries"
msgstr "Meklēt valstis"

#: oobe.rs:165
msgid "The system disk was not found."
msgstr "Sistēmas disks netika atrasts."

#: oobe.rs:173
msgid "Encryption needs the Btrfs layout created by the MAN installer."
msgstr "Šifrēšanai vajadzīgs MAN instalētāja izveidotais Btrfs izkārtojums."

#: oobe.rs:177
msgid "This installation has no separate boot partition, which encryption needs. Reinstall MAN with “Erase Disk” to use encryption."
msgstr "Šai instalācijai nav atsevišķa palaišanas nodalījuma, kas vajadzīgs šifrēšanai. Lai izmantotu šifrēšanu, pārinstalējiet MAN ar “Dzēst disku”."

#: oobe.rs:501
msgid "MAN Setup"
msgstr "MAN Setup"

#: oobe.rs:554
msgid "Where Are You?"
msgstr "Kur jūs atrodaties?"

#: oobe.rs:554
msgid "Your country or region sets the date, time and number formats."
msgstr "Jūsu valsts vai reģions nosaka datuma, laika un skaitļu formātu."

#: oobe.rs:572
msgid "Country"
msgstr "Valsts"

#: oobe.rs:587
msgid "GNU General Public License, version 2"
msgstr "GNU Vispārējā publiskā licence, 2. versija"

#: oobe.rs:587
msgid "The Linux kernel and many system tools"
msgstr "Linux kodols un daudzi sistēmas rīki"

#: oobe.rs:588
msgid "GNU General Public License, version 3"
msgstr "GNU Vispārējā publiskā licence, 3. versija"

#: oobe.rs:588
msgid "Many GNU and GNOME programs"
msgstr "Daudzas GNU un GNOME programmas"

#: oobe.rs:589
msgid "GNU Lesser General Public License, version 2.1"
msgstr "GNU Mazākā vispārējā publiskā licence, 2.1. versija"

#: oobe.rs:589
msgid "GTK, GLib and many libraries"
msgstr "GTK, GLib un daudzas bibliotēkas"

#: oobe.rs:590
msgid "GNU Lesser General Public License, version 3"
msgstr "GNU Mazākā vispārējā publiskā licence, 3. versija"

#: oobe.rs:590
msgid "Libraries"
msgstr "Bibliotēkas"

#: oobe.rs:591
msgid "Mozilla Public License 2.0"
msgstr "Mozilla publiskā licence 2.0"

#: oobe.rs:591
msgid "Programs and libraries from Mozilla and others"
msgstr "Mozilla un citu programmas un bibliotēkas"

#: oobe.rs:592
msgid "Apache License 2.0"
msgstr "Apache licence 2.0"

#: oobe.rs:592
msgid "Libraries and tools"
msgstr "Bibliotēkas un rīki"

#: oobe.rs:597
msgid "License Agreement"
msgstr "Licences līgums"

#: oobe.rs:597
msgid "Please read and accept the terms under which MAN is provided."
msgstr "Lūdzu, izlasiet un pieņemiet noteikumus, ar kādiem tiek nodrošināts MAN."

#: oobe.rs:608
msgid "Licenses"
msgstr "Licences"

#: oobe.rs:616
msgid "The license text is not available ({path})."
msgstr "Licences teksts nav pieejams ({path})."

#: oobe.rs:622
msgid "I have read and accept the license terms"
msgstr "Esmu izlasījis(-usi) un pieņemu licences noteikumus"

#: oobe.rs:692
msgid "Wired"
msgstr "Vadu"

#: oobe.rs:698
msgid "Not connected"
msgstr "Nav savienots"

#: oobe.rs:732
msgid "Connect to the Internet"
msgstr "Savienoties ar internetu"

#: oobe.rs:732
msgid "Connecting lets MAN set the time and keep your software up to date. You can also do this later."
msgstr "Ar savienojumu MAN var iestatīt laiku un uzturēt programmatūru atjauninātu. To var izdarīt arī vēlāk."

#: oobe.rs:734
msgid "Checking the connection…"
msgstr "Pārbauda savienojumu…"

#: oobe.rs:740
msgid "Wi-Fi Networks"
msgstr "Wi-Fi tīkli"

#: oobe.rs:742
msgid "Search Again"
