msgstr "Disks gatavs"

#: install.rs:853
msgid "Keeping your accounts and settings"
msgstr "Saglabā jūsu kontus un iestatījumus"

#: install.rs:869
msgid "Skipped"
msgstr "Izlaists"

#: install.rs:873
msgid "Creating a snapshot of the fresh system"
msgstr "Izveido jaunās sistēmas momentuzņēmumu"

#: install.rs:879
msgid "Adding the snapshot to the boot menu"
msgstr "Pievieno momentuzņēmumu palaišanas izvēlnei"

#: install.rs:883
msgid "Unmounting"
msgstr "Atmontē"

#: install.rs:93
msgid "The installer backend must run as root."
msgstr "Instalētāja palīgam jādarbojas kā root."

#: install.rs:121
msgid "This computer was not started in UEFI mode. MAN requires UEFI."
msgstr "Šis dators netika palaists UEFI režīmā. MAN vajag UEFI."

#: install.rs:125
msgid "The username is not valid."
msgstr "Lietotājvārds nav derīgs."

#: install.rs:128
msgid "A password is required."
msgstr "Parole ir obligāta."

#: install.rs:132
msgid "The computer name is not valid."
msgstr "Datora nosaukums nav derīgs."

#: install.rs:138
msgid "Unknown language."
msgstr "Nezināma valoda."

#: install.rs:144
msgid "The encryption passphrase must have at least 8 characters."
msgstr "Šifrēšanas paroles frāzei jābūt vismaz 8 rakstzīmēm."

#: install.rs:155
msgid "The disk changed after you confirmed the installation. Nothing was modified; please review and confirm again."
msgstr "Disks mainījās pēc tam, kad apstiprinājāt instalēšanu. Nekas netika mainīts; pārskatiet un apstipriniet vēlreiz."

#: install.rs:171
msgid "Choose a system partition."
msgstr "Izvēlieties sistēmas nodalījumu."

#: install.rs:178
msgid "The confirmed disk does not hold the chosen system partition."
msgstr "Apstiprinātajā diskā nav izvēlētā sistēmas nodalījuma."

#: install.rs:190
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "Palaišanas nodalījumam jābūt atsevišķam no EFI un sistēmas nodalījumiem."

#: install.rs:193
msgid "The boot partition must be at least 512 MB."
msgstr "Palaišanas nodalījumam jābūt vismaz 512 MB."

#: install.rs:208
msgid "No installation chosen."
msgstr "Instalācija nav izvēlēta."

#: install.rs:212
msgid "The confirmed disk does not hold the chosen installation."
msgstr "Apstiprinātajā diskā nav izvēlētās instalācijas."

#: install.rs:379
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "Šifrētajai instalācijai nav MAN_BOOT nodalījuma."

#: install.rs:745
msgid "No kernel with matching modules was found in /boot."
msgstr "Mapē /boot netika atrasts kodols ar atbilstošiem moduļiem."

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "Valodu jāmaina sistēmas palīgam."

#: oobe.rs:205
msgid "Applying your settings"
msgstr "Lieto jūsu iestatījumus"

#: oobe.rs:213
msgid "Preparing disk encryption"
msgstr "Sagatavo diska šifrēšanu"

#: oobe.rs:217
msgid "Finishing"
msgstr "Pabeidz"

#: oobe.rs:101
msgid "MAN Setup must be finished by the system helper."
msgstr "MAN Setup jāpabeidz sistēmas palīgam."

#: oobe.rs:104
msgid "MAN Setup has already been completed on this computer."
msgstr "MAN Setup šajā datorā jau ir pabeigts."

#: oobe.rs:125
msgid "Unknown accent color."
msgstr "Nezināma akcenta krāsa."

#: oobe.rs:129
msgid "The chosen wallpaper is not available."
msgstr "Izvēlētais fona attēls nav pieejams."

#: oobe.rs:147
msgid "This system cannot be encrypted."
msgstr "Šo sistēmu nevar šifrēt."

#: oobe.rs:258
msgid "The setup key is missing, so encryption cannot continue in the background."
msgstr "Trūkst iestatīšanas atslēgas, tāpēc šifrēšana nevar turpināties fonā."

#: recovery.rs:450
msgid "Downloading MAN"
msgstr "Lejupielādē MAN"

#: recovery.rs:459
msgid "Opening the downloaded MAN"
msgstr "Atver lejupielādēto MAN"

#: recovery.rs:85
msgid "Leaving out what Recovery does not need"
msgstr "Izlaiž to, kas atkopšanai nav vajadzīgs"

#: recovery.rs:87
msgid "Setting up the recovery system"
msgstr "Iestata atkopšanas sistēmu"

#: recovery.rs:89
msgid "Adding its start-up files"
msgstr "Pievieno tās palaišanas failus"

#: recovery.rs:104
msgid "MAN Recovery is ready"
msgstr "MAN atkopšana ir gatava"

#: recovery.rs:64
msgid "This MAN has no MAN Recovery program."
msgstr "Šim MAN nav MAN atkopšanas programmas."

#: recovery.rs:82
msgid "MAN Recovery was not started."
msgstr "MAN atkopšana netika sākta."

#: recovery.rs:206
msgid "The installed system has no kernel for MAN Recovery."
msgstr "Instalētajai sistēmai nav kodola MAN atkopšanai."

#: recovery.rs:234
msgid "MAN Recovery was not started from the boot menu."
msgstr "MAN atkopšana netika palaista no sāknēšanas izvēlnes."

#: recovery.rs:235
msgid "The disk of this MAN was not found."
msgstr "Šī MAN disks netika atrasts."

#: recovery.rs:240
msgid "This works only in MAN Recovery."
msgstr "Tas darbojas tikai MAN atkopšanā."

#: recovery.rs:290
msgid "The password is not correct."
msgstr "Parole nav pareiza."

#: recovery.rs:333
msgid "Invalid snapshot id."
msgstr "Nederīgs momentuzņēmuma ID."

#: recovery.rs:405
msgid "No MAN for this computer was found on MAN's download page."
msgstr "MAN lejupielādes lapā šim datoram MAN netika atrasts."

#: recovery.rs:434
msgid "The downloaded MAN is damaged (its checksum does not match). Try again."
msgstr "Lejupielādētais MAN ir bojāts (kontrolsumma nesakrīt). Mēģiniet vēlreiz."

#: recovery.rs:491
msgid "The partition of this MAN was not found."
msgstr "Šī MAN nodalījums netika atrasts."

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "Sistēma nav instalēta uz Btrfs, tāpēc momentuzņēmumi nav pieejami."

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "Momentuzņēmuma atjaunošana gaida pārstartēšanu. Vispirms pārstartējiet datoru, lai to pabeigtu."

#: update.rs:32
msgid "Checking the update"
msgstr "Pārbauda atjauninājumu"

#: update.rs:32
msgid "Creating a snapshot"
msgstr "Izveido momentuzņēmumu"

#: update.rs:32
msgid "Preparing the update area"
msgstr "Sagatavo atjaunināšanas apgabalu"

#: update.rs:32
msgid "Unpacking the new system"
msgstr "Izpako jauno sistēmu"

#: update.rs:32
msgid "Moving your accounts and settings"
msgstr "Pārnes jūsu kontus un iestatījumus"

#: update.rs:32
msgid "Preparing the restart"
msgstr "Sagatavo pārstartēšanu"

#: update.rs:195
msgid "Unpacked"
msgstr "Izpakots"

#: update.rs:285
msgid "Accounts"
msgstr "Konti"

#: update.rs:338
msgid "Reinstalling kept apps"
msgstr "Atkārtoti instalē saglabātās lietotnes"

#: update.rs:404
msgid "Removing installer-only software"
msgstr "Noņem tikai instalētājam paredzēto programmatūru"

#: update.rs:450
msgid "Building the update boot image"
msgstr "Veido atjauninājuma palaišanas attēlu"

#: update.rs:453
msgid "Adding the one-time boot entry"
msgstr "Pievieno vienreizēju palaišanas ierakstu"

#: update.rs:488
msgid "The update is genuine"
msgstr "Atjauninājums ir īsts"

#: update.rs:494
msgid "Snapshot created"
msgstr "Momentuzņēmums izveidots"

#: update.rs:505
msgid "Update area ready"
msgstr "Atjaunināšanas apgabals gatavs"

#: update.rs:528
msgid "Preparing the new system"
msgstr "Sagatavo jauno sistēmu"

#: update.rs:184
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Atjauninājuma fails ir bojāts (kontrolsumma nesakrīt). Lejupielādējiet to vēlreiz."

#: update.rs:187
msgid "The update file could not be read completely."
msgstr "Atjauninājuma failu neizdevās nolasīt pilnībā."

#: update.rs:416
msgid "The update contains no kernel."
msgstr "Atjauninājumā nav kodola."

#: update.rs:470
msgid "Updates must be installed by the system helper."
msgstr "Atjauninājumi jāinstalē sistēmas palīgam."

#: update.rs:480
msgid "The chosen installation was not found."
msgstr "Izvēlētā instalācija netika atrasta."

#: update.rs:482
msgid "Only the running MAN installation can be updated."
msgstr "Atjaunināt var tikai darbojošos MAN instalāciju."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Tas nav MAN atjauninājuma fails (nav manifesta)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "Atjauninājums nav parakstīts, tāpēc tam nevar uzticēties."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "Atjauninājuma paraksts ir bojāts."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "Atjauninājumu nav parakstījis MAN. Tas var būt mainīts vai nākt no neuzticama avota."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "Atjauninājuma manifests nav derīgs."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "Paroles frāze nav pareiza, vai šifrēto nodalījumu nevar atvērt."

