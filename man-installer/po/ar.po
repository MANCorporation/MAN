#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "هذا الملف ليس تطبيقًا يمكن تثبيته هنا (‎.deb أو ‎.flatpak أو ‎.flatpakref أو AppImage)."

#: appinstaller.rs:128
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "هذا التطبيق مصنوع لحواسيب {arch} ولا يعمل على هذا الحاسوب (x86-64)."

#: appinstaller.rs:313
msgid "The file could not be read. It may be damaged."
msgstr "تعذرت قراءة الملف. ربما يكون تالفًا."

#: appinstaller.rs:485
msgid "This is not an AppImage."
msgstr "هذا ليس ملف AppImage."

#: appinstaller.rs:679
msgid "Introduction"
msgstr "مقدمة"

#: appinstaller.rs:680
msgid "License"
msgstr "الترخيص"

#: appinstaller.rs:681
msgid "Destination Select"
msgstr "اختيار الوجهة"

#: appinstaller.rs:682
msgid "Installation Type"
msgstr "نوع التثبيت"

#: appinstaller.rs:683
msgid "Installation"
msgstr "التثبيت"

#: appinstaller.rs:684
msgid "Summary"
msgstr "الملخص"

#: appinstaller.rs:790
msgid "_Continue"
msgstr "_تابع"

#: appinstaller.rs:799
msgid "Welcome to the {name} Installer"
msgstr "مرحبًا بك في مثبّت {name}"

#: appinstaller.rs:803
msgid "Software License Agreement"
msgstr "اتفاقية ترخيص البرنامج"

#: appinstaller.rs:813
msgid "Do You Agree to the License?"
msgstr "هل توافق على الترخيص؟"

#: appinstaller.rs:814
msgid "To continue installing, you must agree to the terms of the software license agreement."
msgstr "لمتابعة التثبيت، يجب أن توافق على شروط اتفاقية ترخيص البرنامج."

#: appinstaller.rs:816
msgid "_Read License"
msgstr "_اقرأ الترخيص"

#: appinstaller.rs:817
msgid "_Agree"
msgstr "_أوافق"

#: appinstaller.rs:830
msgid "Select a Destination"
msgstr "اختر وجهة"

#: appinstaller.rs:834
msgid "Standard Install"
msgstr "تثبيت قياسي"

#: appinstaller.rs:835
msgid "_Install"
msgstr "_ثبّت"

#: appinstaller.rs:848
msgid "Debian package (.deb)"
msgstr "حزمة دبيان (‎.deb)"

#: appinstaller.rs:849
msgid "Flatpak app"
msgstr "تطبيق Flatpak"

#: appinstaller.rs:850
msgid "Flatpak app from {source}"
msgstr "تطبيق Flatpak من {source}"

#: appinstaller.rs:851
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:869
msgid "You will be guided through the steps necessary to install this software."
msgstr "سنرشدك خلال الخطوات اللازمة لتثبيت هذا البرنامج."

#: appinstaller.rs:880
msgid "Version"
msgstr "الإصدار"

#: appinstaller.rs:883
msgid "Publisher"
msgstr "الناشر"

#: appinstaller.rs:885
msgid "Type"
msgstr "النوع"

#: appinstaller.rs:887
msgid "Size"
msgstr "الحجم"

#: appinstaller.rs:893
msgid "Website"
msgstr "الموقع"

#: appinstaller.rs:895
msgid "File"
msgstr "الملف"

#: appinstaller.rs:905
msgid "This app is installed already. Installing it again replaces it."
msgstr "هذا التطبيق مثبّت بالفعل. تثبيته مرة أخرى يستبدله."

#: appinstaller.rs:908
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr "تصبح التطبيقات من حزم ‎.deb جزءًا من النظام. يستبدل تحديث MAN النظام، لذا لا يُعاد تثبيتها بعد التحديث إلا إذا احتفظت بها (الخطوات التالية)."

#: appinstaller.rs:911
msgid "Only install apps from sources you trust."
msgstr "ثبّت التطبيقات من مصادر تثق بها فقط."

#: appinstaller.rs:917
msgid "Where do you want to install {name}?"
msgstr "أين تريد تثبيت {name}؟"

#: appinstaller.rs:922
msgid "Only your account can use the app."
msgstr "يمكن لحسابك فقط استخدام التطبيق."

#: appinstaller.rs:923
msgid "Needs administrator rights."
msgstr "يحتاج إلى صلاحيات المدير."

#: appinstaller.rs:930
msgid "Only for Me"
msgstr "لي فقط"

#: appinstaller.rs:930
msgid "For All Users of This Computer"
msgstr "لكل مستخدمي هذا الحاسوب"

#: appinstaller.rs:945
msgid "This will take {size} of space on your computer."
msgstr "سيشغل هذا {size} من المساحة على حاسوبك."

#: appinstaller.rs:947
msgid "The app is downloaded from {source}."
msgstr "يُنزَّل التطبيق من {source}."

#: appinstaller.rs:949
msgid "The app is installed for all users of this computer."
msgstr "يُثبَّت التطبيق لكل مستخدمي هذا الحاسوب."

#: appinstaller.rs:949
msgid "The app is installed only for you."
msgstr "يُثبَّت التطبيق لك فقط."

#: appinstaller.rs:952
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "يُنقل ملف AppImage إلى {folder} ويُضاف إلى تطبيقاتك."

#: appinstaller.rs:958
msgid "Keep After MAN Updates"
msgstr "الاحتفاظ به بعد تحديثات MAN"

#: appinstaller.rs:959
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "يعيد MAN تثبيت التطبيق بعد كل تحديث. تُحفظ ملفات حزمته لذلك."

#: appinstaller.rs:967
msgid "Click Install to install {name}."
msgstr "انقر «ثبّت» لتثبيت {name}."

#: appinstaller.rs:973
msgid "Checking what else the app needs…"
msgstr "جارٍ التحقق مما يحتاجه التطبيق أيضًا…"

#: appinstaller.rs:983
msgid "Also installs the packages it needs: {list}"
msgstr "يثبّت أيضًا الحزم التي يحتاجها: {list}"

#: appinstaller.rs:989
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "بعض الحزم التي يحتاجها التطبيق غير متاحة بعد. يجلب التثبيت أولًا أحدث قوائم الحزم؛ وإن بقيت مفقودة فلا يمكن تثبيت التطبيق."

#: appinstaller.rs:1050
msgid "Installing {name}…"
msgstr "جارٍ تثبيت {name}…"

#: appinstaller.rs:1056
msgid "Preparing…"
msgstr "جارٍ التحضير…"

#: appinstaller.rs:1063
msgid "Details"
msgstr "التفاصيل"

#: appinstaller.rs:1103
msgid "Installing the package…"
msgstr "جارٍ تثبيت الحزمة…"

#: appinstaller.rs:1122
msgid "Moving the app to its folder…"
msgstr "جارٍ نقل التطبيق إلى مجلده…"

#: appinstaller.rs:1131
msgid "The app could not be installed."
msgstr "تعذر تثبيت التطبيق."

#: appinstaller.rs:1135
msgid "Installing the app with Flatpak…"
msgstr "جارٍ تثبيت التطبيق باستخدام Flatpak…"

#: appinstaller.rs:1159
msgid "Log"
msgstr "السجل"

#: appinstaller.rs:1189
msgid "_Close"
msgstr "_أغلق"

#: appinstaller.rs:1199
msgid "The Installation Was Successful"
msgstr "نجح التثبيت"

#: appinstaller.rs:1199
msgid "The app was installed."
msgstr "ثُبّت التطبيق."

#: appinstaller.rs:1204
msgid "The Installation Failed"
msgstr "فشل التثبيت"

#: appinstaller.rs:1215
msgid "_Open"
msgstr "_افتح"

#: appinstaller.rs:1225
msgid "_Show Details"
msgstr "_اعرض التفاصيل"

#: appinstaller.rs:1228
msgid "Installation Log"
msgstr "سجل التثبيت"

#: appinstaller.rs:1255
msgid "App Installer"
msgstr "مثبّت التطبيقات"

#: appinstaller.rs:1276
msgid "Go _Back"
msgstr "_رجوع"

#: appinstaller.rs:1349
msgid "Reading the app…"
msgstr "جارٍ قراءة التطبيق…"

#: appinstaller.rs:1358
msgid "Install {name}"
msgstr "ثبّت {name}"

#: appinstaller.rs:1377
msgid "Apps"
msgstr "التطبيقات"

#: appinstaller.rs:1383
msgid "Choose an App to Install"
msgstr "اختر تطبيقًا لتثبيته"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "تعذّر تشغيل مساعد النظام."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "تعذّر التواصل مع مساعد النظام."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "انقطع الاتصال بمساعد النظام."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "أُلغي التخويل."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "يتطلب هذا الإجراء صلاحيات المدير."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "توقف مساعد النظام بشكل غير متوقع."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "لا يوجد قسم نظام EFI"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "المساحة الحرة {free} فقط، ويحتاج MAN إلى {need}. أفرغ مساحة باستخدام DUHACH! في Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "لا توجد مساحة حرة. شغّل DUHACH! في Windows لإفساح مكان لـ MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "يعمل MAN من هذا القرص"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "قيد الاستخدام: يوجد قسم موصول"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "صغير جدًا، يحتاج MAN إلى {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "ثبّت MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "جارٍ تثبيت MAN. انتظر حتى ينتهي."

#: installer.rs:143
msgid "Language"
msgstr "اللغة"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_أعد التشغيل بهذه اللغة"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "تُعاد الجلسة الحية بالّلغة المختارة، ويُثبَّت MAN بها."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "مرحبًا بك في MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"نظام GNOME سريع ومفتوح وقابل للتخصيص بالكامل.\n"
"ثبّته على هذا الحاسوب، أو تابع استكشاف الجلسة الحية."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_ثبّت MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_تابع تجربة MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "جارٍ البحث عن الأقراص…"

#: installer.rs:250
msgid "Welcome"
msgstr "مرحبًا"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "بدأ هذا الحاسوب في وضع BIOS القديم. لا يمكن تثبيت MAN إلا على حواسيب UEFI: أعد التشغيل واختر خيار الإقلاع UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "لم يُرجع مساعد النظام أي معلومات عن الأقراص."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_التالي"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "امسح القرص وثبّت MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "يُحذف كل ما على القرص المختار، بما في ذلك Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "موصى به. يُحذف كل ما على القرص المختار."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "ثبّت بجانب Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "موصى به. يستخدم MAN المساحة الحرة بجانب Windows، ويبقى Windows وملفاته. تختار النظام عند كل إقلاع."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "أعد تثبيت MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "يستبدل النظام لكنه يحتفظ بالملفات الشخصية في ‎/home. يُحفظ النظام الحالي كلقطة."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "أقسام مخصصة"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "للخبراء: اختر الأقسام بنفسك أو أنشئها باستخدام «الأقراص»."

#: installer.rs:392
msgid "Disk"
msgstr "القرص"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "اختر القرص الذي سيُمسح. تظهر الأقراص غير القابلة للاستخدام مع السبب."

#: installer.rs:418
msgid "No disks were found"
msgstr "لم يُعثر على أقراص"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "المساحة الحرة بجانب Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "لا تُمس أقسام Windows. يشارك MAN قسم نظام EFI ويضيف Windows إلى قائمة الإقلاع الخاصة به."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} حرة"

#: installer.rs:432
msgid "no free space"
msgstr "لا توجد مساحة حرة"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "التثبيت المراد استبداله"

#: installer.rs:477
msgid "no home folders"
msgstr "لا توجد مجلدات منزلية"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "المجلدات المنزلية: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "اللقطات: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN على {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "عبارة المرور لـ {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "افتح القفل"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "تعذّر فحص التثبيت."

#: installer.rs:554
msgid "Partitions"
msgstr "الأقسام"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "يُهيّأ قسم النظام بنظام Btrfs ويحتوي على ‎@system و‎@home و‎@snapshots. لا تظهر أقسام القرص الذي يعمل منه MAN."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "افتح «الأقراص» لإنشاء الأقسام أو تغيير حجمها"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "حدّث قائمة الأقسام"

#: installer.rs:567
msgid "Choose a partition"
msgstr "اختر قسمًا"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "قسم نظام EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "هيّئ قسم نظام EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "اتركه معطّلًا للإبقاء على محمّلات الإقلاع للأنظمة الأخرى"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "قسم النظام (يُهيّأ بنظام Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "قسم الإقلاع (مطلوب مع التشفير)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "حُدّثت قائمة الأقسام"

#: installer.rs:650
msgid "Security"
msgstr "الأمان"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "شفّر النظام"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "يحمي بياناتك إذا فُقد الحاسوب أو سُرق. تُطلب عبارة مرور عند كل إقلاع."

#: installer.rs:656
msgid "Passphrase"
msgstr "عبارة المرور"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "أكّد عبارة المرور"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "احتفظ بعبارة المرور هذه في مكان آمن"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "إذا فقدتها فلن يستطيع أحد استعادة البيانات. تبقى النواة وملفات الإقلاع على قسم إقلاع صغير غير مشفّر."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "يجب أن تتكون عبارة المرور من 8 محارف على الأقل."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "عبارتا المرور غير متطابقتين."

#: installer.rs:748
msgid "Choose a disk."
msgstr "اختر قرصًا."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "اختر القرص الذي عليه Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "اختر التثبيت المراد استبداله."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "افتح قفل التثبيت المشفّر أولًا."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "لا يحتوي هذا القسم على نظام MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "اختر قسم نظام EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "اختر قسم النظام."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "يجب أن يكون قسم EFI وقسم النظام مختلفين."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "يحتاج التشفير إلى قسم إقلاع منفصل."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "يجب ألا يقل قسم النظام عن {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "قسم EFI غير مهيّأ بنظام FAT؛ فعّل التهيئة."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "قسم النظام موصول؛ افصله أولًا في «الأقراص»."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "أين يُثبَّت MAN؟"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "الوقت ولوحة المفاتيح"

#: installer.rs:829
msgid "Time Zone"
msgstr "المنطقة الزمنية"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "تخطيط لوحة المفاتيح"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "جرّب لوحة المفاتيح"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "اكتب هنا للتأكد من أن المفاتيح تُخرج المحارف الصحيحة."

#: installer.rs:844
msgid "Type here"
msgstr "اكتب هنا"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "المنطقة الزمنية ولوحة المفاتيح"

#: installer.rs:920
msgid "No disk chosen"
msgstr "لم يُختر قرص"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "لم يُختر قسم نظام"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "اختفى قسم النظام"

#: installer.rs:933
msgid "No installation chosen"
msgstr "لم يُختر تثبيت"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "اختفى القرص"

#: installer.rs:955
msgid "Review"
msgstr "المراجعة"

#: installer.rs:958
msgid "Destination"
msgstr "الوجهة"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "امسح القرص وثبّت"

#: installer.rs:961
msgid "Custom partitions"
msgstr "أقسام مخصصة"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "أعد التثبيت مع الإبقاء على ‎/home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "بجانب Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (سيُهيّأ)"

#: installer.rs:969
msgid " (kept)"
msgstr " (يُحتفظ به)"

#: installer.rs:970
msgid "System Partition"
msgstr "قسم النظام"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (سيُهيّأ)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "قسم الإقلاع"

#: installer.rs:980
msgid "Space for MAN"
msgstr "مساحة لـ MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} مساحة حرة (يُنشأ قسم إقلاع وقسم النظام)"

#: installer.rs:981
msgid "Windows"
