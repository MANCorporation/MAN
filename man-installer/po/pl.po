msgstr "Obszar aktualizacji gotowy"

#: update.rs:410
msgid "Preparing the new system"
msgstr "Przygotowywanie nowego systemu"

#: update.rs:168
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Plik aktualizacji jest uszkodzony (niezgodna suma kontrolna). Pobierz go ponownie."

#: update.rs:171
msgid "The update file could not be read completely."
msgstr "Nie można odczytać całego pliku aktualizacji."

#: update.rs:312
msgid "The update contains no kernel."
msgstr "Aktualizacja nie zawiera jądra."

#: update.rs:360
msgid "Updates must be installed by the system helper."
msgstr "Aktualizacje musi instalować pomocnik systemowy."

#: update.rs:369
msgid "The chosen installation was not found."
msgstr "Nie znaleziono wybranej instalacji."

#: update.rs:371
