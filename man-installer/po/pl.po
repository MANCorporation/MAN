#: backend.rs:46
msgid "Could not start the system helper."
msgstr "Nie można uruchomić pomocnika systemowego."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "Nie można porozumieć się z pomocnikiem systemowym."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "Utracono połączenie z pomocnikiem systemowym."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "Anulowano uwierzytelnienie."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "Do tego działania potrzebne są uprawnienia administratora."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "Pomocnik systemowy nieoczekiwanie zakończył działanie."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Brak partycji systemowej EFI"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Wolne tylko {free}, MAN potrzebuje {need}. Zwolnij miejsce za pomocą DUHACH! w Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Brak wolnego miejsca. Uruchom DUHACH! w Windows, aby zrobić miejsce dla MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN działa z tego dysku"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "W użyciu: partycja jest zamontowana"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Za mały, MAN potrzebuje {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Zainstaluj MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "Trwa instalacja MAN. Zaczekaj na jej zakończenie."

#: installer.rs:143
msgid "Language"
msgstr "Język"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Uruchom ponownie w tym języku"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Sesja live uruchomi się ponownie w wybranym języku, a MAN zostanie w nim zainstalowany."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Witamy w MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Szybki, otwarty i w pełni konfigurowalny system GNOME.\n"
"Zainstaluj go na tym komputerze lub dalej poznawaj sesję live."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Zainstaluj MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Dalej wypróbowuj MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Wyszukiwanie dysków…"

#: installer.rs:250
msgid "Welcome"
msgstr "Witamy"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Ten komputer został uruchomiony w trybie BIOS (legacy). MAN można zainstalować tylko na komputerach z UEFI: uruchom ponownie i wybierz opcję rozruchu UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Pomocnik systemowy nie zwrócił informacji o dyskach."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Dalej"

#: installer.rs:361
msgid "Installation Type"
msgstr "Rodzaj instalacji"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Wyczyść dysk i zainstaluj MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Wszystko na wybranym dysku zostanie usunięte, także Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Zalecane. Wszystko na wybranym dysku zostanie usunięte."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Zainstaluj obok Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Zalecane. MAN użyje wolnego miejsca obok Windows; Windows i jego pliki pozostaną. System wybierasz przy każdym uruchomieniu."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Zainstaluj MAN ponownie"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Zastępuje system, ale zachowuje pliki osobiste w /home. Obecny system zostanie zapisany jako migawka."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Własne partycje"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Dla ekspertów: wybierz partycje samodzielnie lub utwórz je w programie Dyski."

#: installer.rs:392
msgid "Disk"
msgstr "Dysk"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Wybierz dysk do wyczyszczenia. Dyski, których nie można użyć, są pokazane z przyczyną."

#: installer.rs:418
msgid "No disks were found"
msgstr "Nie znaleziono dysków"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Wolne miejsce obok Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Partycje Windows pozostaną nietknięte. MAN współdzieli partycję systemową EFI i dodaje Windows do swojego menu startowego."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} wolne"

#: installer.rs:432
msgid "no free space"
msgstr "brak wolnego miejsca"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Instalacja do zastąpienia"

#: installer.rs:477
msgid "no home folders"
msgstr "brak katalogów domowych"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "katalogi domowe: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "migawki: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN na {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Hasło dla {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Odblokuj"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Nie można zbadać instalacji."

#: installer.rs:554
msgid "Partitions"
msgstr "Partycje"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Partycja systemowa zostanie sformatowana jako Btrfs i będzie zawierać @system, @home i @snapshots. Partycje na dysku, z którego działa MAN, nie są wyświetlane."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Otwórz Dyski, aby utworzyć partycje lub zmienić ich rozmiar"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Odśwież listę partycji"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Wybierz partycję"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "Partycja systemowa EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Sformatuj partycję systemową EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Pozostaw wyłączone, aby zachować programy rozruchowe innych systemów"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Partycja systemowa (zostanie sformatowana jako Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Partycja rozruchowa (wymagana przy szyfrowaniu)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Odświeżono listę partycji"

#: installer.rs:650
msgid "Security"
msgstr "Bezpieczeństwo"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Zaszyfruj system"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Chroni dane w razie zgubienia lub kradzieży komputera. Hasło jest wymagane przy każdym uruchomieniu."

#: installer.rs:656
msgid "Passphrase"
msgstr "Hasło"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Potwierdź hasło"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Przechowuj to hasło w bezpiecznym miejscu"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Jeśli je zgubisz, nikt nie odzyska danych. Jądro i pliki rozruchowe pozostaną na małej, niezaszyfrowanej partycji rozruchowej."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Hasło musi mieć co najmniej 8 znaków."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Hasła się nie zgadzają."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Wybierz dysk."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Wybierz dysk z Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Wybierz instalację do zastąpienia."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Najpierw odblokuj zaszyfrowaną instalację."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Ta partycja nie zawiera systemu MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Wybierz partycję systemową EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Wybierz partycję systemową."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Partycja EFI i partycja systemowa muszą być różne."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Szyfrowanie wymaga osobnej partycji rozruchowej."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Partycja systemowa musi mieć co najmniej {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Partycja EFI nie jest sformatowana jako FAT; włącz formatowanie."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Partycja systemowa jest zamontowana; najpierw odmontuj ją w programie Dyski."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Gdzie zainstalować MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Czas i klawiatura"

#: installer.rs:829
msgid "Time Zone"
msgstr "Strefa czasowa"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Układ klawiatury"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Sprawdź klawiaturę"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Pisz tutaj, aby sprawdzić, czy klawisze wprowadzają właściwe znaki."

#: installer.rs:844
msgid "Type here"
msgstr "Pisz tutaj"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Strefa czasowa i klawiatura"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Nie wybrano dysku"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Nie wybrano partycji systemowej"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Partycja systemowa zniknęła"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Nie wybrano instalacji"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Dysk zniknął"

#: installer.rs:955
msgid "Review"
msgstr "Podsumowanie"

#: installer.rs:958
msgid "Destination"
msgstr "Miejsce docelowe"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Wyczyść dysk i zainstaluj"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Własne partycje"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Zainstaluj ponownie, zachowaj /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Obok Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (zostanie sformatowana)"

#: installer.rs:969
msgid " (kept)"
msgstr " (zachowana)"

#: installer.rs:970
msgid "System Partition"
msgstr "Partycja systemowa"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (zostanie sformatowana)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Partycja rozruchowa"

#: installer.rs:976
msgid "Installation"
msgstr "Instalacja"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Miejsce na MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} wolnego miejsca (zostanie utworzona partycja rozruchowa i systemowa)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Bez zmian. Pojawi się w menu startowym MAN; partycja systemowa EFI jest współdzielona."

#: installer.rs:983
msgid "Encryption"
msgstr "Szyfrowanie"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Włączone (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Wyłączone"

#: installer.rs:985
msgid "File System"
msgstr "System plików"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system dla MAN, @home na twoje pliki, @snapshots na punkty przywracania. Wszystkie współdzielą wolne miejsce."

#: installer.rs:991
msgid "System"
msgstr "System"

#: installer.rs:993
msgid "Your Account"
msgstr "Twoje konto"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Zostanie utworzone w MAN Setup przy pierwszym uruchomieniu komputera, razem z nazwą komputera, wyglądem i ustawieniami prywatności."

#: installer.rs:998
msgid "Keyboard"
msgstr "Klawiatura"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "Wszystkie dane na {model} ({path}) zostaną usunięte."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Wyczyść i zainstaluj"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Wybrane partycje zostaną sformatowane. Pozostałe partycje się nie zmienią."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Sformatuj i zainstaluj"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "Obecny system zostanie zastąpiony. Twoje pliki w /home pozostaną, a stary system zostanie zapisany jako migawka."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "_Zainstaluj ponownie"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN zostanie zainstalowany w wolnym miejscu. Windows i jego pliki się nie zmienią."

#: installer.rs:1005
msgid "_Install"
msgstr "_Zainstaluj"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "Gotowe do instalacji"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "Wyczyścić {model}?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "Wszystkie pliki i partycje na {path} ({size}) zostaną trwale usunięte. Tego nie można cofnąć."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "Wyczyść i zainstaluj"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "Sformatować wybrane partycje?"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "Wszystkie dane na wybranych partycjach zostaną trwale usunięte. Pozostałe partycje się nie zmienią."

#: installer.rs:1037
msgid "Format and Install"
msgstr "Sformatuj i zainstaluj"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "Zainstalować MAN obok Windows?"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "MAN zostanie zainstalowany w {free} wolnego miejsca na {model} ({path}). Windows i jego pliki się nie zmienią."

#: installer.rs:1046
msgid "Install"
msgstr "Zainstaluj"

#: installer.rs:1050
msgid "Reinstall MAN?"
msgstr "Zainstalować MAN ponownie?"

#: installer.rs:1051
msgid "The installed system will be replaced by a fresh copy. Personal files in /home are kept and the old system remains available as a snapshot."
msgstr "Zainstalowany system zostanie zastąpiony nową kopią. Pliki osobiste w /home pozostaną, a stary system będzie dostępny jako migawka."

#: installer.rs:1052
msgid "Reinstall"
msgstr "Zainstaluj ponownie"

#: installer.rs:1057
msgid "_Cancel"
msgstr "_Anuluj"

#: installer.rs:1076
msgid "Installing MAN"
msgstr "Instalowanie MAN"

#: installer.rs:1077
msgid "Starting…"
msgstr "Uruchamianie…"

#: installer.rs:1085
msgid "Details"
msgstr "Szczegóły"

#: installer.rs:1090
msgid "Installing"
msgstr "Instalowanie"

#: installer.rs:1103
msgid "Step {index} of {n}  ·  {title}"
msgstr "Krok {index} z {n}  ·  {title}"

#: installer.rs:1128
msgid "Log"
msgstr "Dziennik"

#: installer.rs:1138
msgid "MAN Is Installed"
msgstr "MAN został zainstalowany"

#: installer.rs:1143
msgid "Restart the computer to start using MAN. A menu at every start lets you choose MAN or Windows; the temporary MAN installer partition is removed by MAN on its first start."
msgstr "Uruchom ponownie komputer, aby zacząć korzystać z MAN. Menu przy każdym uruchomieniu pozwala wybrać MAN lub Windows; tymczasową partycję instalatora MAN usunie przy pierwszym uruchomieniu."

#: installer.rs:1149
msgid "Restart the computer to start using MAN. You can remove the installation media; if it stays connected, MAN still starts from the new disk."
msgstr "Uruchom ponownie komputer, aby zacząć korzystać z MAN. Możesz odłączyć nośnik instalacyjny; jeśli pozostanie podłączony, MAN i tak uruchomi się z nowego dysku."

#: installer.rs:1156
msgid "_Restart Now"
msgstr "_Uruchom ponownie teraz"

#: installer.rs:1171
msgid "Done"
msgstr "Gotowe"

#: installer.rs:1182
msgid "Installation Failed"
msgstr "Instalacja nie powiodła się"

#: installer.rs:1186
msgid "No other disk was changed, and the installer has released the target disk. You can review the plan and try again."
msgstr "Żaden inny dysk nie został zmieniony, a instalator zwolnił dysk docelowy. Możesz przejrzeć plan i spróbować ponownie."

#: installer.rs:1191
msgid "_Review and Try Again"
msgstr "_Przejrzyj i spróbuj ponownie"

#: installer.rs:1193
msgid "_Show Details"
msgstr "_Pokaż szczegóły"

#: installer.rs:1208
msgid "Installation Log"
msgstr "Dziennik instalacji"

#: langui.rs:229
msgid "Search languages"
msgstr "Szukaj języków"

#: langui.rs:269
msgid "Search countries"
msgstr "Szukaj krajów"

#: oobe.rs:165
msgid "The system disk was not found."
msgstr "Nie znaleziono dysku systemowego."

#: oobe.rs:173
msgid "Encryption needs the Btrfs layout created by the MAN installer."
msgstr "Szyfrowanie wymaga układu Btrfs utworzonego przez instalator MAN."

#: oobe.rs:177
msgid "This installation has no separate boot partition, which encryption needs. Reinstall MAN with “Erase Disk” to use encryption."
msgstr "Ta instalacja nie ma osobnej partycji rozruchowej, której wymaga szyfrowanie. Aby użyć szyfrowania, zainstaluj MAN ponownie z opcją „Wyczyść dysk”."

#: oobe.rs:501
msgid "MAN Setup"
msgstr "MAN Setup"

#: oobe.rs:554
msgid "Where Are You?"
msgstr "Gdzie jesteś?"

#: oobe.rs:554
msgid "Your country or region sets the date, time and number formats."
msgstr "Twój kraj lub region określa format daty, godziny i liczb."

#: oobe.rs:572
msgid "Country"
msgstr "Kraj"

#: oobe.rs:587
msgid "GNU General Public License, version 2"
msgstr "Powszechna Licencja Publiczna GNU, wersja 2"

#: oobe.rs:587
msgid "The Linux kernel and many system tools"
msgstr "Jądro Linux i wiele narzędzi systemowych"

#: oobe.rs:588
msgid "GNU General Public License, version 3"
msgstr "Powszechna Licencja Publiczna GNU, wersja 3"

#: oobe.rs:588
msgid "Many GNU and GNOME programs"
msgstr "Wiele programów GNU i GNOME"

#: oobe.rs:589
msgid "GNU Lesser General Public License, version 2.1"
msgstr "Mniejsza Powszechna Licencja Publiczna GNU, wersja 2.1"

#: oobe.rs:589
msgid "GTK, GLib and many libraries"
msgstr "GTK, GLib i wiele bibliotek"

#: oobe.rs:590
msgid "GNU Lesser General Public License, version 3"
msgstr "Mniejsza Powszechna Licencja Publiczna GNU, wersja 3"

#: oobe.rs:590
msgid "Libraries"
msgstr "Biblioteki"

#: oobe.rs:591
msgid "Mozilla Public License 2.0"
msgstr "Mozilla Public License 2.0"

#: oobe.rs:591
msgid "Programs and libraries from Mozilla and others"
msgstr "Programy i biblioteki od Mozilli i innych"

#: oobe.rs:592
msgid "Apache License 2.0"
msgstr "Licencja Apache 2.0"

#: oobe.rs:592
msgid "Libraries and tools"
msgstr "Biblioteki i narzędzia"

#: oobe.rs:597
msgid "License Agreement"
msgstr "Umowa licencyjna"

#: oobe.rs:597
msgid "Please read and accept the terms under which MAN is provided."
msgstr "Przeczytaj i zaakceptuj warunki, na jakich udostępniany jest MAN."

#: oobe.rs:608
msgid "Licenses"
msgstr "Licencje"

#: oobe.rs:616
msgid "The license text is not available ({path})."
msgstr "Tekst licencji jest niedostępny ({path})."

#: oobe.rs:622
msgid "I have read and accept the license terms"
msgstr "Przeczytałem(-am) i akceptuję warunki licencji"

#: oobe.rs:692
msgid "Wired"
msgstr "Przewodowe"

#: oobe.rs:698
msgid "Not connected"
msgstr "Brak połączenia"

#: oobe.rs:732
msgid "Connect to the Internet"
msgstr "Połącz z internetem"

#: oobe.rs:732
msgid "Connecting lets MAN set the time and keep your software up to date. You can also do this later."
msgstr "Dzięki połączeniu MAN ustawi zegar i będzie aktualizować oprogramowanie. Możesz to zrobić także później."

#: oobe.rs:734
msgid "Checking the connection…"
msgstr "Sprawdzanie połączenia…"

#: oobe.rs:740
msgid "Wi-Fi Networks"
msgstr "Sieci Wi-Fi"

#: oobe.rs:742
msgid "Search Again"
msgstr "Szukaj ponownie"

#: oobe.rs:753
msgid "_Skip"
msgstr "_Pomiń"

#: oobe.rs:754
msgid "You can connect later in Settings."
msgstr "Możesz połączyć się później w Ustawieniach."

#: oobe.rs:763
msgid "Connected"
