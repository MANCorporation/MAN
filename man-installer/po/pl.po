msgstr "MAN Setup został już ukończony na tym komputerze."

#: oobe.rs:124
msgid "Unknown accent color."
msgstr "Nieznany kolor akcentu."

#: oobe.rs:128
msgid "The chosen wallpaper is not available."
msgstr "Wybrana tapeta jest niedostępna."

