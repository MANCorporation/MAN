msgid "The confirmed disk does not hold the chosen system partition."
msgstr "Potwierdzony dysk nie zawiera wybranej partycji systemowej."

#: install.rs:157
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "Partycja rozruchowa musi być oddzielna od partycji EFI i systemowej."

#: install.rs:160
msgid "The boot partition must be at least 512 MB."
msgstr "Partycja rozruchowa musi mieć co najmniej 512 MB."

#: install.rs:175
msgid "No installation chosen."
msgstr "Nie wybrano instalacji."

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "Potwierdzony dysk nie zawiera wybranej instalacji."

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "Zaszyfrowana instalacja nie ma partycji MAN_BOOT."

#: install.rs:695
msgid "No kernel with matching modules was found in /boot."
msgstr "W /boot nie znaleziono jądra z pasującymi modułami."

#: locale.rs:180
