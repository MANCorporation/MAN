msgid "Choose the installation to replace."
msgstr "Velg installasjonen som skal erstattes."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Lås opp den krypterte installasjonen først."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Denne partisjonen inneholder ikke noe MAN-system."

