msgid "Choose an EFI system partition."
msgstr "Velg en EFI-systempartisjon."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Velg systempartisjonen."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI-partisjonen og systempartisjonen må være forskjellige."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Kryptering krever en egen oppstartspartisjon."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Systempartisjonen må være minst {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI-partisjonen er ikke FAT-formatert; slå på formatering."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Systempartisjonen er montert; avmonter den først i Disker."

