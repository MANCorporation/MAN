#: installer.rs:554
msgid "Partitions"
msgstr "Partisjoner"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Systempartisjonen formateres med Btrfs og inneholder @system, @home og @snapshots. Partisjoner på disken MAN kjører fra, vises ikke."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Åpne Disker for å lage partisjoner eller endre størrelsen på dem"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Oppdater partisjonslisten"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Velg en partisjon"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI-systempartisjon"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Formater EFI-systempartisjonen"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "La være av for å beholde oppstartslastere for andre systemer"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Systempartisjon (formateres som Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Oppstartspartisjon (trengs med kryptering)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Partisjonslisten er oppdatert"

#: installer.rs:650
msgid "Security"
msgstr "Sikkerhet"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Krypter systemet"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Beskytter dataene dine hvis maskinen blir borte eller stjålet. En passordfrase kreves ved hver oppstart."

#: installer.rs:656
msgid "Passphrase"
msgstr "Passordfrase"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Bekreft passordfrase"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Ta vare på passordfrasen"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Hvis den går tapt, kan ingen gjenopprette dataene. Kjernen og oppstartsfilene ligger på en liten ukryptert oppstartspartisjon."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Passordfrasen må ha minst 8 tegn."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Passordfrasene er ikke like."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Velg en disk."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Velg disken med Windows."

