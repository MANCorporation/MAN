msgstr "Forbindelsen til systemhjelperen ble brutt."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "Autentiseringen ble avbrutt."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "Denne handlingen krever administratorrettigheter."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "Systemhjelperen stoppet uventet."

