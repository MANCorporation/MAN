#: backend.rs:46
msgid "Could not start the system helper."
msgstr "সিস্টেম সহায়ক চালু করা যায়নি।"

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "সিস্টেম সহায়কের সাথে যোগাযোগ করা যায়নি।"

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "সিস্টেম সহায়কের সাথে সংযোগ বিচ্ছিন্ন হয়েছে।"

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "অনুমোদন বাতিল করা হয়েছে।"

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "এই কাজের জন্য প্রশাসকের অধিকার প্রয়োজন।"

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "সিস্টেম সহায়ক অপ্রত্যাশিতভাবে থেমে গেছে।"

#: installer.rs:78
msgid "No EFI system partition"
msgstr "কোনো EFI সিস্টেম পার্টিশন নেই"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "মাত্র {free} খালি, MAN-এর প্রয়োজন {need}। Windows-এ DUHACH! দিয়ে জায়গা খালি করুন।"

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "কোনো খালি জায়গা নেই। MAN-এর জন্য জায়গা করতে Windows-এ DUHACH! চালু করুন।"

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN এই ডিস্ক থেকে চলছে"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "ব্যবহৃত হচ্ছে: একটি পার্টিশন মাউন্ট করা আছে"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "খুব ছোট, MAN-এর প্রয়োজন {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "MAN ইনস্টল করুন"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN ইনস্টল হচ্ছে। শেষ না হওয়া পর্যন্ত অপেক্ষা করুন।"

#: installer.rs:143
msgid "Language"
msgstr "ভাষা"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "এই ভাষায় পুনরায় চালু করুন(_R)"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "লাইভ সেশন বেছে নেওয়া ভাষায় পুনরায় চালু হবে, এবং MAN সেই ভাষায় ইনস্টল হবে।"

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "MAN-এ স্বাগতম"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"একটি দ্রুত, মুক্ত এবং সম্পূর্ণ কাস্টমাইজযোগ্য GNOME সিস্টেম।\n"
"এটি এই কম্পিউটারে ইনস্টল করুন, অথবা লাইভ সেশন ঘুরে দেখা চালিয়ে যান।"

#: installer.rs:218
msgid "_Install MAN…"
msgstr "MAN ইনস্টল করুন(_I)…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "MAN চেষ্টা চালিয়ে যান(_K)"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "ডিস্ক খোঁজা হচ্ছে…"

#: installer.rs:250
msgid "Welcome"
msgstr "স্বাগতম"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "এই কম্পিউটারটি পুরোনো BIOS মোডে চালু হয়েছে। MAN কেবল UEFI কম্পিউটারে ইনস্টল করা যায়: পুনরায় চালু করে UEFI বুট বিকল্প বেছে নিন।"

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "সিস্টেম সহায়ক কোনো ডিস্কের তথ্য দেয়নি।"

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "পরবর্তী(_N)"

#: installer.rs:361
msgid "Installation Type"
msgstr "ইনস্টলেশনের ধরন"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "ডিস্ক মুছে MAN ইনস্টল করুন"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "বেছে নেওয়া ডিস্কের সবকিছু মুছে যাবে, Windows সহ।"

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "প্রস্তাবিত। বেছে নেওয়া ডিস্কের সবকিছু মুছে যাবে।"

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Windows-এর পাশে ইনস্টল করুন"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "প্রস্তাবিত। MAN, Windows-এর পাশের খালি জায়গা ব্যবহার করে; Windows ও এর ফাইল থেকে যায়। প্রতিবার চালু করার সময় সিস্টেম বেছে নিন।"

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "MAN পুনরায় ইনস্টল করুন"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "সিস্টেম প্রতিস্থাপন করে কিন্তু /home-এর ব্যক্তিগত ফাইল রাখে। বর্তমান সিস্টেম স্ন্যাপশট হিসেবে সংরক্ষিত হয়।"

#: installer.rs:383
msgid "Custom Partitions"
msgstr "নিজস্ব পার্টিশন"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "বিশেষজ্ঞদের জন্য: নিজে পার্টিশন বেছে নিন, অথবা Disks দিয়ে তৈরি করুন।"

#: installer.rs:392
msgid "Disk"
msgstr "ডিস্ক"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "মোছার জন্য ডিস্ক বেছে নিন। যে ডিস্ক ব্যবহার করা যায় না সেগুলো কারণসহ দেখানো হয়।"

#: installer.rs:418
msgid "No disks were found"
msgstr "কোনো ডিস্ক পাওয়া যায়নি"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Windows-এর পাশে খালি জায়গা"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows-এর পার্টিশন স্পর্শ করা হয় না। MAN, EFI সিস্টেম পার্টিশন ভাগ করে নেয় এবং Windows-কে নিজের বুট মেনুতে যোগ করে।"

#: installer.rs:432
msgid "{size} free"
msgstr "{size} খালি"

#: installer.rs:432
msgid "no free space"
msgstr "কোনো খালি জায়গা নেই"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "প্রতিস্থাপনের ইনস্টলেশন"

#: installer.rs:477
msgid "no home folders"
msgstr "কোনো হোম ফোল্ডার নেই"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "হোম ফোল্ডার: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "স্ন্যাপশট: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "{model}-এ MAN"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "{device}-এর পাসফ্রেজ"

#: installer.rs:500
msgid "Unlock"
msgstr "আনলক করুন"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "ইনস্টলেশন পরীক্ষা করা যায়নি।"

#: installer.rs:554
msgid "Partitions"
msgstr "পার্টিশন"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "সিস্টেম পার্টিশন Btrfs-এ ফরম্যাট হয় এবং এতে @system, @home ও @snapshots থাকে। যে ডিস্ক থেকে MAN চলছে তার পার্টিশন তালিকায় নেই।"

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "পার্টিশন তৈরি বা আকার বদলাতে Disks খুলুন"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "পার্টিশন তালিকা রিফ্রেশ করুন"

#: installer.rs:567
msgid "Choose a partition"
msgstr "একটি পার্টিশন বেছে নিন"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI সিস্টেম পার্টিশন"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI সিস্টেম পার্টিশন ফরম্যাট করুন"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "অন্য সিস্টেমের বুট লোডার রাখতে বন্ধ রাখুন"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "সিস্টেম পার্টিশন (Btrfs হিসেবে ফরম্যাট হবে)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "বুট পার্টিশন (এনক্রিপশনের জন্য প্রয়োজন)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "পার্টিশন তালিকা রিফ্রেশ হয়েছে"

#: installer.rs:650
msgid "Security"
msgstr "নিরাপত্তা"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "সিস্টেম এনক্রিপ্ট করুন"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "কম্পিউটার হারালে বা চুরি হলে আপনার ডেটা রক্ষা করে। প্রতিবার চালুর সময় একটি পাসফ্রেজ চাওয়া হয়।"

#: installer.rs:656
msgid "Passphrase"
msgstr "পাসফ্রেজ"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "পাসফ্রেজ নিশ্চিত করুন"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "এই পাসফ্রেজ নিরাপদে রাখুন"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "এটি হারালে কেউ ডেটা পুনরুদ্ধার করতে পারবে না। কার্নেল ও বুট ফাইল একটি ছোট অ-এনক্রিপ্টেড বুট পার্টিশনে থাকে।"

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "পাসফ্রেজে অন্তত ৮টি অক্ষর থাকতে হবে।"

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "পাসফ্রেজ মিলছে না।"

#: installer.rs:748
msgid "Choose a disk."
msgstr "একটি ডিস্ক বেছে নিন।"

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Windows থাকা ডিস্কটি বেছে নিন।"

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "প্রতিস্থাপনের ইনস্টলেশন বেছে নিন।"

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "আগে এনক্রিপ্টেড ইনস্টলেশন আনলক করুন।"

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "এই পার্টিশনে কোনো MAN সিস্টেম নেই।"

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "একটি EFI সিস্টেম পার্টিশন বেছে নিন।"

#: installer.rs:778
msgid "Choose the system partition."
msgstr "সিস্টেম পার্টিশন বেছে নিন।"

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI ও সিস্টেম পার্টিশন আলাদা হতে হবে।"

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "এনক্রিপশনের জন্য আলাদা বুট পার্টিশন প্রয়োজন।"

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "সিস্টেম পার্টিশন অন্তত {size} হতে হবে।"

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI পার্টিশন FAT-এ ফরম্যাট করা নেই; ফরম্যাট করা চালু করুন।"

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "সিস্টেম পার্টিশন মাউন্ট করা আছে; আগে Disks-এ আনমাউন্ট করুন।"

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "MAN কোথায় ইনস্টল করবেন?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "সময় ও কীবোর্ড"

#: installer.rs:829
msgid "Time Zone"
msgstr "সময় অঞ্চল"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "কীবোর্ড লেআউট"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "কীবোর্ড পরীক্ষা করুন"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "কী-গুলো সঠিক অক্ষর লেখে কিনা দেখতে এখানে টাইপ করুন।"

#: installer.rs:844
msgid "Type here"
msgstr "এখানে টাইপ করুন"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "সময় অঞ্চল ও কীবোর্ড"

#: installer.rs:920
msgid "No disk chosen"
msgstr "কোনো ডিস্ক বেছে নেওয়া হয়নি"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "কোনো সিস্টেম পার্টিশন বেছে নেওয়া হয়নি"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "সিস্টেম পার্টিশন উধাও হয়ে গেছে"

#: installer.rs:933
msgid "No installation chosen"
msgstr "কোনো ইনস্টলেশন বেছে নেওয়া হয়নি"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "ডিস্ক উধাও হয়ে গেছে"

#: installer.rs:955
msgid "Review"
msgstr "পর্যালোচনা"

#: installer.rs:958
msgid "Destination"
msgstr "গন্তব্য"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "ডিস্ক মুছে ইনস্টল করুন"

#: installer.rs:961
msgid "Custom partitions"
msgstr "নিজস্ব পার্টিশন"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "/home রেখে পুনরায় ইনস্টল করুন"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Windows-এর পাশে"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (ফরম্যাট হবে)"

#: installer.rs:969
msgid " (kept)"
msgstr " (রাখা হবে)"

#: installer.rs:970
msgid "System Partition"
msgstr "সিস্টেম পার্টিশন"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (ফরম্যাট হবে)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "বুট পার্টিশন"

#: installer.rs:976
msgid "Installation"
msgstr "ইনস্টলেশন"

#: installer.rs:980
msgid "Space for MAN"
msgstr "MAN-এর জন্য জায়গা"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} খালি জায়গা (একটি বুট পার্টিশন ও সিস্টেম পার্টিশন তৈরি হবে)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "অপরিবর্তিত। এটি MAN-এর বুট মেনুতে দেখা যাবে; EFI সিস্টেম পার্টিশন ভাগ করা।"

#: installer.rs:983
msgid "Encryption"
msgstr "এনক্রিপশন"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "চালু (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "বন্ধ"

#: installer.rs:985
msgid "File System"
