msgid ""
msgstr ""
"Project-Id-Version: man-installer\n"
"Language: he\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: backend.rs:46
msgid "Could not start the system helper."
msgstr "לא ניתן להפעיל את מסייע המערכת."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "לא ניתן לתקשר עם מסייע המערכת."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "החיבור למסייע המערכת אבד."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "האימות בוטל."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "פעולה זו דורשת הרשאות מנהל."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "מסייע המערכת נעצר באופן בלתי צפוי."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "אין מחיצת מערכת EFI"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "רק {free} פנויים, ‏MAN צריכה {need}. יש לפנות מקום עם DUHACH! ב־Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "אין מקום פנוי. יש להפעיל את DUHACH! ב־Windows כדי לפנות מקום ל־MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN פועלת מהכונן הזה"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "בשימוש: מחיצה מעוגנת"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "קטן מדי, MAN צריכה {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "התקנת MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN מותקנת. נא להמתין לסיום."

#: installer.rs:143
msgid "Language"
msgstr "שפה"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "הפעלה _מחדש בשפה זו"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "ההפעלה החיה תופעל מחדש בשפה שנבחרה, ו־MAN תותקן בה."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "ברוכים הבאים ל־MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"מערכת GNOME מהירה, פתוחה וניתנת להתאמה מלאה.\n"
"אפשר להתקין אותה במחשב הזה או להמשיך להתנסות בהפעלה החיה."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_התקנת MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "להמשיך _לנסות את MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "מחפש כוננים…"

#: installer.rs:250
msgid "Welcome"
msgstr "ברוכים הבאים"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "המחשב הזה הופעל במצב BIOS ישן. אפשר להתקין את MAN רק במחשבי UEFI: יש להפעיל מחדש ולבחור באפשרות האתחול UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "מסייע המערכת לא החזיר מידע על הכוננים."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "ה_בא"

#: installer.rs:361
msgid "Installation Type"
msgstr "סוג ההתקנה"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "מחיקת הכונן והתקנת MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "כל מה שבכונן שנבחר יימחק, כולל Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "מומלץ. כל מה שבכונן שנבחר יימחק."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "התקנה לצד Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "מומלץ. MAN משתמשת במקום הפנוי לצד Windows; ‏Windows וקבציה נשארים. בוחרים מערכת בכל הפעלה."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "התקנה מחדש של MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "מחליפה את המערכת אך שומרת את הקבצים האישיים ב־‎/home. המערכת הנוכחית נשמרת כתמונת מצב."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "מחיצות מותאמות"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "למומחים: לבחור מחיצות בעצמך או ליצור אותן עם „כוננים”."

#: installer.rs:392
msgid "Disk"
msgstr "כונן"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "יש לבחור את הכונן שיימחק. כוננים שאי אפשר להשתמש בהם מוצגים עם הסיבה."

#: installer.rs:418
msgid "No disks were found"
msgstr "לא נמצאו כוננים"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "מקום פנוי לצד Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "מחיצות Windows לא משתנות. MAN חולקת את מחיצת מערכת EFI ומוסיפה את Windows לתפריט האתחול שלה."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} פנויים"

#: installer.rs:432
msgid "no free space"
msgstr "אין מקום פנוי"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} ‏(Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "התקנה להחלפה"

#: installer.rs:477
msgid "no home folders"
msgstr "אין תיקיות בית"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "תיקיות בית: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "תמונות מצב: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN על {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "מילת צופן עבור {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "שחרור נעילה"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "לא ניתן לבדוק את ההתקנה."

#: installer.rs:554
msgid "Partitions"
msgstr "מחיצות"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "מחיצת המערכת מפורמטת ב־Btrfs ומכילה את ‎@system,‏ ‎@home ו־‎@snapshots. מחיצות בכונן שממנו MAN פועלת אינן מוצגות."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "פתיחת „כוננים” ליצירת מחיצות או לשינוי גודלן"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "רענון רשימת המחיצות"

#: installer.rs:567
msgid "Choose a partition"
msgstr "בחירת מחיצה"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "מחיצת מערכת EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "פרמוט מחיצת מערכת EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "להשאיר כבוי כדי לשמור על מנהלי האתחול של מערכות אחרות"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "מחיצת מערכת (מפורמטת כ־Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "מחיצת אתחול (נדרשת עם הצפנה)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "רשימת המחיצות רועננה"

#: installer.rs:650
msgid "Security"
msgstr "אבטחה"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "הצפנת המערכת"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "מגינה על הנתונים שלך אם המחשב אובד או נגנב. בכל הפעלה תתבקש מילת צופן."

#: installer.rs:656
msgid "Passphrase"
msgstr "מילת צופן"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "אישור מילת הצופן"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "יש לשמור את מילת הצופן במקום בטוח"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "אם היא תאבד, אף אחד לא יוכל לשחזר את הנתונים. הליבה וקובצי האתחול נשארים במחיצת אתחול קטנה ולא מוצפנת."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "מילת הצופן חייבת להכיל לפחות 8 תווים."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "מילות הצופן אינן תואמות."

#: installer.rs:748
msgid "Choose a disk."
msgstr "יש לבחור כונן."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "יש לבחור את הכונן עם Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "יש לבחור את ההתקנה להחלפה."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "יש לשחרר קודם את נעילת ההתקנה המוצפנת."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "מחיצה זו אינה מכילה מערכת MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "יש לבחור מחיצת מערכת EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "יש לבחור את מחיצת המערכת."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "מחיצת EFI ומחיצת המערכת חייבות להיות שונות."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "הצפנה דורשת מחיצת אתחול נפרדת."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "מחיצת המערכת חייבת להיות בגודל {size} לפחות."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "מחיצת EFI אינה מפורמטת ב־FAT; יש להפעיל פרמוט."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "מחיצת המערכת מעוגנת; יש לנתק אותה קודם ב„כוננים”."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "היכן להתקין את MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "שעה ומקלדת"

#: installer.rs:829
msgid "Time Zone"
msgstr "אזור זמן"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "פריסת מקלדת"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "בדיקת המקלדת"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "יש להקליד כאן כדי לוודא שהמקשים מפיקים את התווים הנכונים."

#: installer.rs:844
msgid "Type here"
msgstr "להקליד כאן"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "אזור זמן ומקלדת"

#: installer.rs:920
msgid "No disk chosen"
msgstr "לא נבחר כונן"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "לא נבחרה מחיצת מערכת"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "מחיצת המערכת נעלמה"

#: installer.rs:933
msgid "No installation chosen"
msgstr "לא נבחרה התקנה"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "הכונן נעלם"

#: installer.rs:955
msgid "Review"
msgstr "סקירה"

#: installer.rs:958
msgid "Destination"
msgstr "יעד"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "מחיקת הכונן והתקנה"

#: installer.rs:961
msgid "Custom partitions"
msgstr "מחיצות מותאמות"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "התקנה מחדש, שמירת ‎/home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "לצד Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (תפורמט)"

#: installer.rs:969
msgid " (kept)"
msgstr " (נשמרת)"

#: installer.rs:970
msgid "System Partition"
msgstr "מחיצת מערכת"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (תפורמט)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "מחיצת אתחול"

#: installer.rs:976
msgid "Installation"
msgstr "התקנה"

#: installer.rs:980
msgid "Space for MAN"
msgstr "מקום ל־MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} מקום פנוי (נוצרות מחיצת אתחול ומחיצת מערכת)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "ללא שינוי. מופיעה בתפריט האתחול של MAN; מחיצת מערכת EFI משותפת."

#: installer.rs:983
msgid "Encryption"
msgstr "הצפנה"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "פעילה (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "כבויה"

#: installer.rs:985
msgid "File System"
msgstr "מערכת קבצים"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: ‏@system ל־MAN,‏ ‎@home לקבצים שלך,‏ ‎@snapshots לנקודות שחזור. כולן חולקות את המקום הפנוי."

#: installer.rs:991
msgid "System"
msgstr "מערכת"

#: installer.rs:993
msgid "Your Account"
msgstr "החשבון שלך"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "נוצר ב־MAN Setup בהפעלה הראשונה של המחשב, יחד עם שם המחשב, המראה והגדרות הפרטיות."

#: installer.rs:998
msgid "Keyboard"
msgstr "מקלדת"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "כל הנתונים ב־{model} ‏({path}) יימחקו."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_מחיקה והתקנה"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "המחיצות שנבחרו יפורמטו. שאר המחיצות לא משתנות."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_פרמוט והתקנה"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "המערכת הנוכחית מוחלפת. הקבצים שלך ב־‎/home נשמרים, והמערכת הישנה נשמרת כתמונת מצב."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "התקנה _מחדש"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN מותקנת במקום הפנוי. Windows וקבציה לא משתנים."

#: installer.rs:1005
msgid "_Install"
msgstr "ה_תקנה"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "מוכן להתקנה"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "למחוק את {model}?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "כל הקבצים והמחיצות ב־{path} ‏({size}) יימחקו לצמיתות. אי אפשר לבטל זאת."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "מחיקה והתקנה"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "לפרמט את המחיצות שנבחרו?"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "כל הנתונים במחיצות שנבחרו יימחקו לצמיתות. שאר המחיצות לא משתנות."

#: installer.rs:1037
msgid "Format and Install"
msgstr "פרמוט והתקנה"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "להתקין את MAN לצד Windows?"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "MAN תותקן ב־{free} המקום הפנוי ב־{model} ‏({path}). ‏Windows וקבציה לא משתנים."

#: installer.rs:1046
msgid "Install"
msgstr "התקנה"

#: installer.rs:1050
msgid "Reinstall MAN?"
msgstr "להתקין את MAN מחדש?"

#: installer.rs:1051
msgid "The installed system will be replaced by a fresh copy. Personal files in /home are kept and the old system remains available as a snapshot."
msgstr "המערכת המותקנת תוחלף בעותק חדש. הקבצים האישיים ב־‎/home נשמרים, והמערכת הישנה נשארת זמינה כתמונת מצב."

#: installer.rs:1052
msgid "Reinstall"
msgstr "התקנה מחדש"

#: installer.rs:1057
msgid "_Cancel"
msgstr "_ביטול"

#: installer.rs:1076
msgid "Installing MAN"
msgstr "MAN מותקנת"

#: installer.rs:1077
msgid "Starting…"
msgstr "מתחיל…"

#: installer.rs:1085
msgid "Details"
msgstr "פרטים"

#: installer.rs:1090
msgid "Installing"
msgstr "מתקין"

#: installer.rs:1103
msgid "Step {index} of {n}  ·  {title}"
msgstr "שלב {index} מתוך {n}  ·  {title}"

#: installer.rs:1128
msgid "Log"
msgstr "יומן"

#: installer.rs:1138
msgid "MAN Is Installed"
msgstr "MAN הותקנה"

#: installer.rs:1143
msgid "Restart the computer to start using MAN. A menu at every start lets you choose MAN or Windows; the temporary MAN installer partition is removed by MAN on its first start."
msgstr "יש להפעיל מחדש את המחשב כדי להתחיל להשתמש ב־MAN. בכל הפעלה תפריט מאפשר לבחור ב־MAN או ב־Windows; MAN מסירה את מחיצת המתקין הזמנית בהפעלה הראשונה."

#: installer.rs:1149
msgid "Restart the computer to start using MAN. You can remove the installation media; if it stays connected, MAN still starts from the new disk."
msgstr "יש להפעיל מחדש את המחשב כדי להתחיל להשתמש ב־MAN. אפשר להוציא את מדיית ההתקנה; אם היא נשארת מחוברת, MAN עדיין תעלה מהכונן החדש."

#: installer.rs:1156
msgid "_Restart Now"
msgstr "הפעלה _מחדש כעת"

#: installer.rs:1171
msgid "Done"
msgstr "בוצע"

#: installer.rs:1182
msgid "Installation Failed"
msgstr "ההתקנה נכשלה"

#: installer.rs:1186
msgid "No other disk was changed, and the installer has released the target disk. You can review the plan and try again."
msgstr "שום כונן אחר לא שונה, והמתקין שחרר את כונן היעד. אפשר לסקור את התוכנית ולנסות שוב."

#: installer.rs:1191
msgid "_Review and Try Again"
msgstr "_סקירה וניסיון חוזר"

#: installer.rs:1193
msgid "_Show Details"
msgstr "_הצגת פרטים"

#: installer.rs:1208
msgid "Installation Log"
msgstr "יומן ההתקנה"

#: langui.rs:229
msgid "Search languages"
msgstr "חיפוש שפות"

#: langui.rs:269
msgid "Search countries"
msgstr "חיפוש מדינות"

#: oobe.rs:165
msgid "The system disk was not found."
msgstr "כונן המערכת לא נמצא."

#: oobe.rs:173
msgid "Encryption needs the Btrfs layout created by the MAN installer."
msgstr "הצפנה דורשת את מבנה ה־Btrfs שיוצר המתקין של MAN."

#: oobe.rs:177
msgid "This installation has no separate boot partition, which encryption needs. Reinstall MAN with “Erase Disk” to use encryption."
