#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "קובץ זה אינו יישום שאפשר להתקין כאן (‎.deb, ‏.flatpak, ‏.flatpakref או AppImage)."

#: appinstaller.rs:134
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "יישום זה נועד למחשבי {arch} ואינו פועל במחשב זה (x86-64)."

#: appinstaller.rs:320
msgid "The file could not be read. It may be damaged."
msgstr "לא ניתן לקרוא את הקובץ. ייתכן שהוא פגום."

#: appinstaller.rs:492
msgid "This is not an AppImage."
msgstr "זה אינו AppImage."

#: appinstaller.rs:686
msgid "Introduction"
msgstr "מבוא"

#: appinstaller.rs:687
msgid "License"
msgstr "רישיון"

#: appinstaller.rs:688
msgid "Destination Select"
msgstr "בחירת יעד"

#: appinstaller.rs:689
msgid "Installation Type"
msgstr "סוג ההתקנה"

#: appinstaller.rs:690
msgid "Installation"
msgstr "התקנה"

#: appinstaller.rs:691
msgid "Summary"
msgstr "סיכום"

#: appinstaller.rs:797
msgid "_Continue"
msgstr "_המשך"

#: appinstaller.rs:806
msgid "Welcome to the {name} Installer"
msgstr "ברוכים הבאים לתוכנית ההתקנה של {name}"

#: appinstaller.rs:810
msgid "Software License Agreement"
msgstr "הסכם רישיון תוכנה"

#: appinstaller.rs:820
msgid "Do You Agree to the License?"
msgstr "האם את/ה מסכים/ה לרישיון?"

#: appinstaller.rs:821
msgid "To continue installing, you must agree to the terms of the software license agreement."
msgstr "כדי להמשיך בהתקנה, יש להסכים לתנאי הסכם רישיון התוכנה."

#: appinstaller.rs:823
msgid "_Read License"
msgstr "_קריאת הרישיון"

#: appinstaller.rs:824
msgid "_Agree"
msgstr "_מסכים/ה"

#: appinstaller.rs:837
msgid "Select a Destination"
msgstr "בחירת יעד"

#: appinstaller.rs:841
msgid "Standard Install"
msgstr "התקנה רגילה"

#: appinstaller.rs:842
msgid "_Install"
msgstr "ה_תקנה"

#: appinstaller.rs:855
msgid "Debian package (.deb)"
msgstr "חבילת Debian‏ (‎.deb)"

#: appinstaller.rs:856
msgid "Flatpak app"
msgstr "יישום Flatpak"

#: appinstaller.rs:857
msgid "Flatpak app from {source}"
msgstr "יישום Flatpak מ־{source}"

#: appinstaller.rs:858
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:876
msgid "You will be guided through the steps necessary to install this software."
msgstr "נדריך אותך בשלבים הדרושים להתקנת תוכנה זו."

#: appinstaller.rs:887
msgid "Version"
msgstr "גרסה"

#: appinstaller.rs:890
msgid "Publisher"
msgstr "מפרסם"

#: appinstaller.rs:892
msgid "Type"
msgstr "סוג"

#: appinstaller.rs:894
msgid "Size"
msgstr "גודל"

#: appinstaller.rs:900
msgid "Website"
msgstr "אתר אינטרנט"

#: appinstaller.rs:902
msgid "File"
msgstr "קובץ"

#: appinstaller.rs:912
msgid "This app is installed already. Installing it again replaces it."
msgstr "יישום זה כבר מותקן. התקנה מחדש תחליף אותו."

#: appinstaller.rs:915
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr "יישומים מחבילות ‎.deb הופכים לחלק מהמערכת. עדכון MAN מחליף את המערכת, ולכן הם מותקנים מחדש אחרי עדכון רק אם בוחרים לשמור אותם (השלבים הבאים)."

#: appinstaller.rs:918
msgid "Only install apps from sources you trust."
msgstr "יש להתקין יישומים רק ממקורות מהימנים."

#: appinstaller.rs:924
msgid "Where do you want to install {name}?"
msgstr "היכן להתקין את {name}?"

#: appinstaller.rs:929
msgid "Only your account can use the app."
msgstr "רק החשבון שלך יכול להשתמש ביישום."

#: appinstaller.rs:930
msgid "Needs administrator rights."
msgstr "נדרשות הרשאות מנהל."

#: appinstaller.rs:937
msgid "Only for Me"
msgstr "רק עבורי"

#: appinstaller.rs:937
msgid "For All Users of This Computer"
msgstr "עבור כל המשתמשים במחשב זה"

#: appinstaller.rs:952
msgid "This will take {size} of space on your computer."
msgstr "הדבר יתפוס {size} במחשב שלך."

#: appinstaller.rs:954
msgid "The app is downloaded from {source}."
msgstr "היישום מוּרד מ־{source}."

#: appinstaller.rs:956
msgid "The app is installed for all users of this computer."
msgstr "היישום מותקן עבור כל המשתמשים במחשב זה."

#: appinstaller.rs:956
msgid "The app is installed only for you."
msgstr "היישום מותקן רק עבורך."

#: appinstaller.rs:959
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "ה־AppImage מועבר אל {folder} ומתווסף ליישומים שלך."

#: appinstaller.rs:965
msgid "Keep After MAN Updates"
msgstr "לשמור אחרי עדכוני MAN"

#: appinstaller.rs:966
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "MAN מתקינה את היישום מחדש אחרי כל עדכון. לשם כך נשמרים קובצי החבילה שלו."

#: appinstaller.rs:974
msgid "Click Install to install {name}."
msgstr "יש ללחוץ על התקנה כדי להתקין את {name}."

#: appinstaller.rs:980
msgid "Checking what else the app needs…"
msgstr "בודק מה עוד היישום צריך…"

#: appinstaller.rs:990
msgid "Also installs the packages it needs: {list}"
msgstr "מתקין גם את החבילות הדרושות לו: {list}"

#: appinstaller.rs:996
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "חלק מהחבילות שהיישום צריך עדיין אינן זמינות. ההתקנה מורידה תחילה את רשימות החבילות העדכניות; אם הן עדיין חסרות, לא ניתן להתקין את היישום."

#: appinstaller.rs:1057
msgid "Installing {name}…"
msgstr "מתקין את {name}…"

#: appinstaller.rs:1063
msgid "Preparing…"
msgstr "בהכנה…"

#: appinstaller.rs:1070
msgid "Details"
msgstr "פרטים"

#: appinstaller.rs:1110
msgid "Installing the package…"
msgstr "מתקין את החבילה…"

#: appinstaller.rs:1129
msgid "Moving the app to its folder…"
msgstr "מעביר את היישום לתיקייה שלו…"

#: appinstaller.rs:1138
msgid "The app could not be installed."
msgstr "לא ניתן היה להתקין את היישום."

#: appinstaller.rs:1142
msgid "Installing the app with Flatpak…"
msgstr "מתקין את היישום עם Flatpak…"

#: appinstaller.rs:1166
msgid "Log"
msgstr "יומן"

#: appinstaller.rs:1196
msgid "_Close"
msgstr "_סגירה"

#: appinstaller.rs:1206
msgid "The Installation Was Successful"
msgstr "ההתקנה הצליחה"

#: appinstaller.rs:1206
msgid "The app was installed."
msgstr "היישום הותקן."

#: appinstaller.rs:1211
msgid "The Installation Failed"
msgstr "ההתקנה נכשלה"

#: appinstaller.rs:1222
msgid "_Open"
msgstr "_פתיחה"

#: appinstaller.rs:1232
msgid "_Show Details"
msgstr "_הצגת פרטים"

#: appinstaller.rs:1235
msgid "Installation Log"
msgstr "יומן ההתקנה"

#: appinstaller.rs:1262
msgid "App Installer"
msgstr "מתקין היישומים"

#: appinstaller.rs:1283
msgid "Go _Back"
msgstr "_חזרה"

#: appinstaller.rs:1356
msgid "Reading the app…"
msgstr "קורא את היישום…"

#: appinstaller.rs:1365
msgid "Install {name}"
msgstr "התקנת {name}"

#: appinstaller.rs:1384
msgid "Apps"
msgstr "יישומים"

#: appinstaller.rs:1390
msgid "Choose an App to Install"
msgstr "בחירת יישום להתקנה"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "לא ניתן להפעיל את מסייע המערכת."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "לא ניתן לתקשר עם מסייע המערכת."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "החיבור למסייע המערכת אבד."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "האימות בוטל."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "פעולה זו דורשת הרשאות מנהל."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "מסייע המערכת נעצר באופן בלתי צפוי."

#: installer.rs:89
msgid "No EFI system partition"
msgstr "אין מחיצת מערכת EFI"

#: installer.rs:93
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "רק {free} פנויים, ‏MAN צריכה {need}. יש לפנות מקום עם DUHACH! ב־Windows."

#: installer.rs:94
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "אין מקום פנוי. יש להפעיל את DUHACH! ב־Windows כדי לפנות מקום ל־MAN."

#: installer.rs:103
msgid "MAN is running from this disk"
msgstr "MAN פועלת מהכונן הזה"

#: installer.rs:107
msgid "In use: a partition is mounted"
msgstr "בשימוש: מחיצה מעוגנת"

#: installer.rs:109
msgid "Too small, MAN needs {need}"
msgstr "קטן מדי, MAN צריכה {need}"

#: installer.rs:119
msgid "Install MAN"
msgstr "התקנת MAN"

#: installer.rs:137
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN מותקנת. נא להמתין לסיום."

#: installer.rs:154
msgid "Language"
msgstr "שפה"

#: installer.rs:166
msgid "_Restart in This Language"
msgstr "הפעלה _מחדש בשפה זו"

#: installer.rs:178
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "ההפעלה החיה תופעל מחדש בשפה שנבחרה, ו־MAN תותקן בה."

#: installer.rs:224
msgid "Welcome to MAN"
msgstr "ברוכים הבאים ל־MAN"

#: installer.rs:225
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"מערכת GNOME מהירה, פתוחה וניתנת להתאמה מלאה.\n"
"אפשר להתקין אותה במחשב הזה או להמשיך להתנסות בהפעלה החיה."

#: installer.rs:229
msgid "_Install MAN…"
msgstr "_התקנת MAN…"

#: installer.rs:231
msgid "_Keep Trying MAN"
msgstr "להמשיך _לנסות את MAN"

#: installer.rs:234
msgid "Looking for disks…"
msgstr "מחפש כוננים…"

#: installer.rs:261
msgid "Welcome"
msgstr "ברוכים הבאים"

#: installer.rs:276
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "המחשב הזה הופעל במצב BIOS ישן. אפשר להתקין את MAN רק במחשבי UEFI: יש להפעיל מחדש ולבחור באפשרות האתחול UEFI."

#: installer.rs:294
msgid "The system helper returned no disk information."
msgstr "מסייע המערכת לא החזיר מידע על הכוננים."

#: installer.rs:372
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:380
msgid "_Next"
msgstr "ה_בא"

#: installer.rs:388
msgid "Erase Disk and Install MAN"
msgstr "מחיקת הכונן והתקנת MAN"

#: installer.rs:389
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "כל מה שבכונן שנבחר יימחק, כולל Windows."

#: installer.rs:389
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "מומלץ. כל מה שבכונן שנבחר יימחק."

#: installer.rs:393
msgid "Install Alongside Windows"
msgstr "התקנה לצד Windows"

#: installer.rs:394
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "מומלץ. MAN משתמשת במקום הפנוי לצד Windows; ‏Windows וקבציה נשארים. בוחרים מערכת בכל הפעלה."

#: installer.rs:401
msgid "Reinstall MAN"
msgstr "התקנה מחדש של MAN"

#: installer.rs:402
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "מחליפה את המערכת אך שומרת את הקבצים האישיים ב־‎/home. המערכת הנוכחית נשמרת כתמונת מצב."

#: installer.rs:407
msgid "Custom Partitions"
msgstr "מחיצות מותאמות"

#: installer.rs:407
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "למומחים: לבחור מחיצות בעצמך או ליצור אותן עם „כוננים”."

#: installer.rs:418
msgid "Erase an External Disk and Install MAN"
msgstr "מחיקת כונן חיצוני והתקנת MAN"

#: installer.rs:419
msgid "Everything on the chosen external disk is deleted. The Mac's internal disk is not shown and not changed."
msgstr "כל מה שבכונן החיצוני שנבחר יימחק. הכונן הפנימי של ה־Mac אינו מוצג ואינו משתנה."

#: installer.rs:420
msgid "Install on This Mac"
msgstr "התקנה ב־Mac הזה"

#: installer.rs:422
msgid "Recommended. Into the {size} prepared in macOS. macOS and its partitions are not changed."
msgstr "מומלץ. ב־{size} שהוכנו ב־macOS. ‏macOS והמחיצות שלו אינם משתנים."

#: installer.rs:427
msgid "No space for MAN was prepared yet. In macOS, run MAN-Mac/install-man.sh from the MAN USB stick and choose “MAN boot loader + space for MAN”."
msgstr "עדיין לא הוכן מקום ל־MAN. ב־macOS, יש להריץ את MAN-Mac/install-man.sh מכונן ה־USB של MAN ולבחור “MAN boot loader + space for MAN”."

#: installer.rs:433
msgid "Disk"
msgstr "כונן"

#: installer.rs:433
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "יש לבחור את הכונן שיימחק. כוננים שאי אפשר להשתמש בהם מוצגים עם הסיבה."

#: installer.rs:459
msgid "No disks were found"
msgstr "לא נמצאו כוננים"

#: installer.rs:466
msgid "Free Space Next to Windows"
msgstr "מקום פנוי לצד Windows"

#: installer.rs:467
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "מחיצות Windows לא משתנות. MAN חולקת את מחיצת מערכת EFI ומוסיפה את Windows לתפריט האתחול שלה."

#: installer.rs:473
msgid "{size} free"
msgstr "{size} פנויים"

#: installer.rs:473
msgid "no free space"
msgstr "אין מקום פנוי"

#: installer.rs:478
msgid "{model} (Windows)"
msgstr "{model} ‏(Windows)"

#: installer.rs:497
msgid "Installation to Replace"
msgstr "התקנה להחלפה"

#: installer.rs:518
msgid "no home folders"
msgstr "אין תיקיות בית"

#: installer.rs:520
msgid "home folders: {list}"
msgstr "תיקיות בית: {list}"

#: installer.rs:522
msgid "snapshots: {n}"
msgstr "תמונות מצב: {n}"

#: installer.rs:526
msgid "MAN on {model}"
msgstr "MAN על {model}"

#: installer.rs:540
msgid "Passphrase for {device}"
msgstr "מילת צופן עבור {device}"

#: installer.rs:541
msgid "Unlock"
msgstr "שחרור נעילה"

#: installer.rs:578
msgid "The installation could not be inspected."
msgstr "לא ניתן לבדוק את ההתקנה."

#: installer.rs:595
msgid "Partitions"
msgstr "מחיצות"

#: installer.rs:596
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "מחיצת המערכת מפורמטת ב־Btrfs ומכילה את ‎@system,‏ ‎@home ו־‎@snapshots. מחיצות בכונן שממנו MAN פועלת אינן מוצגות."

#: installer.rs:598
msgid "Open Disks to create or resize partitions"
msgstr "פתיחת „כוננים” ליצירת מחיצות או לשינוי גודלן"

#: installer.rs:600
msgid "Refresh the partition list"
msgstr "רענון רשימת המחיצות"

#: installer.rs:608
msgid "Choose a partition"
msgstr "בחירת מחיצה"

#: installer.rs:620
msgid "EFI System Partition"
msgstr "מחיצת מערכת EFI"

#: installer.rs:621
msgid "Format EFI System Partition"
msgstr "פרמוט מחיצת מערכת EFI"

#: installer.rs:621
msgid "Leave off to keep boot loaders of other systems"
msgstr "להשאיר כבוי כדי לשמור על מנהלי האתחול של מערכות אחרות"

#: installer.rs:623
msgid "System Partition (formatted as Btrfs)"
msgstr "מחיצת מערכת (מפורמטת כ־Btrfs)"

#: installer.rs:624
msgid "Boot Partition (needed with encryption)"
msgstr "מחיצת אתחול (נדרשת עם הצפנה)"

#: installer.rs:683
msgid "Partition list refreshed"
msgstr "רשימת המחיצות רועננה"

#: installer.rs:691
msgid "Security"
msgstr "אבטחה"

#: installer.rs:693
msgid "Encrypt the System"
msgstr "הצפנת המערכת"

#: installer.rs:694
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "מגינה על הנתונים שלך אם המחשב אובד או נגנב. בכל הפעלה תתבקש מילת צופן."

#: installer.rs:697
msgid "Passphrase"
msgstr "מילת צופן"

#: installer.rs:698
msgid "Confirm Passphrase"
msgstr "אישור מילת הצופן"

#: installer.rs:700
msgid "Keep this passphrase safe"
msgstr "יש לשמור את מילת הצופן במקום בטוח"

#: installer.rs:701
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "אם היא תאבד, אף אחד לא יוכל לשחזר את הנתונים. הליבה וקובצי האתחול נשארים במחיצת אתחול קטנה ולא מוצפנת."

#: installer.rs:774
msgid "The passphrase needs at least 8 characters."
msgstr "מילת הצופן חייבת להכיל לפחות 8 תווים."

#: installer.rs:776
msgid "The passphrases do not match."
msgstr "מילות הצופן אינן תואמות."

#: installer.rs:790
msgid "Choose a disk."
msgstr "יש לבחור כונן."

#: installer.rs:800
msgid "Choose the disk with Windows."
msgstr "יש לבחור את הכונן עם Windows."

#: installer.rs:809
msgid "Choose the installation to replace."
msgstr "יש לבחור את ההתקנה להחלפה."

#: installer.rs:810
msgid "Unlock the encrypted installation first."
msgstr "יש לשחרר קודם את נעילת ההתקנה המוצפנת."

#: installer.rs:811
msgid "This partition holds no MAN system."
msgstr "מחיצה זו אינה מכילה מערכת MAN."

#: installer.rs:818
msgid "Choose an EFI system partition."
msgstr "יש לבחור מחיצת מערכת EFI."

#: installer.rs:820
msgid "Choose the system partition."
msgstr "יש לבחור את מחיצת המערכת."

#: installer.rs:822
msgid "The EFI and system partitions must be different."
msgstr "מחיצת EFI ומחיצת המערכת חייבות להיות שונות."

#: installer.rs:824
msgid "Encryption needs a separate boot partition."
msgstr "הצפנה דורשת מחיצת אתחול נפרדת."

#: installer.rs:833
msgid "The system partition must be at least {size}."
msgstr "מחיצת המערכת חייבת להיות בגודל {size} לפחות."

#: installer.rs:835
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "מחיצת EFI אינה מפורמטת ב־FAT; יש להפעיל פרמוט."

#: installer.rs:837
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "מחיצת המערכת מעוגנת; יש לנתק אותה קודם ב„כוננים”."

#: installer.rs:859
msgid "Where Should MAN Be Installed?"
msgstr "היכן להתקין את MAN?"

#: installer.rs:866
msgid "Time and Keyboard"
msgstr "שעה ומקלדת"

#: installer.rs:871
msgid "Time Zone"
msgstr "אזור זמן"

