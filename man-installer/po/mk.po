msgid "Ready"
msgstr "Подготвено"

#: updater.rs:441
msgid "The Update Could Not Be Prepared"
msgstr "Ажурирањето не може да се подготви"

#: updater.rs:442
msgid "Nothing was changed on your system."
msgstr "Ништо не е променето во вашиот систем."

#: updater.rs:446
msgid "_Try Again"
msgstr "_Обиди се повторно"

#: updater.rs:461
msgid "Update Log"
msgstr "Дневник на ажурирањето"

#: updater.rs:463
msgid "Failed"
msgstr "Неуспешно"

