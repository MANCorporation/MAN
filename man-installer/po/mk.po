msgid "Preparing {name} {version}"
msgstr "Подготовка на {name} {version}"

#: updater.rs:385
msgid "Restart to Install"
msgstr "Рестартирај за инсталирање"

#: updater.rs:386
msgid "The computer restarts twice. Your files are safe."
msgstr "Компјутерот ќе се рестартира двапати. Вашите датотеки се безбедни."

