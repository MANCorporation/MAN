msgid "The encryption passphrase must have at least 8 characters."
msgstr "Лозинката за шифрирање мора да има најмалку 8 знаци."

#: install.rs:122
msgid "The disk changed after you confirmed the installation. Nothing was modified; please review and confirm again."
msgstr "Дискот се промени откако ја потврдивте инсталацијата. Ништо не е изменето; прегледајте и потврдете повторно."

#: install.rs:138
msgid "Choose a system partition."
msgstr "Изберете системска партиција."

#: install.rs:145
msgid "The confirmed disk does not hold the chosen system partition."
msgstr "Потврдениот диск не ја содржи избраната системска партиција."

#: install.rs:157
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "Партицијата за подигнување мора да биде одвоена од EFI и системската партиција."

#: install.rs:160
msgid "The boot partition must be at least 512 MB."
msgstr "Партицијата за подигнување мора да има најмалку 512 MB."

#: install.rs:175
msgid "No installation chosen."
msgstr "Не е избрана инсталација."

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "Потврдениот диск не ја содржи избраната инсталација."

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "Шифрираната инсталација нема партиција MAN_BOOT."

#: install.rs:695
msgid "No kernel with matching modules was found in /boot."
msgstr "Во /boot не е пронајдено јадро со соодветни модули."

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "Јазикот мора да го смени системскиот помошник."

#: oobe.rs:204
msgid "Applying your settings"
msgstr "Примена на вашите поставки"

#: oobe.rs:212
msgid "Preparing disk encryption"
msgstr "Подготовка на шифрирањето на дискот"

#: oobe.rs:216
msgid "Finishing"
msgstr "Завршување"

#: oobe.rs:100
msgid "MAN Setup must be finished by the system helper."
msgstr "MAN Setup мора да го заврши системскиот помошник."

#: oobe.rs:103
msgid "MAN Setup has already been completed on this computer."
msgstr "MAN Setup е веќе завршен на овој компјутер."

#: oobe.rs:124
msgid "Unknown accent color."
msgstr "Непозната акцентна боја."

#: oobe.rs:128
msgid "The chosen wallpaper is not available."
msgstr "Избраната позадина не е достапна."

#: oobe.rs:146
msgid "This system cannot be encrypted."
msgstr "Овој систем не може да се шифрира."

#: oobe.rs:257
msgid "The setup key is missing, so encryption cannot continue in the background."
msgstr "Клучот за поставување недостасува, па шифрирањето не може да продолжи во позадина."

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "Системот не е инсталиран на Btrfs, па снимките не се достапни."

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "Враќање снимка чека рестартирање. Прво рестартирајте го компјутерот за да го завршите."

#: snapshots.rs:99
msgid "Invalid snapshot id."
msgstr "Невалиден ID на снимка."

