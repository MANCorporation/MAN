msgstr "Shkruani këtu për të kontrolluar që tastet japin shenjat e duhura."

#: installer.rs:844
msgid "Type here"
msgstr "Shkruani këtu"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Zona kohore dhe tastiera"

