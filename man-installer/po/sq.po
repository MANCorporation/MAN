msgstr "S’është zgjedhur instalim"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Disku u zhduk"

#: installer.rs:955
msgid "Review"
msgstr "Shqyrtim"

#: installer.rs:958
msgid "Destination"
msgstr "Vendmbërritja"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Fshi diskun dhe instalo"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Ndarje të përshtatura"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Riinstalo, duke mbajtur /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Krahas Windows-it"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (do të formatohet)"

#: installer.rs:969
msgid " (kept)"
msgstr " (mbahet)"

#: installer.rs:970
msgid "System Partition"
msgstr "Ndarje sistemi"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (do të formatohet)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Ndarje nisjeje"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Hapësirë për MAN-in"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} hapësirë e lirë (krijohen një ndarje nisjeje dhe ndarja e sistemit)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Pa ndryshime. Shfaqet në menynë e nisjes së MAN-it; ndarja e sistemit EFI është e përbashkët."

#: installer.rs:983
msgid "Encryption"
msgstr "Fshehtëzim"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Aktiv (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Joaktiv"

#: installer.rs:985
msgid "File System"
msgstr "Sistem kartelash"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system për MAN-in, @home për kartelat tuaja, @snapshots për pikat e rikthimit. Të gjitha ndajnë hapësirën e lirë."

#: installer.rs:991
msgid "System"
msgstr "Sistemi"

#: installer.rs:993
msgid "Your Account"
msgstr "Llogaria juaj"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Krijohet në MAN Setup kur kompjuteri niset për herë të parë, bashkë me emrin e kompjuterit, pamjen dhe rregullimet e privatësisë."

#: installer.rs:998
msgid "Keyboard"
msgstr "Tastiera"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "Të gjitha të dhënat në {model} ({path}) do të fshihen."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Fshi dhe instalo"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Ndarjet e zgjedhura do të formatohen. Ndarjet e tjera nuk ndryshojnë."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Formato dhe instalo"

#: installer.rs:1004
