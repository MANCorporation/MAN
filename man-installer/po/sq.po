msgstr "AppImage"

#: appinstaller.rs:867
msgid "You will be guided through the steps necessary to install this software."
msgstr "Do t'ju udhëheqim nëpër hapat e nevojshëm për të instaluar këtë program."

#: appinstaller.rs:878
msgid "Version"
msgstr "Version"

#: appinstaller.rs:881
msgid "Publisher"
msgstr "Botuesi"

#: appinstaller.rs:883
msgid "Type"
msgstr "Lloji"

#: appinstaller.rs:885
msgid "Size"
msgstr "Madhësia"

#: appinstaller.rs:891
msgid "Website"
msgstr "Sajti"

#: appinstaller.rs:893
msgid "File"
msgstr "Skedari"

#: appinstaller.rs:903
msgid "This app is installed already. Installing it again replaces it."
msgstr "Ky aplikacion është instaluar tashmë. Instalimi sërish e zëvendëson."

#: appinstaller.rs:906
msgid "Apps from .deb packages become part of the system. When MAN is updated they are removed and need to be installed again. Flatpak apps and AppImages are kept."
msgstr "Aplikacionet nga paketat .deb bëhen pjesë e sistemit. Kur përditësohet MAN, ato hiqen dhe duhen instaluar sërish. Aplikacionet Flatpak dhe AppImage ruhen."

#: appinstaller.rs:909
msgid "Only install apps from sources you trust."
msgstr "Instaloni vetëm aplikacione nga burime që u besoni."

#: appinstaller.rs:915
msgid "Where do you want to install {name}?"
msgstr "Ku doni ta instaloni {name}?"

#: appinstaller.rs:920
msgid "Only your account can use the app."
msgstr "Vetëm llogaria juaj mund ta përdorë aplikacionin."

#: appinstaller.rs:921
msgid "Needs administrator rights."
msgstr "Kërkon të drejta administratori."

#: appinstaller.rs:928
msgid "Only for Me"
msgstr "Vetëm për mua"

#: appinstaller.rs:928
msgid "For All Users of This Computer"
msgstr "Për të gjithë përdoruesit e këtij kompjuteri"

#: appinstaller.rs:943
msgid "This will take {size} of space on your computer."
msgstr "Kjo do të zërë {size} hapësirë në kompjuter."

#: appinstaller.rs:945
msgid "The app is downloaded from {source}."
msgstr "Aplikacioni shkarkohet nga {source}."

#: appinstaller.rs:947
msgid "The app is installed for all users of this computer."
msgstr "Aplikacioni instalohet për të gjithë përdoruesit e këtij kompjuteri."

#: appinstaller.rs:947
msgid "The app is installed only for you."
msgstr "Aplikacioni instalohet vetëm për ju."

#: appinstaller.rs:950
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage zhvendoset te {folder} dhe shtohet te aplikacionet tuaja."

#: appinstaller.rs:952
msgid "Click Install to install {name}."
msgstr "Klikoni Instalo për të instaluar {name}."

#: appinstaller.rs:958
msgid "Checking what else the app needs…"
msgstr "Po kontrollohet çfarë tjetër i duhet aplikacionit…"

#: appinstaller.rs:968
msgid "Also installs the packages it needs: {list}"
msgstr "Instalon edhe paketat që i duhen: {list}"

#: appinstaller.rs:974
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Disa paketa që i duhen aplikacionit nuk janë ende të disponueshme. Instalimi merr së pari listat më të reja të paketave; nëse mungojnë ende, aplikacioni nuk mund të instalohet."

#: appinstaller.rs:1035
msgid "Installing {name}…"
msgstr "Po instalohet {name}…"

#: appinstaller.rs:1041
msgid "Preparing…"
msgstr "Po përgatitet…"

#: appinstaller.rs:1048
msgid "Details"
msgstr "Hollësi"

#: appinstaller.rs:1088
msgid "Installing the package…"
msgstr "Po instalohet paketa…"

#: appinstaller.rs:1107
msgid "Moving the app to its folder…"
msgstr "Aplikacioni po zhvendoset te dosja e tij…"

#: appinstaller.rs:1116
msgid "The app could not be installed."
msgstr "Aplikacioni nuk u instalua dot."

#: appinstaller.rs:1120
msgid "Installing the app with Flatpak…"
msgstr "Aplikacioni po instalohet me Flatpak…"

