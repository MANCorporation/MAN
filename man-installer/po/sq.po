#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Ky skedar nuk është aplikacion që mund të instalohet këtu (.deb, .flatpak, .flatpakref ose AppImage)."

#: appinstaller.rs:128
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Ky aplikacion është bërë për kompjuterë {arch} dhe nuk punon në këtë (x86-64)."

