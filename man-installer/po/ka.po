#: appinstaller.rs:902
msgid "File"
msgstr "ფაილი"

#: appinstaller.rs:912
msgid "This app is installed already. Installing it again replaces it."
msgstr "ეს აპი უკვე დაყენებულია. ხელახლა დაყენება მას ჩაანაცვლებს."

#: appinstaller.rs:915
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr ".deb პაკეტების აპები სისტემის ნაწილი ხდება. MAN-ის განახლება სისტემას ცვლის, ამიტომ განახლების შემდეგ ისინი ხელახლა დაყენდება მხოლოდ თუ შეინახავთ (შემდეგი ნაბიჯები)."

#: appinstaller.rs:918
msgid "Only install apps from sources you trust."
msgstr "დააყენეთ აპები მხოლოდ სანდო წყაროებიდან."

#: appinstaller.rs:924
msgid "Where do you want to install {name}?"
msgstr "სად გსურთ {name}-ის დაყენება?"

#: appinstaller.rs:929
msgid "Only your account can use the app."
msgstr "აპით სარგებლობა მხოლოდ თქვენს ანგარიშს შეუძლია."

#: appinstaller.rs:930
msgid "Needs administrator rights."
msgstr "საჭიროა ადმინისტრატორის უფლებები."

#: appinstaller.rs:937
msgid "Only for Me"
msgstr "მხოლოდ ჩემთვის"

#: appinstaller.rs:937
msgid "For All Users of This Computer"
msgstr "ამ კომპიუტერის ყველა მომხმარებლისთვის"

#: appinstaller.rs:952
msgid "This will take {size} of space on your computer."
msgstr "ეს დაიკავებს {size} ადგილს თქვენს კომპიუტერზე."

#: appinstaller.rs:954
msgid "The app is downloaded from {source}."
msgstr "აპი ჩამოიტვირთება {source}-დან."

#: appinstaller.rs:956
msgid "The app is installed for all users of this computer."
msgstr "აპი დაყენდება ამ კომპიუტერის ყველა მომხმარებლისთვის."

#: appinstaller.rs:956
msgid "The app is installed only for you."
msgstr "აპი დაყენდება მხოლოდ თქვენთვის."

#: appinstaller.rs:959
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage გადაიტანება {folder}-ში და დაემატება თქვენს აპებს."

#: appinstaller.rs:965
msgid "Keep After MAN Updates"
msgstr "შენახვა MAN-ის განახლებების შემდეგ"

#: appinstaller.rs:966
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "MAN ყოველი განახლების შემდეგ ხელახლა აყენებს აპს. ამისთვის ინახება მისი პაკეტის ფაილები."

#: appinstaller.rs:974
msgid "Click Install to install {name}."
msgstr "დააწკაპუნეთ „დაყენებაზე“, რომ დააყენოთ {name}."

#: appinstaller.rs:980
msgid "Checking what else the app needs…"
msgstr "მოწმდება, კიდევ რა სჭირდება აპს…"

#: appinstaller.rs:990
msgid "Also installs the packages it needs: {list}"
msgstr "ასევე დააყენებს საჭირო პაკეტებს: {list}"

#: appinstaller.rs:996
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "აპისთვის საჭირო ზოგიერთი პაკეტი ჯერ ხელმისაწვდომი არ არის. დაყენება ჯერ უახლეს პაკეტების სიებს მიიღებს; თუ ისინი მაინც აკლია, აპის დაყენება ვერ მოხერხდება."

#: appinstaller.rs:1057
msgid "Installing {name}…"
msgstr "{name}-ის დაყენება…"

#: appinstaller.rs:1063
msgid "Preparing…"
msgstr "მომზადება…"

#: appinstaller.rs:1070
msgid "Details"
msgstr "დეტალები"

#: appinstaller.rs:1110
msgid "Installing the package…"
msgstr "პაკეტის დაყენება…"

#: appinstaller.rs:1129
msgid "Moving the app to its folder…"
msgstr "აპის გადატანა თავის საქაღალდეში…"

#: appinstaller.rs:1138
msgid "The app could not be installed."
msgstr "აპის დაყენება ვერ მოხერხდა."

#: appinstaller.rs:1142
msgid "Installing the app with Flatpak…"
msgstr "აპის დაყენება Flatpak-ით…"

#: appinstaller.rs:1166
msgid "Log"
msgstr "ჟურნალი"

#: appinstaller.rs:1196
msgid "_Close"
msgstr "_დახურვა"

#: appinstaller.rs:1206
msgid "The Installation Was Successful"
msgstr "დაყენება წარმატებულია"

#: appinstaller.rs:1206
msgid "The app was installed."
msgstr "აპი დაყენდა."

#: appinstaller.rs:1211
msgid "The Installation Failed"
msgstr "დაყენება ვერ მოხერხდა"

#: appinstaller.rs:1222
msgid "_Open"
msgstr "_გახსნა"

#: appinstaller.rs:1232
msgid "_Show Details"
msgstr "დეტალების _ჩვენება"

#: appinstaller.rs:1235
msgid "Installation Log"
msgstr "დაყენების ჟურნალი"

#: appinstaller.rs:1262
msgid "App Installer"
msgstr "აპების დამყენებელი"

#: appinstaller.rs:1283
msgid "Go _Back"
msgstr "_უკან"

#: appinstaller.rs:1356
msgid "Reading the app…"
msgstr "აპის წაკითხვა…"

#: appinstaller.rs:1365
msgid "Install {name}"
msgstr "{name}-ის დაყენება"

#: appinstaller.rs:1384
msgid "Apps"
msgstr "აპები"

#: appinstaller.rs:1390
msgid "Choose an App to Install"
msgstr "აირჩიეთ დასაყენებელი აპი"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "სისტემის დამხმარის გაშვება ვერ მოხერხდა."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "სისტემის დამხმარესთან დაკავშირება ვერ მოხერხდა."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "სისტემის დამხმარესთან კავშირი დაიკარგა."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "ავტორიზაცია გაუქმდა."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "ამ მოქმედებისთვის საჭიროა ადმინისტრატორის უფლებები."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "სისტემის დამხმარე მოულოდნელად გაჩერდა."

#: installer.rs:89
msgid "No EFI system partition"
msgstr "EFI სისტემური დანაყოფი არ არის"

#: installer.rs:93
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "თავისუფალია მხოლოდ {free}, MAN-ს სჭირდება {need}. გაათავისუფლეთ ადგილი DUHACH!-ით Windows-ში."

#: installer.rs:94
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "თავისუფალი ადგილი არ არის. გაუშვით DUHACH! Windows-ში, რომ MAN-ს ადგილი გაუთავისუფლოთ."

#: installer.rs:103
msgid "MAN is running from this disk"
msgstr "MAN ამ დისკიდან მუშაობს"

#: installer.rs:107
msgid "In use: a partition is mounted"
msgstr "გამოიყენება: დანაყოფი მიმაგრებულია"

#: installer.rs:109
msgid "Too small, MAN needs {need}"
msgstr "ძალიან პატარაა, MAN-ს სჭირდება {need}"

#: installer.rs:119
msgid "Install MAN"
msgstr "MAN-ის დაყენება"

#: installer.rs:137
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN ყენდება. გთხოვთ, მოიცადოთ დასრულებამდე."

#: installer.rs:154
msgid "Language"
msgstr "ენა"

#: installer.rs:166
msgid "_Restart in This Language"
msgstr "_გადატვირთვა ამ ენაზე"

#: installer.rs:178
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "ცოცხალი სესია გადაიტვირთება არჩეულ ენაზე და MAN ამ ენაზე დაყენდება."

#: installer.rs:224
msgid "Welcome to MAN"
msgstr "მოგესალმებით MAN-ში"

#: installer.rs:225
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"სწრაფი, ღია და სრულად მორგებადი GNOME სისტემა.\n"
"დააყენეთ ის ამ კომპიუტერზე ან განაგრძეთ ცოცხალი სესიის დათვალიერება."

#: installer.rs:229
msgid "_Install MAN…"
msgstr "MAN-ის _დაყენება…"

#: installer.rs:231
msgid "_Keep Trying MAN"
msgstr "MAN-ის _ცდის გაგრძელება"

#: installer.rs:234
msgid "Looking for disks…"
msgstr "დისკების ძებნა…"

#: installer.rs:261
msgid "Welcome"
msgstr "მოგესალმებით"

#: installer.rs:276
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "ეს კომპიუტერი ძველ BIOS რეჟიმში ჩაირთო. MAN-ის დაყენება მხოლოდ UEFI კომპიუტერებზეა შესაძლებელი: გადატვირთეთ და აირჩიეთ UEFI ჩატვირთვის ვარიანტი."

#: installer.rs:294
msgid "The system helper returned no disk information."
msgstr "სისტემის დამხმარემ დისკების შესახებ ინფორმაცია არ დააბრუნა."

#: installer.rs:372
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:380
msgid "_Next"
msgstr "_შემდეგი"

#: installer.rs:388
msgid "Erase Disk and Install MAN"
msgstr "დისკის წაშლა და MAN-ის დაყენება"

#: installer.rs:389
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "არჩეულ დისკზე ყველაფერი წაიშლება, Windows-ის ჩათვლით."

#: installer.rs:389
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "რეკომენდებული. არჩეულ დისკზე ყველაფერი წაიშლება."

#: installer.rs:393
msgid "Install Alongside Windows"
msgstr "დაყენება Windows-ის გვერდით"

#: installer.rs:394
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "რეკომენდებული. MAN იყენებს Windows-ის გვერდით არსებულ თავისუფალ ადგილს; Windows და მისი ფაილები რჩება. სისტემას ყოველ ჩართვაზე ირჩევთ."

#: installer.rs:401
msgid "Reinstall MAN"
msgstr "MAN-ის ხელახლა დაყენება"

#: installer.rs:402
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "ცვლის სისტემას, მაგრამ ინახავს პირად ფაილებს /home-ში. მიმდინარე სისტემა შეინახება სნეპშოტად."

#: installer.rs:407
msgid "Custom Partitions"
msgstr "მორგებული დანაყოფები"

#: installer.rs:407
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "ექსპერტებისთვის: აირჩიეთ დანაყოფები თავად ან შექმენით ისინი „დისკებით“."

#: installer.rs:418
msgid "Erase an External Disk and Install MAN"
msgstr "გარე დისკის წაშლა და MAN-ის დაყენება"

#: installer.rs:419
msgid "Everything on the chosen external disk is deleted. The Mac's internal disk is not shown and not changed."
msgstr "არჩეულ გარე დისკზე ყველაფერი წაიშლება. Mac-ის შიდა დისკი არ ჩანს და არ იცვლება."

#: installer.rs:420
msgid "Install on This Mac"
msgstr "დაყენება ამ Mac-ზე"

#: installer.rs:422
msgid "Recommended. Into the {size} prepared in macOS. macOS and its partitions are not changed."
msgstr "რეკომენდებულია. macOS-ში მომზადებულ {size}-ში. macOS და მისი დანაყოფები არ იცვლება."

#: installer.rs:427
msgid "No space for MAN was prepared yet. In macOS, run MAN-Mac/install-man.sh from the MAN USB stick and choose “MAN boot loader + space for MAN”."
msgstr "MAN-ისთვის ადგილი ჯერ არ მომზადებულა. macOS-ში გაუშვით MAN-Mac/install-man.sh MAN-ის USB ფლეშიდან და აირჩიეთ “MAN boot loader + space for MAN”."

#: installer.rs:433
msgid "Disk"
msgstr "დისკი"

#: installer.rs:433
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "აირჩიეთ წასაშლელი დისკი. გამოუსადეგარი დისკები ნაჩვენებია მიზეზით."

#: installer.rs:459
msgid "No disks were found"
msgstr "დისკები ვერ მოიძებნა"

#: installer.rs:466
msgid "Free Space Next to Windows"
msgstr "თავისუფალი ადგილი Windows-ის გვერდით"

#: installer.rs:467
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows-ის დანაყოფებს არ ეხება. MAN იზიარებს EFI სისტემურ დანაყოფს და Windows-ს ამატებს თავის ჩატვირთვის მენიუში."

#: installer.rs:473
msgid "{size} free"
msgstr "{size} თავისუფალი"

#: installer.rs:473
msgid "no free space"
msgstr "თავისუფალი ადგილი არ არის"

#: installer.rs:478
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:497
msgid "Installation to Replace"
msgstr "ჩასანაცვლებელი დაყენება"

#: installer.rs:518
msgid "no home folders"
msgstr "საწყისი საქაღალდეები არ არის"

#: installer.rs:520
msgid "home folders: {list}"
msgstr "საწყისი საქაღალდეები: {list}"

