msgid "You will be guided through the steps necessary to install this software."
msgstr "გაგიძღვებით ამ პროგრამის დასაყენებლად საჭირო ნაბიჯებში."

#: appinstaller.rs:887
msgid "Version"
msgstr "ვერსია"

#: appinstaller.rs:890
msgid "Publisher"
msgstr "გამომცემელი"

#: appinstaller.rs:892
