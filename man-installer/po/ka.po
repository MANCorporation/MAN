#: backend.rs:46
msgid "Could not start the system helper."
msgstr "სისტემის დამხმარის გაშვება ვერ მოხერხდა."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "სისტემის დამხმარესთან დაკავშირება ვერ მოხერხდა."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "სისტემის დამხმარესთან კავშირი დაიკარგა."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "ავტორიზაცია გაუქმდა."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "ამ მოქმედებისთვის საჭიროა ადმინისტრატორის უფლებები."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "სისტემის დამხმარე მოულოდნელად გაჩერდა."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "EFI სისტემური დანაყოფი არ არის"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "თავისუფალია მხოლოდ {free}, MAN-ს სჭირდება {need}. გაათავისუფლეთ ადგილი DUHACH!-ით Windows-ში."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "თავისუფალი ადგილი არ არის. გაუშვით DUHACH! Windows-ში, რომ MAN-ს ადგილი გაუთავისუფლოთ."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN ამ დისკიდან მუშაობს"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "გამოიყენება: დანაყოფი მიმაგრებულია"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "ძალიან პატარაა, MAN-ს სჭირდება {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "MAN-ის დაყენება"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN ყენდება. გთხოვთ, მოიცადოთ დასრულებამდე."

#: installer.rs:143
msgid "Language"
msgstr "ენა"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_გადატვირთვა ამ ენაზე"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "ცოცხალი სესია გადაიტვირთება არჩეულ ენაზე და MAN ამ ენაზე დაყენდება."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "მოგესალმებით MAN-ში"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"სწრაფი, ღია და სრულად მორგებადი GNOME სისტემა.\n"
"დააყენეთ ის ამ კომპიუტერზე ან განაგრძეთ ცოცხალი სესიის დათვალიერება."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "MAN-ის _დაყენება…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "MAN-ის _ცდის გაგრძელება"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "დისკების ძებნა…"

#: installer.rs:250
msgid "Welcome"
msgstr "მოგესალმებით"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "ეს კომპიუტერი ძველ BIOS რეჟიმში ჩაირთო. MAN-ის დაყენება მხოლოდ UEFI კომპიუტერებზეა შესაძლებელი: გადატვირთეთ და აირჩიეთ UEFI ჩატვირთვის ვარიანტი."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "სისტემის დამხმარემ დისკების შესახებ ინფორმაცია არ დააბრუნა."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_შემდეგი"

#: installer.rs:361
msgid "Installation Type"
msgstr "დაყენების ტიპი"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "დისკის წაშლა და MAN-ის დაყენება"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "არჩეულ დისკზე ყველაფერი წაიშლება, Windows-ის ჩათვლით."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "რეკომენდებული. არჩეულ დისკზე ყველაფერი წაიშლება."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "დაყენება Windows-ის გვერდით"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "რეკომენდებული. MAN იყენებს Windows-ის გვერდით არსებულ თავისუფალ ადგილს; Windows და მისი ფაილები რჩება. სისტემას ყოველ ჩართვაზე ირჩევთ."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "MAN-ის ხელახლა დაყენება"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "ცვლის სისტემას, მაგრამ ინახავს პირად ფაილებს /home-ში. მიმდინარე სისტემა შეინახება სნეპშოტად."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "მორგებული დანაყოფები"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "ექსპერტებისთვის: აირჩიეთ დანაყოფები თავად ან შექმენით ისინი „დისკებით“."

#: installer.rs:392
msgid "Disk"
msgstr "დისკი"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "აირჩიეთ წასაშლელი დისკი. გამოუსადეგარი დისკები ნაჩვენებია მიზეზით."

#: installer.rs:418
msgid "No disks were found"
msgstr "დისკები ვერ მოიძებნა"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "თავისუფალი ადგილი Windows-ის გვერდით"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows-ის დანაყოფებს არ ეხება. MAN იზიარებს EFI სისტემურ დანაყოფს და Windows-ს ამატებს თავის ჩატვირთვის მენიუში."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} თავისუფალი"

#: installer.rs:432
msgid "no free space"
msgstr "თავისუფალი ადგილი არ არის"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "ჩასანაცვლებელი დაყენება"

#: installer.rs:477
msgid "no home folders"
msgstr "საწყისი საქაღალდეები არ არის"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "საწყისი საქაღალდეები: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "სნეპშოტები: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN {model}-ზე"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "საიდუმლო ფრაზა {device}-ისთვის"

#: installer.rs:500
msgid "Unlock"
msgstr "განბლოკვა"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "დაყენების შემოწმება ვერ მოხერხდა."

#: installer.rs:554
msgid "Partitions"
msgstr "დანაყოფები"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "სისტემური დანაყოფი ფორმატდება Btrfs-ით და შეიცავს @system, @home და @snapshots-ს. იმ დისკის დანაყოფები, საიდანაც MAN მუშაობს, არ ჩანს."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "„დისკების“ გახსნა დანაყოფების შესაქმნელად ან ზომის შესაცვლელად"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "დანაყოფების სიის განახლება"

#: installer.rs:567
msgid "Choose a partition"
msgstr "აირჩიეთ დანაყოფი"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI სისტემური დანაყოფი"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI სისტემური დანაყოფის დაფორმატება"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "დატოვეთ გამორთული, რომ სხვა სისტემების ჩამტვირთავები შენარჩუნდეს"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "სისტემური დანაყოფი (ფორმატდება Btrfs-ად)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "ჩატვირთვის დანაყოფი (საჭიროა დაშიფვრისთვის)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "დანაყოფების სია განახლდა"

#: installer.rs:650
msgid "Security"
msgstr "უსაფრთხოება"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "სისტემის დაშიფვრა"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "იცავს თქვენს მონაცემებს, თუ კომპიუტერი დაიკარგება ან მოიპარავენ. ყოველ ჩართვაზე საიდუმლო ფრაზა მოითხოვება."

#: installer.rs:656
msgid "Passphrase"
msgstr "საიდუმლო ფრაზა"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "საიდუმლო ფრაზის დადასტურება"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "შეინახეთ ეს საიდუმლო ფრაზა უსაფრთხოდ"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "თუ დაიკარგა, მონაცემების აღდგენას ვერავინ შეძლებს. ბირთვი და ჩატვირთვის ფაილები რჩება პატარა დაუშიფრავ ჩატვირთვის დანაყოფზე."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "საიდუმლო ფრაზა უნდა შეიცავდეს მინიმუმ 8 სიმბოლოს."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "საიდუმლო ფრაზები არ ემთხვევა."

#: installer.rs:748
msgid "Choose a disk."
msgstr "აირჩიეთ დისკი."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "აირჩიეთ Windows-იანი დისკი."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "აირჩიეთ ჩასანაცვლებელი დაყენება."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "ჯერ განბლოკეთ დაშიფრული დაყენება."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "ეს დანაყოფი MAN სისტემას არ შეიცავს."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "აირჩიეთ EFI სისტემური დანაყოფი."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "აირჩიეთ სისტემური დანაყოფი."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI და სისტემური დანაყოფები განსხვავებული უნდა იყოს."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "დაშიფვრას სჭირდება ცალკე ჩატვირთვის დანაყოფი."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "სისტემური დანაყოფი უნდა იყოს მინიმუმ {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI დანაყოფი FAT-ით არ არის დაფორმატებული; ჩართეთ დაფორმატება."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "სისტემური დანაყოფი მიმაგრებულია; ჯერ მოხსენით ის „დისკებში“."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "სად დავაყენოთ MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "დრო და კლავიატურა"

#: installer.rs:829
msgid "Time Zone"
msgstr "სასაათო სარტყელი"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "კლავიატურის განლაგება"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "შეამოწმეთ კლავიატურა"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "აკრიფეთ აქ, რომ შეამოწმოთ, სწორ სიმბოლოებს კრეფს თუ არა კლავიშები."

#: installer.rs:844
msgid "Type here"
msgstr "აკრიფეთ აქ"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "სასაათო სარტყელი და კლავიატურა"

#: installer.rs:920
msgid "No disk chosen"
msgstr "დისკი არჩეული არ არის"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "სისტემური დანაყოფი არჩეული არ არის"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "სისტემური დანაყოფი გაქრა"

#: installer.rs:933
msgid "No installation chosen"
msgstr "დაყენება არჩეული არ არის"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "დისკი გაქრა"

#: installer.rs:955
msgid "Review"
msgstr "გადახედვა"

#: installer.rs:958
msgid "Destination"
msgstr "დანიშნულება"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "დისკის წაშლა და დაყენება"

#: installer.rs:961
msgid "Custom partitions"
msgstr "მორგებული დანაყოფები"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "ხელახლა დაყენება /home-ის შენარჩუნებით"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Windows-ის გვერდით"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (დაფორმატდება)"

#: installer.rs:969
msgid " (kept)"
msgstr " (შენარჩუნდება)"

#: installer.rs:970
msgid "System Partition"
msgstr "სისტემური დანაყოფი"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (დაფორმატდება)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "ჩატვირთვის დანაყოფი"

#: installer.rs:976
msgid "Installation"
msgstr "დაყენება"

#: installer.rs:980
msgid "Space for MAN"
msgstr "ადგილი MAN-ისთვის"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} თავისუფალი ადგილი (იქმნება ჩატვირთვის და სისტემური დანაყოფები)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "უცვლელი. ჩნდება MAN-ის ჩატვირთვის მენიუში; EFI სისტემური დანაყოფი საერთოა."

#: installer.rs:983
msgid "Encryption"
msgstr "დაშიფვრა"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "ჩართულია (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "გამორთულია"

#: installer.rs:985
msgid "File System"
msgstr "ფაილური სისტემა"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system MAN-ისთვის, @home თქვენი ფაილებისთვის, @snapshots აღდგენის წერტილებისთვის. ყველა იზიარებს თავისუფალ ადგილს."

#: installer.rs:991
msgid "System"
msgstr "სისტემა"

#: installer.rs:993
msgid "Your Account"
msgstr "თქვენი ანგარიში"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
