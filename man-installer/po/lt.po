msgstr "Kuriama jūsų paskyra"

#: install.rs:649
msgid "Preparing MAN Setup for the first start"
msgstr "MAN Setup ruošiama pirmam paleidimui"

#: install.rs:655
msgid "Setting time zone and keyboard"
msgstr "Nustatoma laiko juosta ir klaviatūra"

#: install.rs:680
msgid "Removing the installer from the new system"
msgstr "Diegimo programa šalinama iš naujosios sistemos"

#: install.rs:687
msgid "Building the boot image (initramfs)"
msgstr "Kuriamas paleidimo atvaizdas (initramfs)"

#: install.rs:717
msgid "Configuring GRUB"
msgstr "Konfigūruojamas GRUB"

#: install.rs:735
msgid "Installing GRUB to the EFI system partition"
msgstr "GRUB diegiama į EFI sistemos skaidinį"

#: install.rs:750
msgid "Installing the fallback boot loader"
msgstr "Diegiama atsarginė paleidyklė"

#: install.rs:757
msgid "Writing the boot menu"
msgstr "Rašomas paleidimo meniu"

#: install.rs:778
msgid "Disk ready"
msgstr "Diskas paruoštas"

#: install.rs:791
msgid "Creating a snapshot of the fresh system"
msgstr "Kuriama naujosios sistemos momentinė kopija"

#: install.rs:797
msgid "Adding the snapshot to the boot menu"
msgstr "Momentinė kopija pridedama į paleidimo meniu"

#: install.rs:801
msgid "Unmounting"
msgstr "Atjungiama"

#: install.rs:85
msgid "The installer backend must run as root."
msgstr "Diegimo programos pagelbiklis turi veikti kaip root."

#: install.rs:88
msgid "This computer was not started in UEFI mode. MAN requires UEFI."
msgstr "Šis kompiuteris nepaleistas UEFI režimu. MAN reikia UEFI."

#: install.rs:92
msgid "The username is not valid."
msgstr "Naudotojo vardas netinkamas."

#: install.rs:95
msgid "A password is required."
msgstr "Reikia slaptažodžio."

#: install.rs:99
msgid "The computer name is not valid."
msgstr "Kompiuterio pavadinimas netinkamas."

#: install.rs:105
msgid "Unknown language."
msgstr "Nežinoma kalba."

#: install.rs:111
msgid "The encryption passphrase must have at least 8 characters."
msgstr "Šifravimo slaptafrazę turi sudaryti bent 8 simboliai."

#: install.rs:122
msgid "The disk changed after you confirmed the installation. Nothing was modified; please review and confirm again."
msgstr "Diskas pasikeitė po to, kai patvirtinote diegimą. Niekas nepakeista; peržiūrėkite ir patvirtinkite dar kartą."

#: install.rs:138
msgid "Choose a system partition."
msgstr "Pasirinkite sistemos skaidinį."

#: install.rs:145
msgid "The confirmed disk does not hold the chosen system partition."
msgstr "Patvirtintame diske nėra pasirinkto sistemos skaidinio."

#: install.rs:157
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "Paleidimo skaidinys turi būti atskiras nuo EFI ir sistemos skaidinių."

#: install.rs:160
msgid "The boot partition must be at least 512 MB."
msgstr "Paleidimo skaidinys turi būti bent 512 MB."

#: install.rs:175
msgid "No installation chosen."
msgstr "Įdiegtis nepasirinkta."

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "Patvirtintame diske nėra pasirinktos įdiegties."

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "Šifruota įdiegtis neturi MAN_BOOT skaidinio."

#: install.rs:695
msgid "No kernel with matching modules was found in /boot."
msgstr "Kataloge /boot nerastas branduolys su atitinkamais moduliais."

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "Kalbą turi keisti sistemos pagelbiklis."

#: oobe.rs:204
msgid "Applying your settings"
msgstr "Taikomi jūsų nustatymai"

#: oobe.rs:212
msgid "Preparing disk encryption"
msgstr "Ruošiamas disko šifravimas"

#: oobe.rs:216
msgid "Finishing"
msgstr "Baigiama"

#: oobe.rs:100
msgid "MAN Setup must be finished by the system helper."
msgstr "MAN Setup turi baigti sistemos pagelbiklis."

#: oobe.rs:103
msgid "MAN Setup has already been completed on this computer."
msgstr "MAN Setup šiame kompiuteryje jau atlikta."

#: oobe.rs:124
msgid "Unknown accent color."
msgstr "Nežinoma akcento spalva."

#: oobe.rs:128
msgid "The chosen wallpaper is not available."
msgstr "Pasirinktas darbalaukio fonas neprieinamas."

#: oobe.rs:146
msgid "This system cannot be encrypted."
msgstr "Šios sistemos šifruoti negalima."

#: oobe.rs:257
msgid "The setup key is missing, so encryption cannot continue in the background."
msgstr "Trūksta sąrankos rakto, todėl šifravimas negali tęstis fone."

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "Sistema neįdiegta Btrfs, todėl momentinės kopijos neprieinamos."

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "Momentinės kopijos atkūrimas laukia paleidimo iš naujo. Pirmiausia paleiskite kompiuterį iš naujo, kad jį baigtumėte."

#: snapshots.rs:99
msgid "Invalid snapshot id."
msgstr "Netinkamas momentinės kopijos ID."

#: update.rs:32
msgid "Checking the update"
msgstr "Tikrinamas atnaujinimas"

#: update.rs:32
msgid "Creating a snapshot"
msgstr "Kuriama momentinė kopija"

#: update.rs:32
msgid "Preparing the update area"
msgstr "Ruošiama atnaujinimo sritis"

#: update.rs:32
msgid "Unpacking the new system"
msgstr "Išpakuojama naujoji sistema"

#: update.rs:32
msgid "Moving your accounts and settings"
msgstr "Perkeliamos jūsų paskyros ir nustatymai"

#: update.rs:32
msgid "Preparing the restart"
msgstr "Ruošiamas paleidimas iš naujo"

#: update.rs:179
msgid "Unpacked"
msgstr "Išpakuota"

#: update.rs:261
msgid "Accounts"
msgstr "Paskyros"

#: update.rs:301
msgid "Removing installer-only software"
msgstr "Šalinama tik diegimo programai skirta programinė įranga"

#: update.rs:340
msgid "Building the update boot image"
msgstr "Kuriamas atnaujinimo paleidimo atvaizdas"

#: update.rs:343
msgid "Adding the one-time boot entry"
msgstr "Pridedamas vienkartinis paleidimo įrašas"

#: update.rs:377
msgid "The update is genuine"
msgstr "Atnaujinimas tikras"

#: update.rs:383
msgid "Snapshot created"
msgstr "Momentinė kopija sukurta"

#: update.rs:385
msgid "Skipped"
msgstr "Praleista"

#: update.rs:394
msgid "Update area ready"
msgstr "Atnaujinimo sritis paruošta"

#: update.rs:410
msgid "Preparing the new system"
msgstr "Ruošiama naujoji sistema"

#: update.rs:168
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Atnaujinimo failas sugadintas (kontrolinė suma nesutampa). Atsisiųskite jį dar kartą."

#: update.rs:171
msgid "The update file could not be read completely."
msgstr "Nepavyko perskaityti viso atnaujinimo failo."

#: update.rs:312
msgid "The update contains no kernel."
msgstr "Atnaujinime nėra branduolio."

#: update.rs:360
msgid "Updates must be installed by the system helper."
msgstr "Atnaujinimus turi diegti sistemos pagelbiklis."

#: update.rs:369
msgid "The chosen installation was not found."
msgstr "Pasirinkta įdiegtis nerasta."

#: update.rs:371
msgid "Only the running MAN installation can be updated."
msgstr "Atnaujinti galima tik veikiančią MAN įdiegtį."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Tai ne MAN atnaujinimo failas (nėra manifesto)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "Atnaujinimas nepasirašytas, todėl juo pasitikėti negalima."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "Atnaujinimo parašas sugadintas."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "Atnaujinimo nepasirašė MAN. Jis galėjo būti pakeistas arba gautas iš nepatikimo šaltinio."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "Atnaujinimo manifestas netinkamas."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "Slaptafrazė neteisinga arba nepavyksta atverti šifruoto skaidinio."

