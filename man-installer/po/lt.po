#: backend.rs:46
msgid "Could not start the system helper."
msgstr "Nepavyko paleisti sistemos pagelbiklio."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "Nepavyko susisiekti su sistemos pagelbikliu."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "Ryšys su sistemos pagelbikliu nutrūko."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "Įgaliojimas atšauktas."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "Šiam veiksmui reikia administratoriaus teisių."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "Sistemos pagelbiklis netikėtai sustojo."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Nėra EFI sistemos skaidinio"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Laisva tik {free}, MAN reikia {need}. Atlaisvinkite vietos su DUHACH! sistemoje Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Nėra laisvos vietos. Paleiskite DUHACH! sistemoje Windows, kad padarytumėte vietos MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN veikia iš šio disko"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Naudojamas: prijungtas skaidinys"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Per mažas, MAN reikia {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Įdiegti MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN diegiama. Palaukite, kol baigsis."

#: installer.rs:143
msgid "Language"
msgstr "Kalba"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Paleisti iš naujo šia kalba"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Gyvoji sesija bus paleista iš naujo pasirinkta kalba, ir MAN bus įdiegta ta kalba."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Sveiki atvykę į MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Greita, atvira ir visiškai pritaikoma GNOME sistema.\n"
"Įdiekite ją šiame kompiuteryje arba toliau tyrinėkite gyvąją sesiją."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "Į_diegti MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Toliau bandyti MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Ieškoma diskų…"

#: installer.rs:250
msgid "Welcome"
msgstr "Sveiki atvykę"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Šis kompiuteris paleistas senuoju BIOS režimu. MAN galima įdiegti tik UEFI kompiuteriuose: paleiskite iš naujo ir pasirinkite UEFI paleidimo parinktį."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Sistemos pagelbiklis negrąžino informacijos apie diskus."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Toliau"

#: installer.rs:361
msgid "Installation Type"
msgstr "Diegimo tipas"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Ištrinti diską ir įdiegti MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Viskas pasirinktame diske bus ištrinta, įskaitant Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Rekomenduojama. Viskas pasirinktame diske bus ištrinta."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Įdiegti šalia Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Rekomenduojama. MAN naudoja laisvą vietą šalia Windows; Windows ir jos failai lieka. Sistemą renkatės kaskart paleisdami."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Įdiegti MAN iš naujo"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Pakeičia sistemą, bet išsaugo asmeninius failus kataloge /home. Dabartinė sistema išsaugoma kaip momentinė kopija."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Pasirinktiniai skaidiniai"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Ekspertams: skaidinius pasirinkite patys arba sukurkite programa Diskai."

#: installer.rs:392
msgid "Disk"
msgstr "Diskas"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Pasirinkite diską, kuris bus ištrintas. Netinkami diskai rodomi su priežastimi."

#: installer.rs:418
msgid "No disks were found"
msgstr "Diskų nerasta"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Laisva vieta šalia Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows skaidiniai neliečiami. MAN dalijasi EFI sistemos skaidiniu ir prideda Windows į savo paleidimo meniu."

#: installer.rs:432
msgid "{size} free"
msgstr "laisva {size}"

#: installer.rs:432
msgid "no free space"
msgstr "nėra laisvos vietos"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Keičiama įdiegtis"

#: installer.rs:477
msgid "no home folders"
msgstr "nėra namų aplankų"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "namų aplankai: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "momentinės kopijos: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN diske {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Slaptafrazė įrenginiui {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Atrakinti"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Nepavyko patikrinti įdiegties."

#: installer.rs:554
msgid "Partitions"
msgstr "Skaidiniai"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Sistemos skaidinys formatuojamas Btrfs ir turi @system, @home ir @snapshots. Disko, iš kurio veikia MAN, skaidiniai nerodomi."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Atverti Diskus skaidiniams kurti ar jų dydžiui keisti"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Atnaujinti skaidinių sąrašą"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Pasirinkite skaidinį"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI sistemos skaidinys"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Formatuoti EFI sistemos skaidinį"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Palikite išjungtą, kad liktų kitų sistemų paleidyklės"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Sistemos skaidinys (formatuojamas Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Paleidimo skaidinys (reikalingas šifruojant)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Skaidinių sąrašas atnaujintas"

#: installer.rs:650
msgid "Security"
msgstr "Saugumas"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Šifruoti sistemą"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Apsaugo jūsų duomenis, jei kompiuteris pamestas ar pavogtas. Slaptafrazės klausiama kaskart paleidžiant."

#: installer.rs:656
msgid "Passphrase"
msgstr "Slaptafrazė"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Patvirtinkite slaptafrazę"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Saugokite šią slaptafrazę"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Ją pametus niekas negalės atkurti duomenų. Branduolys ir paleidimo failai lieka mažame nešifruotame paleidimo skaidinyje."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Slaptafrazę turi sudaryti bent 8 simboliai."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Slaptafrazės nesutampa."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Pasirinkite diską."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Pasirinkite diską su Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Pasirinkite keičiamą įdiegtį."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Pirmiausia atrakinkite šifruotą įdiegtį."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Šiame skaidinyje nėra MAN sistemos."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Pasirinkite EFI sistemos skaidinį."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Pasirinkite sistemos skaidinį."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI ir sistemos skaidiniai turi skirtis."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Šifravimui reikia atskiro paleidimo skaidinio."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Sistemos skaidinys turi būti bent {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI skaidinys nesuformatuotas FAT; įjunkite formatavimą."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Sistemos skaidinys prijungtas; pirmiausia atjunkite jį programoje Diskai."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Kur įdiegti MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Laikas ir klaviatūra"

#: installer.rs:829
msgid "Time Zone"
msgstr "Laiko juosta"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Klaviatūros išdėstymas"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Išbandykite klaviatūrą"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Rašykite čia, kad patikrintumėte, ar klavišai rašo teisingus simbolius."

#: installer.rs:844
msgid "Type here"
msgstr "Rašykite čia"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Laiko juosta ir klaviatūra"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Diskas nepasirinktas"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Sistemos skaidinys nepasirinktas"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Sistemos skaidinys dingo"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Įdiegtis nepasirinkta"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Diskas dingo"

#: installer.rs:955
msgid "Review"
msgstr "Peržiūra"

#: installer.rs:958
msgid "Destination"
msgstr "Paskirtis"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Ištrinti diską ir įdiegti"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Pasirinktiniai skaidiniai"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Įdiegti iš naujo, išsaugant /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Šalia Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (bus suformatuotas)"

#: installer.rs:969
msgid " (kept)"
msgstr " (išsaugomas)"

#: installer.rs:970
msgid "System Partition"
msgstr "Sistemos skaidinys"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (bus suformatuotas)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Paleidimo skaidinys"

#: installer.rs:976
msgid "Installation"
msgstr "Įdiegtis"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Vieta MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} laisvos vietos (sukuriamas paleidimo ir sistemos skaidinys)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Nepakeista. Ji rodoma MAN paleidimo meniu; EFI sistemos skaidinys bendras."

#: installer.rs:983
msgid "Encryption"
msgstr "Šifravimas"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Įjungtas (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Išjungtas"

#: installer.rs:985
msgid "File System"
msgstr "Failų sistema"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system skirtas MAN, @home – jūsų failams, @snapshots – atkūrimo taškams. Visi dalijasi laisva vieta."

#: installer.rs:991
msgid "System"
msgstr "Sistema"

#: installer.rs:993
msgid "Your Account"
msgstr "Jūsų paskyra"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Sukuriama MAN Setup pirmą kartą paleidus kompiuterį, kartu su kompiuterio pavadinimu, išvaizda ir privatumo nustatymais."

#: installer.rs:998
msgid "Keyboard"
msgstr "Klaviatūra"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "Visi duomenys diske {model} ({path}) bus ištrinti."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Ištrinti ir įdiegti"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Pasirinkti skaidiniai bus suformatuoti. Kiti skaidiniai nesikeičia."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Formatuoti ir įdiegti"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "Dabartinė sistema pakeičiama. Jūsų failai kataloge /home išsaugomi, o senoji sistema išsaugoma kaip momentinė kopija."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "Įdiegti _iš naujo"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN įdiegiama laisvoje vietoje. Windows ir jos failai nesikeičia."

#: installer.rs:1005
msgid "_Install"
msgstr "Į_diegti"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "Paruošta diegti"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "Ištrinti {model}?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "Visi failai ir skaidiniai įrenginyje {path} ({size}) bus negrįžtamai ištrinti. To atšaukti negalima."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "Ištrinti ir įdiegti"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "Formatuoti pasirinktus skaidinius?"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "Visi duomenys pasirinktuose skaidiniuose bus negrįžtamai ištrinti. Kiti skaidiniai nesikeičia."

#: installer.rs:1037
msgid "Format and Install"
msgstr "Formatuoti ir įdiegti"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "Įdiegti MAN šalia Windows?"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "MAN įdiegiama {free} laisvos vietos diske {model} ({path}). Windows ir jos failai nesikeičia."

#: installer.rs:1046
msgid "Install"
msgstr "Įdiegti"

#: installer.rs:1050
msgid "Reinstall MAN?"
msgstr "Įdiegti MAN iš naujo?"

#: installer.rs:1051
msgid "The installed system will be replaced by a fresh copy. Personal files in /home are kept and the old system remains available as a snapshot."
msgstr "Įdiegta sistema bus pakeista nauja kopija. Asmeniniai failai kataloge /home išsaugomi, o senoji sistema lieka pasiekiama kaip momentinė kopija."

#: installer.rs:1052
msgid "Reinstall"
msgstr "Įdiegti iš naujo"

#: installer.rs:1057
msgid "_Cancel"
msgstr "_Atsisakyti"

#: installer.rs:1076
msgid "Installing MAN"
msgstr "Diegiama MAN"

#: installer.rs:1077
msgid "Starting…"
msgstr "Pradedama…"

#: installer.rs:1085
msgid "Details"
msgstr "Išsamiau"

#: installer.rs:1090
msgid "Installing"
msgstr "Diegiama"

#: installer.rs:1103
msgid "Step {index} of {n}  ·  {title}"
msgstr "Žingsnis {index} iš {n}  ·  {title}"

#: installer.rs:1128
msgid "Log"
msgstr "Žurnalas"

#: installer.rs:1138
msgid "MAN Is Installed"
msgstr "MAN įdiegta"

#: installer.rs:1143
msgid "Restart the computer to start using MAN. A menu at every start lets you choose MAN or Windows; the temporary MAN installer partition is removed by MAN on its first start."
msgstr "Paleiskite kompiuterį iš naujo, kad pradėtumėte naudoti MAN. Kaskart paleidžiant meniu leidžia rinktis MAN arba Windows; laikiną diegimo skaidinį MAN pašalina pirmą kartą paleista."

#: installer.rs:1149
msgid "Restart the computer to start using MAN. You can remove the installation media; if it stays connected, MAN still starts from the new disk."
msgstr "Paleiskite kompiuterį iš naujo, kad pradėtumėte naudoti MAN. Diegimo laikmeną galite išimti; jei ji lieka prijungta, MAN vis tiek paleidžiama iš naujojo disko."

#: installer.rs:1156
msgid "_Restart Now"
msgstr "_Paleisti iš naujo dabar"

#: installer.rs:1171
msgid "Done"
msgstr "Atlikta"

#: installer.rs:1182
msgid "Installation Failed"
msgstr "Diegimas nepavyko"

#: installer.rs:1186
msgid "No other disk was changed, and the installer has released the target disk. You can review the plan and try again."
msgstr "Joks kitas diskas nepakeistas, o diegimo programa atlaisvino paskirties diską. Galite peržiūrėti planą ir bandyti dar kartą."

#: installer.rs:1191
msgid "_Review and Try Again"
msgstr "_Peržiūrėti ir bandyti dar kartą"

#: installer.rs:1193
msgid "_Show Details"
msgstr "_Rodyti išsamiau"

#: installer.rs:1208
msgid "Installation Log"
msgstr "Diegimo žurnalas"

#: langui.rs:229
msgid "Search languages"
msgstr "Ieškoti kalbų"

#: langui.rs:269
msgid "Search countries"
msgstr "Ieškoti šalių"

#: oobe.rs:165
msgid "The system disk was not found."
msgstr "Sistemos diskas nerastas."

#: oobe.rs:173
msgid "Encryption needs the Btrfs layout created by the MAN installer."
msgstr "Šifravimui reikia MAN diegimo programos sukurto Btrfs išdėstymo."

#: oobe.rs:177
msgid "This installation has no separate boot partition, which encryption needs. Reinstall MAN with “Erase Disk” to use encryption."
msgstr "Šioje įdiegtyje nėra atskiro paleidimo skaidinio, kurio reikia šifravimui. Norėdami šifruoti, įdiekite MAN iš naujo su „Ištrinti diską“."

#: oobe.rs:501
msgid "MAN Setup"
msgstr "MAN Setup"

#: oobe.rs:554
msgid "Where Are You?"
msgstr "Kur esate?"

#: oobe.rs:554
msgid "Your country or region sets the date, time and number formats."
msgstr "Jūsų šalis ar regionas nustato datos, laiko ir skaičių formatą."

#: oobe.rs:572
msgid "Country"
msgstr "Šalis"

#: oobe.rs:587
msgid "GNU General Public License, version 2"
msgstr "GNU bendroji viešoji licencija, 2 versija"

#: oobe.rs:587
msgid "The Linux kernel and many system tools"
msgstr "Linux branduolys ir daug sistemos įrankių"

#: oobe.rs:588
msgid "GNU General Public License, version 3"
msgstr "GNU bendroji viešoji licencija, 3 versija"

#: oobe.rs:588
msgid "Many GNU and GNOME programs"
msgstr "Daug GNU ir GNOME programų"

#: oobe.rs:589
msgid "GNU Lesser General Public License, version 2.1"
msgstr "GNU mažesnioji bendroji viešoji licencija, 2.1 versija"

#: oobe.rs:589
msgid "GTK, GLib and many libraries"
msgstr "GTK, GLib ir daug bibliotekų"

#: oobe.rs:590
msgid "GNU Lesser General Public License, version 3"
msgstr "GNU mažesnioji bendroji viešoji licencija, 3 versija"

#: oobe.rs:590
msgid "Libraries"
msgstr "Bibliotekos"

#: oobe.rs:591
msgid "Mozilla Public License 2.0"
msgstr "Mozilla viešoji licencija 2.0"

#: oobe.rs:591
msgid "Programs and libraries from Mozilla and others"
msgstr "Mozilla ir kitų programos bei bibliotekos"

#: oobe.rs:592
msgid "Apache License 2.0"
msgstr "Apache licencija 2.0"

#: oobe.rs:592
msgid "Libraries and tools"
msgstr "Bibliotekos ir įrankiai"

#: oobe.rs:597
msgid "License Agreement"
msgstr "Licencinė sutartis"

#: oobe.rs:597
msgid "Please read and accept the terms under which MAN is provided."
msgstr "Perskaitykite ir priimkite sąlygas, kuriomis teikiama MAN."

#: oobe.rs:608
msgid "Licenses"
msgstr "Licencijos"

#: oobe.rs:616
msgid "The license text is not available ({path})."
msgstr "Licencijos tekstas neprieinamas ({path})."

#: oobe.rs:622
msgid "I have read and accept the license terms"
msgstr "Perskaičiau ir priimu licencijos sąlygas"

#: oobe.rs:692
msgid "Wired"
msgstr "Laidinis"

#: oobe.rs:698
msgid "Not connected"
msgstr "Neprisijungta"

#: oobe.rs:732
msgid "Connect to the Internet"
msgstr "Prisijunkite prie interneto"

#: oobe.rs:732
msgid "Connecting lets MAN set the time and keep your software up to date. You can also do this later."
msgstr "Prisijungusi MAN gali nustatyti laiką ir atnaujinti programinę įrangą. Tai galite padaryti ir vėliau."

#: oobe.rs:734
msgid "Checking the connection…"
msgstr "Tikrinamas ryšys…"

#: oobe.rs:740
msgid "Wi-Fi Networks"
msgstr "Wi-Fi tinklai"

#: oobe.rs:742
msgid "Search Again"
msgstr "Ieškoti dar kartą"

#: oobe.rs:753
msgid "_Skip"
msgstr "_Praleisti"

#: oobe.rs:754
msgid "You can connect later in Settings."
msgstr "Prisijungti galite vėliau Nustatymuose."

#: oobe.rs:763
msgid "Connected"
msgstr "Prisijungta"

#: oobe.rs:763
msgid "Not Connected"
msgstr "Neprisijungta"

#: oobe.rs:791
msgid "No networks found"
msgstr "Tinklų nerasta"

