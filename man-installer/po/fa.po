msgid "Summary"
msgstr "خلاصه"

#: appinstaller.rs:788
msgid "_Continue"
msgstr "_ادامه"

#: appinstaller.rs:797
msgid "Welcome to the {name} Installer"
msgstr "به نصب‌کنندهٔ {name} خوش آمدید"

#: appinstaller.rs:801
msgid "Software License Agreement"
msgstr "توافق‌نامهٔ پروانهٔ نرم‌افزار"

#: appinstaller.rs:811
msgid "Do You Agree to the License?"
msgstr "آیا با پروانه موافقید؟"

#: appinstaller.rs:812
msgid "To continue installing, you must agree to the terms of the software license agreement."
msgstr "برای ادامهٔ نصب باید با شرایط توافق‌نامهٔ پروانهٔ نرم‌افزار موافقت کنید."

#: appinstaller.rs:814
msgid "_Read License"
msgstr "_خواندن پروانه"

#: appinstaller.rs:815
msgid "_Agree"
msgstr "_موافقم"

#: appinstaller.rs:828
msgid "Select a Destination"
msgstr "یک مقصد انتخاب کنید"

#: appinstaller.rs:832
msgid "Standard Install"
msgstr "نصب استاندارد"

#: appinstaller.rs:833
msgid "_Install"
msgstr "_نصب"

#: appinstaller.rs:846
msgid "Debian package (.deb)"
msgstr "بستهٔ دبیان (‎.deb)"

#: appinstaller.rs:847
msgid "Flatpak app"
msgstr "برنامهٔ Flatpak"

#: appinstaller.rs:848
msgid "Flatpak app from {source}"
msgstr "برنامهٔ Flatpak از {source}"

#: appinstaller.rs:849
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:867
msgid "You will be guided through the steps necessary to install this software."
msgstr "در گام‌های لازم برای نصب این نرم‌افزار راهنمایی می‌شوید."

#: appinstaller.rs:878
msgid "Version"
msgstr "نسخه"

#: appinstaller.rs:881
msgid "Publisher"
msgstr "ناشر"

#: appinstaller.rs:883
msgid "Type"
msgstr "نوع"

#: appinstaller.rs:885
msgid "Size"
msgstr "اندازه"

#: appinstaller.rs:891
msgid "Website"
msgstr "وب‌سایت"

#: appinstaller.rs:893
msgid "File"
msgstr "پرونده"

#: appinstaller.rs:903
msgid "This app is installed already. Installing it again replaces it."
msgstr "این برنامه از قبل نصب است. نصب دوباره آن را جایگزین می‌کند."

#: appinstaller.rs:906
msgid "Apps from .deb packages become part of the system. When MAN is updated they are removed and need to be installed again. Flatpak apps and AppImages are kept."
msgstr "برنامه‌های بسته‌های ‎.deb بخشی از سامانه می‌شوند. با به‌روزرسانی MAN حذف می‌شوند و باید دوباره نصب شوند. برنامه‌های Flatpak و AppImage حفظ می‌شوند."

#: appinstaller.rs:909
msgid "Only install apps from sources you trust."
msgstr "فقط برنامه‌هایی را از منابع مورد اعتماد نصب کنید."

#: appinstaller.rs:915
msgid "Where do you want to install {name}?"
msgstr "می‌خواهید {name} را کجا نصب کنید؟"

#: appinstaller.rs:920
msgid "Only your account can use the app."
msgstr "فقط حساب شما می‌تواند از برنامه استفاده کند."

#: appinstaller.rs:921
msgid "Needs administrator rights."
msgstr "به دسترسی مدیر نیاز دارد."

#: appinstaller.rs:928
msgid "Only for Me"
msgstr "فقط برای من"

#: appinstaller.rs:928
msgid "For All Users of This Computer"
msgstr "برای همهٔ کاربران این رایانه"

#: appinstaller.rs:943
msgid "This will take {size} of space on your computer."
msgstr "این کار {size} از فضای رایانهٔ شما را می‌گیرد."

#: appinstaller.rs:945
msgid "The app is downloaded from {source}."
msgstr "برنامه از {source} بارگیری می‌شود."

#: appinstaller.rs:947
msgid "The app is installed for all users of this computer."
msgstr "برنامه برای همهٔ کاربران این رایانه نصب می‌شود."

#: appinstaller.rs:947
msgid "The app is installed only for you."
msgstr "برنامه فقط برای شما نصب می‌شود."

#: appinstaller.rs:950
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage به {folder} منتقل و به برنامه‌های شما افزوده می‌شود."

#: appinstaller.rs:952
msgid "Click Install to install {name}."
msgstr "برای نصب {name} روی «نصب» بزنید."

#: appinstaller.rs:958
msgid "Checking what else the app needs…"
msgstr "در حال بررسی نیازهای دیگر برنامه…"

#: appinstaller.rs:968
msgid "Also installs the packages it needs: {list}"
msgstr "بسته‌های مورد نیاز آن را هم نصب می‌کند: {list}"

#: appinstaller.rs:974
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "برخی بسته‌هایی که برنامه نیاز دارد هنوز در دسترس نیستند. نصب ابتدا تازه‌ترین فهرست‌های بسته را می‌گیرد؛ اگر باز هم موجود نباشند، برنامه نصب نمی‌شود."

#: appinstaller.rs:1035
msgid "Installing {name}…"
msgstr "در حال نصب {name}…"

#: appinstaller.rs:1041
msgid "Preparing…"
msgstr "در حال آماده‌سازی…"

#: appinstaller.rs:1048
msgid "Details"
msgstr "جزئیات"

#: appinstaller.rs:1088
msgid "Installing the package…"
msgstr "در حال نصب بسته…"

#: appinstaller.rs:1107
msgid "Moving the app to its folder…"
msgstr "در حال انتقال برنامه به پوشه‌اش…"

#: appinstaller.rs:1116
msgid "The app could not be installed."
msgstr "برنامه نصب نشد."

#: appinstaller.rs:1120
msgid "Installing the app with Flatpak…"
msgstr "در حال نصب برنامه با Flatpak…"

#: appinstaller.rs:1139
msgid "Log"
msgstr "گزارش"

#: appinstaller.rs:1169
msgid "_Close"
msgstr "_بستن"

#: appinstaller.rs:1179
msgid "The Installation Was Successful"
msgstr "نصب با موفقیت انجام شد"

#: appinstaller.rs:1179
msgid "The app was installed."
msgstr "برنامه نصب شد."

#: appinstaller.rs:1184
msgid "The Installation Failed"
msgstr "نصب شکست خورد"

#: appinstaller.rs:1195
msgid "_Open"
msgstr "_باز کردن"

#: appinstaller.rs:1205
msgid "_Show Details"
msgstr "_نمایش جزئیات"

#: appinstaller.rs:1208
msgid "Installation Log"
msgstr "گزارش نصب"

#: appinstaller.rs:1235
msgid "App Installer"
msgstr "نصب‌کنندهٔ برنامه"

#: appinstaller.rs:1256
msgid "Go _Back"
msgstr "_بازگشت"

#: appinstaller.rs:1328
msgid "Reading the app…"
msgstr "در حال خواندن برنامه…"

#: appinstaller.rs:1337
msgid "Install {name}"
msgstr "نصب {name}"

#: appinstaller.rs:1356
msgid "Apps"
msgstr "برنامه‌ها"

#: appinstaller.rs:1362
msgid "Choose an App to Install"
msgstr "برنامه‌ای برای نصب انتخاب کنید"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "دستیار سیستم اجرا نشد."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "ارتباط با دستیار سیستم ممکن نشد."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "ارتباط با دستیار سیستم قطع شد."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "مجوزدهی لغو شد."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "این کار به دسترسی مدیر نیاز دارد."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "دستیار سیستم به‌طور غیرمنتظره متوقف شد."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "پارتیشن سیستم EFI وجود ندارد"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "فقط {free} فضای خالی هست و MAN به {need} نیاز دارد. با DUHACH! در Windows فضا آزاد کنید."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "فضای خالی وجود ندارد. DUHACH! را در Windows اجرا کنید تا برای MAN جا باز شود."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN از همین دیسک اجرا می‌شود"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "در حال استفاده: یک پارتیشن سوار شده است"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "خیلی کوچک است، MAN به {need} نیاز دارد"

#: installer.rs:108
msgid "Install MAN"
msgstr "نصب MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN در حال نصب است. لطفاً تا پایان صبر کنید."

#: installer.rs:143
msgid "Language"
msgstr "زبان"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_راه‌اندازی دوباره با این زبان"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "نشست زنده با زبان انتخاب‌شده دوباره راه‌اندازی می‌شود و MAN نیز با همین زبان نصب می‌شود."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "به MAN خوش آمدید"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"یک سیستم GNOME سریع، باز و کاملاً سفارشی‌شدنی.\n"
"آن را روی این رایانه نصب کنید یا به کاوش در نشست زنده ادامه دهید."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_نصب MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_ادامهٔ آزمودن MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "در حال جست‌وجوی دیسک‌ها…"

#: installer.rs:250
msgid "Welcome"
msgstr "خوش آمدید"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "این رایانه در حالت BIOS قدیمی راه‌اندازی شده است. MAN فقط روی رایانه‌های UEFI نصب می‌شود: دوباره راه‌اندازی کنید و گزینهٔ راه‌اندازی UEFI را برگزینید."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "دستیار سیستم هیچ اطلاعاتی دربارهٔ دیسک‌ها برنگرداند."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_بعدی"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "پاک کردن دیسک و نصب MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "همه‌چیز روی دیسک انتخاب‌شده پاک می‌شود، از جمله Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "پیشنهادی. همه‌چیز روی دیسک انتخاب‌شده پاک می‌شود."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "نصب در کنار Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "پیشنهادی. MAN از فضای خالی کنار Windows استفاده می‌کند؛ Windows و پرونده‌هایش می‌مانند. در هر راه‌اندازی سیستم را انتخاب می‌کنید."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "نصب دوبارهٔ MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "سیستم را جایگزین می‌کند ولی پرونده‌های شخصی در ‎/home را نگه می‌دارد. سیستم کنونی به‌صورت تصویر لحظه‌ای ذخیره می‌شود."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "پارتیشن‌های سفارشی"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "برای کارشناسان: پارتیشن‌ها را خودتان انتخاب کنید یا با «دیسک‌ها» بسازید."

#: installer.rs:392
msgid "Disk"
msgstr "دیسک"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "دیسکی را که پاک می‌شود انتخاب کنید. دیسک‌های غیرقابل استفاده همراه با دلیل نشان داده می‌شوند."

#: installer.rs:418
msgid "No disks were found"
msgstr "هیچ دیسکی پیدا نشد"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "فضای خالی کنار Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "به پارتیشن‌های Windows دست زده نمی‌شود. MAN پارتیشن سیستم EFI را به اشتراک می‌گذارد و Windows را به منوی راه‌اندازی خود می‌افزاید."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} خالی"

#: installer.rs:432
msgid "no free space"
msgstr "بدون فضای خالی"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "نصبی که جایگزین می‌شود"

#: installer.rs:477
msgid "no home folders"
msgstr "بدون پوشهٔ خانگی"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "پوشه‌های خانگی: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "تصویرهای لحظه‌ای: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN روی {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "عبارت عبور برای {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "باز کردن قفل"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "نصب بررسی نشد."

#: installer.rs:554
msgid "Partitions"
msgstr "پارتیشن‌ها"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "پارتیشن سیستم با Btrfs قالب‌بندی می‌شود و شامل ‎@system، ‎@home و ‎@snapshots است. پارتیشن‌های دیسکی که MAN از آن اجرا می‌شود فهرست نمی‌شوند."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "باز کردن «دیسک‌ها» برای ساخت یا تغییر اندازهٔ پارتیشن‌ها"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "تازه‌سازی فهرست پارتیشن‌ها"

#: installer.rs:567
msgid "Choose a partition"
msgstr "یک پارتیشن انتخاب کنید"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "پارتیشن سیستم EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "قالب‌بندی پارتیشن سیستم EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "خاموش بگذارید تا بارکننده‌های راه‌اندازی سیستم‌های دیگر حفظ شوند"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "پارتیشن سیستم (با Btrfs قالب‌بندی می‌شود)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "پارتیشن راه‌اندازی (برای رمزگذاری لازم است)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "فهرست پارتیشن‌ها تازه شد"

#: installer.rs:650
msgid "Security"
msgstr "امنیت"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "رمزگذاری سیستم"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "اگر رایانه گم یا دزدیده شود از داده‌هایتان محافظت می‌کند. در هر راه‌اندازی عبارت عبور پرسیده می‌شود."

#: installer.rs:656
msgid "Passphrase"
msgstr "عبارت عبور"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "تأیید عبارت عبور"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "این عبارت عبور را در جای امنی نگه دارید"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "اگر گم شود، هیچ‌کس نمی‌تواند داده‌ها را بازیابی کند. هسته و پرونده‌های راه‌اندازی روی یک پارتیشن راه‌اندازی کوچک و رمزگذاری‌نشده می‌مانند."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "عبارت عبور باید دست‌کم ۸ نویسه باشد."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "عبارت‌های عبور یکسان نیستند."

#: installer.rs:748
msgid "Choose a disk."
msgstr "یک دیسک انتخاب کنید."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "دیسک دارای Windows را انتخاب کنید."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "نصبی را که جایگزین می‌شود انتخاب کنید."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "ابتدا قفل نصب رمزگذاری‌شده را باز کنید."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "این پارتیشن سیستم MAN ندارد."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "یک پارتیشن سیستم EFI انتخاب کنید."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "پارتیشن سیستم را انتخاب کنید."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "پارتیشن EFI و پارتیشن سیستم باید متفاوت باشند."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "رمزگذاری به یک پارتیشن راه‌اندازی جداگانه نیاز دارد."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "پارتیشن سیستم باید دست‌کم {size} باشد."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "پارتیشن EFI با FAT قالب‌بندی نشده است؛ قالب‌بندی را روشن کنید."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "پارتیشن سیستم سوار شده است؛ ابتدا آن را در «دیسک‌ها» پیاده کنید."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "MAN کجا نصب شود؟"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "زمان و صفحه‌کلید"

#: installer.rs:829
msgid "Time Zone"
msgstr "منطقهٔ زمانی"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "چیدمان صفحه‌کلید"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "صفحه‌کلید خود را بیازمایید"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "اینجا بنویسید تا مطمئن شوید کلیدها نویسه‌های درست را تولید می‌کنند."

#: installer.rs:844
msgid "Type here"
msgstr "اینجا بنویسید"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "منطقهٔ زمانی و صفحه‌کلید"

#: installer.rs:920
msgid "No disk chosen"
