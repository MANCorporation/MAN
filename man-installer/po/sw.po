msgstr "Maktaba na zana"

#: oobe.rs:597
msgid "License Agreement"
msgstr "Makubaliano ya leseni"

#: oobe.rs:597
msgid "Please read and accept the terms under which MAN is provided."
msgstr "Tafadhali soma na ukubali masharti ambayo MAN inatolewa chini yake."

#: oobe.rs:608
msgid "Licenses"
msgstr "Leseni"

