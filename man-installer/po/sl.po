msgid "Creating a snapshot of the fresh system"
msgstr "Ustvarjanje posnetka novega sistema"

#: install.rs:797
msgid "Adding the snapshot to the boot menu"
msgstr "Dodajanje posnetka v zagonski meni"

#: install.rs:801
msgid "Unmounting"
msgstr "Odklapljanje"

#: install.rs:85
msgid "The installer backend must run as root."
msgstr "Pomočnik namestitvenega programa mora teči kot root."

#: install.rs:88
msgid "This computer was not started in UEFI mode. MAN requires UEFI."
msgstr "Ta računalnik ni bil zagnan v načinu UEFI. MAN zahteva UEFI."

#: install.rs:92
msgid "The username is not valid."
msgstr "Uporabniško ime ni veljavno."

#: install.rs:95
msgid "A password is required."
msgstr "Geslo je obvezno."

#: install.rs:99
msgid "The computer name is not valid."
msgstr "Ime računalnika ni veljavno."

#: install.rs:105
msgid "Unknown language."
msgstr "Neznan jezik."

#: install.rs:111
msgid "The encryption passphrase must have at least 8 characters."
msgstr "Šifrirno geslo mora imeti vsaj 8 znakov."

#: install.rs:122
msgid "The disk changed after you confirmed the installation. Nothing was modified; please review and confirm again."
msgstr "Disk se je spremenil po tem, ko ste potrdili namestitev. Nič ni bilo spremenjeno; preglejte in znova potrdite."

#: install.rs:138
msgid "Choose a system partition."
msgstr "Izberite sistemski razdelek."

#: install.rs:145
msgid "The confirmed disk does not hold the chosen system partition."
msgstr "Potrjeni disk ne vsebuje izbranega sistemskega razdelka."

#: install.rs:157
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "Zagonski razdelek mora biti ločen od razdelka EFI in sistemskega razdelka."

#: install.rs:160
msgid "The boot partition must be at least 512 MB."
msgstr "Zagonski razdelek mora imeti vsaj 512 MB."

#: install.rs:175
msgid "No installation chosen."
msgstr "Namestitev ni izbrana."

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "Potrjeni disk ne vsebuje izbrane namestitve."

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "Šifrirana namestitev nima razdelka MAN_BOOT."

#: install.rs:695
msgid "No kernel with matching modules was found in /boot."
msgstr "V /boot ni bilo najdeno jedro z ustreznimi moduli."

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "Jezik mora spremeniti sistemski pomočnik."

#: oobe.rs:204
msgid "Applying your settings"
msgstr "Uveljavljanje vaših nastavitev"

#: oobe.rs:212
msgid "Preparing disk encryption"
msgstr "Pripravljanje šifriranja diska"

#: oobe.rs:216
msgid "Finishing"
msgstr "Dokončevanje"

#: oobe.rs:100
msgid "MAN Setup must be finished by the system helper."
msgstr "MAN Setup mora dokončati sistemski pomočnik."

#: oobe.rs:103
msgid "MAN Setup has already been completed on this computer."
msgstr "MAN Setup je na tem računalniku že dokončan."

#: oobe.rs:124
msgid "Unknown accent color."
msgstr "Neznana poudarna barva."

#: oobe.rs:128
msgid "The chosen wallpaper is not available."
msgstr "Izbrano ozadje ni na voljo."

#: oobe.rs:146
msgid "This system cannot be encrypted."
msgstr "Tega sistema ni mogoče šifrirati."

#: oobe.rs:257
msgid "The setup key is missing, so encryption cannot continue in the background."
msgstr "Nastavitveni ključ manjka, zato se šifriranje ne more nadaljevati v ozadju."

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "Sistem ni nameščen na Btrfs, zato posnetki niso na voljo."

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "Obnovitev posnetka čaka na ponovni zagon. Najprej znova zaženite računalnik, da jo dokončate."

#: snapshots.rs:99
msgid "Invalid snapshot id."
msgstr "Neveljaven ID posnetka."

#: update.rs:32
msgid "Checking the update"
msgstr "Preverjanje posodobitve"

#: update.rs:32
msgid "Creating a snapshot"
msgstr "Ustvarjanje posnetka"

#: update.rs:32
msgid "Preparing the update area"
msgstr "Pripravljanje območja za posodobitev"

#: update.rs:32
msgid "Unpacking the new system"
msgstr "Razširjanje novega sistema"

#: update.rs:32
msgid "Moving your accounts and settings"
msgstr "Prenašanje vaših računov in nastavitev"

#: update.rs:32
msgid "Preparing the restart"
msgstr "Pripravljanje ponovnega zagona"

#: update.rs:179
msgid "Unpacked"
msgstr "Razširjeno"

#: update.rs:261
msgid "Accounts"
msgstr "Računi"

#: update.rs:301
msgid "Removing installer-only software"
msgstr "Odstranjevanje programske opreme samo za namestitveni program"

#: update.rs:340
msgid "Building the update boot image"
msgstr "Izdelava zagonske slike posodobitve"

#: update.rs:343
msgid "Adding the one-time boot entry"
msgstr "Dodajanje enkratnega zagonskega vnosa"

#: update.rs:377
msgid "The update is genuine"
msgstr "Posodobitev je pristna"

#: update.rs:383
msgid "Snapshot created"
msgstr "Posnetek je ustvarjen"

#: update.rs:385
msgid "Skipped"
msgstr "Preskočeno"

#: update.rs:394
msgid "Update area ready"
msgstr "Območje za posodobitev je pripravljeno"

#: update.rs:410
msgid "Preparing the new system"
msgstr "Pripravljanje novega sistema"

#: update.rs:168
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Datoteka posodobitve je poškodovana (nadzorna vsota se ne ujema). Znova jo prenesite."

#: update.rs:171
msgid "The update file could not be read completely."
msgstr "Datoteke posodobitve ni bilo mogoče prebrati v celoti."

#: update.rs:312
msgid "The update contains no kernel."
msgstr "Posodobitev ne vsebuje jedra."

#: update.rs:360
msgid "Updates must be installed by the system helper."
msgstr "Posodobitve mora namestiti sistemski pomočnik."

#: update.rs:369
msgid "The chosen installation was not found."
msgstr "Izbrane namestitve ni bilo mogoče najti."

#: update.rs:371
msgid "Only the running MAN installation can be updated."
msgstr "Posodobiti je mogoče le zagnano namestitev MAN."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "To ni datoteka posodobitve MAN (ni manifesta)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "Posodobitev ni podpisana, zato ji ni mogoče zaupati."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "Podpis posodobitve je poškodovan."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "Posodobitve ni podpisal MAN. Morda je bila spremenjena ali izvira iz nezaupanja vrednega vira."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "Manifest posodobitve ni veljaven."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "Šifrirno geslo ni pravilno ali šifriranega razdelka ni mogoče odpreti."

