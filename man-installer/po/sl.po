msgstr "Licenca Apache 2.0"

#: oobe.rs:592
msgid "Libraries and tools"
msgstr "Knjižnice in orodja"

#: oobe.rs:597
msgid "License Agreement"
msgstr "Licenčna pogodba"

#: oobe.rs:597
msgid "Please read and accept the terms under which MAN is provided."
msgstr "Preberite in sprejmite pogoje, pod katerimi je MAN na voljo."

#: oobe.rs:608
msgid "Licenses"
msgstr "Licence"

#: oobe.rs:616
msgid "The license text is not available ({path})."
msgstr "Besedilo licence ni na voljo ({path})."

#: oobe.rs:622
msgid "I have read and accept the license terms"
msgstr "Prebral(a) sem licenčne pogoje in jih sprejemam"

#: oobe.rs:692
msgid "Wired"
msgstr "Žično"

#: oobe.rs:698
msgid "Not connected"
msgstr "Ni povezano"

#: oobe.rs:732
msgid "Connect to the Internet"
msgstr "Povežite se z internetom"

#: oobe.rs:732
msgid "Connecting lets MAN set the time and keep your software up to date. You can also do this later."
msgstr "S povezavo lahko MAN nastavi uro in posodablja vašo programsko opremo. To lahko storite tudi pozneje."

#: oobe.rs:734
msgid "Checking the connection…"
msgstr "Preverjanje povezave …"

