#: backend.rs:46
msgid "Could not start the system helper."
msgstr "Sistemskega pomočnika ni mogoče zagnati."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "S sistemskim pomočnikom ni mogoče komunicirati."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "Povezava s sistemskim pomočnikom je bila prekinjena."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "Overitev je bila preklicana."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "Za to dejanje so potrebne skrbniške pravice."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "Sistemski pomočnik se je nepričakovano ustavil."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Ni sistemskega razdelka EFI"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Prostega je le {free}, MAN potrebuje {need}. Sprostite prostor z DUHACH! v sistemu Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Ni prostega prostora. Zaženite DUHACH! v sistemu Windows in sprostite prostor za MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN teče s tega diska"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "V uporabi: razdelek je priklopljen"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Premajhen, MAN potrebuje {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Namesti MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN se namešča. Počakajte, da se konča."

#: installer.rs:143
msgid "Language"
msgstr "Jezik"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Znova zaženi v tem jeziku"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Živa seja se znova zažene v izbranem jeziku in MAN se namesti v njem."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Dobrodošli v MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Hiter, odprt in v celoti prilagodljiv sistem GNOME.\n"
"Namestite ga na ta računalnik ali nadaljujte z raziskovanjem žive seje."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Namesti MAN …"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Še naprej preizkušaj MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Iskanje diskov …"

#: installer.rs:250
msgid "Welcome"
msgstr "Dobrodošli"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Ta računalnik je bil zagnan v starejšem načinu BIOS. MAN je mogoče namestiti le na računalnike UEFI: znova zaženite in izberite možnost zagona UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Sistemski pomočnik ni vrnil podatkov o diskih."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Naprej"

#: installer.rs:361
msgid "Installation Type"
msgstr "Vrsta namestitve"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Izbriši disk in namesti MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Vse na izbranem disku se izbriše, vključno z Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Priporočeno. Vse na izbranem disku se izbriše."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Namesti poleg sistema Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Priporočeno. MAN uporabi prosti prostor poleg sistema Windows; Windows in njegove datoteke ostanejo. Sistem izberete ob vsakem zagonu."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Znova namesti MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Zamenja sistem, vendar ohrani osebne datoteke v /home. Trenutni sistem se shrani kot posnetek."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Razdelki po meri"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Za strokovnjake: razdelke izberite sami ali jih ustvarite z Diski."

#: installer.rs:392
msgid "Disk"
msgstr "Disk"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Izberite disk, ki bo izbrisan. Diski, ki jih ni mogoče uporabiti, so prikazani z razlogom."

#: installer.rs:418
msgid "No disks were found"
msgstr "Ni najdenih diskov"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Prosti prostor poleg sistema Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Razdelki sistema Windows ostanejo nedotaknjeni. MAN si deli sistemski razdelek EFI in doda Windows v svoj zagonski meni."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} prosto"

#: installer.rs:432
msgid "no free space"
msgstr "ni prostega prostora"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Namestitev za zamenjavo"

#: installer.rs:477
msgid "no home folders"
msgstr "ni domačih map"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "domače mape: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "posnetki: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN na {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Šifrirno geslo za {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Odkleni"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Namestitve ni bilo mogoče pregledati."

#: installer.rs:554
msgid "Partitions"
msgstr "Razdelki"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Sistemski razdelek se formatira v Btrfs in vsebuje @system, @home in @snapshots. Razdelki na disku, s katerega teče MAN, niso prikazani."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Odpri Diske za ustvarjanje ali spreminjanje velikosti razdelkov"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Osveži seznam razdelkov"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Izberite razdelek"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "Sistemski razdelek EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Formatiraj sistemski razdelek EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Pustite izklopljeno, da ohranite zagonske nalagalnike drugih sistemov"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Sistemski razdelek (formatiran kot Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Zagonski razdelek (potreben pri šifriranju)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Seznam razdelkov je osvežen"

#: installer.rs:650
msgid "Security"
msgstr "Varnost"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Šifriraj sistem"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Ščiti vaše podatke, če računalnik izgubite ali vam ga ukradejo. Ob vsakem zagonu se zahteva šifrirno geslo."

#: installer.rs:656
msgid "Passphrase"
msgstr "Šifrirno geslo"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Potrdi šifrirno geslo"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "To geslo hranite na varnem"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Če ga izgubite, podatkov ne more obnoviti nihče. Jedro in zagonske datoteke ostanejo na majhnem nešifriranem zagonskem razdelku."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Šifrirno geslo mora imeti vsaj 8 znakov."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Šifrirni gesli se ne ujemata."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Izberite disk."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Izberite disk s sistemom Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Izberite namestitev za zamenjavo."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Najprej odklenite šifrirano namestitev."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Ta razdelek ne vsebuje sistema MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Izberite sistemski razdelek EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Izberite sistemski razdelek."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Razdelek EFI in sistemski razdelek morata biti različna."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Šifriranje zahteva ločen zagonski razdelek."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Sistemski razdelek mora imeti vsaj {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Razdelek EFI ni formatiran kot FAT; vklopite formatiranje."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Sistemski razdelek je priklopljen; najprej ga odklopite v Diskih."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Kam namestiti MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Čas in tipkovnica"

#: installer.rs:829
msgid "Time Zone"
msgstr "Časovni pas"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Razporeditev tipkovnice"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Preizkusite tipkovnico"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Tipkajte sem in preverite, ali tipke vnašajo prave znake."

#: installer.rs:844
msgid "Type here"
msgstr "Tipkajte sem"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Časovni pas in tipkovnica"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Disk ni izbran"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Sistemski razdelek ni izbran"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Sistemski razdelek je izginil"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Namestitev ni izbrana"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Disk je izginil"

#: installer.rs:955
msgid "Review"
msgstr "Pregled"

#: installer.rs:958
msgid "Destination"
msgstr "Cilj"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Izbriši disk in namesti"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Razdelki po meri"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Znova namesti, ohrani /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Poleg sistema Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (bo formatiran)"

#: installer.rs:969
msgid " (kept)"
msgstr " (ohranjen)"

#: installer.rs:970
msgid "System Partition"
msgstr "Sistemski razdelek"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (bo formatiran)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Zagonski razdelek"

#: installer.rs:976
msgid "Installation"
msgstr "Namestitev"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Prostor za MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} prostega prostora (ustvarita se zagonski in sistemski razdelek)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Brez sprememb. Prikaže se v zagonskem meniju MAN; sistemski razdelek EFI je skupen."

#: installer.rs:983
msgid "Encryption"
msgstr "Šifriranje"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Vklopljeno (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Izklopljeno"

#: installer.rs:985
msgid "File System"
msgstr "Datotečni sistem"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system za MAN, @home za vaše datoteke, @snapshots za obnovitvene točke. Vsi si delijo prosti prostor."

#: installer.rs:991
msgid "System"
msgstr "Sistem"

#: installer.rs:993
msgid "Your Account"
msgstr "Vaš račun"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Ustvari se v MAN Setup ob prvem zagonu računalnika, skupaj z imenom računalnika, videzom in nastavitvami zasebnosti."

#: installer.rs:998
msgid "Keyboard"
msgstr "Tipkovnica"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "Vsi podatki na {model} ({path}) bodo izbrisani."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Izbriši in namesti"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Izbrani razdelki bodo formatirani. Drugi razdelki se ne spremenijo."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Formatiraj in namesti"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "Trenutni sistem se zamenja. Vaše datoteke v /home se ohranijo, stari sistem pa se shrani kot posnetek."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "_Znova namesti"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN se namesti v prosti prostor. Windows in njegove datoteke se ne spremenijo."

#: installer.rs:1005
msgid "_Install"
msgstr "_Namesti"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "Pripravljeno za namestitev"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "Izbrišem {model}?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "Vse datoteke in razdelki na {path} ({size}) bodo trajno izbrisani. Tega ni mogoče razveljaviti."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "Izbriši in namesti"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "Formatiram izbrane razdelke?"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "Vsi podatki na izbranih razdelkih bodo trajno izbrisani. Drugi razdelki se ne spremenijo."

#: installer.rs:1037
msgid "Format and Install"
msgstr "Formatiraj in namesti"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "Namestim MAN poleg sistema Windows?"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "MAN se namesti v {free} prostega prostora na {model} ({path}). Windows in njegove datoteke se ne spremenijo."

#: installer.rs:1046
msgid "Install"
msgstr "Namesti"

#: installer.rs:1050
msgid "Reinstall MAN?"
msgstr "Znova namestim MAN?"

#: installer.rs:1051
msgid "The installed system will be replaced by a fresh copy. Personal files in /home are kept and the old system remains available as a snapshot."
msgstr "Nameščeni sistem bo zamenjan z novo kopijo. Osebne datoteke v /home se ohranijo, stari sistem pa ostane na voljo kot posnetek."

#: installer.rs:1052
msgid "Reinstall"
msgstr "Znova namesti"

#: installer.rs:1057
msgid "_Cancel"
msgstr "_Prekliči"

#: installer.rs:1076
msgid "Installing MAN"
msgstr "Nameščanje MAN"

#: installer.rs:1077
msgid "Starting…"
msgstr "Zaganjanje …"

#: installer.rs:1085
msgid "Details"
msgstr "Podrobnosti"

#: installer.rs:1090
msgid "Installing"
msgstr "Nameščanje"

#: installer.rs:1103
msgid "Step {index} of {n}  ·  {title}"
msgstr "Korak {index} od {n}  ·  {title}"

#: installer.rs:1128
msgid "Log"
msgstr "Dnevnik"

#: installer.rs:1138
msgid "MAN Is Installed"
msgstr "MAN je nameščen"

#: installer.rs:1143
msgid "Restart the computer to start using MAN. A menu at every start lets you choose MAN or Windows; the temporary MAN installer partition is removed by MAN on its first start."
msgstr "Znova zaženite računalnik in začnite uporabljati MAN. Meni ob vsakem zagonu vam omogoča izbiro med MAN in Windows; začasni razdelek namestitvenega programa MAN odstrani ob prvem zagonu."

#: installer.rs:1149
msgid "Restart the computer to start using MAN. You can remove the installation media; if it stays connected, MAN still starts from the new disk."
msgstr "Znova zaženite računalnik in začnite uporabljati MAN. Namestitveni medij lahko odstranite; če ostane priključen, se MAN vseeno zažene z novega diska."

#: installer.rs:1156
msgid "_Restart Now"
msgstr "_Znova zaženi zdaj"

#: installer.rs:1171
msgid "Done"
msgstr "Končano"

#: installer.rs:1182
msgid "Installation Failed"
msgstr "Namestitev ni uspela"

#: installer.rs:1186
msgid "No other disk was changed, and the installer has released the target disk. You can review the plan and try again."
msgstr "Noben drug disk ni bil spremenjen in namestitveni program je sprostil ciljni disk. Načrt lahko pregledate in poskusite znova."

#: installer.rs:1191
msgid "_Review and Try Again"
msgstr "_Preglej in poskusi znova"

#: installer.rs:1193
msgid "_Show Details"
msgstr "_Pokaži podrobnosti"

#: installer.rs:1208
msgid "Installation Log"
msgstr "Dnevnik namestitve"

#: langui.rs:229
msgid "Search languages"
msgstr "Iskanje jezikov"

#: langui.rs:269
msgid "Search countries"
msgstr "Iskanje držav"

#: oobe.rs:165
msgid "The system disk was not found."
msgstr "Sistemskega diska ni bilo mogoče najti."

#: oobe.rs:173
msgid "Encryption needs the Btrfs layout created by the MAN installer."
msgstr "Šifriranje zahteva razporeditev Btrfs, ki jo ustvari namestitveni program MAN."

#: oobe.rs:177
msgid "This installation has no separate boot partition, which encryption needs. Reinstall MAN with “Erase Disk” to use encryption."
msgstr "Ta namestitev nima ločenega zagonskega razdelka, ki ga šifriranje potrebuje. Za šifriranje znova namestite MAN z možnostjo »Izbriši disk«."

#: oobe.rs:501
msgid "MAN Setup"
msgstr "MAN Setup"

#: oobe.rs:554
msgid "Where Are You?"
msgstr "Kje ste?"

#: oobe.rs:554
msgid "Your country or region sets the date, time and number formats."
msgstr "Vaša država ali regija določa obliko datuma, časa in števil."

#: oobe.rs:572
msgid "Country"
msgstr "Država"

#: oobe.rs:587
msgid "GNU General Public License, version 2"
msgstr "Splošno dovoljenje GNU, različica 2"

#: oobe.rs:587
