msgstr "Sektsioonide loend värskendatud"

#: installer.rs:650
msgid "Security"
msgstr "Turvalisus"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Krüpti süsteem"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Kaitseb sinu andmeid, kui arvuti kaob või varastatakse. Igal käivitamisel küsitakse paroolifraasi."

