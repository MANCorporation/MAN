msgstr "EFI süsteemisektsioon puudub"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Vaba on ainult {free}, MAN vajab {need}. Vabasta ruumi Windowsis DUHACH!-iga."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Vaba ruumi pole. Käivita Windowsis DUHACH!, et teha MAN-ile ruumi."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN töötab sellelt kettalt"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Kasutusel: sektsioon on haagitud"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Liiga väike, MAN vajab {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Paigalda MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN-i paigaldatakse. Palun oota, kuni see lõpeb."

