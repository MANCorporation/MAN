msgid "Where do you want to install {name}?"
msgstr "Kuhu soovid rakenduse {name} paigaldada?"

#: appinstaller.rs:922
msgid "Only your account can use the app."
msgstr "Rakendust saab kasutada ainult sinu konto."

#: appinstaller.rs:923
msgid "Needs administrator rights."
msgstr "Vajab administraatori õigusi."

#: appinstaller.rs:930
msgid "Only for Me"
msgstr "Ainult minule"

#: appinstaller.rs:930
msgid "For All Users of This Computer"
msgstr "Kõigile selle arvuti kasutajatele"

