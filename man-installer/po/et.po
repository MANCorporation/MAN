#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI- ja süsteemisektsioon peavad olema erinevad."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Krüptimiseks on vaja eraldi alglaadimissektsiooni."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Süsteemisektsioon peab olema vähemalt {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI-sektsioon pole FAT-vormingus; lülita vormindamine sisse."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Süsteemisektsioon on haagitud; haagi see esmalt rakenduses Kettad lahti."

