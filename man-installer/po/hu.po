#: backend.rs:46
msgid "Could not start the system helper."
msgstr "A rendszersegéd nem indítható el."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "Nem sikerült kommunikálni a rendszersegéddel."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "Megszakadt a kapcsolat a rendszersegéddel."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "A hitelesítés megszakítva."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "Ehhez a művelethez rendszergazdai jogosultság szükséges."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "A rendszersegéd váratlanul leállt."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Nincs EFI rendszerpartíció"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Csak {free} szabad, a MAN-nak {need} kell. Szabadítson fel helyet a DUHACH! segítségével Windowsban."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Nincs szabad hely. Indítsa el a DUHACH!-ot Windowsban, hogy helyet csináljon a MAN-nak."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "A MAN erről a lemezről fut"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Használatban: egy partíció csatolva van"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Túl kicsi, a MAN-nak {need} kell"

#: installer.rs:108
msgid "Install MAN"
msgstr "MAN telepítése"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "A MAN telepítése folyamatban. Várjon, amíg befejeződik."

#: installer.rs:143
msgid "Language"
msgstr "Nyelv"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "Ú_jraindítás ezen a nyelven"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Az élő munkamenet a választott nyelven indul újra, és a MAN is ezen a nyelven települ."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Üdvözli a MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Gyors, nyílt és teljesen testreszabható GNOME rendszer.\n"
"Telepítse erre a számítógépre, vagy folytassa az élő munkamenet felfedezését."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "MAN _telepítése…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "A MAN _további kipróbálása"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Lemezek keresése…"

#: installer.rs:250
msgid "Welcome"
msgstr "Üdvözöljük"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Ez a számítógép hagyományos BIOS módban indult. A MAN csak UEFI-s számítógépekre telepíthető: indítsa újra, és válassza az UEFI indítási lehetőséget."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "A rendszersegéd nem adott vissza lemezinformációt."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Tovább"

#: installer.rs:361
msgid "Installation Type"
msgstr "Telepítés típusa"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Lemez törlése és a MAN telepítése"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "A választott lemezen minden törlődik, a Windows is."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Ajánlott. A választott lemezen minden törlődik."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Telepítés a Windows mellé"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Ajánlott. A MAN a Windows melletti szabad helyet használja; a Windows és a fájljai megmaradnak. Minden indításkor választhat rendszert."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "MAN újratelepítése"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Lecseréli a rendszert, de megtartja a személyes fájlokat a /home könyvtárban. A jelenlegi rendszer pillanatképként mentődik."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Egyéni partíciók"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Szakértőknek: válassza ki saját maga a partíciókat, vagy hozza létre őket a Lemezek alkalmazással."

#: installer.rs:392
msgid "Disk"
msgstr "Lemez"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Válassza ki a törlendő lemezt. A nem használható lemezek az okkal együtt jelennek meg."

#: installer.rs:418
msgid "No disks were found"
msgstr "Nem található lemez"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Szabad hely a Windows mellett"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "A Windows partícióihoz nem nyúl. A MAN megosztja az EFI rendszerpartíciót, és felveszi a Windowst az indítómenüjébe."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} szabad"

#: installer.rs:432
msgid "no free space"
msgstr "nincs szabad hely"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Lecserélendő telepítés"

#: installer.rs:477
msgid "no home folders"
msgstr "nincsenek saját mappák"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "saját mappák: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "pillanatképek: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN ezen: {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Jelmondat ehhez: {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Feloldás"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "A telepítés nem vizsgálható meg."

#: installer.rs:554
msgid "Partitions"
msgstr "Partíciók"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "A rendszerpartíció Btrfs fájlrendszerrel lesz formázva, és tartalmazza a @system, @home és @snapshots alköteteket. Annak a lemeznek a partíciói, amelyről a MAN fut, nem jelennek meg."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "A Lemezek megnyitása partíciók létrehozásához vagy átméretezéséhez"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "A partíciólista frissítése"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Válasszon partíciót"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI rendszerpartíció"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Az EFI rendszerpartíció formázása"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Hagyja kikapcsolva, hogy más rendszerek rendszerbetöltői megmaradjanak"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Rendszerpartíció (Btrfs-re formázva)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Rendszerindító partíció (titkosításhoz szükséges)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "A partíciólista frissítve"

#: installer.rs:650
msgid "Security"
msgstr "Biztonság"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "A rendszer titkosítása"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Védi az adatait, ha a számítógép elveszik vagy ellopják. Minden indításkor jelmondatot kér."

#: installer.rs:656
msgid "Passphrase"
msgstr "Jelmondat"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Jelmondat megerősítése"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Őrizze meg biztonságban ezt a jelmondatot"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Ha elveszik, senki sem tudja visszaállítani az adatokat. A kernel és a rendszerindító fájlok egy kis, titkosítatlan rendszerindító partíción maradnak."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "A jelmondatnak legalább 8 karakterből kell állnia."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "A jelmondatok nem egyeznek."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Válasszon lemezt."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Válassza ki a Windowst tartalmazó lemezt."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Válassza ki a lecserélendő telepítést."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Először oldja fel a titkosított telepítést."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Ez a partíció nem tartalmaz MAN rendszert."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Válasszon EFI rendszerpartíciót."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Válassza ki a rendszerpartíciót."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Az EFI és a rendszerpartíciónak különbözőnek kell lennie."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "A titkosításhoz külön rendszerindító partíció szükséges."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "A rendszerpartíciónak legalább {size} méretűnek kell lennie."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Az EFI partíció nem FAT formátumú; kapcsolja be a formázást."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "A rendszerpartíció csatolva van; először válassza le a Lemezek alkalmazásban."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Hová települjön a MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Idő és billentyűzet"

#: installer.rs:829
msgid "Time Zone"
msgstr "Időzóna"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Billentyűzetkiosztás"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Próbálja ki a billentyűzetét"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Gépeljen ide, és ellenőrizze, hogy a billentyűk a megfelelő karaktereket adják-e."

#: installer.rs:844
msgid "Type here"
msgstr "Gépeljen ide"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Időzóna és billentyűzet"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Nincs lemez kiválasztva"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Nincs rendszerpartíció kiválasztva"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "A rendszerpartíció eltűnt"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Nincs telepítés kiválasztva"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "A lemez eltűnt"

#: installer.rs:955
msgid "Review"
msgstr "Áttekintés"

#: installer.rs:958
msgid "Destination"
msgstr "Cél"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Lemez törlése és telepítés"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Egyéni partíciók"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Újratelepítés a /home megtartásával"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "A Windows mellé"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (formázva lesz)"

#: installer.rs:969
msgid " (kept)"
msgstr " (megmarad)"

#: installer.rs:970
msgid "System Partition"
msgstr "Rendszerpartíció"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (formázva lesz)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Rendszerindító partíció"

#: installer.rs:976
msgid "Installation"
msgstr "Telepítés"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Hely a MAN számára"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} szabad hely (létrejön egy rendszerindító és a rendszerpartíció)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Változatlan. Megjelenik a MAN indítómenüjében; az EFI rendszerpartíció közös."

#: installer.rs:983
msgid "Encryption"
msgstr "Titkosítás"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Be (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Ki"

#: installer.rs:985
msgid "File System"
msgstr "Fájlrendszer"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system a MAN-nak, @home a fájljainak, @snapshots a visszaállítási pontoknak. Mind a szabad helyen osztoznak."

#: installer.rs:991
msgid "System"
msgstr "Rendszer"

#: installer.rs:993
msgid "Your Account"
msgstr "Az Ön fiókja"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "A MAN Setupban jön létre a számítógép első indításakor, a számítógép nevével, a megjelenéssel és az adatvédelmi beállításokkal együtt."

#: installer.rs:998
msgid "Keyboard"
msgstr "Billentyűzet"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "A(z) {model} ({path}) összes adata törlődik."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Törlés és telepítés"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "A kiválasztott partíciók formázva lesznek. A többi partíció nem változik."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Formázás és telepítés"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "A jelenlegi rendszer lecserélődik. A /home fájljai megmaradnak, a régi rendszer pillanatképként mentődik."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "Ú_jratelepítés"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "A MAN a szabad helyre települ. A Windows és a fájljai nem változnak."

#: installer.rs:1005
msgid "_Install"
msgstr "_Telepítés"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "Kész a telepítésre"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "Törli ezt: {model}?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "A(z) {path} ({size}) összes fájlja és partíciója véglegesen törlődik. Ez nem vonható vissza."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "Törlés és telepítés"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "Formázza a kiválasztott partíciókat?"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "A kiválasztott partíciók összes adata véglegesen törlődik. A többi partíció nem változik."

#: installer.rs:1037
msgid "Format and Install"
msgstr "Formázás és telepítés"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "Telepíti a MAN-t a Windows mellé?"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "A MAN a(z) {model} ({path}) {free} szabad helyére települ. A Windows és a fájljai nem változnak."

#: installer.rs:1046
msgid "Install"
msgstr "Telepítés"

#: installer.rs:1050
msgid "Reinstall MAN?"
msgstr "Újratelepíti a MAN-t?"

#: installer.rs:1051
msgid "The installed system will be replaced by a fresh copy. Personal files in /home are kept and the old system remains available as a snapshot."
msgstr "A telepített rendszert egy friss példány váltja fel. A /home személyes fájljai megmaradnak, a régi rendszer pillanatképként elérhető marad."

#: installer.rs:1052
msgid "Reinstall"
msgstr "Újratelepítés"

#: installer.rs:1057
msgid "_Cancel"
msgstr "_Mégse"

#: installer.rs:1076
msgid "Installing MAN"
msgstr "A MAN telepítése"

#: installer.rs:1077
msgid "Starting…"
msgstr "Indítás…"

#: installer.rs:1085
msgid "Details"
msgstr "Részletek"

#: installer.rs:1090
msgid "Installing"
msgstr "Telepítés"

#: installer.rs:1103
msgid "Step {index} of {n}  ·  {title}"
msgstr "{index}/{n}. lépés  ·  {title}"

#: installer.rs:1128
msgid "Log"
msgstr "Napló"

#: installer.rs:1138
msgid "MAN Is Installed"
msgstr "A MAN telepítve"

#: installer.rs:1143
msgid "Restart the computer to start using MAN. A menu at every start lets you choose MAN or Windows; the temporary MAN installer partition is removed by MAN on its first start."
msgstr "Indítsa újra a számítógépet a MAN használatához. Minden indításkor egy menüben választhat a MAN és a Windows között; az ideiglenes telepítőpartíciót a MAN az első indításkor eltávolítja."

#: installer.rs:1149
msgid "Restart the computer to start using MAN. You can remove the installation media; if it stays connected, MAN still starts from the new disk."
msgstr "Indítsa újra a számítógépet a MAN használatához. A telepítő adathordozót eltávolíthatja; ha csatlakoztatva marad, a MAN akkor is az új lemezről indul."

#: installer.rs:1156
msgid "_Restart Now"
msgstr "Új_raindítás most"

#: installer.rs:1171
msgid "Done"
msgstr "Kész"

#: installer.rs:1182
msgid "Installation Failed"
msgstr "A telepítés sikertelen"

#: installer.rs:1186
msgid "No other disk was changed, and the installer has released the target disk. You can review the plan and try again."
msgstr "Más lemez nem változott, és a telepítő felszabadította a céllemezt. Áttekintheti a tervet, és újra megpróbálhatja."

#: installer.rs:1191
msgid "_Review and Try Again"
msgstr "Á_ttekintés és újrapróbálás"

#: installer.rs:1193
msgid "_Show Details"
msgstr "_Részletek megjelenítése"

#: installer.rs:1208
msgid "Installation Log"
msgstr "Telepítési napló"

#: langui.rs:229
msgid "Search languages"
msgstr "Nyelvek keresése"

#: langui.rs:269
msgid "Search countries"
msgstr "Országok keresése"

#: oobe.rs:165
msgid "The system disk was not found."
msgstr "A rendszerlemez nem található."

#: oobe.rs:173
msgid "Encryption needs the Btrfs layout created by the MAN installer."
msgstr "A titkosításhoz a MAN telepítő által létrehozott Btrfs-elrendezés szükséges."

#: oobe.rs:177
msgid "This installation has no separate boot partition, which encryption needs. Reinstall MAN with “Erase Disk” to use encryption."
msgstr "Ennek a telepítésnek nincs külön rendszerindító partíciója, amely a titkosításhoz kell. A titkosítás használatához telepítse újra a MAN-t a „Lemez törlése” lehetőséggel."

#: oobe.rs:501
msgid "MAN Setup"
msgstr "MAN Setup"

#: oobe.rs:554
msgid "Where Are You?"
msgstr "Hol tartózkodik?"

#: oobe.rs:554
msgid "Your country or region sets the date, time and number formats."
msgstr "Országa vagy régiója határozza meg a dátum, az idő és a számok formátumát."

#: oobe.rs:572
msgid "Country"
msgstr "Ország"

#: oobe.rs:587
msgid "GNU General Public License, version 2"
msgstr "GNU General Public License, 2. verzió"

#: oobe.rs:587
msgid "The Linux kernel and many system tools"
msgstr "A Linux kernel és sok rendszereszköz"

#: oobe.rs:588
msgid "GNU General Public License, version 3"
msgstr "GNU General Public License, 3. verzió"

#: oobe.rs:588
msgid "Many GNU and GNOME programs"
msgstr "Sok GNU és GNOME program"

#: oobe.rs:589
msgid "GNU Lesser General Public License, version 2.1"
msgstr "GNU Lesser General Public License, 2.1-es verzió"

#: oobe.rs:589
msgid "GTK, GLib and many libraries"
msgstr "GTK, GLib és sok függvénykönyvtár"

#: oobe.rs:590
msgid "GNU Lesser General Public License, version 3"
msgstr "GNU Lesser General Public License, 3. verzió"

#: oobe.rs:590
msgid "Libraries"
msgstr "Függvénykönyvtárak"

#: oobe.rs:591
msgid "Mozilla Public License 2.0"
msgstr "Mozilla Public License 2.0"

#: oobe.rs:591
msgid "Programs and libraries from Mozilla and others"
msgstr "A Mozilla és mások programjai és könyvtárai"

#: oobe.rs:592
msgid "Apache License 2.0"
msgstr "Apache licenc 2.0"

#: oobe.rs:592
msgid "Libraries and tools"
msgstr "Függvénykönyvtárak és eszközök"

#: oobe.rs:597
msgid "License Agreement"
msgstr "Licencszerződés"

#: oobe.rs:597
msgid "Please read and accept the terms under which MAN is provided."
msgstr "Olvassa el és fogadja el a feltételeket, amelyek mellett a MAN rendelkezésre áll."

#: oobe.rs:608
msgid "Licenses"
msgstr "Licencek"

#: oobe.rs:616
msgid "The license text is not available ({path})."
msgstr "A licenc szövege nem érhető el ({path})."

#: oobe.rs:622
msgid "I have read and accept the license terms"
msgstr "Elolvastam és elfogadom a licencfeltételeket"

#: oobe.rs:692
msgid "Wired"
msgstr "Vezetékes"

#: oobe.rs:698
msgid "Not connected"
msgstr "Nincs kapcsolódva"

#: oobe.rs:732
msgid "Connect to the Internet"
