#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Ez a fájl nem olyan alkalmazás, amely itt telepíthető (.deb, .flatpak, .flatpakref vagy AppImage)."

#: appinstaller.rs:134
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Ez az alkalmazás {arch} számítógépekhez készült, és ezen a gépen (x86-64) nem működik."

#: appinstaller.rs:320
msgid "The file could not be read. It may be damaged."
msgstr "A fájl nem olvasható. Lehet, hogy sérült."

#: appinstaller.rs:492
msgid "This is not an AppImage."
msgstr "Ez nem AppImage."

#: appinstaller.rs:686
msgid "Introduction"
msgstr "Bevezetés"

#: appinstaller.rs:687
msgid "License"
msgstr "Licenc"

#: appinstaller.rs:688
msgid "Destination Select"
msgstr "Célhely kiválasztása"

#: appinstaller.rs:689
msgid "Installation Type"
msgstr "Telepítés típusa"

#: appinstaller.rs:690
msgid "Installation"
msgstr "Telepítés"

#: appinstaller.rs:691
msgid "Summary"
msgstr "Összegzés"

#: appinstaller.rs:797
msgid "_Continue"
msgstr "_Folytatás"

#: appinstaller.rs:806
msgid "Welcome to the {name} Installer"
msgstr "Üdvözli a(z) {name} telepítője"

#: appinstaller.rs:810
msgid "Software License Agreement"
msgstr "Szoftver-licencszerződés"

#: appinstaller.rs:820
msgid "Do You Agree to the License?"
msgstr "Elfogadja a licencet?"

#: appinstaller.rs:821
msgid "To continue installing, you must agree to the terms of the software license agreement."
msgstr "A telepítés folytatásához el kell fogadnia a szoftver-licencszerződés feltételeit."

#: appinstaller.rs:823
msgid "_Read License"
msgstr "Licenc _elolvasása"

#: appinstaller.rs:824
msgid "_Agree"
msgstr "_Elfogadom"

#: appinstaller.rs:837
msgid "Select a Destination"
msgstr "Válasszon célhelyet"

#: appinstaller.rs:841
msgid "Standard Install"
msgstr "Normál telepítés"

#: appinstaller.rs:842
msgid "_Install"
msgstr "_Telepítés"

#: appinstaller.rs:855
msgid "Debian package (.deb)"
msgstr "Debian-csomag (.deb)"

#: appinstaller.rs:856
msgid "Flatpak app"
msgstr "Flatpak alkalmazás"

#: appinstaller.rs:857
msgid "Flatpak app from {source}"
msgstr "Flatpak alkalmazás innen: {source}"

#: appinstaller.rs:858
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:876
msgid "You will be guided through the steps necessary to install this software."
msgstr "Végigvezetjük a szoftver telepítéséhez szükséges lépéseken."

#: appinstaller.rs:887
msgid "Version"
msgstr "Verzió"

#: appinstaller.rs:890
msgid "Publisher"
msgstr "Kiadó"

#: appinstaller.rs:892
msgid "Type"
msgstr "Típus"

#: appinstaller.rs:894
msgid "Size"
msgstr "Méret"

#: appinstaller.rs:900
msgid "Website"
msgstr "Weboldal"

#: appinstaller.rs:902
msgid "File"
msgstr "Fájl"

#: appinstaller.rs:912
msgid "This app is installed already. Installing it again replaces it."
msgstr "Ez az alkalmazás már telepítve van. Az újratelepítés lecseréli."

#: appinstaller.rs:915
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr "A .deb csomagokból telepített alkalmazások a rendszer részévé válnak. A MAN frissítése lecseréli a rendszert, így frissítés után csak akkor települnek újra, ha megtartja őket (következő lépések)."

#: appinstaller.rs:918
msgid "Only install apps from sources you trust."
msgstr "Csak megbízható forrásból telepítsen alkalmazásokat."

#: appinstaller.rs:924
msgid "Where do you want to install {name}?"
msgstr "Hová szeretné telepíteni ezt: {name}?"

#: appinstaller.rs:929
msgid "Only your account can use the app."
msgstr "Csak az Ön fiókja használhatja az alkalmazást."

#: appinstaller.rs:930
msgid "Needs administrator rights."
msgstr "Rendszergazdai jogok szükségesek."

#: appinstaller.rs:937
msgid "Only for Me"
msgstr "Csak nekem"

#: appinstaller.rs:937
msgid "For All Users of This Computer"
msgstr "A számítógép összes felhasználójának"

#: appinstaller.rs:952
msgid "This will take {size} of space on your computer."
msgstr "Ez {size} helyet foglal a számítógépen."

#: appinstaller.rs:954
msgid "The app is downloaded from {source}."
msgstr "Az alkalmazás innen töltődik le: {source}."

#: appinstaller.rs:956
msgid "The app is installed for all users of this computer."
msgstr "Az alkalmazás a számítógép összes felhasználója számára települ."

#: appinstaller.rs:956
msgid "The app is installed only for you."
msgstr "Az alkalmazás csak az Ön számára települ."

#: appinstaller.rs:959
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "Az AppImage a(z) {folder} mappába kerül, és megjelenik az alkalmazásai között."

#: appinstaller.rs:965
msgid "Keep After MAN Updates"
msgstr "Megtartás MAN-frissítések után"

#: appinstaller.rs:966
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "A MAN minden frissítés után újratelepíti az alkalmazást. Ehhez megőrzi a csomagfájljait."

#: appinstaller.rs:974
msgid "Click Install to install {name}."
msgstr "Kattintson a Telepítés gombra a(z) {name} telepítéséhez."

#: appinstaller.rs:980
msgid "Checking what else the app needs…"
msgstr "Annak ellenőrzése, mire van még szüksége az alkalmazásnak…"

#: appinstaller.rs:990
msgid "Also installs the packages it needs: {list}"
msgstr "A szükséges csomagokat is telepíti: {list}"

#: appinstaller.rs:996
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Az alkalmazáshoz szükséges egyes csomagok még nem érhetők el. A telepítés először letölti a legújabb csomaglistákat; ha még mindig hiányoznak, az alkalmazás nem telepíthető."

#: appinstaller.rs:1057
msgid "Installing {name}…"
msgstr "{name} telepítése…"

#: appinstaller.rs:1063
msgid "Preparing…"
msgstr "Előkészítés…"

#: appinstaller.rs:1070
msgid "Details"
msgstr "Részletek"

#: appinstaller.rs:1110
msgid "Installing the package…"
msgstr "A csomag telepítése…"

#: appinstaller.rs:1129
msgid "Moving the app to its folder…"
msgstr "Az alkalmazás áthelyezése a mappájába…"

#: appinstaller.rs:1138
msgid "The app could not be installed."
msgstr "Az alkalmazást nem sikerült telepíteni."

#: appinstaller.rs:1142
msgid "Installing the app with Flatpak…"
msgstr "Az alkalmazás telepítése Flatpakkal…"

#: appinstaller.rs:1166
msgid "Log"
msgstr "Napló"

#: appinstaller.rs:1196
msgid "_Close"
msgstr "_Bezárás"

#: appinstaller.rs:1206
msgid "The Installation Was Successful"
msgstr "A telepítés sikeres volt"

#: appinstaller.rs:1206
msgid "The app was installed."
msgstr "Az alkalmazás telepítve lett."

#: appinstaller.rs:1211
msgid "The Installation Failed"
msgstr "A telepítés sikertelen"

#: appinstaller.rs:1222
msgid "_Open"
msgstr "_Megnyitás"

#: appinstaller.rs:1232
msgid "_Show Details"
msgstr "_Részletek megjelenítése"

#: appinstaller.rs:1235
msgid "Installation Log"
msgstr "Telepítési napló"

#: appinstaller.rs:1262
msgid "App Installer"
msgstr "Alkalmazástelepítő"

#: appinstaller.rs:1283
msgid "Go _Back"
msgstr "_Vissza"

#: appinstaller.rs:1356
msgid "Reading the app…"
msgstr "Az alkalmazás beolvasása…"

#: appinstaller.rs:1365
msgid "Install {name}"
msgstr "{name} telepítése"

#: appinstaller.rs:1384
msgid "Apps"
msgstr "Alkalmazások"

#: appinstaller.rs:1390
msgid "Choose an App to Install"
msgstr "Válassza ki a telepítendő alkalmazást"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "A rendszersegéd nem indítható el."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "Nem sikerült kommunikálni a rendszersegéddel."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Megszakadt a kapcsolat a rendszersegéddel."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "A hitelesítés megszakítva."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Ehhez a művelethez rendszergazdai jogosultság szükséges."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "A rendszersegéd váratlanul leállt."

#: installer.rs:89
msgid "No EFI system partition"
msgstr "Nincs EFI rendszerpartíció"

#: installer.rs:93
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Csak {free} szabad, a MAN-nak {need} kell. Szabadítson fel helyet a DUHACH! segítségével Windowsban."

#: installer.rs:94
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Nincs szabad hely. Indítsa el a DUHACH!-ot Windowsban, hogy helyet csináljon a MAN-nak."

#: installer.rs:103
msgid "MAN is running from this disk"
msgstr "A MAN erről a lemezről fut"

#: installer.rs:107
msgid "In use: a partition is mounted"
msgstr "Használatban: egy partíció csatolva van"

#: installer.rs:109
msgid "Too small, MAN needs {need}"
msgstr "Túl kicsi, a MAN-nak {need} kell"

#: installer.rs:119
msgid "Install MAN"
msgstr "MAN telepítése"

#: installer.rs:137
msgid "MAN is being installed. Please wait until it finishes."
msgstr "A MAN telepítése folyamatban. Várjon, amíg befejeződik."

#: installer.rs:154
msgid "Language"
msgstr "Nyelv"

#: installer.rs:166
msgid "_Restart in This Language"
msgstr "Ú_jraindítás ezen a nyelven"

#: installer.rs:178
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Az élő munkamenet a választott nyelven indul újra, és a MAN is ezen a nyelven települ."

#: installer.rs:224
msgid "Welcome to MAN"
msgstr "Üdvözli a MAN"

#: installer.rs:225
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Gyors, nyílt és teljesen testreszabható GNOME rendszer.\n"
"Telepítse erre a számítógépre, vagy folytassa az élő munkamenet felfedezését."

#: installer.rs:229
msgid "_Install MAN…"
msgstr "MAN _telepítése…"

#: installer.rs:231
msgid "_Keep Trying MAN"
msgstr "A MAN _további kipróbálása"

#: installer.rs:234
msgid "Looking for disks…"
msgstr "Lemezek keresése…"

#: installer.rs:261
msgid "Welcome"
msgstr "Üdvözöljük"

#: installer.rs:276
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Ez a számítógép hagyományos BIOS módban indult. A MAN csak UEFI-s számítógépekre telepíthető: indítsa újra, és válassza az UEFI indítási lehetőséget."

#: installer.rs:294
msgid "The system helper returned no disk information."
msgstr "A rendszersegéd nem adott vissza lemezinformációt."

#: installer.rs:372
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:380
msgid "_Next"
msgstr "_Tovább"

#: installer.rs:388
msgid "Erase Disk and Install MAN"
msgstr "Lemez törlése és a MAN telepítése"

#: installer.rs:389
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "A választott lemezen minden törlődik, a Windows is."

#: installer.rs:389
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Ajánlott. A választott lemezen minden törlődik."

#: installer.rs:393
msgid "Install Alongside Windows"
msgstr "Telepítés a Windows mellé"

#: installer.rs:394
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Ajánlott. A MAN a Windows melletti szabad helyet használja; a Windows és a fájljai megmaradnak. Minden indításkor választhat rendszert."

#: installer.rs:401
msgid "Reinstall MAN"
msgstr "MAN újratelepítése"

#: installer.rs:402
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Lecseréli a rendszert, de megtartja a személyes fájlokat a /home könyvtárban. A jelenlegi rendszer pillanatképként mentődik."

#: installer.rs:407
msgid "Custom Partitions"
msgstr "Egyéni partíciók"

#: installer.rs:407
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Szakértőknek: válassza ki saját maga a partíciókat, vagy hozza létre őket a Lemezek alkalmazással."

#: installer.rs:418
msgid "Erase an External Disk and Install MAN"
msgstr "Külső lemez törlése és a MAN telepítése"

#: installer.rs:419
msgid "Everything on the chosen external disk is deleted. The Mac's internal disk is not shown and not changed."
msgstr "A kiválasztott külső lemezen minden törlődik. A Mac belső lemeze nem jelenik meg és nem változik."

#: installer.rs:420
msgid "Install on This Mac"
msgstr "Telepítés erre a Macre"

#: installer.rs:422
msgid "Recommended. Into the {size} prepared in macOS. macOS and its partitions are not changed."
msgstr "Ajánlott. A macOS-ben előkészített {size} helyre. A macOS és partíciói nem változnak."

#: installer.rs:427
msgid "No space for MAN was prepared yet. In macOS, run MAN-Mac/install-man.sh from the MAN USB stick and choose “MAN boot loader + space for MAN”."
msgstr "Még nincs előkészítve hely a MAN számára. A macOS-ben futtassa a MAN-Mac/install-man.sh fájlt a MAN USB-meghajtóról, és válassza a “MAN boot loader + space for MAN” lehetőséget."

#: installer.rs:433
msgid "Disk"
msgstr "Lemez"

#: installer.rs:433
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Válassza ki a törlendő lemezt. A nem használható lemezek az okkal együtt jelennek meg."

#: installer.rs:459
msgid "No disks were found"
msgstr "Nem található lemez"

#: installer.rs:466
msgid "Free Space Next to Windows"
msgstr "Szabad hely a Windows mellett"

#: installer.rs:467
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "A Windows partícióihoz nem nyúl. A MAN megosztja az EFI rendszerpartíciót, és felveszi a Windowst az indítómenüjébe."

#: installer.rs:473
msgid "{size} free"
msgstr "{size} szabad"

#: installer.rs:473
msgid "no free space"
msgstr "nincs szabad hely"

#: installer.rs:478
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:497
msgid "Installation to Replace"
msgstr "Lecserélendő telepítés"

#: installer.rs:518
msgid "no home folders"
msgstr "nincsenek saját mappák"

#: installer.rs:520
msgid "home folders: {list}"
msgstr "saját mappák: {list}"

#: installer.rs:522
msgid "snapshots: {n}"
msgstr "pillanatképek: {n}"

#: installer.rs:526
msgid "MAN on {model}"
msgstr "MAN ezen: {model}"

#: installer.rs:540
msgid "Passphrase for {device}"
msgstr "Jelmondat ehhez: {device}"

#: installer.rs:541
msgid "Unlock"
msgstr "Feloldás"

#: installer.rs:578
msgid "The installation could not be inspected."
msgstr "A telepítés nem vizsgálható meg."

#: installer.rs:595
msgid "Partitions"
msgstr "Partíciók"

#: installer.rs:596
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "A rendszerpartíció Btrfs fájlrendszerrel lesz formázva, és tartalmazza a @system, @home és @snapshots alköteteket. Annak a lemeznek a partíciói, amelyről a MAN fut, nem jelennek meg."

#: installer.rs:598
msgid "Open Disks to create or resize partitions"
msgstr "A Lemezek megnyitása partíciók létrehozásához vagy átméretezéséhez"

#: installer.rs:600
msgid "Refresh the partition list"
msgstr "A partíciólista frissítése"

#: installer.rs:608
msgid "Choose a partition"
msgstr "Válasszon partíciót"

#: installer.rs:620
msgid "EFI System Partition"
msgstr "EFI rendszerpartíció"

#: installer.rs:621
msgid "Format EFI System Partition"
msgstr "Az EFI rendszerpartíció formázása"

#: installer.rs:621
msgid "Leave off to keep boot loaders of other systems"
msgstr "Hagyja kikapcsolva, hogy más rendszerek rendszerbetöltői megmaradjanak"

#: installer.rs:623
msgid "System Partition (formatted as Btrfs)"
msgstr "Rendszerpartíció (Btrfs-re formázva)"

#: installer.rs:624
msgid "Boot Partition (needed with encryption)"
msgstr "Rendszerindító partíció (titkosításhoz szükséges)"

#: installer.rs:683
msgid "Partition list refreshed"
msgstr "A partíciólista frissítve"

#: installer.rs:691
msgid "Security"
msgstr "Biztonság"

#: installer.rs:693
msgid "Encrypt the System"
msgstr "A rendszer titkosítása"

#: installer.rs:694
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Védi az adatait, ha a számítógép elveszik vagy ellopják. Minden indításkor jelmondatot kér."

#: installer.rs:697
msgid "Passphrase"
msgstr "Jelmondat"

#: installer.rs:698
msgid "Confirm Passphrase"
msgstr "Jelmondat megerősítése"

#: installer.rs:700
msgid "Keep this passphrase safe"
msgstr "Őrizze meg biztonságban ezt a jelmondatot"

#: installer.rs:701
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Ha elveszik, senki sem tudja visszaállítani az adatokat. A kernel és a rendszerindító fájlok egy kis, titkosítatlan rendszerindító partíción maradnak."

#: installer.rs:774
msgid "The passphrase needs at least 8 characters."
msgstr "A jelmondatnak legalább 8 karakterből kell állnia."

#: installer.rs:776
msgid "The passphrases do not match."
msgstr "A jelmondatok nem egyeznek."

#: installer.rs:790
msgid "Choose a disk."
msgstr "Válasszon lemezt."

#: installer.rs:800
msgid "Choose the disk with Windows."
msgstr "Válassza ki a Windowst tartalmazó lemezt."

#: installer.rs:809
msgid "Choose the installation to replace."
msgstr "Válassza ki a lecserélendő telepítést."

#: installer.rs:810
msgid "Unlock the encrypted installation first."
msgstr "Először oldja fel a titkosított telepítést."

#: installer.rs:811
msgid "This partition holds no MAN system."
msgstr "Ez a partíció nem tartalmaz MAN rendszert."

#: installer.rs:818
msgid "Choose an EFI system partition."
msgstr "Válasszon EFI rendszerpartíciót."

#: installer.rs:820
msgid "Choose the system partition."
msgstr "Válassza ki a rendszerpartíciót."

#: installer.rs:822
msgid "The EFI and system partitions must be different."
msgstr "Az EFI és a rendszerpartíciónak különbözőnek kell lennie."

#: installer.rs:824
msgid "Encryption needs a separate boot partition."
msgstr "A titkosításhoz külön rendszerindító partíció szükséges."

#: installer.rs:833
msgid "The system partition must be at least {size}."
msgstr "A rendszerpartíciónak legalább {size} méretűnek kell lennie."

#: installer.rs:835
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Az EFI partíció nem FAT formátumú; kapcsolja be a formázást."

#: installer.rs:837
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "A rendszerpartíció csatolva van; először válassza le a Lemezek alkalmazásban."

#: installer.rs:859
msgid "Where Should MAN Be Installed?"
msgstr "Hová települjön a MAN?"

#: installer.rs:866
msgid "Time and Keyboard"
msgstr "Idő és billentyűzet"

#: installer.rs:871
msgid "Time Zone"
msgstr "Időzóna"

#: installer.rs:875
msgid "Keyboard Layout"
msgstr "Billentyűzetkiosztás"

#: installer.rs:885
msgid "Test Your Keyboard"
msgstr "Próbálja ki a billentyűzetét"

#: installer.rs:885
msgid "Type here to check that your keys produce the right characters."
msgstr "Gépeljen ide, és ellenőrizze, hogy a billentyűk a megfelelő karaktereket adják-e."

#: installer.rs:886
msgid "Type here"
msgstr "Gépeljen ide"

#: installer.rs:919
msgid "Time Zone and Keyboard"
msgstr "Időzóna és billentyűzet"

#: installer.rs:962
msgid "No disk chosen"
msgstr "Nincs lemez kiválasztva"

#: installer.rs:968
msgid "No system partition chosen"
msgstr "Nincs rendszerpartíció kiválasztva"

#: installer.rs:970
msgid "The system partition disappeared"
msgstr "A rendszerpartíció eltűnt"

#: installer.rs:975
msgid "No installation chosen"
msgstr "Nincs telepítés kiválasztva"

#: installer.rs:986
msgid "The disk disappeared"
msgstr "A lemez eltűnt"

#: installer.rs:997
msgid "Review"
msgstr "Áttekintés"

#: installer.rs:1000
msgid "Destination"
msgstr "Cél"

#: installer.rs:1002
msgid "Erase disk and install"
msgstr "Lemez törlése és telepítés"

#: installer.rs:1003
msgid "This Mac (space prepared in macOS)"
msgstr "Ez a Mac (macOS-ben előkészített hely)"

#: installer.rs:1004
msgid "Custom partitions"
msgstr "Egyéni partíciók"

#: installer.rs:1005
msgid "Reinstall, keeping /home"
msgstr "Újratelepítés a /home megtartásával"

#: installer.rs:1006
msgid "Alongside Windows"
msgstr "A Windows mellé"

#: installer.rs:1012
msgid " (will be formatted)"
msgstr " (formázva lesz)"

#: installer.rs:1012
msgid " (kept)"
msgstr " (megmarad)"

#: installer.rs:1013
msgid "System Partition"
msgstr "Rendszerpartíció"

#: installer.rs:1013
msgid "{partition} (will be formatted)"
msgstr "{partition} (formázva lesz)"

#: installer.rs:1015
msgid "Boot Partition"
msgstr "Rendszerindító partíció"

#: installer.rs:1023
msgid "Space for MAN"
msgstr "Hely a MAN számára"

#: installer.rs:1023
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} szabad hely (létrejön egy rendszerindító és a rendszerpartíció)"

#: installer.rs:1024
msgid "Windows"
msgstr "Windows"

#: installer.rs:1024
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
