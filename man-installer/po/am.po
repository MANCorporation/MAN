msgid "Adding the snapshot to the boot menu"
msgstr "ቅጽበታዊ ቅጂውን ወደ ማስነሻ ምናሌው በማከል ላይ"

#: install.rs:801
msgid "Unmounting"
msgstr "በመንቀል ላይ"

#: install.rs:85
msgid "The installer backend must run as root."
msgstr "የጫኚው ረዳት እንደ root መሄድ አለበት።"

#: install.rs:88
msgid "This computer was not started in UEFI mode. MAN requires UEFI."
msgstr "ይህ ኮምፒውተር በUEFI ሁነታ አልጀመረም። MAN UEFI ይፈልጋል።"

#: install.rs:92
msgid "The username is not valid."
msgstr "የተጠቃሚ ስሙ ልክ አይደለም።"

#: install.rs:95
msgid "A password is required."
msgstr "የይለፍ ቃል ያስፈልጋል።"

#: install.rs:99
msgid "The computer name is not valid."
msgstr "የኮምፒውተሩ ስም ልክ አይደለም።"

#: install.rs:105
msgid "Unknown language."
msgstr "ያልታወቀ ቋንቋ።"

#: install.rs:111
msgid "The encryption passphrase must have at least 8 characters."
msgstr "የምስጠራ የይለፍ ሐረጉ ቢያንስ 8 ቁምፊዎች ሊኖሩት ይገባል።"

#: install.rs:122
msgid "The disk changed after you confirmed the installation. Nothing was modified; please review and confirm again."
msgstr "ጭነቱን ካረጋገጡ በኋላ ዲስኩ ተለውጧል። ምንም አልተለወጠም፤ እባክዎ ገምግመው እንደገና ያረጋግጡ።"

#: install.rs:138
msgid "Choose a system partition."
msgstr "የስርዓት ክፋይ ይምረጡ።"

#: install.rs:145
msgid "The confirmed disk does not hold the chosen system partition."
msgstr "የተረጋገጠው ዲስክ የተመረጠውን የስርዓት ክፋይ አልያዘም።"

#: install.rs:157
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "የማስነሻ ክፋዩ ከEFI እና ከስርዓት ክፋዮች የተለየ መሆን አለበት።"

#: install.rs:160
msgid "The boot partition must be at least 512 MB."
msgstr "የማስነሻ ክፋዩ ቢያንስ 512 MB መሆን አለበት።"

#: install.rs:175
msgid "No installation chosen."
msgstr "ምንም ጭነት አልተመረጠም።"

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "የተረጋገጠው ዲስክ የተመረጠውን ጭነት አልያዘም።"

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "የተመሰጠረው ጭነት የMAN_BOOT ክፋይ የለውም።"

#: install.rs:695
msgid "No kernel with matching modules was found in /boot."
msgstr "በ/boot ውስጥ ተዛማጅ ሞጁሎች ያሉት ከርነል አልተገኘም።"

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "ቋንቋው መቀየር ያለበት በስርዓት ረዳቱ ነው።"

#: oobe.rs:204
msgid "Applying your settings"
msgstr "ቅንብሮችዎን በመተግበር ላይ"

#: oobe.rs:212
msgid "Preparing disk encryption"
msgstr "የዲስክ ምስጠራን በማዘጋጀት ላይ"

#: oobe.rs:216
msgid "Finishing"
msgstr "በማጠናቀቅ ላይ"

#: oobe.rs:100
msgid "MAN Setup must be finished by the system helper."
msgstr "MAN Setup መጠናቀቅ ያለበት በስርዓት ረዳቱ ነው።"

#: oobe.rs:103
msgid "MAN Setup has already been completed on this computer."
msgstr "MAN Setup በዚህ ኮምፒውተር ላይ አስቀድሞ ተጠናቋል።"

#: oobe.rs:124
msgid "Unknown accent color."
msgstr "ያልታወቀ የአጽንዖት ቀለም።"

#: oobe.rs:128
msgid "The chosen wallpaper is not available."
msgstr "የተመረጠው የግድግዳ ወረቀት አይገኝም።"

#: oobe.rs:146
msgid "This system cannot be encrypted."
msgstr "ይህ ስርዓት ሊመሰጠር አይችልም።"

#: oobe.rs:257
msgid "The setup key is missing, so encryption cannot continue in the background."
msgstr "የማዋቀሪያ ቁልፉ ጠፍቷል፣ ስለዚህ ምስጠራ ከበስተጀርባ መቀጠል አይችልም።"

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "ስርዓቱ በBtrfs ላይ አልተጫነም፣ ስለዚህ ቅጽበታዊ ቅጂዎች አይገኙም።"

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "የቅጽበታዊ ቅጂ መመለስ ዳግም ጅምርን እየጠበቀ ነው። ለመጨረስ መጀመሪያ ኮምፒውተሩን እንደገና ያስጀምሩ።"

#: snapshots.rs:99
msgid "Invalid snapshot id."
msgstr "ልክ ያልሆነ የቅጽበታዊ ቅጂ ID።"

#: update.rs:32
msgid "Checking the update"
msgstr "ዝማኔውን በማረጋገጥ ላይ"

#: update.rs:32
msgid "Creating a snapshot"
msgstr "ቅጽበታዊ ቅጂ በመፍጠር ላይ"

#: update.rs:32
msgid "Preparing the update area"
msgstr "የዝማኔ ቦታውን በማዘጋጀት ላይ"

#: update.rs:32
msgid "Unpacking the new system"
msgstr "አዲሱን ስርዓት በመፍታት ላይ"

#: update.rs:32
msgid "Moving your accounts and settings"
msgstr "መለያዎችዎንና ቅንብሮችዎን በማዛወር ላይ"

#: update.rs:32
msgid "Preparing the restart"
msgstr "ለዳግም ጅምር በመዘጋጀት ላይ"

#: update.rs:179
msgid "Unpacked"
msgstr "ተፈትቷል"

#: update.rs:261
msgid "Accounts"
msgstr "መለያዎች"

#: update.rs:301
msgid "Removing installer-only software"
msgstr "የጫኚውን ሶፍትዌር ብቻ በማስወገድ ላይ"

#: update.rs:340
msgid "Building the update boot image"
msgstr "የዝማኔ ማስነሻ ምስልን በመገንባት ላይ"

#: update.rs:343
msgid "Adding the one-time boot entry"
msgstr "የአንድ ጊዜ የማስነሻ ግቤት በማከል ላይ"

#: update.rs:377
msgid "The update is genuine"
msgstr "ዝማኔው እውነተኛ ነው"

#: update.rs:383
msgid "Snapshot created"
msgstr "ቅጽበታዊ ቅጂ ተፈጥሯል"

#: update.rs:385
msgid "Skipped"
msgstr "ተዘሏል"

#: update.rs:394
msgid "Update area ready"
msgstr "የዝማኔ ቦታው ዝግጁ ነው"

#: update.rs:410
msgid "Preparing the new system"
msgstr "አዲሱን ስርዓት በማዘጋጀት ላይ"

#: update.rs:168
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "የዝማኔ ፋይሉ ተበላሽቷል (ቼክሰሙ አይዛመድም)። እንደገና ያውርዱት።"

#: update.rs:171
msgid "The update file could not be read completely."
msgstr "የዝማኔ ፋይሉን ሙሉ በሙሉ ማንበብ አልተቻለም።"

#: update.rs:312
msgid "The update contains no kernel."
msgstr "ዝማኔው ከርነል አልያዘም።"

#: update.rs:360
msgid "Updates must be installed by the system helper."
msgstr "ዝማኔዎች መጫን ያለባቸው በስርዓት ረዳቱ ነው።"

#: update.rs:369
msgid "The chosen installation was not found."
msgstr "የተመረጠው ጭነት አልተገኘም።"

#: update.rs:371
msgid "Only the running MAN installation can be updated."
msgstr "ሊዘመን የሚችለው የሚሄድ የMAN ጭነት ብቻ ነው።"

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "ይህ የMAN ዝማኔ ፋይል አይደለም (ማኒፌስት የለም)።"

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "ዝማኔው አልተፈረመም፣ ስለዚህ ሊታመን አይችልም።"

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "የዝማኔው ፊርማ ተበላሽቷል።"

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "ዝማኔው በMAN አልተፈረመም። ተቀይሮ ሊሆን ወይም ከማይታመን ምንጭ የመጣ ሊሆን ይችላል።"

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "የዝማኔው ማኒፌስት ልክ አይደለም።"

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "የይለፍ ሐረጉ የተሳሳተ ነው፣ ወይም የተመሰጠረው ክፋይ ሊከፈት አይችልም።"

