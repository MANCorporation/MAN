"Content-Transfer-Encoding: 8bit\n"

#: backend.rs:46
msgid "Could not start the system helper."
msgstr "የስርዓት ረዳቱን ማስጀመር አልተቻለም።"

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "ከስርዓት ረዳቱ ጋር መገናኘት አልተቻለም።"

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "ከስርዓት ረዳቱ ጋር ያለው ግንኙነት ተቋርጧል።"

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "ፈቃዱ ተሰርዟል።"

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "ይህ ተግባር የአስተዳዳሪ መብቶችን ይፈልጋል።"

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "የስርዓት ረዳቱ ሳይጠበቅ ቆሟል።"

#: installer.rs:78
msgid "No EFI system partition"
msgstr "የEFI ስርዓት ክፋይ የለም"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "ባዶ ያለው {free} ብቻ ነው፣ MAN {need} ይፈልጋል። በWindows ውስጥ በDUHACH! ቦታ ያስለቅቁ።"

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "ባዶ ቦታ የለም። ለMAN ቦታ ለማዘጋጀት በWindows ውስጥ DUHACH!ን ያሂዱ።"

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN ከዚህ ዲስክ እየሄደ ነው"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "በጥቅም ላይ: አንድ ክፋይ ተሰክቷል"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "በጣም ትንሽ ነው፣ MAN {need} ይፈልጋል"

#: installer.rs:108
msgid "Install MAN"
msgstr "MAN ጫን"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN እየተጫነ ነው። እስኪጠናቀቅ ድረስ እባክዎ ይጠብቁ።"

#: installer.rs:143
msgid "Language"
msgstr "ቋንቋ"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "በዚህ ቋንቋ እንደገና ያስጀምሩ(_R)"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "የቀጥታ ክፍለ-ጊዜው በተመረጠው ቋንቋ እንደገና ይጀምራል፣ MANም በዚያ ቋንቋ ይጫናል።"

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "ወደ MAN እንኳን በደህና መጡ"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"ፈጣን፣ ክፍት እና ሙሉ በሙሉ ሊበጅ የሚችል የGNOME ስርዓት።\n"
"በዚህ ኮምፒውተር ላይ ይጫኑት፣ ወይም የቀጥታ ክፍለ-ጊዜውን መመልከትዎን ይቀጥሉ።"

#: installer.rs:218
msgid "_Install MAN…"
msgstr "MAN ጫን(_I)…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "MANን መሞከር ቀጥል(_K)"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "ዲስኮችን በመፈለግ ላይ…"

#: installer.rs:250
msgid "Welcome"
msgstr "እንኳን በደህና መጡ"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "ይህ ኮምፒውተር በአሮጌው BIOS ሁነታ ተጀምሯል። MAN የሚጫነው በUEFI ኮምፒውተሮች ላይ ብቻ ነው: እንደገና ያስጀምሩና የUEFI ማስነሻ አማራጩን ይምረጡ።"

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "የስርዓት ረዳቱ ምንም የዲስክ መረጃ አልሰጠም።"

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "ቀጣይ(_N)"

#: installer.rs:361
msgid "Installation Type"
msgstr "የጭነት ዓይነት"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "ዲስኩን አጥፍተው MAN ይጫኑ"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "በተመረጠው ዲስክ ላይ ያለው ሁሉ ይጠፋል፣ Windowsንም ጨምሮ።"

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "የሚመከር። በተመረጠው ዲስክ ላይ ያለው ሁሉ ይጠፋል።"

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "ከWindows ጎን ይጫኑ"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "የሚመከር። MAN ከWindows አጠገብ ያለውን ባዶ ቦታ ይጠቀማል፤ Windows እና ፋይሎቹ እንዳሉ ይቆያሉ። በእያንዳንዱ ጅምር ስርዓቱን ይምረጡ።"

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "MANን እንደገና ይጫኑ"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "ስርዓቱን ይተካል ነገር ግን በ/home ውስጥ ያሉ የግል ፋይሎችን ያስቀምጣል። የአሁኑ ስርዓት እንደ ቅጽበታዊ ቅጂ ይቀመጣል።"

#: installer.rs:383
msgid "Custom Partitions"
msgstr "ብጁ ክፋዮች"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "ለባለሙያዎች: ክፋዮቹን ራስዎ ይምረጡ፣ ወይም በDisks ይፍጠሯቸው።"

#: installer.rs:392
msgid "Disk"
msgstr "ዲስክ"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "የሚጠፋውን ዲስክ ይምረጡ። መጠቀም የማይቻሉ ዲስኮች ከምክንያታቸው ጋር ይታያሉ።"

#: installer.rs:418
msgid "No disks were found"
msgstr "ምንም ዲስክ አልተገኘም"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "ከWindows አጠገብ ያለ ባዶ ቦታ"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "የWindows ክፋዮች አይነኩም። MAN የEFI ስርዓት ክፋዩን ይጋራል እና Windowsን ወደ ራሱ የማስነሻ ምናሌ ያክላል።"

#: installer.rs:432
msgid "{size} free"
msgstr "{size} ባዶ"

#: installer.rs:432
msgid "no free space"
msgstr "ባዶ ቦታ የለም"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "የሚተካው ጭነት"

#: installer.rs:477
msgid "no home folders"
msgstr "የቤት አቃፊዎች የሉም"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "የቤት አቃፊዎች: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "ቅጽበታዊ ቅጂዎች: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN በ{model} ላይ"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "ለ{device} የይለፍ ሐረግ"

#: installer.rs:500
msgid "Unlock"
msgstr "ክፈት"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "ጭነቱን ማረጋገጥ አልተቻለም።"

#: installer.rs:554
msgid "Partitions"
msgstr "ክፋዮች"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "የስርዓት ክፋዩ በBtrfs ይቀረጻል እና @system፣ @home እና @snapshots ይይዛል። MAN እየሄደበት ያለው ዲስክ ክፋዮች በዝርዝሩ ውስጥ የሉም።"

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "ክፋዮችን ለመፍጠር ወይም መጠናቸውን ለመቀየር Disksን ይክፈቱ"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "የክፋይ ዝርዝሩን አድስ"

#: installer.rs:567
msgid "Choose a partition"
msgstr "አንድ ክፋይ ይምረጡ"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "የEFI ስርዓት ክፋይ"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "የEFI ስርዓት ክፋዩን ቅረጽ"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "የሌሎች ስርዓቶችን ማስነሻዎች ለማቆየት ጠፍቶ ይተዉት"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "የስርዓት ክፋይ (በBtrfs ይቀረጻል)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "የማስነሻ ክፋይ (ለምስጠራ ያስፈልጋል)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "የክፋይ ዝርዝሩ ታድሷል"

#: installer.rs:650
msgid "Security"
msgstr "ደህንነት"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "ስርዓቱን መስጥር"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "ኮምፒውተሩ ቢጠፋ ወይም ቢሰረቅ ውሂብዎን ይጠብቃል። በእያንዳንዱ ጅምር የይለፍ ሐረግ ይጠየቃል።"

#: installer.rs:656
msgid "Passphrase"
msgstr "የይለፍ ሐረግ"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "የይለፍ ሐረጉን ያረጋግጡ"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "ይህን የይለፍ ሐረግ በደህና ያስቀምጡ"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "ቢጠፋ ማንም ውሂቡን መመለስ አይችልም። ከርነሉ እና የማስነሻ ፋይሎቹ ባልተመሰጠረ ትንሽ የማስነሻ ክፋይ ላይ ይቆያሉ።"

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "የይለፍ ሐረጉ ቢያንስ 8 ቁምፊዎች ሊኖሩት ይገባል።"

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "የይለፍ ሐረጎቹ አይዛመዱም።"

#: installer.rs:748
msgid "Choose a disk."
msgstr "አንድ ዲስክ ይምረጡ።"

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Windows ያለበትን ዲስክ ይምረጡ።"

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "የሚተካውን ጭነት ይምረጡ።"

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "መጀመሪያ የተመሰጠረውን ጭነት ይክፈቱ።"

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "ይህ ክፋይ የMAN ስርዓት አልያዘም።"

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "የEFI ስርዓት ክፋይ ይምረጡ።"

#: installer.rs:778
msgid "Choose the system partition."
msgstr "የስርዓት ክፋዩን ይምረጡ።"

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "የEFI እና የስርዓት ክፋዮች የተለያዩ መሆን አለባቸው።"

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "ምስጠራ የተለየ የማስነሻ ክፋይ ይፈልጋል።"

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "የስርዓት ክፋዩ ቢያንስ {size} መሆን አለበት።"

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "የEFI ክፋዩ በFAT አልተቀረጸም፤ መቅረጽን ያብሩ።"

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "የስርዓት ክፋዩ ተሰክቷል፤ መጀመሪያ በDisks ውስጥ ይንቀሉት።"

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "MAN የት ይጫን?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "ሰዓት እና የቁልፍ ሰሌዳ"

#: installer.rs:829
msgid "Time Zone"
msgstr "የሰዓት ሰቅ"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "የቁልፍ ሰሌዳ አቀማመጥ"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "የቁልፍ ሰሌዳዎን ይሞክሩ"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "ቁልፎቹ ትክክለኛ ቁምፊዎችን እንደሚጽፉ ለማረጋገጥ እዚህ ይተይቡ።"

#: installer.rs:844
msgid "Type here"
msgstr "እዚህ ይተይቡ"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "የሰዓት ሰቅ እና የቁልፍ ሰሌዳ"

#: installer.rs:920
msgid "No disk chosen"
msgstr "ምንም ዲስክ አልተመረጠም"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "ምንም የስርዓት ክፋይ አልተመረጠም"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "የስርዓት ክፋዩ ጠፍቷል"

#: installer.rs:933
