msgstr ""
"Project-Id-Version: man-installer\n"
"Language: ml\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: backend.rs:46
msgid "Could not start the system helper."
msgstr "സിസ്റ്റം സഹായി ആരംഭിക്കാനായില്ല."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "സിസ്റ്റം സഹായിയുമായി ആശയവിനിമയം നടത്താനായില്ല."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "സിസ്റ്റം സഹായിയുമായുള്ള ബന്ധം നഷ്ടപ്പെട്ടു."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "അംഗീകാരം റദ്ദാക്കി."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "ഈ പ്രവർത്തനത്തിന് അഡ്മിനിസ്ട്രേറ്റർ അവകാശങ്ങൾ ആവശ്യമാണ്."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "സിസ്റ്റം സഹായി അപ്രതീക്ഷിതമായി നിലച്ചു."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "EFI സിസ്റ്റം പാർട്ടീഷൻ ഇല്ല"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "{free} മാത്രമേ ഒഴിവുള്ളൂ, MAN-ന് {need} വേണം. Windows-ൽ DUHACH! ഉപയോഗിച്ച് ഇടം ഒഴിവാക്കുക."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "ഒഴിവുള്ള ഇടമില്ല. MAN-ന് ഇടമൊരുക്കാൻ Windows-ൽ DUHACH! പ്രവർത്തിപ്പിക്കുക."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN ഈ ഡിസ്കിൽ നിന്നാണ് പ്രവർത്തിക്കുന്നത്"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "ഉപയോഗത്തിൽ: ഒരു പാർട്ടീഷൻ മൗണ്ട് ചെയ്തിരിക്കുന്നു"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "വളരെ ചെറുത്, MAN-ന് {need} വേണം"

#: installer.rs:108
msgid "Install MAN"
msgstr "MAN ഇൻസ്റ്റാൾ ചെയ്യുക"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN ഇൻസ്റ്റാൾ ചെയ്യുന്നു. ദയവായി പൂർത്തിയാകുന്നതുവരെ കാത്തിരിക്കുക."

#: installer.rs:143
msgid "Language"
msgstr "ഭാഷ"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "ഈ ഭാഷയിൽ പുനരാരംഭിക്കുക(_R)"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "ലൈവ് സെഷൻ തിരഞ്ഞെടുത്ത ഭാഷയിൽ പുനരാരംഭിക്കും, MAN ആ ഭാഷയിൽ ഇൻസ്റ്റാൾ ചെയ്യപ്പെടും."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "MAN-ലേക്ക് സ്വാഗതം"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"വേഗതയേറിയ, തുറന്ന, പൂർണ്ണമായും ഇഷ്ടാനുസൃതമാക്കാവുന്ന GNOME സിസ്റ്റം.\n"
"ഇത് ഈ കമ്പ്യൂട്ടറിൽ ഇൻസ്റ്റാൾ ചെയ്യുക, അല്ലെങ്കിൽ ലൈവ് സെഷൻ തുടർന്നും പരീക്ഷിക്കുക."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "MAN ഇൻസ്റ്റാൾ ചെയ്യുക(_I)…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "MAN പരീക്ഷിക്കുന്നത് തുടരുക(_K)"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "ഡിസ്കുകൾ തിരയുന്നു…"

#: installer.rs:250
msgid "Welcome"
msgstr "സ്വാഗതം"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "ഈ കമ്പ്യൂട്ടർ പഴയ BIOS മോഡിലാണ് ആരംഭിച്ചത്. MAN UEFI കമ്പ്യൂട്ടറുകളിൽ മാത്രമേ ഇൻസ്റ്റാൾ ചെയ്യാനാകൂ: പുനരാരംഭിച്ച് UEFI ബൂട്ട് ഓപ്ഷൻ തിരഞ്ഞെടുക്കുക."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "സിസ്റ്റം സഹായി ഡിസ്ക് വിവരങ്ങളൊന്നും നൽകിയില്ല."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "അടുത്തത്(_N)"

#: installer.rs:361
msgid "Installation Type"
msgstr "ഇൻസ്റ്റലേഷൻ തരം"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "ഡിസ്ക് മായ്ച്ച് MAN ഇൻസ്റ്റാൾ ചെയ്യുക"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "തിരഞ്ഞെടുത്ത ഡിസ്കിലെ എല്ലാം മായ്ക്കപ്പെടും, Windows ഉൾപ്പെടെ."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "ശുപാർശ ചെയ്യുന്നു. തിരഞ്ഞെടുത്ത ഡിസ്കിലെ എല്ലാം മായ്ക്കപ്പെടും."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Windows-നൊപ്പം ഇൻസ്റ്റാൾ ചെയ്യുക"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "ശുപാർശ ചെയ്യുന്നു. MAN, Windows-ന് അടുത്തുള്ള ഒഴിവുള്ള ഇടം ഉപയോഗിക്കുന്നു; Windows-ഉം അതിന്റെ ഫയലുകളും നിലനിൽക്കും. ഓരോ തുടക്കത്തിലും സിസ്റ്റം തിരഞ്ഞെടുക്കുക."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "MAN വീണ്ടും ഇൻസ്റ്റാൾ ചെയ്യുക"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "സിസ്റ്റം മാറ്റുന്നു, പക്ഷേ /home-ലെ സ്വകാര്യ ഫയലുകൾ സൂക്ഷിക്കുന്നു. നിലവിലെ സിസ്റ്റം സ്നാപ്‌ഷോട്ടായി സംരക്ഷിക്കപ്പെടും."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "ഇഷ്ടാനുസൃത പാർട്ടീഷനുകൾ"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "വിദഗ്ധർക്ക്: പാർട്ടീഷനുകൾ സ്വയം തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ Disks ഉപയോഗിച്ച് സൃഷ്ടിക്കുക."

#: installer.rs:392
msgid "Disk"
msgstr "ഡിസ്ക്"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "മായ്ക്കേണ്ട ഡിസ്ക് തിരഞ്ഞെടുക്കുക. ഉപയോഗിക്കാനാവാത്ത ഡിസ്കുകൾ കാരണത്തോടൊപ്പം കാണിക്കും."

#: installer.rs:418
msgid "No disks were found"
msgstr "ഡിസ്കുകളൊന്നും കണ്ടെത്തിയില്ല"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Windows-ന് അടുത്തുള്ള ഒഴിവുള്ള ഇടം"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows പാർട്ടീഷനുകൾ തൊടില്ല. MAN, EFI സിസ്റ്റം പാർട്ടീഷൻ പങ്കിടുകയും Windows-നെ സ്വന്തം ബൂട്ട് മെനുവിൽ ചേർക്കുകയും ചെയ്യുന്നു."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} ഒഴിവ്"

#: installer.rs:432
msgid "no free space"
msgstr "ഒഴിവുള്ള ഇടമില്ല"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "മാറ്റിസ്ഥാപിക്കേണ്ട ഇൻസ്റ്റലേഷൻ"

#: installer.rs:477
msgid "no home folders"
msgstr "ഹോം ഫോൾഡറുകളില്ല"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "ഹോം ഫോൾഡറുകൾ: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "സ്നാപ്‌ഷോട്ടുകൾ: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "{model}-ലെ MAN"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "{device}-നുള്ള പാസ്‌ഫ്രേസ്"

#: installer.rs:500
msgid "Unlock"
msgstr "അൺലോക്ക് ചെയ്യുക"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "ഇൻസ്റ്റലേഷൻ പരിശോധിക്കാനായില്ല."

#: installer.rs:554
msgid "Partitions"
msgstr "പാർട്ടീഷനുകൾ"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "സിസ്റ്റം പാർട്ടീഷൻ Btrfs-ൽ ഫോർമാറ്റ് ചെയ്യപ്പെടുകയും @system, @home, @snapshots എന്നിവ ഉൾക്കൊള്ളുകയും ചെയ്യുന്നു. MAN പ്രവർത്തിക്കുന്ന ഡിസ്കിലെ പാർട്ടീഷനുകൾ പട്ടികയിലില്ല."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "പാർട്ടീഷനുകൾ സൃഷ്ടിക്കാനോ വലുപ്പം മാറ്റാനോ Disks തുറക്കുക"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "പാർട്ടീഷൻ പട്ടിക പുതുക്കുക"

#: installer.rs:567
msgid "Choose a partition"
msgstr "ഒരു പാർട്ടീഷൻ തിരഞ്ഞെടുക്കുക"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI സിസ്റ്റം പാർട്ടീഷൻ"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI സിസ്റ്റം പാർട്ടീഷൻ ഫോർമാറ്റ് ചെയ്യുക"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "മറ്റ് സിസ്റ്റങ്ങളുടെ ബൂട്ട് ലോഡറുകൾ നിലനിർത്താൻ ഓഫായി വയ്ക്കുക"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "സിസ്റ്റം പാർട്ടീഷൻ (Btrfs ആയി ഫോർമാറ്റ് ചെയ്യപ്പെടും)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "ബൂട്ട് പാർട്ടീഷൻ (എൻക്രിപ്ഷന് ആവശ്യം)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "പാർട്ടീഷൻ പട്ടിക പുതുക്കി"

#: installer.rs:650
msgid "Security"
msgstr "സുരക്ഷ"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "സിസ്റ്റം എൻക്രിപ്റ്റ് ചെയ്യുക"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "കമ്പ്യൂട്ടർ നഷ്ടപ്പെടുകയോ മോഷ്ടിക്കപ്പെടുകയോ ചെയ്താൽ നിങ്ങളുടെ ഡാറ്റ സംരക്ഷിക്കുന്നു. ഓരോ തുടക്കത്തിലും പാസ്‌ഫ്രേസ് ചോദിക്കും."

#: installer.rs:656
msgid "Passphrase"
msgstr "പാസ്‌ഫ്രേസ്"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "പാസ്‌ഫ്രേസ് സ്ഥിരീകരിക്കുക"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "ഈ പാസ്‌ഫ്രേസ് സുരക്ഷിതമായി സൂക്ഷിക്കുക"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "ഇത് നഷ്ടപ്പെട്ടാൽ ആർക്കും ഡാറ്റ വീണ്ടെടുക്കാനാവില്ല. കേർണലും ബൂട്ട് ഫയലുകളും ഒരു ചെറിയ എൻക്രിപ്റ്റ് ചെയ്യാത്ത ബൂട്ട് പാർട്ടീഷനിൽ നിലനിൽക്കും."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "പാസ്‌ഫ്രേസിൽ കുറഞ്ഞത് 8 അക്ഷരങ്ങൾ വേണം."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "പാസ്‌ഫ്രേസുകൾ പൊരുത്തപ്പെടുന്നില്ല."

#: installer.rs:748
msgid "Choose a disk."
msgstr "ഒരു ഡിസ്ക് തിരഞ്ഞെടുക്കുക."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Windows ഉള്ള ഡിസ്ക് തിരഞ്ഞെടുക്കുക."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "മാറ്റിസ്ഥാപിക്കേണ്ട ഇൻസ്റ്റലേഷൻ തിരഞ്ഞെടുക്കുക."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "ആദ്യം എൻക്രിപ്റ്റ് ചെയ്ത ഇൻസ്റ്റലേഷൻ അൺലോക്ക് ചെയ്യുക."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "ഈ പാർട്ടീഷനിൽ MAN സിസ്റ്റം ഇല്ല."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "ഒരു EFI സിസ്റ്റം പാർട്ടീഷൻ തിരഞ്ഞെടുക്കുക."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "സിസ്റ്റം പാർട്ടീഷൻ തിരഞ്ഞെടുക്കുക."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI, സിസ്റ്റം പാർട്ടീഷനുകൾ വ്യത്യസ്തമായിരിക്കണം."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "എൻക്രിപ്ഷന് പ്രത്യേക ബൂട്ട് പാർട്ടീഷൻ ആവശ്യമാണ്."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "സിസ്റ്റം പാർട്ടീഷൻ കുറഞ്ഞത് {size} ആയിരിക്കണം."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI പാർട്ടീഷൻ FAT-ൽ ഫോർമാറ്റ് ചെയ്തിട്ടില്ല; ഫോർമാറ്റിംഗ് ഓണാക്കുക."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
