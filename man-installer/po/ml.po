msgstr "സിസ്റ്റം സ്നാപ്‌ഷോട്ടുകൾ സൃഷ്ടിക്കുകയും പുനഃസ്ഥാപിക്കുകയും ചെയ്യുക"

#: com.man.Updater.desktop
msgid "System Update Installer"
msgstr "സിസ്റ്റം അപ്‌ഡേറ്റ് ഇൻസ്റ്റാളർ"

#: com.man.Updater.desktop
msgid "Install a MAN system update file"
msgstr "MAN സിസ്റ്റം അപ്‌ഡേറ്റ് ഫയൽ ഇൻസ്റ്റാൾ ചെയ്യുക"

#: com.man.Installer.desktop
msgid "Offer to install MAN when the live session starts"
msgstr "ലൈവ് സെഷൻ ആരംഭിക്കുമ്പോൾ MAN ഇൻസ്റ്റാൾ ചെയ്യാൻ നിർദ്ദേശിക്കുന്നു"

#: com.man.UpdateNotice.desktop
msgid "MAN Update Notice"
msgstr "MAN അപ്‌ഡേറ്റ് അറിയിപ്പ്"

#: com.man.UpdateNotice.desktop
msgid "Tells you once after logging in that MAN was updated"
msgstr "ലോഗിൻ ചെയ്ത ശേഷം MAN അപ്‌ഡേറ്റ് ചെയ്തതായി ഒരിക്കൽ അറിയിക്കുന്നു"

#: com.man.Oobe.desktop
msgid "Set up your new MAN computer"
msgstr "നിങ്ങളുടെ പുതിയ MAN കമ്പ്യൂട്ടർ സജ്ജമാക്കുക"

#: man-oobe.desktop
msgid "First-start setup of MAN"
msgstr "MAN ആദ്യ സജ്ജീകരണം"
