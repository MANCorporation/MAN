msgid "Unpacking the new system"
msgstr "Sistema berria deskonprimatzen"

#: update.rs:32
msgid "Moving your accounts and settings"
msgstr "Zure kontuak eta ezarpenak eramaten"

#: update.rs:32
msgid "Preparing the restart"
msgstr "Berrabiaraztea prestatzen"

#: update.rs:179
msgid "Unpacked"
msgstr "Deskonprimatuta"

#: update.rs:261
msgid "Accounts"
msgstr "Kontuak"

#: update.rs:301
msgid "Removing installer-only software"
msgstr "Instalatzailearentzako soilik den softwarea kentzen"

