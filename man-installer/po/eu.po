msgid "Custom partitions"
msgstr "Partizio pertsonalizatuak"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Berrinstalatu, /home gordeta"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Windowsen ondoan"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (formateatuko da)"

#: installer.rs:969
msgid " (kept)"
msgstr " (gordetzen da)"

#: installer.rs:970
msgid "System Partition"
msgstr "Sistema-partizioa"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (formateatuko da)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Abio-partizioa"

#: installer.rs:976
msgid "Installation"
msgstr "Instalazioa"

#: installer.rs:980
msgid "Space for MAN"
msgstr "MANentzako lekua"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} leku libre (abio-partizioa eta sistema-partizioa sortzen dira)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Aldatu gabe. MANen abio-menuan agertzen da; EFI sistema-partizioa partekatua da."

#: installer.rs:983
msgid "Encryption"
msgstr "Zifratzea"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Aktibatuta (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Desaktibatuta"

#: installer.rs:985
msgid "File System"
msgstr "Fitxategi-sistema"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system MANentzat, @home zure fitxategientzat, @snapshots leheneratze-puntuentzat. Denek partekatzen dute leku librea."

#: installer.rs:991
msgid "System"
msgstr "Sistema"

#: installer.rs:993
msgid "Your Account"
msgstr "Zure kontua"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "MAN Setup-en sortzen da ordenagailua lehen aldiz abiarazten denean, ordenagailuaren izena, itxura eta pribatutasun-ezarpenekin batera."

#: installer.rs:998
msgid "Keyboard"
msgstr "Teklatua"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "{model} ({path}) gailuko datu guztiak ezabatuko dira."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Ezabatu eta instalatu"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Aukeratutako partizioak formateatuko dira. Beste partizioak ez dira aldatzen."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Formateatu eta instalatu"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "Uneko sistema ordezkatzen da. /home-ko zure fitxategiak gordetzen dira, eta sistema zaharra argazki gisa gordetzen da."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "_Berrinstalatu"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN leku librean instalatzen da. Windows eta bere fitxategiak ez dira aldatzen."

#: installer.rs:1005
msgid "_Install"
msgstr "_Instalatu"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "Instalatzeko prest"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "{model} ezabatu?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "{path} ({size}) gailuko fitxategi eta partizio guztiak betiko ezabatuko dira. Ezin da desegin."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "Ezabatu eta instalatu"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "Aukeratutako partizioak formateatu?"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "Aukeratutako partizioetako datu guztiak betiko ezabatuko dira. Beste partizioak ez dira aldatzen."

#: installer.rs:1037
msgid "Format and Install"
msgstr "Formateatu eta instalatu"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "MAN Windowsen ondoan instalatu?"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "MAN {model} ({path}) gailuko {free} leku librean instalatzen da. Windows eta bere fitxategiak ez dira aldatzen."

#: installer.rs:1046
msgid "Install"
msgstr "Instalatu"

#: installer.rs:1050
msgid "Reinstall MAN?"
msgstr "MAN berrinstalatu?"

#: installer.rs:1051
msgid "The installed system will be replaced by a fresh copy. Personal files in /home are kept and the old system remains available as a snapshot."
msgstr "Instalatutako sistema kopia berri batekin ordezkatuko da. /home-ko fitxategi pertsonalak gordetzen dira eta sistema zaharra argazki gisa erabilgarri geratzen da."

#: installer.rs:1052
msgid "Reinstall"
msgstr "Berrinstalatu"

#: installer.rs:1057
msgid "_Cancel"
msgstr "_Utzi"

#: installer.rs:1076
msgid "Installing MAN"
msgstr "MAN instalatzen"

#: installer.rs:1077
