msgid "Building the update boot image"
msgstr "Eguneraketaren abio-irudia eraikitzen"

#: update.rs:343
msgid "Adding the one-time boot entry"
msgstr "Behin erabiltzeko abio-sarrera gehitzen"

#: update.rs:377
msgid "The update is genuine"
msgstr "Eguneraketa benetakoa da"

#: update.rs:383
msgid "Snapshot created"
msgstr "Argazkia sortu da"

#: update.rs:385
msgid "Skipped"
msgstr "Saltatuta"

#: update.rs:394
msgid "Update area ready"
msgstr "Eguneraketa-eremua prest"

#: update.rs:410
msgid "Preparing the new system"
msgstr "Sistema berria prestatzen"

#: update.rs:168
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Eguneraketa-fitxategia hondatuta dago (kontrol-batura ez dator bat). Deskargatu berriro."

#: update.rs:171
msgid "The update file could not be read completely."
msgstr "Ezin izan da eguneraketa-fitxategia osorik irakurri."

#: update.rs:312
msgid "The update contains no kernel."
msgstr "Eguneraketak ez du nukleorik."

#: update.rs:360
msgid "Updates must be installed by the system helper."
msgstr "Eguneraketak sistemaren laguntzaileak instalatu behar ditu."

#: update.rs:369
msgid "The chosen installation was not found."
msgstr "Ez da aukeratutako instalazioa aurkitu."

#: update.rs:371
msgid "Only the running MAN installation can be updated."
msgstr "Exekutatzen ari den MAN instalazioa soilik egunera daiteke."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Hau ez da MAN eguneraketa-fitxategia (ez du manifesturik)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "Eguneraketa ez dago sinatuta, beraz ezin zaio fidatu."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "Eguneraketaren sinadura hondatuta dago."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "Eguneraketa ez du MANek sinatu. Aldatuta egon daiteke edo iturri ez-fidagarri batetik etorri."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "Eguneraketaren manifestua baliogabea da."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "Pasaesaldia ez da zuzena, edo ezin da partizio zifratua ireki."

