msgstr "{index}/{n} urratsa  ·  {title}"

#: installer.rs:1128
msgid "Log"
msgstr "Egunkaria"

#: installer.rs:1138
msgid "MAN Is Installed"
msgstr "MAN instalatuta dago"

#: installer.rs:1143
msgid "Restart the computer to start using MAN. A menu at every start lets you choose MAN or Windows; the temporary MAN installer partition is removed by MAN on its first start."
msgstr "Berrabiarazi ordenagailua MAN erabiltzen hasteko. Abio bakoitzean menu batek MAN edo Windows aukeratzen uzten dizu; instalatzailearen aldi baterako partizioa MANek kentzen du lehen abioan."

#: installer.rs:1149
msgid "Restart the computer to start using MAN. You can remove the installation media; if it stays connected, MAN still starts from the new disk."
msgstr "Berrabiarazi ordenagailua MAN erabiltzen hasteko. Instalazio-euskarria ken dezakezu; konektatuta geratzen bada ere, MAN disko berritik abiaraziko da."

#: installer.rs:1156
msgid "_Restart Now"
msgstr "_Berrabiarazi orain"

#: installer.rs:1171
msgid "Done"
msgstr "Eginda"

#: installer.rs:1182
msgid "Installation Failed"
msgstr "Instalazioak huts egin du"

#: installer.rs:1186
msgid "No other disk was changed, and the installer has released the target disk. You can review the plan and try again."
msgstr "Ez da beste diskorik aldatu, eta instalatzaileak helburuko diskoa askatu du. Plana berrikusi eta berriro saia zaitezke."

#: installer.rs:1191
msgid "_Review and Try Again"
msgstr "_Berrikusi eta saiatu berriro"

#: installer.rs:1193
msgid "_Show Details"
msgstr "_Erakutsi xehetasunak"

#: installer.rs:1208
