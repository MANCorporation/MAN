#: backend.rs:46
msgid "Could not start the system helper."
msgstr "Ezin izan da sistemaren laguntzailea abiarazi."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "Ezin izan da sistemaren laguntzailearekin komunikatu."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "Sistemaren laguntzailearekiko konexioa galdu da."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "Baimena bertan behera utzi da."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "Ekintza honek administratzaile-baimenak behar ditu."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "Sistemaren laguntzailea ustekabean gelditu da."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Ez dago EFI sistema-partiziorik"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "{free} bakarrik daude libre, MANek {need} behar ditu. Egin leku gehiago DUHACH!-ekin Windowsen."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Ez dago leku librerik. Abiarazi DUHACH! Windowsen MANi lekua egiteko."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN disko honetatik exekutatzen ari da"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Erabilita: partizio bat muntatuta dago"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Txikiegia, MANek {need} behar ditu"

#: installer.rs:108
msgid "Install MAN"
msgstr "Instalatu MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN instalatzen ari da. Itxaron amaitu arte."

#: installer.rs:143
msgid "Language"
msgstr "Hizkuntza"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Berrabiarazi hizkuntza honetan"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Saio zuzena aukeratutako hizkuntzan berrabiaraziko da, eta MAN hizkuntza horretan instalatuko da."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Ongi etorri MANera"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"GNOME sistema azkar, ireki eta guztiz pertsonalizagarria.\n"
"Instalatu ordenagailu honetan, edo jarraitu saio zuzena arakatzen."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Instalatu MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Jarraitu MAN probatzen"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Diskoak bilatzen…"

#: installer.rs:250
msgid "Welcome"
msgstr "Ongi etorri"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Ordenagailu hau BIOS zaharreko moduan abiarazi da. MAN UEFI ordenagailuetan soilik instala daiteke: berrabiarazi eta aukeratu UEFI abioko aukera."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Sistemaren laguntzaileak ez du diskoei buruzko informaziorik itzuli."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Hurrengoa"

#: installer.rs:361
msgid "Installation Type"
msgstr "Instalazio mota"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Ezabatu diskoa eta instalatu MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Aukeratutako diskoko guztia ezabatuko da, Windows barne."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Gomendatua. Aukeratutako diskoko guztia ezabatuko da."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Instalatu Windowsen ondoan"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Gomendatua. MANek Windowsen ondoko leku librea erabiltzen du; Windows eta bere fitxategiak geratzen dira. Abio bakoitzean aukeratzen duzu sistema."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Berrinstalatu MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Sistema ordezkatzen du, baina /home-ko fitxategi pertsonalak gordetzen ditu. Uneko sistema argazki gisa gordetzen da."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Partizio pertsonalizatuak"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Adituentzat: aukeratu zuk partizioak, edo sortu Diskoak aplikazioarekin."

#: installer.rs:392
msgid "Disk"
msgstr "Diskoa"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Aukeratu ezabatuko den diskoa. Erabil ezin diren diskoak arrazoiarekin erakusten dira."

#: installer.rs:418
msgid "No disks were found"
msgstr "Ez da diskorik aurkitu"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Leku librea Windowsen ondoan"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windowsen partizioak ez dira ukitzen. MANek EFI sistema-partizioa partekatzen du eta Windows bere abio-menuan gehitzen du."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} libre"

#: installer.rs:432
msgid "no free space"
msgstr "leku librerik ez"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Ordezkatuko den instalazioa"

#: installer.rs:477
msgid "no home folders"
msgstr "etxeko karpetarik ez"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "etxeko karpetak: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "argazkiak: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN {model}(e)n"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "{device}(r)en pasaesaldia"

#: installer.rs:500
msgid "Unlock"
msgstr "Desblokeatu"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Ezin izan da instalazioa aztertu."

#: installer.rs:554
msgid "Partitions"
msgstr "Partizioak"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Sistema-partizioa Btrfs-rekin formateatzen da eta @system, @home eta @snapshots ditu. MAN exekutatzen ari den diskoko partizioak ez dira zerrendatzen."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Ireki Diskoak partizioak sortzeko edo tamainaz aldatzeko"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Freskatu partizio-zerrenda"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Aukeratu partizio bat"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI sistema-partizioa"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Formateatu EFI sistema-partizioa"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Utzi desaktibatuta beste sistemen abio-kargatzaileak gordetzeko"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Sistema-partizioa (Btrfs gisa formateatua)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Abio-partizioa (zifratzeko beharrezkoa)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Partizio-zerrenda freskatu da"

#: installer.rs:650
msgid "Security"
msgstr "Segurtasuna"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Zifratu sistema"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Zure datuak babesten ditu ordenagailua galdu edo lapurtzen badizute. Abio bakoitzean pasaesaldia eskatzen da."

#: installer.rs:656
msgid "Passphrase"
msgstr "Pasaesaldia"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Berretsi pasaesaldia"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Gorde pasaesaldi hau leku seguruan"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Galtzen bada, inork ezingo ditu datuak berreskuratu. Nukleoa eta abio-fitxategiak zifratu gabeko abio-partizio txiki batean geratzen dira."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Pasaesaldiak gutxienez 8 karaktere izan behar ditu."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Pasaesaldiak ez datoz bat."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Aukeratu disko bat."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Aukeratu Windows duen diskoa."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Aukeratu ordezkatuko den instalazioa."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Desblokeatu lehenik instalazio zifratua."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Partizio honek ez du MAN sistemarik."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Aukeratu EFI sistema-partizio bat."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Aukeratu sistema-partizioa."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI partizioak eta sistema-partizioak desberdinak izan behar dute."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Zifratzeak abio-partizio bereizia behar du."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Sistema-partizioak gutxienez {size} izan behar ditu."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI partizioa ez dago FAT formatuan; aktibatu formateatzea."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Sistema-partizioa muntatuta dago; desmuntatu lehenik Diskoak aplikazioan."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Non instalatu MAN?"

