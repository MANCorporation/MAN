msgid "Time and Keyboard"
msgstr "Ordua eta teklatua"

#: installer.rs:829
msgid "Time Zone"
msgstr "Ordu-zona"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Teklatuaren diseinua"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Probatu teklatua"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Idatzi hemen teklek karaktere zuzenak sortzen dituztela egiaztatzeko."

#: installer.rs:844
msgid "Type here"
msgstr "Idatzi hemen"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Ordu-zona eta teklatua"

