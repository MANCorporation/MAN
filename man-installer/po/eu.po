msgid "The installer backend must run as root."
msgstr "Instalatzailearen laguntzaileak root gisa exekutatu behar du."

#: install.rs:88
msgid "This computer was not started in UEFI mode. MAN requires UEFI."
msgstr "Ordenagailu hau ez da UEFI moduan abiarazi. MANek UEFI behar du."

#: install.rs:92
msgid "The username is not valid."
msgstr "Erabiltzaile-izena ez da baliozkoa."

#: install.rs:95
msgid "A password is required."
msgstr "Pasahitza behar da."

#: install.rs:99
msgid "The computer name is not valid."
msgstr "Ordenagailuaren izena ez da baliozkoa."

#: install.rs:105
msgid "Unknown language."
msgstr "Hizkuntza ezezaguna."

#: install.rs:111
msgid "The encryption passphrase must have at least 8 characters."
msgstr "Zifratzeko pasaesaldiak gutxienez 8 karaktere izan behar ditu."

#: install.rs:122
msgid "The disk changed after you confirmed the installation. Nothing was modified; please review and confirm again."
msgstr "Diskoa aldatu egin da instalazioa berretsi ondoren. Ez da ezer aldatu; berrikusi eta berretsi berriro."

#: install.rs:138
msgid "Choose a system partition."
msgstr "Aukeratu sistema-partizio bat."

#: install.rs:145
msgid "The confirmed disk does not hold the chosen system partition."
msgstr "Berretsitako diskoak ez du aukeratutako sistema-partizioa."

#: install.rs:157
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "Abio-partizioak EFI eta sistema-partizioetatik bereizita egon behar du."

#: install.rs:160
msgid "The boot partition must be at least 512 MB."
msgstr "Abio-partizioak gutxienez 512 MB izan behar ditu."

#: install.rs:175
msgid "No installation chosen."
msgstr "Ez da instalaziorik aukeratu."

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "Berretsitako diskoak ez du aukeratutako instalazioa."

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "Instalazio zifratuak ez du MAN_BOOT partiziorik."

#: install.rs:695
msgid "No kernel with matching modules was found in /boot."
msgstr "Ez da /boot-en modulu egokiak dituen nukleorik aurkitu."

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "Hizkuntza sistemaren laguntzaileak aldatu behar du."

#: oobe.rs:204
msgid "Applying your settings"
msgstr "Zure ezarpenak aplikatzen"

#: oobe.rs:212
msgid "Preparing disk encryption"
msgstr "Diskoaren zifratzea prestatzen"

#: oobe.rs:216
msgid "Finishing"
msgstr "Amaitzen"

#: oobe.rs:100
msgid "MAN Setup must be finished by the system helper."
msgstr "MAN Setup sistemaren laguntzaileak amaitu behar du."

#: oobe.rs:103
msgid "MAN Setup has already been completed on this computer."
msgstr "MAN Setup dagoeneko osatu da ordenagailu honetan."

#: oobe.rs:124
msgid "Unknown accent color."
msgstr "Nabarmentze-kolore ezezaguna."

#: oobe.rs:128
msgid "The chosen wallpaper is not available."
msgstr "Aukeratutako horma-papera ez dago erabilgarri."

#: oobe.rs:146
msgid "This system cannot be encrypted."
msgstr "Sistema hau ezin da zifratu."

#: oobe.rs:257
msgid "The setup key is missing, so encryption cannot continue in the background."
msgstr "Konfigurazio-gakoa falta da, beraz zifratzeak ezin du atzeko planoan jarraitu."

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "Sistema ez dago Btrfs-en instalatuta, beraz argazkiak ez daude erabilgarri."

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "Argazki-leheneratze bat berrabiaraztearen zain dago. Berrabiarazi lehenik ordenagailua amaitzeko."

#: snapshots.rs:99
msgid "Invalid snapshot id."
msgstr "Argazki-ID baliogabea."

