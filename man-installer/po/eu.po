msgstr "Instalatzailea sistema berritik kentzen"

#: install.rs:687
msgid "Building the boot image (initramfs)"
msgstr "Abio-irudia (initramfs) eraikitzen"

#: install.rs:717
msgid "Configuring GRUB"
msgstr "GRUB konfiguratzen"

#: install.rs:735
msgid "Installing GRUB to the EFI system partition"
msgstr "GRUB EFI sistema-partizioan instalatzen"

#: install.rs:750
msgid "Installing the fallback boot loader"
msgstr "Ordezko abio-kargatzailea instalatzen"

