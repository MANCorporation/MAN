msgstr "MAN deskargatzen"

#: recovery.rs:459
msgid "Opening the downloaded MAN"
msgstr "Deskargatutako MAN irekitzen"

#: recovery.rs:85
msgid "Leaving out what Recovery does not need"
msgstr "Berreskuratzeak behar ez duena kentzen"

#: recovery.rs:87
msgid "Setting up the recovery system"
msgstr "Berreskuratze-sistema konfiguratzen"

#: recovery.rs:89
msgid "Adding its start-up files"
msgstr "Haren abioko fitxategiak gehitzen"

#: recovery.rs:104
msgid "MAN Recovery is ready"
msgstr "MAN berreskuratzea prest dago"

#: recovery.rs:64
msgid "This MAN has no MAN Recovery program."
msgstr "MAN honek ez du MAN berreskuratzea programarik."

#: recovery.rs:82
msgid "MAN Recovery was not started."
msgstr "MAN berreskuratzea ez da hasi."

#: recovery.rs:206
msgid "The installed system has no kernel for MAN Recovery."
msgstr "Instalatutako sistemak ez du nukleorik MAN berreskuratzearentzat."

#: recovery.rs:234
msgid "MAN Recovery was not started from the boot menu."
msgstr "MAN berreskuratzea ez da abio-menutik abiarazi."

#: recovery.rs:235
msgid "The disk of this MAN was not found."
msgstr "Ez da MAN honen diskoa aurkitu."

#: recovery.rs:240
msgid "This works only in MAN Recovery."
msgstr "MAN berreskuratzean bakarrik funtzionatzen du."

#: recovery.rs:290
msgid "The password is not correct."
msgstr "Pasahitza ez da zuzena."

#: recovery.rs:333
msgid "Invalid snapshot id."
msgstr "Argazki-ID baliogabea."

#: recovery.rs:405
msgid "No MAN for this computer was found on MAN's download page."
msgstr "Ez da ordenagailu honentzako MANik aurkitu MANen deskarga-orrian."

#: recovery.rs:434
msgid "The downloaded MAN is damaged (its checksum does not match). Try again."
msgstr "Deskargatutako MAN hondatuta dago (kontrol-batura ez dator bat). Saiatu berriro."

#: recovery.rs:491
msgid "The partition of this MAN was not found."
msgstr "Ez da MAN honen partizioa aurkitu."

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "Sistema ez dago Btrfs-en instalatuta, beraz argazkiak ez daude erabilgarri."

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "Argazki-leheneratze bat berrabiaraztearen zain dago. Berrabiarazi lehenik ordenagailua amaitzeko."

