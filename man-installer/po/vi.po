msgstr "Thử bàn phím"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Gõ vào đây để kiểm tra các phím có tạo đúng ký tự không."

#: installer.rs:844
msgid "Type here"
msgstr "Gõ vào đây"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Múi giờ và bàn phím"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Chưa chọn ổ đĩa"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Chưa chọn phân vùng hệ thống"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Phân vùng hệ thống đã biến mất"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Chưa chọn bản cài đặt"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Ổ đĩa đã biến mất"

#: installer.rs:955
msgid "Review"
msgstr "Xem lại"

#: installer.rs:958
msgid "Destination"
msgstr "Đích"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Xóa ổ đĩa và cài đặt"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Phân vùng tùy chỉnh"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Cài lại, giữ /home"

#: installer.rs:963
