#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Tệp này không phải là ứng dụng có thể cài đặt ở đây (.deb, .flatpak, .flatpakref hoặc AppImage)."

#: appinstaller.rs:128
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Ứng dụng này được làm cho máy tính {arch} và không chạy trên máy này (x86-64)."

#: appinstaller.rs:313
msgid "The file could not be read. It may be damaged."
msgstr "Không thể đọc tệp. Tệp có thể đã bị hỏng."

#: appinstaller.rs:485
msgid "This is not an AppImage."
msgstr "Đây không phải là AppImage."

