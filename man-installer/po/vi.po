msgstr "Chọn vị trí"

#: appinstaller.rs:832
msgid "Standard Install"
msgstr "Cài đặt tiêu chuẩn"

#: appinstaller.rs:833
msgid "_Install"
msgstr "_Cài đặt"

#: appinstaller.rs:846
msgid "Debian package (.deb)"
msgstr "Gói Debian (.deb)"

#: appinstaller.rs:847
msgid "Flatpak app"
msgstr "Ứng dụng Flatpak"

#: appinstaller.rs:848
msgid "Flatpak app from {source}"
msgstr "Ứng dụng Flatpak từ {source}"

#: appinstaller.rs:849
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:867
msgid "You will be guided through the steps necessary to install this software."
msgstr "Bạn sẽ được hướng dẫn qua các bước cần thiết để cài đặt phần mềm này."

#: appinstaller.rs:878
msgid "Version"
msgstr "Phiên bản"

#: appinstaller.rs:881
msgid "Publisher"
msgstr "Nhà phát hành"

#: appinstaller.rs:883
msgid "Type"
msgstr "Loại"

#: appinstaller.rs:885
msgid "Size"
msgstr "Kích thước"

#: appinstaller.rs:891
msgid "Website"
msgstr "Trang web"

#: appinstaller.rs:893
msgid "File"
msgstr "Tệp"

#: appinstaller.rs:903
msgid "This app is installed already. Installing it again replaces it."
msgstr "Ứng dụng này đã được cài đặt. Cài đặt lại sẽ thay thế nó."

#: appinstaller.rs:906
msgid "Apps from .deb packages become part of the system. When MAN is updated they are removed and need to be installed again. Flatpak apps and AppImages are kept."
msgstr "Ứng dụng từ gói .deb trở thành một phần của hệ thống. Khi MAN được cập nhật, chúng bị gỡ bỏ và cần cài đặt lại. Ứng dụng Flatpak và AppImage được giữ lại."

#: appinstaller.rs:909
msgid "Only install apps from sources you trust."
msgstr "Chỉ cài đặt ứng dụng từ nguồn bạn tin tưởng."

#: appinstaller.rs:915
msgid "Where do you want to install {name}?"
msgstr "Bạn muốn cài đặt {name} ở đâu?"

#: appinstaller.rs:920
msgid "Only your account can use the app."
msgstr "Chỉ tài khoản của bạn có thể dùng ứng dụng."

#: appinstaller.rs:921
msgid "Needs administrator rights."
msgstr "Cần quyền quản trị viên."

#: appinstaller.rs:928
msgid "Only for Me"
msgstr "Chỉ cho tôi"

#: appinstaller.rs:928
msgid "For All Users of This Computer"
msgstr "Cho tất cả người dùng máy tính này"

#: appinstaller.rs:943
msgid "This will take {size} of space on your computer."
msgstr "Việc này sẽ chiếm {size} dung lượng trên máy tính của bạn."

#: appinstaller.rs:945
msgid "The app is downloaded from {source}."
msgstr "Ứng dụng được tải xuống từ {source}."

#: appinstaller.rs:947
msgid "The app is installed for all users of this computer."
msgstr "Ứng dụng được cài đặt cho tất cả người dùng máy tính này."

#: appinstaller.rs:947
msgid "The app is installed only for you."
msgstr "Ứng dụng chỉ được cài đặt cho bạn."

#: appinstaller.rs:950
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage được chuyển đến {folder} và thêm vào các ứng dụng của bạn."

#: appinstaller.rs:952
msgid "Click Install to install {name}."
msgstr "Nhấn Cài đặt để cài đặt {name}."

#: appinstaller.rs:958
msgid "Checking what else the app needs…"
msgstr "Đang kiểm tra ứng dụng còn cần gì…"

#: appinstaller.rs:968
msgid "Also installs the packages it needs: {list}"
msgstr "Cũng cài đặt các gói mà nó cần: {list}"

#: appinstaller.rs:974
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Một số gói mà ứng dụng cần chưa có sẵn. Quá trình cài đặt sẽ lấy danh sách gói mới nhất trước; nếu vẫn thiếu, ứng dụng không thể được cài đặt."

#: appinstaller.rs:1035
msgid "Installing {name}…"
msgstr "Đang cài đặt {name}…"

#: appinstaller.rs:1041
msgid "Preparing…"
msgstr "Đang chuẩn bị…"

#: appinstaller.rs:1048
msgid "Details"
msgstr "Chi tiết"

#: appinstaller.rs:1088
msgid "Installing the package…"
msgstr "Đang cài đặt gói…"

#: appinstaller.rs:1107
msgid "Moving the app to its folder…"
msgstr "Đang chuyển ứng dụng vào thư mục của nó…"

#: appinstaller.rs:1116
msgid "The app could not be installed."
msgstr "Không thể cài đặt ứng dụng."

#: appinstaller.rs:1120
msgid "Installing the app with Flatpak…"
msgstr "Đang cài đặt ứng dụng bằng Flatpak…"

#: appinstaller.rs:1139
msgid "Log"
msgstr "Nhật ký"

#: appinstaller.rs:1169
msgid "_Close"
msgstr "Đón_g"

#: appinstaller.rs:1179
msgid "The Installation Was Successful"
msgstr "Cài đặt thành công"

#: appinstaller.rs:1179
msgid "The app was installed."
msgstr "Ứng dụng đã được cài đặt."

#: appinstaller.rs:1184
msgid "The Installation Failed"
msgstr "Cài đặt thất bại"

#: appinstaller.rs:1195
msgid "_Open"
msgstr "_Mở"

#: appinstaller.rs:1205
msgid "_Show Details"
msgstr "_Hiện chi tiết"

#: appinstaller.rs:1208
msgid "Installation Log"
msgstr "Nhật ký cài đặt"

#: appinstaller.rs:1235
msgid "App Installer"
msgstr "Trình cài đặt ứng dụng"

#: appinstaller.rs:1256
msgid "Go _Back"
msgstr "_Quay lại"

#: appinstaller.rs:1328
msgid "Reading the app…"
msgstr "Đang đọc ứng dụng…"

#: appinstaller.rs:1337
msgid "Install {name}"
msgstr "Cài đặt {name}"

#: appinstaller.rs:1356
msgid "Apps"
msgstr "Ứng dụng"

#: appinstaller.rs:1362
msgid "Choose an App to Install"
msgstr "Chọn ứng dụng để cài đặt"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "Không thể khởi động trình trợ giúp hệ thống."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "Không thể giao tiếp với trình trợ giúp hệ thống."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Mất kết nối với trình trợ giúp hệ thống."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Đã hủy xác thực."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Thao tác này cần quyền quản trị."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "Trình trợ giúp hệ thống dừng đột ngột."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Không có phân vùng hệ thống EFI"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Chỉ còn trống {free}, MAN cần {need}. Hãy giải phóng dung lượng bằng DUHACH! trong Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Không còn dung lượng trống. Hãy chạy DUHACH! trong Windows để dành chỗ cho MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN đang chạy từ ổ đĩa này"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Đang dùng: có phân vùng đang được gắn"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Quá nhỏ, MAN cần {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Cài đặt MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN đang được cài đặt. Vui lòng chờ đến khi xong."

#: installer.rs:143
msgid "Language"
msgstr "Ngôn ngữ"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Khởi động lại bằng ngôn ngữ này"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Phiên live sẽ khởi động lại bằng ngôn ngữ đã chọn, và MAN được cài bằng ngôn ngữ đó."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Chào mừng đến với MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Hệ thống GNOME nhanh, mở và tùy biến hoàn toàn.\n"
"Cài đặt lên máy tính này, hoặc tiếp tục khám phá phiên live."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Cài đặt MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Tiếp tục dùng thử MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Đang tìm ổ đĩa…"

#: installer.rs:250
msgid "Welcome"
msgstr "Chào mừng"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Máy tính này khởi động ở chế độ BIOS cũ. MAN chỉ cài được trên máy tính UEFI: hãy khởi động lại và chọn tùy chọn khởi động UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Trình trợ giúp hệ thống không trả về thông tin ổ đĩa."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Tiếp"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Xóa ổ đĩa và cài MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Mọi thứ trên ổ đĩa đã chọn sẽ bị xóa, kể cả Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Khuyên dùng. Mọi thứ trên ổ đĩa đã chọn sẽ bị xóa."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Cài bên cạnh Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Khuyên dùng. MAN dùng dung lượng trống cạnh Windows; Windows và tệp của nó vẫn giữ nguyên. Chọn hệ thống mỗi lần khởi động."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Cài lại MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Thay hệ thống nhưng giữ tệp cá nhân trong /home. Hệ thống hiện tại được lưu thành ảnh chụp."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Phân vùng tùy chỉnh"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Dành cho chuyên gia: tự chọn phân vùng, hoặc tạo bằng Đĩa."

#: installer.rs:392
msgid "Disk"
msgstr "Ổ đĩa"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Chọn ổ đĩa sẽ bị xóa. Các ổ không dùng được sẽ hiện kèm lý do."

#: installer.rs:418
msgid "No disks were found"
msgstr "Không tìm thấy ổ đĩa"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Dung lượng trống cạnh Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Các phân vùng của Windows không bị động đến. MAN dùng chung phân vùng hệ thống EFI và thêm Windows vào trình đơn khởi động."

#: installer.rs:432
msgid "{size} free"
msgstr "Trống {size}"

#: installer.rs:432
msgid "no free space"
msgstr "không còn trống"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Bản cài đặt sẽ thay thế"

#: installer.rs:477
msgid "no home folders"
msgstr "không có thư mục nhà"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "thư mục nhà: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "ảnh chụp: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN trên {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Cụm mật khẩu cho {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Mở khóa"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Không thể kiểm tra bản cài đặt."

#: installer.rs:554
msgid "Partitions"
msgstr "Phân vùng"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Phân vùng hệ thống được định dạng Btrfs và chứa @system, @home và @snapshots. Các phân vùng trên ổ đĩa MAN đang chạy không được liệt kê."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Mở Đĩa để tạo hoặc đổi kích thước phân vùng"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Làm mới danh sách phân vùng"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Chọn phân vùng"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "Phân vùng hệ thống EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Định dạng phân vùng hệ thống EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Để tắt để giữ trình nạp khởi động của các hệ thống khác"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Phân vùng hệ thống (định dạng Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Phân vùng khởi động (cần khi mã hóa)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Đã làm mới danh sách phân vùng"

#: installer.rs:650
msgid "Security"
msgstr "Bảo mật"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Mã hóa hệ thống"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Bảo vệ dữ liệu nếu máy tính bị mất hoặc bị đánh cắp. Mỗi lần khởi động sẽ hỏi cụm mật khẩu."

#: installer.rs:656
msgid "Passphrase"
msgstr "Cụm mật khẩu"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Xác nhận cụm mật khẩu"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Hãy giữ cụm mật khẩu này an toàn"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Nếu mất, không ai khôi phục được dữ liệu. Nhân và tệp khởi động nằm trên một phân vùng khởi động nhỏ không mã hóa."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Cụm mật khẩu phải có ít nhất 8 ký tự."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Cụm mật khẩu không khớp."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Hãy chọn ổ đĩa."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Hãy chọn ổ đĩa có Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Hãy chọn bản cài đặt sẽ thay thế."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Hãy mở khóa bản cài đặt đã mã hóa trước."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Phân vùng này không chứa hệ thống MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Hãy chọn phân vùng hệ thống EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Hãy chọn phân vùng hệ thống."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Phân vùng EFI và phân vùng hệ thống phải khác nhau."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Mã hóa cần một phân vùng khởi động riêng."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Phân vùng hệ thống phải có ít nhất {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Phân vùng EFI không phải định dạng FAT; hãy bật định dạng."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Phân vùng hệ thống đang được gắn; hãy gỡ nó trong Đĩa trước."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Cài MAN vào đâu?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Thời gian và bàn phím"

#: installer.rs:829
msgid "Time Zone"
msgstr "Múi giờ"

