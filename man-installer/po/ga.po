msgstr "Deighiltí saincheaptha"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Athshuiteáil, ag coimeád /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Taobh le Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (formáidfear í)"

#: installer.rs:969
