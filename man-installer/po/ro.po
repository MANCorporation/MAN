msgid "Preparing the update area"
msgstr "Se pregătește zona de actualizare"

#: update.rs:32
msgid "Unpacking the new system"
msgstr "Se despachetează noul sistem"

#: update.rs:32
msgid "Moving your accounts and settings"
msgstr "Se mută conturile și setările dvs."

#: update.rs:32
msgid "Preparing the restart"
msgstr "Se pregătește repornirea"

#: update.rs:179
msgid "Unpacked"
msgstr "Despachetat"

#: update.rs:261
msgid "Accounts"
msgstr "Conturi"

#: update.rs:301
msgid "Removing installer-only software"
msgstr "Se elimină software-ul folosit doar de instalator"

