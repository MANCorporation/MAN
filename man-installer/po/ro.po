#: install.rs:145
msgid "The confirmed disk does not hold the chosen system partition."
msgstr "Discul confirmat nu conține partiția de sistem aleasă."

#: install.rs:157
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "Partiția de pornire trebuie să fie separată de partițiile EFI și de sistem."

#: install.rs:160
msgid "The boot partition must be at least 512 MB."
msgstr "Partiția de pornire trebuie să aibă cel puțin 512 MB."

#: install.rs:175
msgid "No installation chosen."
msgstr "Nicio instalare aleasă."

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "Discul confirmat nu conține instalarea aleasă."

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "Instalarea criptată nu are partiție MAN_BOOT."

#: install.rs:695
msgid "No kernel with matching modules was found in /boot."
msgstr "Nu s-a găsit în /boot niciun nucleu cu module potrivite."

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "Limba trebuie schimbată de asistentul de sistem."

#: oobe.rs:204
msgid "Applying your settings"
msgstr "Se aplică setările dvs."

#: oobe.rs:212
msgid "Preparing disk encryption"
msgstr "Se pregătește criptarea discului"

#: oobe.rs:216
msgid "Finishing"
msgstr "Se finalizează"

#: oobe.rs:100
msgid "MAN Setup must be finished by the system helper."
msgstr "MAN Setup trebuie finalizat de asistentul de sistem."

#: oobe.rs:103
msgid "MAN Setup has already been completed on this computer."
msgstr "MAN Setup a fost deja finalizat pe acest calculator."

#: oobe.rs:124
msgid "Unknown accent color."
msgstr "Culoare de accent necunoscută."

#: oobe.rs:128
msgid "The chosen wallpaper is not available."
msgstr "Fundalul ales nu este disponibil."

#: oobe.rs:146
msgid "This system cannot be encrypted."
msgstr "Acest sistem nu poate fi criptat."

#: oobe.rs:257
msgid "The setup key is missing, so encryption cannot continue in the background."
msgstr "Lipsește cheia de configurare, așa că criptarea nu poate continua în fundal."

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "Sistemul nu este instalat pe Btrfs, așa că instantaneele nu sunt disponibile."

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "O restaurare de instantaneu așteaptă o repornire. Reporniți mai întâi calculatorul pentru a o finaliza."

#: snapshots.rs:99
msgid "Invalid snapshot id."
msgstr "ID de instantaneu nevalid."

