msgid "Building the update boot image"
msgstr "Se construiește imaginea de pornire a actualizării"

#: update.rs:343
msgid "Adding the one-time boot entry"
msgstr "Se adaugă intrarea de pornire unică"

#: update.rs:377
msgid "The update is genuine"
msgstr "Actualizarea este autentică"

#: update.rs:383
msgid "Snapshot created"
msgstr "Instantaneu creat"

#: update.rs:385
msgid "Skipped"
msgstr "Omis"

#: update.rs:394
msgid "Update area ready"
msgstr "Zona de actualizare este pregătită"

#: update.rs:410
msgid "Preparing the new system"
msgstr "Se pregătește noul sistem"

#: update.rs:168
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Fișierul de actualizare este deteriorat (suma de control nu se potrivește). Descărcați-l din nou."

#: update.rs:171
msgid "The update file could not be read completely."
msgstr "Fișierul de actualizare nu a putut fi citit complet."

#: update.rs:312
msgid "The update contains no kernel."
msgstr "Actualizarea nu conține niciun nucleu."

#: update.rs:360
msgid "Updates must be installed by the system helper."
msgstr "Actualizările trebuie instalate de asistentul de sistem."

#: update.rs:369
msgid "The chosen installation was not found."
msgstr "Instalarea aleasă nu a fost găsită."

#: update.rs:371
msgid "Only the running MAN installation can be updated."
msgstr "Doar instalarea MAN pornită poate fi actualizată."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Acesta nu este un fișier de actualizare MAN (nu are manifest)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "Actualizarea nu este semnată, deci nu este de încredere."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "Semnătura actualizării este deteriorată."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "Actualizarea nu este semnată de MAN. Este posibil să fi fost modificată sau să provină dintr-o sursă nesigură."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "Manifestul actualizării nu este valid."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "Fraza de acces nu este corectă sau partiția criptată nu poate fi deschisă."

