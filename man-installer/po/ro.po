msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "Î_nainte"

#: installer.rs:361
msgid "Installation Type"
msgstr "Tipul instalării"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Șterge discul și instalează MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Tot ce se află pe discul ales este șters, inclusiv Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Recomandat. Tot ce se află pe discul ales este șters."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Instalează lângă Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Recomandat. MAN folosește spațiul liber de lângă Windows; Windows și fișierele sale rămân. Alegeți sistemul la fiecare pornire."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Reinstalează MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Înlocuiește sistemul, dar păstrează fișierele personale din /home. Sistemul actual este salvat ca instantaneu."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Partiții personalizate"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Pentru experți: alegeți singuri partițiile sau creați-le cu Discuri."

#: installer.rs:392
msgid "Disk"
msgstr "Disc"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Alegeți discul care va fi șters. Discurile care nu pot fi folosite apar împreună cu motivul."

