#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Гэты файл не з'яўляецца праграмай, якую можна тут усталяваць (.deb, .flatpak, .flatpakref або AppImage)."

#: appinstaller.rs:128
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Гэта праграма зроблена для камп'ютараў {arch} і не працуе на гэтым (x86-64)."

#: appinstaller.rs:313
msgid "The file could not be read. It may be damaged."
msgstr "Не ўдалося прачытаць файл. Магчыма, ён пашкоджаны."

#: appinstaller.rs:485
msgid "This is not an AppImage."
msgstr "Гэта не AppImage."

#: appinstaller.rs:679
msgid "Introduction"
msgstr "Уводзіны"

#: appinstaller.rs:680
msgid "License"
msgstr "Ліцэнзія"

#: appinstaller.rs:681
msgid "Destination Select"
msgstr "Выбар месца"

#: appinstaller.rs:682
msgid "Installation Type"
msgstr "Тып усталявання"

#: appinstaller.rs:683
msgid "Installation"
msgstr "Усталяванне"

#: appinstaller.rs:684
msgid "Summary"
msgstr "Зводка"

#: appinstaller.rs:788
msgid "_Continue"
msgstr "_Працягнуць"

#: appinstaller.rs:797
msgid "Welcome to the {name} Installer"
msgstr "Вітаем ва ўсталёўшчыку {name}"

#: appinstaller.rs:801
msgid "Software License Agreement"
msgstr "Ліцэнзійнае пагадненне"

#: appinstaller.rs:811
msgid "Do You Agree to the License?"
msgstr "Вы прымаеце ліцэнзію?"

#: appinstaller.rs:812
msgid "To continue installing, you must agree to the terms of the software license agreement."
msgstr "Каб працягнуць усталяванне, трэба прыняць умовы ліцэнзійнага пагаднення."

#: appinstaller.rs:814
msgid "_Read License"
msgstr "_Чытаць ліцэнзію"

#: appinstaller.rs:815
msgid "_Agree"
msgstr "_Прымаю"

#: appinstaller.rs:828
msgid "Select a Destination"
msgstr "Выберыце месца"

#: appinstaller.rs:832
msgid "Standard Install"
msgstr "Звычайнае ўсталяванне"

#: appinstaller.rs:833
msgid "_Install"
msgstr "_Усталяваць"

#: appinstaller.rs:846
msgid "Debian package (.deb)"
msgstr "Пакет Debian (.deb)"

#: appinstaller.rs:847
msgid "Flatpak app"
msgstr "Праграма Flatpak"

#: appinstaller.rs:848
msgid "Flatpak app from {source}"
msgstr "Праграма Flatpak з {source}"

#: appinstaller.rs:849
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:867
msgid "You will be guided through the steps necessary to install this software."
msgstr "Вы пройдзеце ўсе крокі, патрэбныя для ўсталявання гэтай праграмы."

#: appinstaller.rs:878
msgid "Version"
msgstr "Версія"

#: appinstaller.rs:881
msgid "Publisher"
msgstr "Выдавец"

#: appinstaller.rs:883
msgid "Type"
msgstr "Тып"

#: appinstaller.rs:885
msgid "Size"
msgstr "Памер"

#: appinstaller.rs:891
msgid "Website"
msgstr "Вэб-сайт"

#: appinstaller.rs:893
msgid "File"
msgstr "Файл"

#: appinstaller.rs:903
msgid "This app is installed already. Installing it again replaces it."
msgstr "Гэта праграма ўжо ўсталявана. Паўторнае ўсталяванне заменіць яе."

#: appinstaller.rs:906
msgid "Apps from .deb packages become part of the system. When MAN is updated they are removed and need to be installed again. Flatpak apps and AppImages are kept."
msgstr "Праграмы з пакетаў .deb становяцца часткай сістэмы. Пры абнаўленні MAN яны выдаляюцца, і іх трэба ўсталяваць зноў. Праграмы Flatpak і AppImage захоўваюцца."

#: appinstaller.rs:909
msgid "Only install apps from sources you trust."
msgstr "Усталёўвайце праграмы толькі з надзейных крыніц."

#: appinstaller.rs:915
msgid "Where do you want to install {name}?"
msgstr "Куды ўсталяваць {name}?"

#: appinstaller.rs:920
msgid "Only your account can use the app."
msgstr "Карыстацца праграмай зможа толькі ваш уліковы запіс."

#: appinstaller.rs:921
msgid "Needs administrator rights."
msgstr "Патрэбныя правы адміністратара."

#: appinstaller.rs:928
msgid "Only for Me"
msgstr "Толькі для мяне"

#: appinstaller.rs:928
msgid "For All Users of This Computer"
msgstr "Для ўсіх карыстальнікаў гэтага камп'ютара"

#: appinstaller.rs:943
msgid "This will take {size} of space on your computer."
msgstr "Зойме {size} месца на камп'ютары."

#: appinstaller.rs:945
msgid "The app is downloaded from {source}."
msgstr "Праграма спампоўваецца з {source}."

#: appinstaller.rs:947
msgid "The app is installed for all users of this computer."
msgstr "Праграма ўсталёўваецца для ўсіх карыстальнікаў гэтага камп'ютара."

#: appinstaller.rs:947
msgid "The app is installed only for you."
msgstr "Праграма ўсталёўваецца толькі для вас."

#: appinstaller.rs:950
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage перамяшчаецца ў {folder} і дадаецца да вашых праграм."

#: appinstaller.rs:952
msgid "Click Install to install {name}."
msgstr "Націсніце «Усталяваць», каб усталяваць {name}."

#: appinstaller.rs:958
msgid "Checking what else the app needs…"
msgstr "Праверка, што яшчэ патрэбна праграме…"

#: appinstaller.rs:968
msgid "Also installs the packages it needs: {list}"
msgstr "Таксама будуць усталяваны патрэбныя пакеты: {list}"

#: appinstaller.rs:974
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Некаторыя патрэбныя праграме пакеты пакуль недаступныя. Усталяванне спачатку атрымае найноўшыя спісы пакетаў; калі іх усё роўна не будзе, праграму ўсталяваць нельга."

#: appinstaller.rs:1035
msgid "Installing {name}…"
msgstr "Усталяванне {name}…"

#: appinstaller.rs:1041
msgid "Preparing…"
msgstr "Падрыхтоўка…"

#: appinstaller.rs:1048
msgid "Details"
msgstr "Падрабязнасці"

#: appinstaller.rs:1088
msgid "Installing the package…"
msgstr "Усталяванне пакета…"

#: appinstaller.rs:1107
msgid "Moving the app to its folder…"
msgstr "Перамяшчэнне праграмы ў яе папку…"

#: appinstaller.rs:1116
msgid "The app could not be installed."
msgstr "Не ўдалося ўсталяваць праграму."

#: appinstaller.rs:1120
msgid "Installing the app with Flatpak…"
msgstr "Усталяванне праграмы праз Flatpak…"

#: appinstaller.rs:1139
msgid "Log"
msgstr "Журнал"

#: appinstaller.rs:1169
msgid "_Close"
msgstr "_Закрыць"

#: appinstaller.rs:1179
msgid "The Installation Was Successful"
msgstr "Усталяванне паспяховае"

#: appinstaller.rs:1179
msgid "The app was installed."
msgstr "Праграма ўсталявана."

#: appinstaller.rs:1184
msgid "The Installation Failed"
msgstr "Не ўдалося ўсталяваць"

#: appinstaller.rs:1195
msgid "_Open"
msgstr "_Адкрыць"

#: appinstaller.rs:1205
msgid "_Show Details"
msgstr "_Паказаць падрабязнасці"

#: appinstaller.rs:1208
msgid "Installation Log"
msgstr "Журнал усталявання"

#: appinstaller.rs:1235
msgid "App Installer"
msgstr "Усталёўшчык праграм"

#: appinstaller.rs:1256
msgid "Go _Back"
msgstr "_Назад"

#: appinstaller.rs:1328
msgid "Reading the app…"
msgstr "Чытанне праграмы…"

#: appinstaller.rs:1337
msgid "Install {name}"
msgstr "Усталяваць {name}"

#: appinstaller.rs:1356
msgid "Apps"
msgstr "Праграмы"

#: appinstaller.rs:1362
msgid "Choose an App to Install"
msgstr "Выберыце праграму для ўсталявання"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "Не ўдалося запусціць сістэмнага памочніка."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "Не ўдалося звязацца з сістэмным памочнікам."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Сувязь з сістэмным памочнікам страчана."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Аўтарызацыя скасавана."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Для гэтага дзеяння патрэбныя правы адміністратара."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "Сістэмны памочнік нечакана спыніўся."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Няма сістэмнага раздзела EFI"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Вольна толькі {free}, MAN патрэбна {need}. Вызваліце месца з дапамогай DUHACH! у Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Няма вольнага месца. Запусціце DUHACH! у Windows, каб вызваліць месца для MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN працуе з гэтага дыска"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Выкарыстоўваецца: раздзел прымантаваны"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Занадта малы, MAN патрэбна {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Усталяваць MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN усталёўваецца. Пачакайце, пакуль скончыцца."

#: installer.rs:143
msgid "Language"
msgstr "Мова"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Перазапусціць на гэтай мове"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Жывы сеанс перазапусціцца на выбранай мове, і MAN будзе ўсталяваны на ёй."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Вітаем у MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Хуткая, адкрытая і цалкам наладжвальная сістэма GNOME.\n"
"Усталюйце яе на гэты камп'ютар або працягвайце знаёміцца з жывым сеансам."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Усталяваць MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Працягнуць спрабаваць MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Пошук дыскаў…"

#: installer.rs:250
msgid "Welcome"
msgstr "Вітаем"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Гэты камп'ютар запушчаны ў старым рэжыме BIOS. MAN можна ўсталяваць толькі на камп'ютары з UEFI: перазапусціце і выберыце варыянт загрузкі UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Сістэмны памочнік не вярнуў звестак пра дыскі."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Далей"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Сцерці дыск і ўсталяваць MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Усё на выбраным дыску будзе выдалена, разам з Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Рэкамендуецца. Усё на выбраным дыску будзе выдалена."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Усталяваць побач з Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Рэкамендуецца. MAN выкарыстоўвае вольнае месца побач з Windows; Windows і яго файлы застаюцца. Сістэму вы выбіраеце пры кожным запуску."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Пераўсталяваць MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Замяняе сістэму, але захоўвае асабістыя файлы ў /home. Бягучая сістэма захоўваецца як здымак."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Свае раздзелы"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Для дасведчаных: выберыце раздзелы самі або стварыце іх у «Дысках»."

#: installer.rs:392
msgid "Disk"
msgstr "Дыск"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Выберыце дыск, які будзе сцёрты. Непрыдатныя дыскі паказаны з прычынай."

#: installer.rs:418
msgid "No disks were found"
msgstr "Дыскаў не знойдзена"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Вольнае месца побач з Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Раздзелы Windows не змяняюцца. MAN дзеліць сістэмны раздзел EFI і дадае Windows у сваё меню загрузкі."

#: installer.rs:432
msgid "{size} free"
msgstr "вольна {size}"

#: installer.rs:432
msgid "no free space"
msgstr "няма вольнага месца"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Усталяванне для замены"

#: installer.rs:477
msgid "no home folders"
msgstr "няма хатніх папак"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "хатнія папкі: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "здымкаў: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN на {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Парольная фраза для {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Разблакаваць"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Не ўдалося праверыць усталяванне."

#: installer.rs:554
msgid "Partitions"
msgstr "Раздзелы"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Сістэмны раздзел фарматуецца ў Btrfs і змяшчае @system, @home і @snapshots. Раздзелы дыска, з якога працуе MAN, не паказваюцца."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Адкрыць «Дыскі», каб стварыць раздзелы або змяніць іх памер"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Абнавіць спіс раздзелаў"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Выберыце раздзел"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "Сістэмны раздзел EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Фарматаваць сістэмны раздзел EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Пакіньце выключаным, каб захаваць загрузчыкі іншых сістэм"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Сістэмны раздзел (фарматуецца ў Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Загрузны раздзел (патрэбны для шыфравання)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Спіс раздзелаў абноўлены"

#: installer.rs:650
msgid "Security"
msgstr "Бяспека"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Зашыфраваць сістэму"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Абараняе вашы даныя, калі камп'ютар згублены або скрадзены. Пры кожным запуску пытаецца парольная фраза."

#: installer.rs:656
msgid "Passphrase"
msgstr "Парольная фраза"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Пацвярджэнне парольнай фразы"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Захоўвайце гэту парольную фразу ў надзейным месцы"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Калі яе страціць, ніхто не зможа аднавіць даныя. Ядро і файлы загрузкі застаюцца на невялікім незашыфраваным загрузным раздзеле."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Парольная фраза павінна мець не менш за 8 сімвалаў."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Парольныя фразы не супадаюць."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Выберыце дыск."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Выберыце дыск з Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Выберыце ўсталяванне для замены."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Спачатку разблакуйце зашыфраванае ўсталяванне."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Гэты раздзел не змяшчае сістэмы MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Выберыце сістэмны раздзел EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Выберыце сістэмны раздзел."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Раздзел EFI і сістэмны раздзел павінны адрознівацца."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Для шыфравання патрэбны асобны загрузны раздзел."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Сістэмны раздзел павінен быць не меншым за {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Раздзел EFI не адфарматаваны ў FAT; уключыце фарматаванне."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Сістэмны раздзел прымантаваны; спачатку адмантуйце яго ў «Дысках»."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Куды ўсталяваць MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Час і клавіятура"

#: installer.rs:829
msgid "Time Zone"
msgstr "Часавы пояс"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Раскладка клавіятуры"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Праверце клавіятуру"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Набярыце тут, каб праверыць, што клавішы ўводзяць правільныя сімвалы."

#: installer.rs:844
msgid "Type here"
msgstr "Набірайце тут"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Часавы пояс і клавіятура"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Дыск не выбраны"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Сістэмны раздзел не выбраны"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Сістэмны раздзел знік"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Усталяванне не выбрана"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Дыск знік"

#: installer.rs:955
msgid "Review"
msgstr "Праверка"

#: installer.rs:958
msgid "Destination"
msgstr "Прызначэнне"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Сцерці дыск і ўсталяваць"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Свае раздзелы"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Пераўсталяваць, захаваўшы /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Побач з Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (будзе адфарматаваны)"

#: installer.rs:969
msgid " (kept)"
msgstr " (захоўваецца)"

