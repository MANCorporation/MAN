msgstr "Стварэнне вобраза загрузкі абнаўлення"

#: update.rs:350
msgid "Adding the one-time boot entry"
msgstr "Даданне аднаразовага пункта загрузкі"

#: update.rs:384
msgid "The update is genuine"
msgstr "Абнаўленне сапраўднае"

#: update.rs:390
msgid "Snapshot created"
msgstr "Здымак створаны"

#: update.rs:392
msgid "Skipped"
msgstr "Прапушчана"

#: update.rs:401
msgid "Update area ready"
msgstr "Вобласць абнаўлення гатовая"

#: update.rs:423
msgid "Preparing the new system"
msgstr "Падрыхтоўка новай сістэмы"

#: update.rs:175
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Файл абнаўлення пашкоджаны (кантрольная сума не супадае). Спампуйце яго зноў."

#: update.rs:178
msgid "The update file could not be read completely."
msgstr "Не ўдалося цалкам прачытаць файл абнаўлення."

#: update.rs:319
msgid "The update contains no kernel."
msgstr "Абнаўленне не змяшчае ядра."

#: update.rs:367
msgid "Updates must be installed by the system helper."
msgstr "Абнаўленні павінен усталёўваць сістэмны памочнік."

#: update.rs:376
msgid "The chosen installation was not found."
msgstr "Выбранае ўсталяванне не знойдзена."

#: update.rs:378
msgid "Only the running MAN installation can be updated."
msgstr "Абнавіць можна толькі працуючае ўсталяванне MAN."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Гэта не файл абнаўлення MAN (няма маніфеста)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "Абнаўленне не падпісанае, таму яму нельга давяраць."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "Подпіс абнаўлення пашкоджаны."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "Абнаўленне не падпісана MAN. Магчыма, яго змянілі або яно паходзіць з ненадзейнай крыніцы."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "Маніфест абнаўлення недапушчальны."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "Няправільная парольная фраза, або зашыфраваны раздзел не ўдаецца адкрыць."

