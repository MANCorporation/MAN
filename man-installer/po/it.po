msgstr "{free} di spazio libero (vengono create una partizione di avvio e la partizione di sistema)"

#: installer.rs:1024
msgid "Windows"
msgstr "Windows"

#: installer.rs:1024
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Invariato. Compare nel menu di avvio di MAN; la partizione di sistema EFI è condivisa."

