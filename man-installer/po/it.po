msgid "Unlock"
msgstr "Sblocca"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Impossibile esaminare l'installazione."

#: installer.rs:554
msgid "Partitions"
msgstr "Partizioni"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "La partizione di sistema viene formattata con Btrfs e contiene @system, @home e @snapshots. Le partizioni del disco da cui è in esecuzione MAN non sono elencate."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Apri Dischi per creare o ridimensionare le partizioni"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Aggiorna l'elenco delle partizioni"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Scegli una partizione"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "Partizione di sistema EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Formatta la partizione di sistema EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Lascia disattivato per mantenere i boot loader di altri sistemi"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Partizione di sistema (formattata come Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Partizione di avvio (necessaria con la cifratura)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Elenco delle partizioni aggiornato"

#: installer.rs:650
msgid "Security"
msgstr "Sicurezza"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Cifra il sistema"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Protegge i tuoi dati se il computer viene perso o rubato. A ogni avvio viene richiesta una passphrase."

#: installer.rs:656
msgid "Passphrase"
msgstr "Passphrase"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Conferma passphrase"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Conserva questa passphrase al sicuro"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Se la perdi, nessuno potrà recuperare i dati. Il kernel e i file di avvio restano su una piccola partizione di avvio non cifrata."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "La passphrase deve avere almeno 8 caratteri."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Le passphrase non corrispondono."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Scegli un disco."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Scegli il disco con Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Scegli l'installazione da sostituire."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Sblocca prima l'installazione cifrata."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Questa partizione non contiene un sistema MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Scegli una partizione di sistema EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Scegli la partizione di sistema."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "La partizione EFI e quella di sistema devono essere diverse."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "La cifratura richiede una partizione di avvio separata."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "La partizione di sistema deve essere di almeno {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "La partizione EFI non è formattata FAT; attiva la formattazione."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "La partizione di sistema è montata; smontala prima in Dischi."

