msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system per MAN, @home per i tuoi file, @snapshots per i punti di ripristino. Tutti condividono lo spazio libero."

#: installer.rs:991
msgid "System"
msgstr "Sistema"

#: installer.rs:993
msgid "Your Account"
msgstr "Il tuo account"

