msgid "_Install"
msgstr "_Installa"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "Pronto per l'installazione"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "Cancellare {model}?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "Tutti i file e le partizioni su {path} ({size}) verranno eliminati definitivamente. L'operazione non può essere annullata."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "Cancella e installa"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "Formattare le partizioni scelte?"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "Tutti i dati sulle partizioni scelte verranno eliminati definitivamente. Le altre partizioni non cambiano."

#: installer.rs:1037
msgid "Format and Install"
msgstr "Formatta e installa"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "Installare MAN accanto a Windows?"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "MAN viene installato nei {free} di spazio libero su {model} ({path}). Windows e i suoi file non cambiano."

#: installer.rs:1046
msgid "Install"
msgstr "Installa"

#: installer.rs:1050
msgid "Reinstall MAN?"
msgstr "Reinstallare MAN?"

#: installer.rs:1051
msgid "The installed system will be replaced by a fresh copy. Personal files in /home are kept and the old system remains available as a snapshot."
msgstr "Il sistema installato verrà sostituito da una copia nuova. I file personali in /home vengono mantenuti e il vecchio sistema resta disponibile come istantanea."

