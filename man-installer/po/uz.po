msgstr "Boʻlimni tanlang"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI tizim boʻlimi"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI tizim boʻlimini formatlash"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Boshqa tizimlarning yuklovchilarini saqlash uchun oʻchiq qoldiring"

