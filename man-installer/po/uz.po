msgstr "Bu boʻlimda MAN tizimi yoʻq."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "EFI tizim boʻlimini tanlang."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Tizim boʻlimini tanlang."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI va tizim boʻlimlari har xil boʻlishi kerak."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Shifrlash uchun alohida yuklash boʻlimi kerak."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Tizim boʻlimi kamida {size} boʻlishi kerak."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI boʻlimi FAT formatida emas; formatlashni yoqing."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Tizim boʻlimi ulangan; avval uni Disklarda uzing."

