msgstr "Λογαριασμοί"

#: update.rs:338
msgid "Reinstalling kept apps"
msgstr "Επανεγκατάσταση των διατηρημένων εφαρμογών"

#: update.rs:404
msgid "Removing installer-only software"
msgstr "Αφαίρεση λογισμικού που χρησιμοποιεί μόνο ο εγκαταστάτης"

#: update.rs:450
msgid "Building the update boot image"
msgstr "Δημιουργία της εικόνας εκκίνησης της ενημέρωσης"

#: update.rs:453
msgid "Adding the one-time boot entry"
msgstr "Προσθήκη καταχώρισης εκκίνησης μίας χρήσης"

#: update.rs:488
msgid "The update is genuine"
msgstr "Η ενημέρωση είναι γνήσια"

#: update.rs:494
msgid "Snapshot created"
msgstr "Το στιγμιότυπο δημιουργήθηκε"

#: update.rs:505
msgid "Update area ready"
msgstr "Η περιοχή ενημέρωσης είναι έτοιμη"

#: update.rs:528
msgid "Preparing the new system"
msgstr "Προετοιμασία του νέου συστήματος"

#: update.rs:184
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Το αρχείο ενημέρωσης είναι κατεστραμμένο (το άθροισμα ελέγχου δεν ταιριάζει). Κατεβάστε το ξανά."

#: update.rs:187
msgid "The update file could not be read completely."
msgstr "Δεν ήταν δυνατή η πλήρης ανάγνωση του αρχείου ενημέρωσης."

#: update.rs:416
msgid "The update contains no kernel."
msgstr "Η ενημέρωση δεν περιέχει πυρήνα."

#: update.rs:470
msgid "Updates must be installed by the system helper."
msgstr "Οι ενημερώσεις πρέπει να εγκαθίστανται από τον βοηθό συστήματος."

#: update.rs:480
msgid "The chosen installation was not found."
msgstr "Η επιλεγμένη εγκατάσταση δεν βρέθηκε."

#: update.rs:482
msgid "Only the running MAN installation can be updated."
msgstr "Μόνο η εγκατάσταση MAN που εκτελείται μπορεί να ενημερωθεί."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Αυτό δεν είναι αρχείο ενημέρωσης MAN (χωρίς manifest)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "Η ενημέρωση δεν είναι υπογεγραμμένη, οπότε δεν είναι αξιόπιστη."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "Η υπογραφή της ενημέρωσης είναι κατεστραμμένη."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "Η ενημέρωση δεν είναι υπογεγραμμένη από το MAN. Μπορεί να έχει τροποποιηθεί ή να προέρχεται από μη αξιόπιστη πηγή."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "Το manifest της ενημέρωσης δεν είναι έγκυρο."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "Η φράση πρόσβασης δεν είναι σωστή ή το κρυπτογραφημένο διαμέρισμα δεν ανοίγει."

