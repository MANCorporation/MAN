msgstr "Προτείνει εγκατάσταση του MAN όταν ξεκινά η ζωντανή συνεδρία"

#: com.man.UpdateNotice.desktop
msgid "MAN Update Notice"
msgstr "Ειδοποίηση ενημέρωσης MAN"

#: com.man.UpdateNotice.desktop
