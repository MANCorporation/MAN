#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Αυτό το αρχείο δεν είναι εφαρμογή που μπορεί να εγκατασταθεί εδώ (.deb, .flatpak, .flatpakref ή AppImage)."

#: appinstaller.rs:134
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Αυτή η εφαρμογή είναι φτιαγμένη για υπολογιστές {arch} και δεν λειτουργεί σε αυτόν (x86-64)."

#: appinstaller.rs:320
msgid "The file could not be read. It may be damaged."
msgstr "Δεν ήταν δυνατή η ανάγνωση του αρχείου. Ίσως είναι κατεστραμμένο."

#: appinstaller.rs:492
msgid "This is not an AppImage."
msgstr "Αυτό δεν είναι AppImage."

#: appinstaller.rs:686
msgid "Introduction"
msgstr "Εισαγωγή"

#: appinstaller.rs:687
msgid "License"
msgstr "Άδεια χρήσης"

#: appinstaller.rs:688
msgid "Destination Select"
msgstr "Επιλογή προορισμού"

#: appinstaller.rs:689
msgid "Installation Type"
msgstr "Τύπος εγκατάστασης"

#: appinstaller.rs:690
msgid "Installation"
msgstr "Εγκατάσταση"

#: appinstaller.rs:691
msgid "Summary"
msgstr "Σύνοψη"

#: appinstaller.rs:797
msgid "_Continue"
msgstr "_Συνέχεια"

#: appinstaller.rs:806
msgid "Welcome to the {name} Installer"
msgstr "Καλώς ήρθατε στο πρόγραμμα εγκατάστασης του {name}"

#: appinstaller.rs:810
msgid "Software License Agreement"
msgstr "Άδεια χρήσης λογισμικού"

#: appinstaller.rs:820
msgid "Do You Agree to the License?"
msgstr "Συμφωνείτε με την άδεια χρήσης;"

#: appinstaller.rs:821
msgid "To continue installing, you must agree to the terms of the software license agreement."
msgstr "Για να συνεχίσετε την εγκατάσταση, πρέπει να συμφωνήσετε με τους όρους της άδειας χρήσης λογισμικού."

#: appinstaller.rs:823
msgid "_Read License"
msgstr "_Ανάγνωση άδειας"

#: appinstaller.rs:824
msgid "_Agree"
msgstr "_Συμφωνώ"

#: appinstaller.rs:837
msgid "Select a Destination"
msgstr "Επιλέξτε προορισμό"

#: appinstaller.rs:841
msgid "Standard Install"
msgstr "Τυπική εγκατάσταση"

#: appinstaller.rs:842
msgid "_Install"
msgstr "_Εγκατάσταση"

#: appinstaller.rs:855
msgid "Debian package (.deb)"
msgstr "Πακέτο Debian (.deb)"

#: appinstaller.rs:856
msgid "Flatpak app"
msgstr "Εφαρμογή Flatpak"

#: appinstaller.rs:857
msgid "Flatpak app from {source}"
msgstr "Εφαρμογή Flatpak από {source}"

#: appinstaller.rs:858
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:876
msgid "You will be guided through the steps necessary to install this software."
msgstr "Θα σας καθοδηγήσουμε στα βήματα που χρειάζονται για να εγκαταστήσετε αυτό το λογισμικό."

#: appinstaller.rs:887
msgid "Version"
msgstr "Έκδοση"

#: appinstaller.rs:890
msgid "Publisher"
msgstr "Εκδότης"

#: appinstaller.rs:892
msgid "Type"
msgstr "Τύπος"

#: appinstaller.rs:894
msgid "Size"
msgstr "Μέγεθος"

#: appinstaller.rs:900
msgid "Website"
msgstr "Ιστότοπος"

#: appinstaller.rs:902
msgid "File"
msgstr "Αρχείο"

#: appinstaller.rs:912
msgid "This app is installed already. Installing it again replaces it."
msgstr "Αυτή η εφαρμογή είναι ήδη εγκατεστημένη. Η επανεγκατάσταση την αντικαθιστά."

#: appinstaller.rs:915
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr "Οι εφαρμογές από πακέτα .deb γίνονται μέρος του συστήματος. Μια ενημέρωση του MAN αντικαθιστά το σύστημα, οπότε εγκαθίστανται ξανά μετά από ενημέρωση μόνο αν τις διατηρήσετε (επόμενα βήματα)."

#: appinstaller.rs:918
msgid "Only install apps from sources you trust."
msgstr "Εγκαθιστάτε εφαρμογές μόνο από πηγές που εμπιστεύεστε."

#: appinstaller.rs:924
msgid "Where do you want to install {name}?"
msgstr "Πού θέλετε να εγκαταστήσετε το {name};"

#: appinstaller.rs:929
msgid "Only your account can use the app."
msgstr "Μόνο ο λογαριασμός σας μπορεί να χρησιμοποιεί την εφαρμογή."

#: appinstaller.rs:930
msgid "Needs administrator rights."
msgstr "Απαιτούνται δικαιώματα διαχειριστή."

#: appinstaller.rs:937
msgid "Only for Me"
msgstr "Μόνο για μένα"

#: appinstaller.rs:937
msgid "For All Users of This Computer"
msgstr "Για όλους τους χρήστες αυτού του υπολογιστή"

#: appinstaller.rs:952
msgid "This will take {size} of space on your computer."
msgstr "Θα καταλάβει {size} χώρο στον υπολογιστή σας."

#: appinstaller.rs:954
msgid "The app is downloaded from {source}."
msgstr "Η εφαρμογή λαμβάνεται από {source}."

#: appinstaller.rs:956
msgid "The app is installed for all users of this computer."
msgstr "Η εφαρμογή εγκαθίσταται για όλους τους χρήστες αυτού του υπολογιστή."

#: appinstaller.rs:956
msgid "The app is installed only for you."
msgstr "Η εφαρμογή εγκαθίσταται μόνο για εσάς."

#: appinstaller.rs:959
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "Το AppImage μετακινείται στο {folder} και προστίθεται στις εφαρμογές σας."

#: appinstaller.rs:965
msgid "Keep After MAN Updates"
msgstr "Διατήρηση μετά τις ενημερώσεις του MAN"

#: appinstaller.rs:966
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "Το MAN εγκαθιστά ξανά την εφαρμογή μετά από κάθε ενημέρωση. Γι' αυτό διατηρούνται τα αρχεία του πακέτου της."

#: appinstaller.rs:974
msgid "Click Install to install {name}."
msgstr "Πατήστε Εγκατάσταση για να εγκαταστήσετε το {name}."

#: appinstaller.rs:980
msgid "Checking what else the app needs…"
msgstr "Έλεγχος του τι άλλο χρειάζεται η εφαρμογή…"

#: appinstaller.rs:990
msgid "Also installs the packages it needs: {list}"
msgstr "Εγκαθιστά επίσης τα πακέτα που χρειάζεται: {list}"

#: appinstaller.rs:996
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Κάποια πακέτα που χρειάζεται η εφαρμογή δεν είναι ακόμη διαθέσιμα. Η εγκατάσταση λαμβάνει πρώτα τις νεότερες λίστες πακέτων· αν λείπουν ακόμη, η εφαρμογή δεν μπορεί να εγκατασταθεί."

#: appinstaller.rs:1057
msgid "Installing {name}…"
msgstr "Εγκατάσταση του {name}…"

#: appinstaller.rs:1063
msgid "Preparing…"
msgstr "Προετοιμασία…"

#: appinstaller.rs:1070
msgid "Details"
msgstr "Λεπτομέρειες"

#: appinstaller.rs:1110
msgid "Installing the package…"
msgstr "Εγκατάσταση του πακέτου…"

#: appinstaller.rs:1129
msgid "Moving the app to its folder…"
msgstr "Μετακίνηση της εφαρμογής στον φάκελό της…"

#: appinstaller.rs:1138
msgid "The app could not be installed."
msgstr "Δεν ήταν δυνατή η εγκατάσταση της εφαρμογής."

#: appinstaller.rs:1142
msgid "Installing the app with Flatpak…"
msgstr "Εγκατάσταση της εφαρμογής με Flatpak…"

#: appinstaller.rs:1166
msgid "Log"
msgstr "Αρχείο καταγραφής"

#: appinstaller.rs:1196
msgid "_Close"
msgstr "_Κλείσιμο"

#: appinstaller.rs:1206
msgid "The Installation Was Successful"
msgstr "Η εγκατάσταση ολοκληρώθηκε με επιτυχία"

#: appinstaller.rs:1206
msgid "The app was installed."
msgstr "Η εφαρμογή εγκαταστάθηκε."

#: appinstaller.rs:1211
msgid "The Installation Failed"
msgstr "Η εγκατάσταση απέτυχε"

#: appinstaller.rs:1222
msgid "_Open"
msgstr "Ά_νοιγμα"

#: appinstaller.rs:1232
msgid "_Show Details"
msgstr "_Εμφάνιση λεπτομερειών"

#: appinstaller.rs:1235
msgid "Installation Log"
msgstr "Αρχείο καταγραφής εγκατάστασης"

#: appinstaller.rs:1262
msgid "App Installer"
msgstr "Εγκατάσταση εφαρμογών"

#: appinstaller.rs:1283
msgid "Go _Back"
msgstr "_Πίσω"

#: appinstaller.rs:1356
msgid "Reading the app…"
msgstr "Ανάγνωση της εφαρμογής…"

#: appinstaller.rs:1365
msgid "Install {name}"
msgstr "Εγκατάσταση {name}"

#: appinstaller.rs:1384
msgid "Apps"
msgstr "Εφαρμογές"

#: appinstaller.rs:1390
msgid "Choose an App to Install"
msgstr "Επιλέξτε εφαρμογή για εγκατάσταση"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "Δεν ήταν δυνατή η εκκίνηση του βοηθού συστήματος."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "Δεν ήταν δυνατή η επικοινωνία με τον βοηθό συστήματος."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Χάθηκε η σύνδεση με τον βοηθό συστήματος."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Η εξουσιοδότηση ακυρώθηκε."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Για αυτή την ενέργεια χρειάζονται δικαιώματα διαχειριστή."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "Ο βοηθός συστήματος σταμάτησε απροσδόκητα."

#: installer.rs:89
msgid "No EFI system partition"
msgstr "Δεν υπάρχει διαμέρισμα συστήματος EFI"

#: installer.rs:93
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Μόνο {free} ελεύθερα, το MAN χρειάζεται {need}. Ελευθερώστε χώρο με το DUHACH! στα Windows."

#: installer.rs:94
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Δεν υπάρχει ελεύθερος χώρος. Ανοίξτε το DUHACH! στα Windows για να κάνετε χώρο για το MAN."

#: installer.rs:103
msgid "MAN is running from this disk"
msgstr "Το MAN εκτελείται από αυτόν τον δίσκο"

#: installer.rs:107
msgid "In use: a partition is mounted"
msgstr "Σε χρήση: ένα διαμέρισμα είναι προσαρτημένο"

#: installer.rs:109
msgid "Too small, MAN needs {need}"
msgstr "Πολύ μικρός, το MAN χρειάζεται {need}"

#: installer.rs:119
msgid "Install MAN"
msgstr "Εγκατάσταση του MAN"

#: installer.rs:137
msgid "MAN is being installed. Please wait until it finishes."
msgstr "Το MAN εγκαθίσταται. Περιμένετε να ολοκληρωθεί."

#: installer.rs:154
msgid "Language"
msgstr "Γλώσσα"

#: installer.rs:166
msgid "_Restart in This Language"
msgstr "Επανε_κκίνηση σε αυτή τη γλώσσα"

#: installer.rs:178
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Η ζωντανή συνεδρία επανεκκινείται στη γλώσσα που επιλέξατε και το MAN εγκαθίσταται σε αυτή."

#: installer.rs:224
msgid "Welcome to MAN"
msgstr "Καλώς ήρθατε στο MAN"

#: installer.rs:225
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Ένα γρήγορο, ανοιχτό και πλήρως προσαρμόσιμο σύστημα GNOME.\n"
"Εγκαταστήστε το σε αυτόν τον υπολογιστή ή συνεχίστε να εξερευνάτε τη ζωντανή συνεδρία."

#: installer.rs:229
msgid "_Install MAN…"
msgstr "_Εγκατάσταση του MAN…"

#: installer.rs:231
msgid "_Keep Trying MAN"
msgstr "_Συνέχεια δοκιμής του MAN"

#: installer.rs:234
msgid "Looking for disks…"
msgstr "Αναζήτηση δίσκων…"

#: installer.rs:261
msgid "Welcome"
msgstr "Καλώς ήρθατε"

#: installer.rs:276
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Αυτός ο υπολογιστής ξεκίνησε σε λειτουργία παλαιού BIOS. Το MAN εγκαθίσταται μόνο σε υπολογιστές UEFI: κάντε επανεκκίνηση και επιλέξτε την επιλογή εκκίνησης UEFI."

#: installer.rs:294
msgid "The system helper returned no disk information."
msgstr "Ο βοηθός συστήματος δεν επέστρεψε πληροφορίες δίσκων."

#: installer.rs:372
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:380
msgid "_Next"
msgstr "_Επόμενο"

#: installer.rs:388
msgid "Erase Disk and Install MAN"
msgstr "Διαγραφή δίσκου και εγκατάσταση του MAN"

#: installer.rs:389
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Όλα στον επιλεγμένο δίσκο διαγράφονται, μαζί και τα Windows."

#: installer.rs:389
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Συνιστάται. Όλα στον επιλεγμένο δίσκο διαγράφονται."

#: installer.rs:393
msgid "Install Alongside Windows"
msgstr "Εγκατάσταση δίπλα στα Windows"

#: installer.rs:394
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Συνιστάται. Το MAN χρησιμοποιεί τον ελεύθερο χώρο δίπλα στα Windows· τα Windows και τα αρχεία τους παραμένουν. Επιλέγετε σύστημα σε κάθε εκκίνηση."

#: installer.rs:401
msgid "Reinstall MAN"
msgstr "Επανεγκατάσταση του MAN"

#: installer.rs:402
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Αντικαθιστά το σύστημα αλλά διατηρεί τα προσωπικά αρχεία στο /home. Το τρέχον σύστημα αποθηκεύεται ως στιγμιότυπο."

#: installer.rs:407
msgid "Custom Partitions"
msgstr "Προσαρμοσμένα διαμερίσματα"

#: installer.rs:407
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Για προχωρημένους: επιλέξτε μόνοι σας διαμερίσματα ή δημιουργήστε τα με τους Δίσκους."

#: installer.rs:418
msgid "Erase an External Disk and Install MAN"
msgstr "Διαγραφή εξωτερικού δίσκου και εγκατάσταση του MAN"

#: installer.rs:419
msgid "Everything on the chosen external disk is deleted. The Mac's internal disk is not shown and not changed."
msgstr "Όλα όσα υπάρχουν στον επιλεγμένο εξωτερικό δίσκο διαγράφονται. Ο εσωτερικός δίσκος του Mac δεν εμφανίζεται και δεν αλλάζει."

#: installer.rs:420
msgid "Install on This Mac"
msgstr "Εγκατάσταση σε αυτό το Mac"

#: installer.rs:422
msgid "Recommended. Into the {size} prepared in macOS. macOS and its partitions are not changed."
msgstr "Συνιστάται. Στα {size} που προετοιμάστηκαν στο macOS. Το macOS και οι κατατμήσεις του δεν αλλάζουν."

#: installer.rs:427
msgid "No space for MAN was prepared yet. In macOS, run MAN-Mac/install-man.sh from the MAN USB stick and choose “MAN boot loader + space for MAN”."
msgstr "Δεν έχει προετοιμαστεί ακόμα χώρος για το MAN. Στο macOS, εκτελέστε το MAN-Mac/install-man.sh από το USB stick του MAN και επιλέξτε “MAN boot loader + space for MAN”."

#: installer.rs:433
msgid "Disk"
msgstr "Δίσκος"

#: installer.rs:433
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Επιλέξτε τον δίσκο που θα διαγραφεί. Οι δίσκοι που δεν μπορούν να χρησιμοποιηθούν εμφανίζονται με την αιτία."

#: installer.rs:459
msgid "No disks were found"
msgstr "Δεν βρέθηκαν δίσκοι"

#: installer.rs:466
msgid "Free Space Next to Windows"
msgstr "Ελεύθερος χώρος δίπλα στα Windows"

#: installer.rs:467
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Τα διαμερίσματα των Windows δεν αγγίζονται. Το MAN μοιράζεται το διαμέρισμα συστήματος EFI και προσθέτει τα Windows στο μενού εκκίνησής του."

#: installer.rs:473
msgid "{size} free"
msgstr "{size} ελεύθερα"

#: installer.rs:473
msgid "no free space"
msgstr "χωρίς ελεύθερο χώρο"

#: installer.rs:478
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:497
msgid "Installation to Replace"
msgstr "Εγκατάσταση προς αντικατάσταση"

#: installer.rs:518
msgid "no home folders"
msgstr "χωρίς προσωπικούς φακέλους"

#: installer.rs:520
msgid "home folders: {list}"
msgstr "προσωπικοί φάκελοι: {list}"

#: installer.rs:522
msgid "snapshots: {n}"
msgstr "στιγμιότυπα: {n}"

#: installer.rs:526
msgid "MAN on {model}"
msgstr "MAN στο {model}"

#: installer.rs:540
msgid "Passphrase for {device}"
msgstr "Φράση πρόσβασης για {device}"

#: installer.rs:541
msgid "Unlock"
msgstr "Ξεκλείδωμα"

#: installer.rs:578
msgid "The installation could not be inspected."
msgstr "Δεν ήταν δυνατός ο έλεγχος της εγκατάστασης."

#: installer.rs:595
msgid "Partitions"
msgstr "Διαμερίσματα"

#: installer.rs:596
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Το διαμέρισμα συστήματος διαμορφώνεται σε Btrfs και περιέχει τα @system, @home και @snapshots. Τα διαμερίσματα του δίσκου από τον οποίο εκτελείται το MAN δεν εμφανίζονται."

#: installer.rs:598
msgid "Open Disks to create or resize partitions"
msgstr "Άνοιγμα των Δίσκων για δημιουργία ή αλλαγή μεγέθους διαμερισμάτων"

#: installer.rs:600
msgid "Refresh the partition list"
msgstr "Ανανέωση της λίστας διαμερισμάτων"

#: installer.rs:608
msgid "Choose a partition"
msgstr "Επιλέξτε διαμέρισμα"

#: installer.rs:620
msgid "EFI System Partition"
msgstr "Διαμέρισμα συστήματος EFI"

#: installer.rs:621
msgid "Format EFI System Partition"
msgstr "Διαμόρφωση του διαμερίσματος συστήματος EFI"

#: installer.rs:621
msgid "Leave off to keep boot loaders of other systems"
msgstr "Αφήστε το απενεργοποιημένο για να διατηρηθούν οι φορτωτές εκκίνησης άλλων συστημάτων"

#: installer.rs:623
msgid "System Partition (formatted as Btrfs)"
msgstr "Διαμέρισμα συστήματος (διαμορφώνεται σε Btrfs)"

#: installer.rs:624
msgid "Boot Partition (needed with encryption)"
msgstr "Διαμέρισμα εκκίνησης (απαιτείται με κρυπτογράφηση)"

#: installer.rs:683
msgid "Partition list refreshed"
msgstr "Η λίστα διαμερισμάτων ανανεώθηκε"

#: installer.rs:691
msgid "Security"
msgstr "Ασφάλεια"

#: installer.rs:693
msgid "Encrypt the System"
msgstr "Κρυπτογράφηση του συστήματος"

#: installer.rs:694
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Προστατεύει τα δεδομένα σας αν ο υπολογιστής χαθεί ή κλαπεί. Σε κάθε εκκίνηση ζητείται φράση πρόσβασης."

#: installer.rs:697
msgid "Passphrase"
msgstr "Φράση πρόσβασης"

#: installer.rs:698
msgid "Confirm Passphrase"
msgstr "Επιβεβαίωση φράσης πρόσβασης"

#: installer.rs:700
msgid "Keep this passphrase safe"
msgstr "Φυλάξτε καλά αυτή τη φράση πρόσβασης"

#: installer.rs:701
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Αν χαθεί, κανείς δεν μπορεί να ανακτήσει τα δεδομένα. Ο πυρήνας και τα αρχεία εκκίνησης μένουν σε ένα μικρό μη κρυπτογραφημένο διαμέρισμα εκκίνησης."

#: installer.rs:774
msgid "The passphrase needs at least 8 characters."
msgstr "Η φράση πρόσβασης πρέπει να έχει τουλάχιστον 8 χαρακτήρες."

#: installer.rs:776
msgid "The passphrases do not match."
msgstr "Οι φράσεις πρόσβασης δεν ταιριάζουν."

#: installer.rs:790
msgid "Choose a disk."
msgstr "Επιλέξτε δίσκο."

#: installer.rs:800
msgid "Choose the disk with Windows."
msgstr "Επιλέξτε τον δίσκο με τα Windows."

#: installer.rs:809
msgid "Choose the installation to replace."
msgstr "Επιλέξτε την εγκατάσταση προς αντικατάσταση."

#: installer.rs:810
msgid "Unlock the encrypted installation first."
msgstr "Ξεκλειδώστε πρώτα την κρυπτογραφημένη εγκατάσταση."

#: installer.rs:811
msgid "This partition holds no MAN system."
msgstr "Αυτό το διαμέρισμα δεν περιέχει σύστημα MAN."

#: installer.rs:818
msgid "Choose an EFI system partition."
msgstr "Επιλέξτε διαμέρισμα συστήματος EFI."

#: installer.rs:820
msgid "Choose the system partition."
msgstr "Επιλέξτε το διαμέρισμα συστήματος."

#: installer.rs:822
msgid "The EFI and system partitions must be different."
msgstr "Τα διαμερίσματα EFI και συστήματος πρέπει να είναι διαφορετικά."

#: installer.rs:824
msgid "Encryption needs a separate boot partition."
msgstr "Η κρυπτογράφηση χρειάζεται ξεχωριστό διαμέρισμα εκκίνησης."

#: installer.rs:833
