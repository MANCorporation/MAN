msgstr ""
"Project-Id-Version: man-installer\n"
"Language: el\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: backend.rs:46
msgid "Could not start the system helper."
msgstr "Δεν ήταν δυνατή η εκκίνηση του βοηθού συστήματος."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "Δεν ήταν δυνατή η επικοινωνία με τον βοηθό συστήματος."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "Χάθηκε η σύνδεση με τον βοηθό συστήματος."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "Η εξουσιοδότηση ακυρώθηκε."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "Για αυτή την ενέργεια χρειάζονται δικαιώματα διαχειριστή."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "Ο βοηθός συστήματος σταμάτησε απροσδόκητα."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Δεν υπάρχει διαμέρισμα συστήματος EFI"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Μόνο {free} ελεύθερα, το MAN χρειάζεται {need}. Ελευθερώστε χώρο με το DUHACH! στα Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Δεν υπάρχει ελεύθερος χώρος. Ανοίξτε το DUHACH! στα Windows για να κάνετε χώρο για το MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "Το MAN εκτελείται από αυτόν τον δίσκο"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Σε χρήση: ένα διαμέρισμα είναι προσαρτημένο"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Πολύ μικρός, το MAN χρειάζεται {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Εγκατάσταση του MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "Το MAN εγκαθίσταται. Περιμένετε να ολοκληρωθεί."

#: installer.rs:143
msgid "Language"
msgstr "Γλώσσα"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "Επανε_κκίνηση σε αυτή τη γλώσσα"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Η ζωντανή συνεδρία επανεκκινείται στη γλώσσα που επιλέξατε και το MAN εγκαθίσταται σε αυτή."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Καλώς ήρθατε στο MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Ένα γρήγορο, ανοιχτό και πλήρως προσαρμόσιμο σύστημα GNOME.\n"
"Εγκαταστήστε το σε αυτόν τον υπολογιστή ή συνεχίστε να εξερευνάτε τη ζωντανή συνεδρία."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Εγκατάσταση του MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Συνέχεια δοκιμής του MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Αναζήτηση δίσκων…"

#: installer.rs:250
msgid "Welcome"
msgstr "Καλώς ήρθατε"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Αυτός ο υπολογιστής ξεκίνησε σε λειτουργία παλαιού BIOS. Το MAN εγκαθίσταται μόνο σε υπολογιστές UEFI: κάντε επανεκκίνηση και επιλέξτε την επιλογή εκκίνησης UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Ο βοηθός συστήματος δεν επέστρεψε πληροφορίες δίσκων."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Επόμενο"

#: installer.rs:361
msgid "Installation Type"
msgstr "Τύπος εγκατάστασης"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Διαγραφή δίσκου και εγκατάσταση του MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Όλα στον επιλεγμένο δίσκο διαγράφονται, μαζί και τα Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Συνιστάται. Όλα στον επιλεγμένο δίσκο διαγράφονται."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Εγκατάσταση δίπλα στα Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Συνιστάται. Το MAN χρησιμοποιεί τον ελεύθερο χώρο δίπλα στα Windows· τα Windows και τα αρχεία τους παραμένουν. Επιλέγετε σύστημα σε κάθε εκκίνηση."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Επανεγκατάσταση του MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Αντικαθιστά το σύστημα αλλά διατηρεί τα προσωπικά αρχεία στο /home. Το τρέχον σύστημα αποθηκεύεται ως στιγμιότυπο."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Προσαρμοσμένα διαμερίσματα"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Για προχωρημένους: επιλέξτε μόνοι σας διαμερίσματα ή δημιουργήστε τα με τους Δίσκους."

#: installer.rs:392
msgid "Disk"
msgstr "Δίσκος"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Επιλέξτε τον δίσκο που θα διαγραφεί. Οι δίσκοι που δεν μπορούν να χρησιμοποιηθούν εμφανίζονται με την αιτία."

#: installer.rs:418
msgid "No disks were found"
msgstr "Δεν βρέθηκαν δίσκοι"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Ελεύθερος χώρος δίπλα στα Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Τα διαμερίσματα των Windows δεν αγγίζονται. Το MAN μοιράζεται το διαμέρισμα συστήματος EFI και προσθέτει τα Windows στο μενού εκκίνησής του."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} ελεύθερα"

#: installer.rs:432
msgid "no free space"
msgstr "χωρίς ελεύθερο χώρο"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Εγκατάσταση προς αντικατάσταση"

#: installer.rs:477
msgid "no home folders"
msgstr "χωρίς προσωπικούς φακέλους"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "προσωπικοί φάκελοι: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "στιγμιότυπα: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN στο {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Φράση πρόσβασης για {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Ξεκλείδωμα"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Δεν ήταν δυνατός ο έλεγχος της εγκατάστασης."

#: installer.rs:554
msgid "Partitions"
msgstr "Διαμερίσματα"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Το διαμέρισμα συστήματος διαμορφώνεται σε Btrfs και περιέχει τα @system, @home και @snapshots. Τα διαμερίσματα του δίσκου από τον οποίο εκτελείται το MAN δεν εμφανίζονται."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Άνοιγμα των Δίσκων για δημιουργία ή αλλαγή μεγέθους διαμερισμάτων"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Ανανέωση της λίστας διαμερισμάτων"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Επιλέξτε διαμέρισμα"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "Διαμέρισμα συστήματος EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Διαμόρφωση του διαμερίσματος συστήματος EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Αφήστε το απενεργοποιημένο για να διατηρηθούν οι φορτωτές εκκίνησης άλλων συστημάτων"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Διαμέρισμα συστήματος (διαμορφώνεται σε Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Διαμέρισμα εκκίνησης (απαιτείται με κρυπτογράφηση)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Η λίστα διαμερισμάτων ανανεώθηκε"

#: installer.rs:650
msgid "Security"
msgstr "Ασφάλεια"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Κρυπτογράφηση του συστήματος"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Προστατεύει τα δεδομένα σας αν ο υπολογιστής χαθεί ή κλαπεί. Σε κάθε εκκίνηση ζητείται φράση πρόσβασης."

#: installer.rs:656
msgid "Passphrase"
msgstr "Φράση πρόσβασης"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Επιβεβαίωση φράσης πρόσβασης"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Φυλάξτε καλά αυτή τη φράση πρόσβασης"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Αν χαθεί, κανείς δεν μπορεί να ανακτήσει τα δεδομένα. Ο πυρήνας και τα αρχεία εκκίνησης μένουν σε ένα μικρό μη κρυπτογραφημένο διαμέρισμα εκκίνησης."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Η φράση πρόσβασης πρέπει να έχει τουλάχιστον 8 χαρακτήρες."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Οι φράσεις πρόσβασης δεν ταιριάζουν."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Επιλέξτε δίσκο."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Επιλέξτε τον δίσκο με τα Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Επιλέξτε την εγκατάσταση προς αντικατάσταση."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Ξεκλειδώστε πρώτα την κρυπτογραφημένη εγκατάσταση."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Αυτό το διαμέρισμα δεν περιέχει σύστημα MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Επιλέξτε διαμέρισμα συστήματος EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Επιλέξτε το διαμέρισμα συστήματος."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Τα διαμερίσματα EFI και συστήματος πρέπει να είναι διαφορετικά."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Η κρυπτογράφηση χρειάζεται ξεχωριστό διαμέρισμα εκκίνησης."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Το διαμέρισμα συστήματος πρέπει να είναι τουλάχιστον {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Το διαμέρισμα EFI δεν είναι διαμορφωμένο σε FAT· ενεργοποιήστε τη διαμόρφωση."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Το διαμέρισμα συστήματος είναι προσαρτημένο· αποπροσαρτήστε το πρώτα στους Δίσκους."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Πού θα εγκατασταθεί το MAN;"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Ώρα και πληκτρολόγιο"

#: installer.rs:829
msgid "Time Zone"
msgstr "Ζώνη ώρας"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Διάταξη πληκτρολογίου"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Δοκιμάστε το πληκτρολόγιο"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Πληκτρολογήστε εδώ για να ελέγξετε ότι τα πλήκτρα δίνουν τους σωστούς χαρακτήρες."

#: installer.rs:844
msgid "Type here"
msgstr "Πληκτρολογήστε εδώ"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Ζώνη ώρας και πληκτρολόγιο"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Δεν επιλέχθηκε δίσκος"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Δεν επιλέχθηκε διαμέρισμα συστήματος"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Το διαμέρισμα συστήματος εξαφανίστηκε"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Δεν επιλέχθηκε εγκατάσταση"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Ο δίσκος εξαφανίστηκε"

#: installer.rs:955
msgid "Review"
msgstr "Έλεγχος"

#: installer.rs:958
msgid "Destination"
msgstr "Προορισμός"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Διαγραφή δίσκου και εγκατάσταση"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Προσαρμοσμένα διαμερίσματα"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Επανεγκατάσταση με διατήρηση του /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Δίπλα στα Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (θα διαμορφωθεί)"

#: installer.rs:969
msgid " (kept)"
msgstr " (διατηρείται)"

#: installer.rs:970
msgid "System Partition"
msgstr "Διαμέρισμα συστήματος"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (θα διαμορφωθεί)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Διαμέρισμα εκκίνησης"

#: installer.rs:976
msgid "Installation"
msgstr "Εγκατάσταση"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Χώρος για το MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} ελεύθερου χώρου (δημιουργούνται ένα διαμέρισμα εκκίνησης και το διαμέρισμα συστήματος)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Χωρίς αλλαγές. Εμφανίζονται στο μενού εκκίνησης του MAN· το διαμέρισμα συστήματος EFI είναι κοινό."

#: installer.rs:983
msgid "Encryption"
msgstr "Κρυπτογράφηση"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Ενεργή (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Ανενεργή"

#: installer.rs:985
msgid "File System"
msgstr "Σύστημα αρχείων"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system για το MAN, @home για τα αρχεία σας, @snapshots για σημεία επαναφοράς. Όλα μοιράζονται τον ελεύθερο χώρο."

#: installer.rs:991
msgid "System"
msgstr "Σύστημα"

#: installer.rs:993
msgid "Your Account"
msgstr "Ο λογαριασμός σας"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Δημιουργείται στο MAN Setup την πρώτη φορά που ξεκινά ο υπολογιστής, μαζί με το όνομα υπολογιστή, την εμφάνιση και τις ρυθμίσεις απορρήτου."

#: installer.rs:998
msgid "Keyboard"
msgstr "Πληκτρολόγιο"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "Όλα τα δεδομένα στο {model} ({path}) θα διαγραφούν."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Διαγραφή και εγκατάσταση"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Τα επιλεγμένα διαμερίσματα θα διαμορφωθούν. Τα υπόλοιπα διαμερίσματα δεν αλλάζουν."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "Δια_μόρφωση και εγκατάσταση"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "Το τρέχον σύστημα αντικαθίσταται. Τα αρχεία σας στο /home διατηρούνται και το παλιό σύστημα αποθηκεύεται ως στιγμιότυπο."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "_Επανεγκατάσταση"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "Το MAN εγκαθίσταται στον ελεύθερο χώρο. Τα Windows και τα αρχεία τους δεν αλλάζουν."

#: installer.rs:1005
msgid "_Install"
msgstr "_Εγκατάσταση"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "Έτοιμο για εγκατάσταση"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "Διαγραφή του {model};"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "Όλα τα αρχεία και τα διαμερίσματα στο {path} ({size}) θα διαγραφούν οριστικά. Αυτό δεν αναιρείται."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "Διαγραφή και εγκατάσταση"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "Διαμόρφωση των επιλεγμένων διαμερισμάτων;"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "Όλα τα δεδομένα στα επιλεγμένα διαμερίσματα θα διαγραφούν οριστικά. Τα υπόλοιπα διαμερίσματα δεν αλλάζουν."

#: installer.rs:1037
msgid "Format and Install"
msgstr "Διαμόρφωση και εγκατάσταση"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "Εγκατάσταση του MAN δίπλα στα Windows;"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "Το MAN εγκαθίσταται στα {free} ελεύθερου χώρου του {model} ({path}). Τα Windows και τα αρχεία τους δεν αλλάζουν."

#: installer.rs:1046
msgid "Install"
msgstr "Εγκατάσταση"

#: installer.rs:1050
msgid "Reinstall MAN?"
msgstr "Επανεγκατάσταση του MAN;"

#: installer.rs:1051
msgid "The installed system will be replaced by a fresh copy. Personal files in /home are kept and the old system remains available as a snapshot."
msgstr "Το εγκατεστημένο σύστημα θα αντικατασταθεί από νέο αντίγραφο. Τα προσωπικά αρχεία στο /home διατηρούνται και το παλιό σύστημα παραμένει διαθέσιμο ως στιγμιότυπο."

#: installer.rs:1052
msgid "Reinstall"
msgstr "Επανεγκατάσταση"

#: installer.rs:1057
msgid "_Cancel"
msgstr "_Ακύρωση"

#: installer.rs:1076
msgid "Installing MAN"
msgstr "Εγκατάσταση του MAN"

#: installer.rs:1077
msgid "Starting…"
msgstr "Εκκίνηση…"

#: installer.rs:1085
msgid "Details"
msgstr "Λεπτομέρειες"

#: installer.rs:1090
msgid "Installing"
msgstr "Εγκατάσταση"

#: installer.rs:1103
msgid "Step {index} of {n}  ·  {title}"
msgstr "Βήμα {index} από {n}  ·  {title}"

#: installer.rs:1128
msgid "Log"
msgstr "Αρχείο καταγραφής"

#: installer.rs:1138
msgid "MAN Is Installed"
msgstr "Το MAN εγκαταστάθηκε"

#: installer.rs:1143
msgid "Restart the computer to start using MAN. A menu at every start lets you choose MAN or Windows; the temporary MAN installer partition is removed by MAN on its first start."
msgstr "Κάντε επανεκκίνηση για να αρχίσετε να χρησιμοποιείτε το MAN. Ένα μενού σε κάθε εκκίνηση σάς αφήνει να επιλέξετε MAN ή Windows· το προσωρινό διαμέρισμα του εγκαταστάτη αφαιρείται από το MAN στην πρώτη εκκίνηση."

#: installer.rs:1149
msgid "Restart the computer to start using MAN. You can remove the installation media; if it stays connected, MAN still starts from the new disk."
msgstr "Κάντε επανεκκίνηση για να αρχίσετε να χρησιμοποιείτε το MAN. Μπορείτε να αφαιρέσετε το μέσο εγκατάστασης· αν μείνει συνδεδεμένο, το MAN ξεκινά κανονικά από τον νέο δίσκο."

#: installer.rs:1156
msgid "_Restart Now"
msgstr "Επανεκκίνηση _τώρα"

#: installer.rs:1171
msgid "Done"
msgstr "Ολοκληρώθηκε"

#: installer.rs:1182
msgid "Installation Failed"
msgstr "Η εγκατάσταση απέτυχε"

#: installer.rs:1186
msgid "No other disk was changed, and the installer has released the target disk. You can review the plan and try again."
msgstr "Κανένας άλλος δίσκος δεν άλλαξε και ο εγκαταστάτης αποδέσμευσε τον δίσκο προορισμού. Μπορείτε να ελέγξετε το σχέδιο και να δοκιμάσετε ξανά."

#: installer.rs:1191
msgid "_Review and Try Again"
msgstr "_Έλεγχος και νέα προσπάθεια"

#: installer.rs:1193
msgid "_Show Details"
