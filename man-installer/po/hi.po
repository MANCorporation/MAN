msgid ""
msgstr ""
"Project-Id-Version: man-installer\n"
"Language: hi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: backend.rs:46
msgid "Could not start the system helper."
msgstr "सिस्टम सहायक शुरू नहीं हो सका।"

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "सिस्टम सहायक से संपर्क नहीं हो सका।"

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "सिस्टम सहायक से संपर्क टूट गया।"

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "प्राधिकरण रद्द कर दिया गया।"

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "इस कार्य के लिए व्यवस्थापक अधिकार चाहिए।"

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "सिस्टम सहायक अचानक रुक गया।"

#: installer.rs:78
msgid "No EFI system partition"
msgstr "कोई EFI सिस्टम विभाजन नहीं"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "केवल {free} खाली है, MAN को {need} चाहिए। Windows में DUHACH! से जगह खाली करें।"

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "कोई खाली जगह नहीं। MAN के लिए जगह बनाने हेतु Windows में DUHACH! चलाएँ।"

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN इसी डिस्क से चल रहा है"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "उपयोग में: एक विभाजन माउंट है"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "बहुत छोटा, MAN को {need} चाहिए"

#: installer.rs:108
msgid "Install MAN"
msgstr "MAN स्थापित करें"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN स्थापित हो रहा है। कृपया पूरा होने तक प्रतीक्षा करें।"

#: installer.rs:143
msgid "Language"
msgstr "भाषा"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "इस भाषा में फिर से शुरू करें(_R)"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "लाइव सत्र चुनी गई भाषा में फिर से शुरू होगा, और MAN उसी भाषा में स्थापित होगा।"

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "MAN में आपका स्वागत है"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"एक तेज़, खुला और पूरी तरह अनुकूलन योग्य GNOME सिस्टम।\n"
"इसे इस कंप्यूटर पर स्थापित करें, या लाइव सत्र को आज़माते रहें।"

#: installer.rs:218
msgid "_Install MAN…"
msgstr "MAN स्थापित करें(_I)…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "MAN आज़माते रहें(_K)"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "डिस्क खोजी जा रही हैं…"

#: installer.rs:250
msgid "Welcome"
msgstr "स्वागत है"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "यह कंप्यूटर पुराने BIOS मोड में शुरू हुआ है। MAN केवल UEFI कंप्यूटरों पर स्थापित हो सकता है: फिर से शुरू करें और UEFI बूट विकल्प चुनें।"

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "सिस्टम सहायक ने डिस्क की कोई जानकारी नहीं दी।"

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "आगे(_N)"

#: installer.rs:361
msgid "Installation Type"
msgstr "स्थापना का प्रकार"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "डिस्क मिटाएँ और MAN स्थापित करें"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "चुनी गई डिस्क पर सब कुछ मिटा दिया जाएगा, Windows भी।"

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "अनुशंसित। चुनी गई डिस्क पर सब कुछ मिटा दिया जाएगा।"

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Windows के साथ स्थापित करें"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "अनुशंसित। MAN, Windows के बगल वाली खाली जगह का उपयोग करता है; Windows और उसकी फ़ाइलें बनी रहती हैं। हर बार शुरू करते समय सिस्टम चुनें।"

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "MAN फिर से स्थापित करें"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "सिस्टम बदल देता है पर /home की निजी फ़ाइलें रखता है। मौजूदा सिस्टम स्नैपशॉट के रूप में सहेजा जाता है।"

#: installer.rs:383
msgid "Custom Partitions"
msgstr "कस्टम विभाजन"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "विशेषज्ञों के लिए: विभाजन स्वयं चुनें, या डिस्क ऐप से बनाएँ।"

#: installer.rs:392
msgid "Disk"
msgstr "डिस्क"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "मिटाने के लिए डिस्क चुनें। जिन डिस्क का उपयोग नहीं हो सकता वे कारण सहित दिखती हैं।"

#: installer.rs:418
msgid "No disks were found"
msgstr "कोई डिस्क नहीं मिली"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Windows के बगल में खाली जगह"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows के विभाजनों को नहीं छुआ जाता। MAN, EFI सिस्टम विभाजन साझा करता है और Windows को अपने बूट मेनू में जोड़ता है।"

#: installer.rs:432
msgid "{size} free"
msgstr "{size} खाली"

#: installer.rs:432
msgid "no free space"
msgstr "कोई खाली जगह नहीं"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "बदली जाने वाली स्थापना"

#: installer.rs:477
msgid "no home folders"
msgstr "कोई होम फ़ोल्डर नहीं"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "होम फ़ोल्डर: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "स्नैपशॉट: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "{model} पर MAN"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "{device} के लिए पासफ़्रेज़"

#: installer.rs:500
msgid "Unlock"
msgstr "अनलॉक करें"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "स्थापना की जाँच नहीं हो सकी।"

#: installer.rs:554
msgid "Partitions"
msgstr "विभाजन"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "सिस्टम विभाजन Btrfs में फ़ॉर्मैट होता है और इसमें @system, @home और @snapshots होते हैं। जिस डिस्क से MAN चल रहा है उसके विभाजन सूची में नहीं हैं।"

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "विभाजन बनाने या आकार बदलने के लिए डिस्क खोलें"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "विभाजन सूची ताज़ा करें"

#: installer.rs:567
msgid "Choose a partition"
msgstr "एक विभाजन चुनें"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI सिस्टम विभाजन"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI सिस्टम विभाजन फ़ॉर्मैट करें"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "दूसरे सिस्टमों के बूट लोडर रखने के लिए बंद रहने दें"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "सिस्टम विभाजन (Btrfs में फ़ॉर्मैट होगा)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "बूट विभाजन (एन्क्रिप्शन के लिए आवश्यक)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "विभाजन सूची ताज़ा की गई"

#: installer.rs:650
msgid "Security"
msgstr "सुरक्षा"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "सिस्टम एन्क्रिप्ट करें"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "कंप्यूटर खो जाने या चोरी होने पर आपके डेटा की रक्षा करता है। हर बार शुरू होने पर पासफ़्रेज़ पूछा जाता है।"

#: installer.rs:656
msgid "Passphrase"
msgstr "पासफ़्रेज़"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "पासफ़्रेज़ की पुष्टि करें"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "यह पासफ़्रेज़ सुरक्षित रखें"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "यह खो जाने पर कोई भी डेटा वापस नहीं ला सकता। कर्नेल और बूट फ़ाइलें एक छोटे बिना-एन्क्रिप्टेड बूट विभाजन पर रहती हैं।"

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "पासफ़्रेज़ में कम से कम 8 वर्ण होने चाहिए।"

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "पासफ़्रेज़ मेल नहीं खाते।"

#: installer.rs:748
msgid "Choose a disk."
msgstr "एक डिस्क चुनें।"

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Windows वाली डिस्क चुनें।"

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "बदली जाने वाली स्थापना चुनें।"

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "पहले एन्क्रिप्टेड स्थापना अनलॉक करें।"

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "इस विभाजन में कोई MAN सिस्टम नहीं है।"

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "एक EFI सिस्टम विभाजन चुनें।"

#: installer.rs:778
msgid "Choose the system partition."
msgstr "सिस्टम विभाजन चुनें।"

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI और सिस्टम विभाजन अलग होने चाहिए।"

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "एन्क्रिप्शन के लिए अलग बूट विभाजन चाहिए।"

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "सिस्टम विभाजन कम से कम {size} का होना चाहिए।"

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI विभाजन FAT में फ़ॉर्मैट नहीं है; फ़ॉर्मैट करना चालू करें।"

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "सिस्टम विभाजन माउंट है; पहले उसे डिस्क ऐप में अनमाउंट करें।"

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "MAN कहाँ स्थापित करें?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "समय और कीबोर्ड"

#: installer.rs:829
msgid "Time Zone"
msgstr "समय क्षेत्र"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "कीबोर्ड लेआउट"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "अपना कीबोर्ड जाँचें"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "यहाँ टाइप करके जाँचें कि कुंजियाँ सही अक्षर लिखती हैं।"

#: installer.rs:844
msgid "Type here"
msgstr "यहाँ टाइप करें"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "समय क्षेत्र और कीबोर्ड"

#: installer.rs:920
msgid "No disk chosen"
msgstr "कोई डिस्क नहीं चुनी गई"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "कोई सिस्टम विभाजन नहीं चुना गया"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "सिस्टम विभाजन गायब हो गया"

#: installer.rs:933
msgid "No installation chosen"
msgstr "कोई स्थापना नहीं चुनी गई"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "डिस्क गायब हो गई"

#: installer.rs:955
msgid "Review"
msgstr "समीक्षा"

#: installer.rs:958
msgid "Destination"
msgstr "गंतव्य"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "डिस्क मिटाएँ और स्थापित करें"

#: installer.rs:961
msgid "Custom partitions"
msgstr "कस्टम विभाजन"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "/home रखते हुए फिर से स्थापित करें"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Windows के साथ"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (फ़ॉर्मैट होगा)"

#: installer.rs:969
msgid " (kept)"
msgstr " (रखा जाएगा)"

#: installer.rs:970
msgid "System Partition"
msgstr "सिस्टम विभाजन"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (फ़ॉर्मैट होगा)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "बूट विभाजन"

#: installer.rs:976
msgid "Installation"
msgstr "स्थापना"

#: installer.rs:980
msgid "Space for MAN"
msgstr "MAN के लिए जगह"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} खाली जगह (एक बूट विभाजन और सिस्टम विभाजन बनाए जाएँगे)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "कोई बदलाव नहीं। यह MAN के बूट मेनू में दिखेगा; EFI सिस्टम विभाजन साझा है।"

#: installer.rs:983
msgid "Encryption"
msgstr "एन्क्रिप्शन"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "चालू (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "बंद"

#: installer.rs:985
msgid "File System"
msgstr "फ़ाइल सिस्टम"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: MAN के लिए @system, आपकी फ़ाइलों के लिए @home, पुनर्स्थापना बिंदुओं के लिए @snapshots। सभी खाली जगह साझा करते हैं।"

#: installer.rs:991
msgid "System"
msgstr "सिस्टम"

#: installer.rs:993
msgid "Your Account"
msgstr "आपका खाता"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "कंप्यूटर के पहली बार शुरू होने पर MAN Setup में, कंप्यूटर के नाम, रूप और गोपनीयता सेटिंग्स के साथ बनाया जाता है।"

#: installer.rs:998
msgid "Keyboard"
msgstr "कीबोर्ड"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "{model} ({path}) का सारा डेटा मिटा दिया जाएगा।"

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "मिटाएँ और स्थापित करें(_E)"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "चुने गए विभाजन फ़ॉर्मैट होंगे। दूसरे विभाजन नहीं बदलेंगे।"

#: installer.rs:1003
msgid "_Format and Install"
msgstr "फ़ॉर्मैट करें और स्थापित करें(_F)"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "मौजूदा सिस्टम बदल दिया जाएगा। /home की आपकी फ़ाइलें रहेंगी, और पुराना सिस्टम स्नैपशॉट के रूप में सहेजा जाएगा।"

#: installer.rs:1004
msgid "_Reinstall"
msgstr "फिर से स्थापित करें(_R)"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN खाली जगह में स्थापित होगा। Windows और उसकी फ़ाइलें नहीं बदलेंगी।"

#: installer.rs:1005
msgid "_Install"
msgstr "स्थापित करें(_I)"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "स्थापना के लिए तैयार"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "{model} मिटाएँ?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "{path} ({size}) की सभी फ़ाइलें और विभाजन स्थायी रूप से हट जाएँगे। इसे पूर्ववत नहीं किया जा सकता।"

#: installer.rs:1031
msgid "Erase and Install"
msgstr "मिटाएँ और स्थापित करें"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "चुने गए विभाजन फ़ॉर्मैट करें?"

#: installer.rs:1036
