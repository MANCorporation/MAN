#: install.rs:85
msgid "The installer backend must run as root."
msgstr "इंस्टॉलर सहायक को root के रूप में चलना चाहिए।"

#: install.rs:88
msgid "This computer was not started in UEFI mode. MAN requires UEFI."
msgstr "यह कंप्यूटर UEFI मोड में शुरू नहीं हुआ। MAN को UEFI चाहिए।"

#: install.rs:92
msgid "The username is not valid."
msgstr "उपयोगकर्ता नाम मान्य नहीं है।"

#: install.rs:95
msgid "A password is required."
msgstr "पासवर्ड आवश्यक है।"

#: install.rs:99
msgid "The computer name is not valid."
msgstr "कंप्यूटर का नाम मान्य नहीं है।"

#: install.rs:105
msgid "Unknown language."
msgstr "अज्ञात भाषा।"

#: install.rs:111
msgid "The encryption passphrase must have at least 8 characters."
msgstr "एन्क्रिप्शन पासफ़्रेज़ में कम से कम 8 वर्ण होने चाहिए।"

#: install.rs:122
msgid "The disk changed after you confirmed the installation. Nothing was modified; please review and confirm again."
msgstr "आपके स्थापना की पुष्टि करने के बाद डिस्क बदल गई। कुछ भी नहीं बदला गया; कृपया समीक्षा करके फिर से पुष्टि करें।"

#: install.rs:138
msgid "Choose a system partition."
msgstr "एक सिस्टम विभाजन चुनें।"

#: install.rs:145
msgid "The confirmed disk does not hold the chosen system partition."
msgstr "पुष्टि की गई डिस्क में चुना गया सिस्टम विभाजन नहीं है।"

#: install.rs:157
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "बूट विभाजन EFI और सिस्टम विभाजनों से अलग होना चाहिए।"

#: install.rs:160
msgid "The boot partition must be at least 512 MB."
msgstr "बूट विभाजन कम से कम 512 MB का होना चाहिए।"

#: install.rs:175
msgid "No installation chosen."
msgstr "कोई स्थापना नहीं चुनी गई।"

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "पुष्टि की गई डिस्क में चुनी गई स्थापना नहीं है।"

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "एन्क्रिप्टेड स्थापना में MAN_BOOT विभाजन नहीं है।"

#: install.rs:695
msgid "No kernel with matching modules was found in /boot."
msgstr "/boot में मेल खाते मॉड्यूल वाला कोई कर्नेल नहीं मिला।"

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "भाषा सिस्टम सहायक द्वारा बदली जानी चाहिए।"

#: oobe.rs:204
msgid "Applying your settings"
msgstr "आपकी सेटिंग्स लागू हो रही हैं"

#: oobe.rs:212
msgid "Preparing disk encryption"
msgstr "डिस्क एन्क्रिप्शन तैयार हो रहा है"

#: oobe.rs:216
msgid "Finishing"
msgstr "पूरा किया जा रहा है"

#: oobe.rs:100
msgid "MAN Setup must be finished by the system helper."
msgstr "MAN Setup सिस्टम सहायक द्वारा पूरा होना चाहिए।"

#: oobe.rs:103
msgid "MAN Setup has already been completed on this computer."
msgstr "इस कंप्यूटर पर MAN Setup पहले ही पूरा हो चुका है।"

#: oobe.rs:124
msgid "Unknown accent color."
msgstr "अज्ञात एक्सेंट रंग।"

#: oobe.rs:128
msgid "The chosen wallpaper is not available."
msgstr "चुना गया वॉलपेपर उपलब्ध नहीं है।"

#: oobe.rs:146
msgid "This system cannot be encrypted."
msgstr "यह सिस्टम एन्क्रिप्ट नहीं किया जा सकता।"

#: oobe.rs:257
msgid "The setup key is missing, so encryption cannot continue in the background."
msgstr "सेटअप कुंजी गायब है, इसलिए एन्क्रिप्शन पृष्ठभूमि में जारी नहीं रह सकता।"

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "सिस्टम Btrfs पर स्थापित नहीं है, इसलिए स्नैपशॉट उपलब्ध नहीं हैं।"

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "एक स्नैपशॉट पुनर्स्थापना फिर से शुरू होने की प्रतीक्षा में है। पूरा करने के लिए पहले कंप्यूटर फिर से शुरू करें।"

#: snapshots.rs:99
msgid "Invalid snapshot id."
msgstr "अमान्य स्नैपशॉट ID।"

#: update.rs:32
msgid "Checking the update"
msgstr "अद्यतन जाँचा जा रहा है"

#: update.rs:32
msgid "Creating a snapshot"
msgstr "स्नैपशॉट बनाया जा रहा है"

#: update.rs:32
msgid "Preparing the update area"
msgstr "अद्यतन क्षेत्र तैयार हो रहा है"

#: update.rs:32
msgid "Unpacking the new system"
msgstr "नया सिस्टम खोला जा रहा है"

#: update.rs:32
msgid "Moving your accounts and settings"
msgstr "आपके खाते और सेटिंग्स ले जाए जा रहे हैं"

#: update.rs:32
msgid "Preparing the restart"
msgstr "फिर से शुरू करने की तैयारी"

#: update.rs:179
msgid "Unpacked"
msgstr "खोला गया"

#: update.rs:261
msgid "Accounts"
msgstr "खाते"

#: update.rs:301
msgid "Removing installer-only software"
msgstr "केवल इंस्टॉलर का सॉफ़्टवेयर हटाया जा रहा है"

#: update.rs:340
msgid "Building the update boot image"
msgstr "अद्यतन की बूट इमेज बनाई जा रही है"

#: update.rs:343
msgid "Adding the one-time boot entry"
msgstr "एक बार की बूट प्रविष्टि जोड़ी जा रही है"

#: update.rs:377
msgid "The update is genuine"
msgstr "अद्यतन असली है"

#: update.rs:383
msgid "Snapshot created"
msgstr "स्नैपशॉट बनाया गया"

#: update.rs:385
msgid "Skipped"
msgstr "छोड़ा गया"

#: update.rs:394
msgid "Update area ready"
msgstr "अद्यतन क्षेत्र तैयार"

#: update.rs:410
msgid "Preparing the new system"
msgstr "नया सिस्टम तैयार हो रहा है"

#: update.rs:168
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "अद्यतन फ़ाइल क्षतिग्रस्त है (चेकसम मेल नहीं खाता)। इसे फिर से डाउनलोड करें।"

#: update.rs:171
msgid "The update file could not be read completely."
msgstr "अद्यतन फ़ाइल पूरी तरह पढ़ी नहीं जा सकी।"

#: update.rs:312
msgid "The update contains no kernel."
msgstr "अद्यतन में कोई कर्नेल नहीं है।"

#: update.rs:360
msgid "Updates must be installed by the system helper."
msgstr "अद्यतन सिस्टम सहायक द्वारा स्थापित होने चाहिए।"

#: update.rs:369
msgid "The chosen installation was not found."
msgstr "चुनी गई स्थापना नहीं मिली।"

#: update.rs:371
msgid "Only the running MAN installation can be updated."
msgstr "केवल चल रही MAN स्थापना अद्यतन की जा सकती है।"

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "यह MAN अद्यतन फ़ाइल नहीं है (कोई मैनिफ़ेस्ट नहीं)।"

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "अद्यतन पर हस्ताक्षर नहीं हैं, इसलिए इस पर भरोसा नहीं किया जा सकता।"

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "अद्यतन का हस्ताक्षर क्षतिग्रस्त है।"

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "अद्यतन पर MAN के हस्ताक्षर नहीं हैं। यह बदला गया हो सकता है या किसी अविश्वसनीय स्रोत से आया हो सकता है।"

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "अद्यतन का मैनिफ़ेस्ट अमान्य है।"

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "पासफ़्रेज़ सही नहीं है, या एन्क्रिप्टेड विभाजन नहीं खुल सकता।"

