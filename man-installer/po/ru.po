#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Этот файл не является приложением, которое можно здесь установить (.deb, .flatpak, .flatpakref или AppImage)."

#: appinstaller.rs:128
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Это приложение создано для компьютеров {arch} и не работает на этом (x86-64)."

#: appinstaller.rs:313
msgid "The file could not be read. It may be damaged."
msgstr "Не удалось прочитать файл. Возможно, он повреждён."

#: appinstaller.rs:485
msgid "This is not an AppImage."
msgstr "Это не AppImage."

#: appinstaller.rs:679
msgid "Introduction"
msgstr "Введение"

#: appinstaller.rs:680
msgid "License"
msgstr "Лицензия"

#: appinstaller.rs:681
msgid "Destination Select"
msgstr "Выбор места"

#: appinstaller.rs:682
msgid "Installation Type"
msgstr "Тип установки"

#: appinstaller.rs:683
msgid "Installation"
msgstr "Установка"

#: appinstaller.rs:684
msgid "Summary"
msgstr "Сводка"

#: appinstaller.rs:790
msgid "_Continue"
msgstr "_Продолжить"

#: appinstaller.rs:799
msgid "Welcome to the {name} Installer"
msgstr "Добро пожаловать в установщик {name}"

#: appinstaller.rs:803
msgid "Software License Agreement"
msgstr "Лицензионное соглашение"

#: appinstaller.rs:813
msgid "Do You Agree to the License?"
msgstr "Вы принимаете лицензию?"

#: appinstaller.rs:814
msgid "To continue installing, you must agree to the terms of the software license agreement."
msgstr "Чтобы продолжить установку, нужно принять условия лицензионного соглашения."

#: appinstaller.rs:816
msgid "_Read License"
msgstr "_Читать лицензию"

#: appinstaller.rs:817
msgid "_Agree"
msgstr "_Принимаю"

#: appinstaller.rs:830
msgid "Select a Destination"
msgstr "Выберите место"

#: appinstaller.rs:834
msgid "Standard Install"
msgstr "Обычная установка"

#: appinstaller.rs:835
msgid "_Install"
msgstr "_Установить"

#: appinstaller.rs:848
msgid "Debian package (.deb)"
msgstr "Пакет Debian (.deb)"

#: appinstaller.rs:849
msgid "Flatpak app"
msgstr "Приложение Flatpak"

#: appinstaller.rs:850
msgid "Flatpak app from {source}"
msgstr "Приложение Flatpak из {source}"

#: appinstaller.rs:851
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:869
msgid "You will be guided through the steps necessary to install this software."
msgstr "Вы пройдёте все шаги, необходимые для установки этой программы."

#: appinstaller.rs:880
msgid "Version"
msgstr "Версия"

#: appinstaller.rs:883
msgid "Publisher"
msgstr "Издатель"

#: appinstaller.rs:885
msgid "Type"
msgstr "Тип"

#: appinstaller.rs:887
msgid "Size"
msgstr "Размер"

#: appinstaller.rs:893
msgid "Website"
msgstr "Веб-сайт"

#: appinstaller.rs:895
msgid "File"
msgstr "Файл"

#: appinstaller.rs:905
msgid "This app is installed already. Installing it again replaces it."
msgstr "Это приложение уже установлено. Повторная установка заменит его."

#: appinstaller.rs:908
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr "Приложения из пакетов .deb становятся частью системы. Обновление MAN заменяет систему, поэтому после обновления они устанавливаются снова, только если вы их сохраняете (следующие шаги)."

#: appinstaller.rs:911
msgid "Only install apps from sources you trust."
msgstr "Устанавливайте приложения только из надёжных источников."

#: appinstaller.rs:917
msgid "Where do you want to install {name}?"
msgstr "Куда установить {name}?"

#: appinstaller.rs:922
msgid "Only your account can use the app."
msgstr "Пользоваться приложением сможет только ваша учётная запись."

#: appinstaller.rs:923
msgid "Needs administrator rights."
msgstr "Нужны права администратора."

#: appinstaller.rs:930
msgid "Only for Me"
msgstr "Только для меня"

#: appinstaller.rs:930
msgid "For All Users of This Computer"
msgstr "Для всех пользователей этого компьютера"

#: appinstaller.rs:945
msgid "This will take {size} of space on your computer."
msgstr "Займёт {size} места на компьютере."

#: appinstaller.rs:947
msgid "The app is downloaded from {source}."
msgstr "Приложение загружается из {source}."

#: appinstaller.rs:949
msgid "The app is installed for all users of this computer."
msgstr "Приложение устанавливается для всех пользователей этого компьютера."

#: appinstaller.rs:949
msgid "The app is installed only for you."
msgstr "Приложение устанавливается только для вас."

#: appinstaller.rs:952
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage перемещается в {folder} и добавляется к вашим приложениям."

#: appinstaller.rs:958
msgid "Keep After MAN Updates"
msgstr "Сохранять после обновлений MAN"

#: appinstaller.rs:959
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "MAN заново устанавливает приложение после каждого обновления. Для этого хранятся файлы его пакета."

#: appinstaller.rs:967
msgid "Click Install to install {name}."
msgstr "Нажмите «Установить», чтобы установить {name}."

#: appinstaller.rs:973
msgid "Checking what else the app needs…"
msgstr "Проверка, что ещё нужно приложению…"

#: appinstaller.rs:983
msgid "Also installs the packages it needs: {list}"
msgstr "Также будут установлены нужные пакеты: {list}"

#: appinstaller.rs:989
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Некоторые нужные приложению пакеты пока недоступны. Установка сначала получит свежие списки пакетов; если их по-прежнему не будет, приложение установить нельзя."

#: appinstaller.rs:1050
msgid "Installing {name}…"
msgstr "Установка {name}…"

#: appinstaller.rs:1056
msgid "Preparing…"
msgstr "Подготовка…"

#: appinstaller.rs:1063
msgid "Details"
msgstr "Подробности"

#: appinstaller.rs:1103
msgid "Installing the package…"
msgstr "Установка пакета…"

#: appinstaller.rs:1122
msgid "Moving the app to its folder…"
msgstr "Перемещение приложения в его папку…"

#: appinstaller.rs:1131
msgid "The app could not be installed."
msgstr "Не удалось установить приложение."

#: appinstaller.rs:1135
msgid "Installing the app with Flatpak…"
msgstr "Установка приложения через Flatpak…"

#: appinstaller.rs:1159
msgid "Log"
msgstr "Журнал"

#: appinstaller.rs:1189
msgid "_Close"
msgstr "_Закрыть"

#: appinstaller.rs:1199
msgid "The Installation Was Successful"
msgstr "Установка выполнена успешно"

#: appinstaller.rs:1199
msgid "The app was installed."
msgstr "Приложение установлено."

#: appinstaller.rs:1204
msgid "The Installation Failed"
msgstr "Установка не удалась"

#: appinstaller.rs:1215
msgid "_Open"
msgstr "_Открыть"

#: appinstaller.rs:1225
msgid "_Show Details"
msgstr "_Показать подробности"

#: appinstaller.rs:1228
msgid "Installation Log"
msgstr "Журнал установки"

#: appinstaller.rs:1255
msgid "App Installer"
msgstr "Установщик приложений"

#: appinstaller.rs:1276
msgid "Go _Back"
msgstr "_Назад"

#: appinstaller.rs:1349
msgid "Reading the app…"
msgstr "Чтение приложения…"

#: appinstaller.rs:1358
msgid "Install {name}"
msgstr "Установить {name}"

#: appinstaller.rs:1377
msgid "Apps"
msgstr "Приложения"

#: appinstaller.rs:1383
msgid "Choose an App to Install"
msgstr "Выберите приложение для установки"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "Не удалось запустить системного помощника."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "Не удалось связаться с системным помощником."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Связь с системным помощником потеряна."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Авторизация отменена."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Для этого действия нужны права администратора."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "Системный помощник неожиданно завершил работу."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Нет системного раздела EFI"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Свободно только {free}, MAN нужно {need}. Освободите место с помощью DUHACH! в Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Нет свободного места. Запустите DUHACH! в Windows, чтобы освободить место для MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN работает с этого диска"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Используется: раздел смонтирован"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Слишком мал, MAN нужно {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Установить MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN устанавливается. Дождитесь завершения."

#: installer.rs:143
msgid "Language"
msgstr "Язык"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Перезапустить на этом языке"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Живой сеанс перезапустится на выбранном языке, и MAN будет установлен на нём."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Добро пожаловать в MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Быстрая, открытая и полностью настраиваемая система GNOME.\n"
"Установите её на этот компьютер или продолжайте знакомство с живым сеансом."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Установить MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Продолжить пробовать MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Поиск дисков…"

#: installer.rs:250
msgid "Welcome"
msgstr "Добро пожаловать"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Этот компьютер запущен в режиме legacy BIOS. MAN можно установить только на компьютеры с UEFI: перезагрузитесь и выберите вариант загрузки UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Системный помощник не вернул сведений о дисках."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Далее"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Стереть диск и установить MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Всё на выбранном диске будет удалено, включая Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Рекомендуется. Всё на выбранном диске будет удалено."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Установить рядом с Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Рекомендуется. MAN использует свободное место рядом с Windows; Windows и его файлы останутся. Систему вы выбираете при каждом запуске."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Переустановить MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Заменяет систему, но сохраняет личные файлы в /home. Текущая система сохраняется как снимок."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Свои разделы"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Для опытных: выберите разделы сами или создайте их в «Дисках»."

#: installer.rs:392
msgid "Disk"
msgstr "Диск"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Выберите диск для стирания. Непригодные диски показаны с указанием причины."

#: installer.rs:418
msgid "No disks were found"
msgstr "Диски не найдены"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Свободное место рядом с Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Разделы Windows не затрагиваются. MAN использует общий системный раздел EFI и добавляет Windows в своё меню загрузки."

#: installer.rs:432
msgid "{size} free"
msgstr "свободно {size}"

#: installer.rs:432
msgid "no free space"
msgstr "нет свободного места"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Установка для замены"

#: installer.rs:477
msgid "no home folders"
msgstr "нет домашних папок"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "домашние папки: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "снимков: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN на {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Парольная фраза для {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Разблокировать"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Не удалось проверить установку."

#: installer.rs:554
msgid "Partitions"
msgstr "Разделы"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Системный раздел форматируется в Btrfs и содержит @system, @home и @snapshots. Разделы диска, с которого работает MAN, не показаны."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Открыть «Диски», чтобы создать разделы или изменить их размер"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Обновить список разделов"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Выберите раздел"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "Системный раздел EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Форматировать системный раздел EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Оставьте выключенным, чтобы сохранить загрузчики других систем"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Системный раздел (форматируется в Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Загрузочный раздел (нужен для шифрования)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Список разделов обновлён"

#: installer.rs:650
msgid "Security"
msgstr "Безопасность"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Зашифровать систему"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Защищает ваши данные при потере или краже компьютера. Парольная фраза запрашивается при каждом запуске."

#: installer.rs:656
msgid "Passphrase"
msgstr "Парольная фраза"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Подтверждение парольной фразы"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Храните эту парольную фразу в надёжном месте"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Если её потерять, данные никто не сможет восстановить. Ядро и файлы загрузки остаются на небольшом незашифрованном загрузочном разделе."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Парольная фраза должна содержать не менее 8 символов."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Парольные фразы не совпадают."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Выберите диск."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Выберите диск с Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Выберите установку для замены."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Сначала разблокируйте зашифрованную установку."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Этот раздел не содержит системы MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Выберите системный раздел EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Выберите системный раздел."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Раздел EFI и системный раздел должны быть разными."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Для шифрования нужен отдельный загрузочный раздел."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Системный раздел должен быть не меньше {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Раздел EFI не отформатирован в FAT; включите форматирование."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Системный раздел смонтирован; сначала отмонтируйте его в «Дисках»."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Куда установить MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Время и клавиатура"

#: installer.rs:829
msgid "Time Zone"
msgstr "Часовой пояс"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Раскладка клавиатуры"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Проверьте клавиатуру"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Печатайте здесь, чтобы убедиться, что клавиши вводят правильные символы."

#: installer.rs:844
msgid "Type here"
msgstr "Печатайте здесь"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Часовой пояс и клавиатура"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Диск не выбран"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Системный раздел не выбран"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Системный раздел исчез"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Установка не выбрана"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Диск исчез"

#: installer.rs:955
msgid "Review"
msgstr "Проверка"

#: installer.rs:958
msgid "Destination"
msgstr "Назначение"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Стереть диск и установить"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Свои разделы"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Переустановить, сохранив /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Рядом с Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (будет отформатирован)"

#: installer.rs:969
msgid " (kept)"
msgstr " (сохраняется)"

#: installer.rs:970
msgid "System Partition"
msgstr "Системный раздел"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (будет отформатирован)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Загрузочный раздел"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Место для MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} свободного места (создаются загрузочный и системный разделы)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Без изменений. Появится в меню загрузки MAN; системный раздел EFI общий."

#: installer.rs:983
msgid "Encryption"
msgstr "Шифрование"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Включено (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Выключено"

#: installer.rs:985
msgid "File System"
msgstr "Файловая система"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system для MAN, @home для ваших файлов, @snapshots для точек восстановления. Все используют общее свободное место."

#: installer.rs:991
msgid "System"
msgstr "Система"

#: installer.rs:993
msgid "Your Account"
msgstr "Ваша учётная запись"

