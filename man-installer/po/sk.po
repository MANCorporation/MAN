#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Tento súbor nie je aplikácia, ktorú tu možno nainštalovať (.deb, .flatpak, .flatpakref alebo AppImage)."

#: appinstaller.rs:128
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Táto aplikácia je určená pre počítače {arch} a na tomto počítači (x86-64) nefunguje."

#: appinstaller.rs:313
msgid "The file could not be read. It may be damaged."
msgstr "Súbor sa nedá prečítať. Môže byť poškodený."

#: appinstaller.rs:485
msgid "This is not an AppImage."
msgstr "Toto nie je AppImage."

#: appinstaller.rs:679
msgid "Introduction"
msgstr "Úvod"

#: appinstaller.rs:680
msgid "License"
msgstr "Licencia"

#: appinstaller.rs:681
msgid "Destination Select"
msgstr "Výber umiestnenia"

#: appinstaller.rs:682
msgid "Installation Type"
msgstr "Typ inštalácie"

#: appinstaller.rs:683
msgid "Installation"
msgstr "Inštalácia"

#: appinstaller.rs:684
msgid "Summary"
msgstr "Súhrn"

#: appinstaller.rs:790
msgid "_Continue"
msgstr "_Pokračovať"

#: appinstaller.rs:799
msgid "Welcome to the {name} Installer"
msgstr "Vitajte v inštalátore aplikácie {name}"

#: appinstaller.rs:803
msgid "Software License Agreement"
msgstr "Licenčná zmluva k softvéru"

#: appinstaller.rs:813
msgid "Do You Agree to the License?"
msgstr "Súhlasíte s licenciou?"

#: appinstaller.rs:814
msgid "To continue installing, you must agree to the terms of the software license agreement."
msgstr "Ak chcete pokračovať v inštalácii, musíte súhlasiť s podmienkami licenčnej zmluvy k softvéru."

#: appinstaller.rs:816
msgid "_Read License"
msgstr "_Čítať licenciu"

#: appinstaller.rs:817
msgid "_Agree"
msgstr "_Súhlasím"

#: appinstaller.rs:830
msgid "Select a Destination"
msgstr "Vyberte umiestnenie"

#: appinstaller.rs:834
msgid "Standard Install"
msgstr "Štandardná inštalácia"

#: appinstaller.rs:835
msgid "_Install"
msgstr "_Inštalovať"

#: appinstaller.rs:848
msgid "Debian package (.deb)"
msgstr "Balík Debianu (.deb)"

#: appinstaller.rs:849
msgid "Flatpak app"
msgstr "Aplikácia Flatpak"

#: appinstaller.rs:850
msgid "Flatpak app from {source}"
msgstr "Aplikácia Flatpak z {source}"

#: appinstaller.rs:851
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:869
msgid "You will be guided through the steps necessary to install this software."
msgstr "Prevedieme vás krokmi potrebnými na inštaláciu tohto softvéru."

#: appinstaller.rs:880
msgid "Version"
msgstr "Verzia"

#: appinstaller.rs:883
msgid "Publisher"
msgstr "Vydavateľ"

#: appinstaller.rs:885
msgid "Type"
msgstr "Typ"

#: appinstaller.rs:887
msgid "Size"
msgstr "Veľkosť"

#: appinstaller.rs:893
msgid "Website"
msgstr "Webová stránka"

#: appinstaller.rs:895
msgid "File"
msgstr "Súbor"

#: appinstaller.rs:905
msgid "This app is installed already. Installing it again replaces it."
msgstr "Táto aplikácia je už nainštalovaná. Nová inštalácia ju nahradí."

#: appinstaller.rs:908
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr "Aplikácie z balíkov .deb sa stávajú súčasťou systému. Aktualizácia MAN systém nahradí, takže sa po nej znova nainštalujú len tie, ktoré zachováte (ďalšie kroky)."

#: appinstaller.rs:911
msgid "Only install apps from sources you trust."
msgstr "Inštalujte len aplikácie zo zdrojov, ktorým dôverujete."

#: appinstaller.rs:917
msgid "Where do you want to install {name}?"
msgstr "Kam chcete aplikáciu {name} nainštalovať?"

#: appinstaller.rs:922
msgid "Only your account can use the app."
msgstr "Aplikáciu môže používať len váš účet."

#: appinstaller.rs:923
msgid "Needs administrator rights."
msgstr "Vyžaduje oprávnenia správcu."

#: appinstaller.rs:930
msgid "Only for Me"
msgstr "Len pre mňa"

#: appinstaller.rs:930
msgid "For All Users of This Computer"
msgstr "Pre všetkých používateľov tohto počítača"

#: appinstaller.rs:945
msgid "This will take {size} of space on your computer."
msgstr "Zaberie to {size} miesta v počítači."

#: appinstaller.rs:947
msgid "The app is downloaded from {source}."
msgstr "Aplikácia sa stiahne z {source}."

#: appinstaller.rs:949
msgid "The app is installed for all users of this computer."
msgstr "Aplikácia sa nainštaluje pre všetkých používateľov tohto počítača."

#: appinstaller.rs:949
msgid "The app is installed only for you."
msgstr "Aplikácia sa nainštaluje len pre vás."

#: appinstaller.rs:952
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage sa presunie do {folder} a pridá sa medzi vaše aplikácie."

#: appinstaller.rs:958
msgid "Keep After MAN Updates"
msgstr "Zachovať po aktualizáciách MAN"

#: appinstaller.rs:959
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "MAN aplikáciu po každej aktualizácii znova nainštaluje. Na to sa uchovajú súbory jej balíka."

#: appinstaller.rs:967
msgid "Click Install to install {name}."
msgstr "Kliknutím na Inštalovať nainštalujete aplikáciu {name}."

#: appinstaller.rs:973
msgid "Checking what else the app needs…"
msgstr "Zisťuje sa, čo ďalšie aplikácia potrebuje…"

#: appinstaller.rs:983
msgid "Also installs the packages it needs: {list}"
msgstr "Nainštalujú sa aj balíky, ktoré potrebuje: {list}"

#: appinstaller.rs:989
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Niektoré balíky, ktoré aplikácia potrebuje, zatiaľ nie sú dostupné. Inštalácia najprv získa najnovšie zoznamy balíkov; ak budú stále chýbať, aplikáciu nemožno nainštalovať."

#: appinstaller.rs:1050
msgid "Installing {name}…"
msgstr "Inštaluje sa {name}…"

#: appinstaller.rs:1056
msgid "Preparing…"
msgstr "Pripravuje sa…"

#: appinstaller.rs:1063
msgid "Details"
msgstr "Podrobnosti"

#: appinstaller.rs:1103
msgid "Installing the package…"
msgstr "Inštaluje sa balík…"

#: appinstaller.rs:1122
msgid "Moving the app to its folder…"
msgstr "Aplikácia sa presúva do svojho priečinka…"

#: appinstaller.rs:1131
msgid "The app could not be installed."
msgstr "Aplikáciu nemožno nainštalovať."

#: appinstaller.rs:1135
msgid "Installing the app with Flatpak…"
msgstr "Aplikácia sa inštaluje pomocou Flatpaku…"

#: appinstaller.rs:1159
msgid "Log"
msgstr "Záznam"

#: appinstaller.rs:1189
msgid "_Close"
msgstr "_Zavrieť"

#: appinstaller.rs:1199
msgid "The Installation Was Successful"
msgstr "Inštalácia bola úspešná"

#: appinstaller.rs:1199
msgid "The app was installed."
msgstr "Aplikácia bola nainštalovaná."

#: appinstaller.rs:1204
msgid "The Installation Failed"
msgstr "Inštalácia zlyhala"

#: appinstaller.rs:1215
msgid "_Open"
msgstr "_Otvoriť"

#: appinstaller.rs:1225
msgid "_Show Details"
msgstr "_Zobraziť podrobnosti"

#: appinstaller.rs:1228
msgid "Installation Log"
msgstr "Záznam inštalácie"

#: appinstaller.rs:1255
msgid "App Installer"
msgstr "Inštalátor aplikácií"

#: appinstaller.rs:1276
msgid "Go _Back"
msgstr "_Späť"

#: appinstaller.rs:1349
msgid "Reading the app…"
msgstr "Načítava sa aplikácia…"

#: appinstaller.rs:1358
msgid "Install {name}"
msgstr "Inštalovať {name}"

#: appinstaller.rs:1377
msgid "Apps"
msgstr "Aplikácie"

#: appinstaller.rs:1383
msgid "Choose an App to Install"
msgstr "Vyberte aplikáciu na inštaláciu"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "Systémového pomocníka nemožno spustiť."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "So systémovým pomocníkom nemožno komunikovať."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Spojenie so systémovým pomocníkom sa stratilo."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Overenie bolo zrušené."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Na túto akciu sú potrebné práva správcu."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "Systémový pomocník sa neočakávane ukončil."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Chýba systémový oddiel EFI"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Voľné je len {free}, MAN potrebuje {need}. Uvoľnite miesto pomocou DUHACH! vo Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Žiadne voľné miesto. Spustite vo Windows DUHACH! a uvoľnite miesto pre MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "Z tohto disku práve beží MAN"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Používa sa: oddiel je pripojený"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Príliš malý, MAN potrebuje {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Inštalovať MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN sa inštaluje. Počkajte, prosím, na dokončenie."

#: installer.rs:143
msgid "Language"
msgstr "Jazyk"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Reštartovať v tomto jazyku"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Živá relácia sa reštartuje vo zvolenom jazyku a MAN sa v ňom aj nainštaluje."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Vitajte v MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Rýchly, otvorený a plne prispôsobiteľný systém GNOME.\n"
"Nainštalujte ho do tohto počítača alebo pokračujte v skúšaní živej relácie."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Inštalovať MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Ďalej skúšať MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Hľadajú sa disky…"

#: installer.rs:250
msgid "Welcome"
msgstr "Vitajte"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Tento počítač bol spustený v režime legacy BIOS. MAN možno nainštalovať len na počítače s UEFI: reštartujte a zvoľte možnosť spustenia UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Systémový pomocník nevrátil žiadne informácie o diskoch."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "Ď_alej"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Vymazať disk a nainštalovať MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Všetko na zvolenom disku sa vymaže, vrátane Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Odporúčané. Všetko na zvolenom disku sa vymaže."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Inštalovať vedľa Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Odporúčané. MAN využije voľné miesto vedľa Windows; Windows aj jeho súbory zostanú. Systém si zvolíte pri každom spustení."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Preinštalovať MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Nahradí systém, ale ponechá osobné súbory v /home. Súčasný systém sa uloží ako snímka."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Vlastné oddiely"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Pre odborníkov: zvoľte oddiely sami alebo ich vytvorte v aplikácii Disky."

#: installer.rs:392
msgid "Disk"
msgstr "Disk"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Zvoľte disk, ktorý sa vymaže. Disky, ktoré nemožno použiť, sú zobrazené s dôvodom."

#: installer.rs:418
msgid "No disks were found"
msgstr "Nenašli sa žiadne disky"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Voľné miesto vedľa Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Oddiely Windows zostanú nedotknuté. MAN zdieľa systémový oddiel EFI a pridá Windows do svojej ponuky pri spustení."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} voľné"

#: installer.rs:432
msgid "no free space"
msgstr "žiadne voľné miesto"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Inštalácia na nahradenie"

#: installer.rs:477
msgid "no home folders"
msgstr "žiadne domovské priečinky"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "domovské priečinky: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "snímky: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN na {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Heslo pre {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Odomknúť"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Inštaláciu sa nepodarilo preskúmať."

#: installer.rs:554
msgid "Partitions"
msgstr "Oddiely"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Systémový oddiel sa naformátuje na Btrfs a obsahuje @system, @home a @snapshots. Oddiely na disku, z ktorého MAN beží, nie sú uvedené."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Otvoriť Disky na vytvorenie alebo zmenu veľkosti oddielov"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Obnoviť zoznam oddielov"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Zvoľte oddiel"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "Systémový oddiel EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Naformátovať systémový oddiel EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Nechajte vypnuté, aby zostali zavádzače iných systémov"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Systémový oddiel (naformátuje sa na Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Zavádzací oddiel (potrebný pre šifrovanie)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Zoznam oddielov bol obnovený"

#: installer.rs:650
msgid "Security"
msgstr "Zabezpečenie"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Šifrovať systém"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Chráni vaše údaje, ak počítač stratíte alebo vám ho ukradnú. Heslo sa zadáva pri každom spustení."

#: installer.rs:656
msgid "Passphrase"
msgstr "Heslo"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Potvrdenie hesla"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Uschovajte si toto heslo"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Ak ho stratíte, údaje už nikto neobnoví. Jadro a zavádzacie súbory zostanú na malom nešifrovanom zavádzacom oddiele."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Heslo musí mať aspoň 8 znakov."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Heslá sa nezhodujú."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Zvoľte disk."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Zvoľte disk s Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Zvoľte inštaláciu, ktorá sa nahradí."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Najprv odomknite šifrovanú inštaláciu."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Tento oddiel neobsahuje systém MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Zvoľte systémový oddiel EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Zvoľte systémový oddiel."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Oddiel EFI a systémový oddiel sa musia líšiť."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Šifrovanie potrebuje samostatný zavádzací oddiel."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Systémový oddiel musí mať aspoň {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Oddiel EFI nie je vo formáte FAT; zapnite formátovanie."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Systémový oddiel je pripojený; najprv ho odpojte v aplikácii Disky."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Kam nainštalovať MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Čas a klávesnica"

#: installer.rs:829
msgid "Time Zone"
msgstr "Časové pásmo"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Rozloženie klávesnice"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Vyskúšajte klávesnicu"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Píšte sem a overte, že klávesy píšu správne znaky."

#: installer.rs:844
msgid "Type here"
msgstr "Píšte sem"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Časové pásmo a klávesnica"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Nie je zvolený disk"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Nie je zvolený systémový oddiel"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Systémový oddiel zmizol"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Nie je zvolená inštalácia"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Disk zmizol"

#: installer.rs:955
msgid "Review"
msgstr "Prehľad"

#: installer.rs:958
msgid "Destination"
msgstr "Cieľ"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Vymazať disk a nainštalovať"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Vlastné oddiely"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Preinštalovať, ponechať /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Vedľa Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (naformátuje sa)"

#: installer.rs:969
msgid " (kept)"
msgstr " (ponechá sa)"

#: installer.rs:970
msgid "System Partition"
msgstr "Systémový oddiel"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (naformátuje sa)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Zavádzací oddiel"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Miesto pre MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} voľného miesta (vytvorí sa zavádzací a systémový oddiel)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Bez zmeny. Objaví sa v ponuke pri spustení MAN; systémový oddiel EFI je zdieľaný."

#: installer.rs:983
msgid "Encryption"
msgstr "Šifrovanie"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Zapnuté (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Vypnuté"

#: installer.rs:985
msgid "File System"
msgstr "Súborový systém"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system pre MAN, @home pre vaše súbory, @snapshots pre body obnovenia. Všetky zdieľajú voľné miesto."

#: installer.rs:991
msgid "System"
msgstr "Systém"

#: installer.rs:993
msgid "Your Account"
msgstr "Váš účet"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Vytvorí sa v MAN Setup pri prvom spustení počítača, spolu s názvom počítača, vzhľadom a nastaveniami súkromia."

#: installer.rs:998
msgid "Keyboard"
msgstr "Klávesnica"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "Všetky údaje na {model} ({path}) sa vymažú."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Vymazať a nainštalovať"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Zvolené oddiely sa naformátujú. Ostatné oddiely sa nezmenia."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Naformátovať a nainštalovať"

