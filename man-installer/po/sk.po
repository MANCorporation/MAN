msgstr "Aktualizácia je pravá"

#: update.rs:494
msgid "Snapshot created"
msgstr "Snímka bola vytvorená"

#: update.rs:505
msgid "Update area ready"
msgstr "Oblasť pre aktualizáciu je pripravená"

#: update.rs:528
msgid "Preparing the new system"
msgstr "Príprava nového systému"

#: update.rs:184
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Súbor aktualizácie je poškodený (kontrolný súčet nesedí). Stiahnite ho znova."

#: update.rs:187
