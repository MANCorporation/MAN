msgid "The installer backend must run as root."
msgstr "La instalila helpilo devas funkcii kiel root."

#: install.rs:88
msgid "This computer was not started in UEFI mode. MAN requires UEFI."
msgstr "Ĉi tiu komputilo ne startis en UEFI-reĝimo. MAN bezonas UEFI."

#: install.rs:92
msgid "The username is not valid."
msgstr "La uzantnomo ne validas."

#: install.rs:95
msgid "A password is required."
msgstr "Pasvorto estas bezonata."

#: install.rs:99
msgid "The computer name is not valid."
msgstr "La komputilnomo ne validas."

#: install.rs:105
msgid "Unknown language."
msgstr "Nekonata lingvo."

#: install.rs:111
msgid "The encryption passphrase must have at least 8 characters."
msgstr "La ĉifra pasfrazo devas havi almenaŭ 8 signojn."

#: install.rs:122
msgid "The disk changed after you confirmed the installation. Nothing was modified; please review and confirm again."
msgstr "La disko ŝanĝiĝis post kiam vi konfirmis la instaladon. Nenio estis ŝanĝita; bonvolu kontroli kaj konfirmi denove."

#: install.rs:138
msgid "Choose a system partition."
msgstr "Elektu sisteman subdiskon."

#: install.rs:145
msgid "The confirmed disk does not hold the chosen system partition."
msgstr "La konfirmita disko ne enhavas la elektitan sisteman subdiskon."

#: install.rs:157
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "La starta subdisko devas esti aparta de la EFI- kaj sistema subdiskoj."

#: install.rs:160
msgid "The boot partition must be at least 512 MB."
msgstr "La starta subdisko devas esti almenaŭ 512 MB."

#: install.rs:175
msgid "No installation chosen."
msgstr "Neniu instalaĵo elektita."

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "La konfirmita disko ne enhavas la elektitan instalaĵon."

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "La ĉifrita instalaĵo ne havas MAN_BOOT-subdiskon."

#: install.rs:695
msgid "No kernel with matching modules was found in /boot."
msgstr "Neniu kerno kun kongruaj moduloj troviĝis en /boot."

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "La lingvon devas ŝanĝi la sistema helpilo."

#: oobe.rs:204
msgid "Applying your settings"
msgstr "Aplikado de viaj agordoj"

#: oobe.rs:212
msgid "Preparing disk encryption"
msgstr "Preparado de diska ĉifrado"

#: oobe.rs:216
msgid "Finishing"
msgstr "Finado"

#: oobe.rs:100
msgid "MAN Setup must be finished by the system helper."
msgstr "MAN Setup devas esti finita de la sistema helpilo."

#: oobe.rs:103
msgid "MAN Setup has already been completed on this computer."
msgstr "MAN Setup jam estas finita en ĉi tiu komputilo."

#: oobe.rs:124
msgid "Unknown accent color."
msgstr "Nekonata emfaza koloro."

#: oobe.rs:128
msgid "The chosen wallpaper is not available."
msgstr "La elektita fonbildo ne haveblas."

#: oobe.rs:146
msgid "This system cannot be encrypted."
msgstr "Ĉi tiu sistemo ne ĉifreblas."

#: oobe.rs:257
msgid "The setup key is missing, so encryption cannot continue in the background."
msgstr "La agorda ŝlosilo mankas, do ĉifrado ne povas daŭri fone."

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "La sistemo ne estas instalita sur Btrfs, do momentkopioj ne haveblas."

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "Restaŭro de momentkopio atendas restartigon. Unue restartigu la komputilon por fini ĝin."

#: snapshots.rs:99
msgid "Invalid snapshot id."
msgstr "Nevalida identigilo de momentkopio."

#: update.rs:32
msgid "Checking the update"
msgstr "Kontrolado de la ĝisdatigo"

#: update.rs:32
msgid "Creating a snapshot"
msgstr "Kreado de momentkopio"

#: update.rs:32
msgid "Preparing the update area"
msgstr "Preparado de la ĝisdatiga areo"

#: update.rs:32
msgid "Unpacking the new system"
msgstr "Malpakado de la nova sistemo"

#: update.rs:32
msgid "Moving your accounts and settings"
msgstr "Transmetado de viaj kontoj kaj agordoj"

#: update.rs:32
msgid "Preparing the restart"
msgstr "Preparado de la restartigo"

#: update.rs:179
msgid "Unpacked"
msgstr "Malpakita"

#: update.rs:261
msgid "Accounts"
msgstr "Kontoj"

#: update.rs:301
msgid "Removing installer-only software"
msgstr "Forigado de programaro nur por la instalilo"

#: update.rs:340
msgid "Building the update boot image"
msgstr "Konstruado de la starta bildo de la ĝisdatigo"

#: update.rs:343
msgid "Adding the one-time boot entry"
msgstr "Aldonado de unufoja starta enigo"

#: update.rs:377
msgid "The update is genuine"
msgstr "La ĝisdatigo estas aŭtentika"

#: update.rs:383
msgid "Snapshot created"
msgstr "Momentkopio kreita"

#: update.rs:385
msgid "Skipped"
msgstr "Preterlasita"

#: update.rs:394
msgid "Update area ready"
msgstr "Ĝisdatiga areo preta"

#: update.rs:410
msgid "Preparing the new system"
msgstr "Preparado de la nova sistemo"

#: update.rs:168
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "La ĝisdatiga dosiero estas difektita (kontrolsumo ne kongruas). Elŝutu ĝin denove."

#: update.rs:171
msgid "The update file could not be read completely."
msgstr "Ne eblis tute legi la ĝisdatigan dosieron."

#: update.rs:312
msgid "The update contains no kernel."
msgstr "La ĝisdatigo ne enhavas kernon."

#: update.rs:360
msgid "Updates must be installed by the system helper."
msgstr "Ĝisdatigojn devas instali la sistema helpilo."

#: update.rs:369
msgid "The chosen installation was not found."
msgstr "La elektita instalaĵo ne troviĝis."

#: update.rs:371
msgid "Only the running MAN installation can be updated."
msgstr "Nur la funkcianta MAN-instalaĵo ĝisdatigeblas."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Ĉi tio ne estas MAN-ĝisdatiga dosiero (neniu manifesto)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "La ĝisdatigo ne estas subskribita, do ĝi ne fidindas."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "La subskribo de la ĝisdatigo estas difektita."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "La ĝisdatigo ne estas subskribita de MAN. Ĝi eble estis ŝanĝita aŭ venas de nefidinda fonto."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "La manifesto de la ĝisdatigo ne validas."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "La pasfrazo ne estas ĝusta, aŭ la ĉifrita subdisko ne malfermeblas."

