msgid "The installation could not be inspected."
msgstr "Ne eblis ekzameni la instalaĵon."

#: installer.rs:554
msgid "Partitions"
msgstr "Subdiskoj"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "La sistema subdisko estas formatita per Btrfs kaj enhavas @system, @home kaj @snapshots. Subdiskoj de la disko, de kiu MAN funkcias, ne estas listigitaj."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Malfermi Diskojn por krei aŭ regrandigi subdiskojn"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Refreŝigi la liston de subdiskoj"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Elektu subdiskon"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI-sistema subdisko"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Formati la EFI-sisteman subdiskon"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Lasu malŝaltita por konservi startigilojn de aliaj sistemoj"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Sistema subdisko (formatota per Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Starta subdisko (necesa por ĉifrado)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Listo de subdiskoj refreŝigita"

#: installer.rs:650
msgid "Security"
msgstr "Sekureco"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Ĉifri la sistemon"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Protektas viajn datumojn, se la komputilo perdiĝas aŭ estas ŝtelita. Pasfrazo estas petata ĉe ĉiu starto."

#: installer.rs:656
msgid "Passphrase"
msgstr "Pasfrazo"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Konfirmu pasfrazon"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Gardu ĉi tiun pasfrazon sekure"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Se ĝi perdiĝas, neniu povas restaŭri la datumojn. La kerno kaj startaj dosieroj restas sur malgranda neĉifrita starta subdisko."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "La pasfrazo devas havi almenaŭ 8 signojn."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "La pasfrazoj ne kongruas."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Elektu diskon."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Elektu la diskon kun Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Elektu la anstataŭigotan instalaĵon."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Unue malŝlosu la ĉifritan instalaĵon."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Ĉi tiu subdisko ne enhavas MAN-sistemon."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Elektu EFI-sisteman subdiskon."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Elektu la sisteman subdiskon."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "La EFI- kaj sistema subdiskoj devas esti malsamaj."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Ĉifrado bezonas apartan startan subdiskon."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "La sistema subdisko devas esti almenaŭ {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "La EFI-subdisko ne estas FAT-formatita; ŝaltu formatadon."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "La sistema subdisko estas surmetita; unue demetu ĝin en Diskoj."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Kien instali MAN?"

