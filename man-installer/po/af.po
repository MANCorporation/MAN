#: update.rs:184
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "Die bywerkingslêer is beskadig (kontrolesom pas nie). Laai dit weer af."

#: update.rs:187
msgid "The update file could not be read completely."
msgstr "Die bywerkingslêer kon nie heeltemal gelees word nie."

#: update.rs:416
msgid "The update contains no kernel."
msgstr "Die bywerking bevat geen kern nie."

#: update.rs:470
msgid "Updates must be installed by the system helper."
msgstr "Bywerkings moet deur die stelselhelper geïnstalleer word."

#: update.rs:480
