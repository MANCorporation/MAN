msgstr "_Gaan voort"

#: appinstaller.rs:799
msgid "Welcome to the {name} Installer"
msgstr "Welkom by die {name}-installeerder"

#: appinstaller.rs:803
msgid "Software License Agreement"
msgstr "Sagtewarelisensie-ooreenkoms"

#: appinstaller.rs:813
msgid "Do You Agree to the License?"
msgstr "Stem jy in tot die lisensie?"

#: appinstaller.rs:814
msgid "To continue installing, you must agree to the terms of the software license agreement."
msgstr "Om voort te gaan met die installering, moet jy instem tot die bepalings van die sagtewarelisensie-ooreenkoms."

#: appinstaller.rs:816
msgid "_Read License"
msgstr "_Lees lisensie"

#: appinstaller.rs:817
msgid "_Agree"
msgstr "_Stem in"

#: appinstaller.rs:830
msgid "Select a Destination"
msgstr "Kies ’n bestemming"

#: appinstaller.rs:834
msgid "Standard Install"
msgstr "Standaardinstallering"

#: appinstaller.rs:835
msgid "_Install"
msgstr "_Installeer"

#: appinstaller.rs:848
msgid "Debian package (.deb)"
msgstr "Debian-pakket (.deb)"

#: appinstaller.rs:849
msgid "Flatpak app"
msgstr "Flatpak-toep"

#: appinstaller.rs:850
msgid "Flatpak app from {source}"
msgstr "Flatpak-toep van {source}"

#: appinstaller.rs:851
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:869
msgid "You will be guided through the steps necessary to install this software."
msgstr "Jy sal gelei word deur die stappe wat nodig is om hierdie sagteware te installeer."

#: appinstaller.rs:880
msgid "Version"
msgstr "Weergawe"

#: appinstaller.rs:883
msgid "Publisher"
msgstr "Uitgewer"

#: appinstaller.rs:885
msgid "Type"
msgstr "Tipe"

#: appinstaller.rs:887
msgid "Size"
msgstr "Grootte"

#: appinstaller.rs:893
msgid "Website"
msgstr "Webwerf"

#: appinstaller.rs:895
msgid "File"
msgstr "Lêer"

#: appinstaller.rs:905
msgid "This app is installed already. Installing it again replaces it."
msgstr "Hierdie toep is reeds geïnstalleer. As jy dit weer installeer, word dit vervang."

#: appinstaller.rs:908
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr "Toepe uit .deb-pakkette word deel van die stelsel. ’n MAN-bywerking vervang die stelsel, so hulle word ná ’n bywerking net weer geïnstalleer as jy hulle behou (volgende stappe)."

#: appinstaller.rs:911
msgid "Only install apps from sources you trust."
msgstr "Installeer net toepe uit bronne wat jy vertrou."

#: appinstaller.rs:917
msgid "Where do you want to install {name}?"
msgstr "Waar wil jy {name} installeer?"

#: appinstaller.rs:922
msgid "Only your account can use the app."
msgstr "Net jou rekening kan die toep gebruik."

#: appinstaller.rs:923
msgid "Needs administrator rights."
msgstr "Benodig administrateurregte."

#: appinstaller.rs:930
msgid "Only for Me"
msgstr "Net vir my"

#: appinstaller.rs:930
msgid "For All Users of This Computer"
msgstr "Vir alle gebruikers van hierdie rekenaar"

#: appinstaller.rs:945
msgid "This will take {size} of space on your computer."
msgstr "Dit sal {size} spasie op jou rekenaar gebruik."

#: appinstaller.rs:947
msgid "The app is downloaded from {source}."
msgstr "Die toep word van {source} afgelaai."

#: appinstaller.rs:949
msgid "The app is installed for all users of this computer."
msgstr "Die toep word vir alle gebruikers van hierdie rekenaar geïnstalleer."

#: appinstaller.rs:949
msgid "The app is installed only for you."
msgstr "Die toep word net vir jou geïnstalleer."

#: appinstaller.rs:952
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "Die AppImage word na {folder} geskuif en by jou toepe gevoeg."

#: appinstaller.rs:958
msgid "Keep After MAN Updates"
msgstr "Behou ná MAN-bywerkings"

#: appinstaller.rs:959
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "MAN installeer die toep weer ná elke bywerking. Die pakketlêers word daarvoor gehou."

#: appinstaller.rs:967
msgid "Click Install to install {name}."
msgstr "Klik Installeer om {name} te installeer."

#: appinstaller.rs:973
msgid "Checking what else the app needs…"
msgstr "Kyk wat die toep nog nodig het…"

#: appinstaller.rs:983
msgid "Also installs the packages it needs: {list}"
msgstr "Installeer ook die pakkette wat dit nodig het: {list}"

#: appinstaller.rs:989
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Sommige pakkette wat die toep nodig het, is nog nie beskikbaar nie. Die installering kry eers die nuutste pakketlyste; as hulle steeds ontbreek, kan die toep nie geïnstalleer word nie."

#: appinstaller.rs:1050
msgid "Installing {name}…"
msgstr "Installeer tans {name}…"

#: appinstaller.rs:1056
msgid "Preparing…"
msgstr "Berei tans voor…"

#: appinstaller.rs:1063
msgid "Details"
msgstr "Besonderhede"

#: appinstaller.rs:1103
msgid "Installing the package…"
msgstr "Installeer tans die pakket…"

#: appinstaller.rs:1122
msgid "Moving the app to its folder…"
msgstr "Skuif tans die toep na sy vouer…"

#: appinstaller.rs:1131
msgid "The app could not be installed."
msgstr "Die toep kon nie geïnstalleer word nie."

#: appinstaller.rs:1135
msgid "Installing the app with Flatpak…"
msgstr "Installeer tans die toep met Flatpak…"

#: appinstaller.rs:1159
msgid "Log"
msgstr "Log"

#: appinstaller.rs:1189
msgid "_Close"
msgstr "_Maak toe"

#: appinstaller.rs:1199
msgid "The Installation Was Successful"
msgstr "Die installering was suksesvol"

#: appinstaller.rs:1199
msgid "The app was installed."
msgstr "Die toep is geïnstalleer."

#: appinstaller.rs:1204
msgid "The Installation Failed"
msgstr "Die installering het misluk"

#: appinstaller.rs:1215
msgid "_Open"
msgstr "_Open"

#: appinstaller.rs:1225
msgid "_Show Details"
msgstr "_Wys besonderhede"

#: appinstaller.rs:1228
msgid "Installation Log"
msgstr "Installasielog"

#: appinstaller.rs:1255
msgid "App Installer"
msgstr "Toepinstalleerder"

#: appinstaller.rs:1276
msgid "Go _Back"
msgstr "_Terug"

#: appinstaller.rs:1349
msgid "Reading the app…"
msgstr "Lees tans die toep…"

#: appinstaller.rs:1358
msgid "Install {name}"
msgstr "Installeer {name}"

#: appinstaller.rs:1377
msgid "Apps"
msgstr "Toepe"

#: appinstaller.rs:1383
msgid "Choose an App to Install"
msgstr "Kies ’n toep om te installeer"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "Die stelselhelper kon nie begin word nie."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "Kan nie met die stelselhelper kommunikeer nie."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Kontak met die stelselhelper is verloor."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Magtiging is gekanselleer."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Hierdie aksie vereis administrateursregte."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "Die stelselhelper het onverwags gestop."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Geen EFI-stelselpartisie nie"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Slegs {free} vry, MAN benodig {need}. Maak meer plek met DUHACH! in Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Geen vrye spasie nie. Begin DUHACH! in Windows om plek vir MAN te maak."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN loop van hierdie skyf af"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "In gebruik: ’n partisie is gekoppel"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Te klein, MAN benodig {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Installeer MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN word geïnstalleer. Wag asseblief tot dit klaar is."

#: installer.rs:143
msgid "Language"
msgstr "Taal"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Herbegin in hierdie taal"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Die lewendige sessie herbegin in die gekose taal, en MAN word daarin geïnstalleer."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Welkom by MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"’n Vinnige, oop en volledig aanpasbare GNOME-stelsel.\n"
"Installeer dit op hierdie rekenaar, of hou aan om die lewendige sessie te verken."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Installeer MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Hou aan om MAN te probeer"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Soek skywe…"

#: installer.rs:250
msgid "Welcome"
msgstr "Welkom"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Hierdie rekenaar is in ou BIOS-modus begin. MAN kan net op UEFI-rekenaars geïnstalleer word: herbegin en kies die UEFI-opstartopsie."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Die stelselhelper het geen skyfinligting teruggegee nie."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Volgende"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Vee skyf uit en installeer MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Alles op die gekose skyf word uitgevee, Windows ingesluit."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Aanbeveel. Alles op die gekose skyf word uitgevee."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Installeer langs Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Aanbeveel. MAN gebruik die vrye spasie langs Windows; Windows en sy lêers bly. Kies die stelsel elke keer as jy begin."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Herinstalleer MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Vervang die stelsel maar hou persoonlike lêers in /home. Die huidige stelsel word as ’n momentopname gestoor."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Pasgemaakte partisies"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Vir kundiges: kies self partisies, of skep hulle met Skywe."

#: installer.rs:392
msgid "Disk"
msgstr "Skyf"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Kies die skyf wat uitgevee word. Skywe wat nie gebruik kan word nie, word met die rede gewys."

#: installer.rs:418
msgid "No disks were found"
msgstr "Geen skywe gevind nie"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Vrye spasie langs Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows se partisies word nie aangeraak nie. MAN deel die EFI-stelselpartisie en voeg Windows by sy opstartkieslys."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} vry"

#: installer.rs:432
msgid "no free space"
msgstr "geen vrye spasie"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Installasie om te vervang"

#: installer.rs:477
msgid "no home folders"
msgstr "geen tuisvouers"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "tuisvouers: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "momentopnames: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN op {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Wagfrase vir {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Ontsluit"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Die installasie kon nie ondersoek word nie."

#: installer.rs:554
msgid "Partitions"
msgstr "Partisies"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Die stelselpartisie word met Btrfs geformateer en bevat @system, @home en @snapshots. Partisies op die skyf waarvan MAN loop, word nie gelys nie."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Maak Skywe oop om partisies te skep of hul grootte te verander"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Verfris die partisielys"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Kies ’n partisie"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI-stelselpartisie"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Formateer EFI-stelselpartisie"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Laat af om ander stelsels se opstartlaaiers te hou"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Stelselpartisie (geformateer as Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Opstartpartisie (nodig met enkripsie)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Partisielys verfris"

#: installer.rs:650
msgid "Security"
msgstr "Sekuriteit"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Enkripteer die stelsel"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Beskerm jou data as die rekenaar verlore raak of gesteel word. ’n Wagfrase word by elke begin gevra."

#: installer.rs:656
msgid "Passphrase"
msgstr "Wagfrase"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Bevestig wagfrase"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Hou hierdie wagfrase veilig"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "As dit verlore raak, kan niemand die data herstel nie. Die kern en opstartlêers bly op ’n klein ongeënkripteerde opstartpartisie."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Die wagfrase moet minstens 8 karakters hê."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Die wagfrases stem nie ooreen nie."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Kies ’n skyf."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Kies die skyf met Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Kies die installasie om te vervang."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Ontsluit eers die geënkripteerde installasie."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Hierdie partisie bevat geen MAN-stelsel nie."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Kies ’n EFI-stelselpartisie."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Kies die stelselpartisie."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Die EFI- en stelselpartisies moet verskil."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Enkripsie benodig ’n aparte opstartpartisie."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Die stelselpartisie moet minstens {size} wees."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Die EFI-partisie is nie FAT-geformateer nie; skakel formatering aan."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Die stelselpartisie is gekoppel; ontkoppel dit eers in Skywe."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Waar moet MAN geïnstalleer word?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Tyd en sleutelbord"

#: installer.rs:829
msgid "Time Zone"
msgstr "Tydsone"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Sleutelborduitleg"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Toets jou sleutelbord"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Tik hier om seker te maak jou sleutels gee die regte karakters."

#: installer.rs:844
msgid "Type here"
msgstr "Tik hier"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Tydsone en sleutelbord"

#: installer.rs:920
msgid "No disk chosen"
msgstr "Geen skyf gekies nie"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "Geen stelselpartisie gekies nie"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "Die stelselpartisie het verdwyn"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Geen installasie gekies nie"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Die skyf het verdwyn"

#: installer.rs:955
msgid "Review"
msgstr "Hersien"

#: installer.rs:958
msgid "Destination"
msgstr "Bestemming"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Vee skyf uit en installeer"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Pasgemaakte partisies"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Herinstalleer, hou /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Langs Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (sal geformateer word)"

#: installer.rs:969
msgid " (kept)"
msgstr " (behou)"

#: installer.rs:970
msgid "System Partition"
msgstr "Stelselpartisie"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (sal geformateer word)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Opstartpartisie"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Spasie vir MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} vrye spasie (’n opstartpartisie en die stelselpartisie word geskep)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Onveranderd. Dit verskyn in MAN se opstartkieslys; die EFI-stelselpartisie word gedeel."

#: installer.rs:983
msgid "Encryption"
msgstr "Enkripsie"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Aan (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Af"

#: installer.rs:985
msgid "File System"
msgstr "Lêerstelsel"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system vir MAN, @home vir jou lêers, @snapshots vir herstelpunte. Almal deel die vrye spasie."

#: installer.rs:991
msgid "System"
msgstr "Stelsel"

#: installer.rs:993
msgid "Your Account"
msgstr "Jou rekening"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Word in MAN Setup geskep wanneer die rekenaar die eerste keer begin, saam met die rekenaarnaam, voorkoms en privaatheidsinstellings."

#: installer.rs:998
msgid "Keyboard"
msgstr "Sleutelbord"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "Alle data op {model} ({path}) sal uitgevee word."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Vee uit en installeer"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Die gekose partisies sal geformateer word. Ander partisies verander nie."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Formateer en installeer"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "Die huidige stelsel word vervang. Jou lêers in /home bly, en die ou stelsel word as ’n momentopname gestoor."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "_Herinstalleer"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN word in die vrye spasie geïnstalleer. Windows en sy lêers verander nie."

#: installer.rs:1019
msgid "Ready to Install"
msgstr "Gereed om te installeer"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "Vee {model} uit?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "Elke lêer en partisie op {path} ({size}) sal permanent geskrap word. Dit kan nie ontdoen word nie."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "Vee uit en installeer"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "Formateer die gekose partisies?"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "Alle data op die gekose partisies sal permanent geskrap word. Ander partisies verander nie."

#: installer.rs:1037
msgid "Format and Install"
msgstr "Formateer en installeer"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "Installeer MAN langs Windows?"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "MAN word in die {free} vrye spasie op {model} ({path}) geïnstalleer. Windows en sy lêers verander nie."

#: installer.rs:1046
msgid "Install"
msgstr "Installeer"

#: installer.rs:1050
msgid "Reinstall MAN?"
