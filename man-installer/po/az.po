msgid "The app is downloaded from {source}."
msgstr "Tətbiq {source} mənbəyindən endirilir."

#: appinstaller.rs:947
msgid "The app is installed for all users of this computer."
msgstr "Tətbiq bu kompüterin bütün istifadəçiləri üçün quraşdırılır."

#: appinstaller.rs:947
msgid "The app is installed only for you."
msgstr "Tətbiq yalnız sizin üçün quraşdırılır."

#: appinstaller.rs:950
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage {folder} qovluğuna köçürülür və tətbiqlərinizə əlavə edilir."

#: appinstaller.rs:952
msgid "Click Install to install {name}."
msgstr "{name} quraşdırmaq üçün Quraşdır düyməsini basın."

