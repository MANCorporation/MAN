msgstr "EFI sistem bölməsi seçin."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Sistem bölməsini seçin."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI və sistem bölmələri fərqli olmalıdır."

