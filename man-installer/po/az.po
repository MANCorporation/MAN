msgid "Review"
msgstr "Nəzərdən keçir"

#: installer.rs:1000
msgid "Destination"
msgstr "Təyinat"

#: installer.rs:1002
msgid "Erase disk and install"
msgstr "Diski sil və quraşdır"

#: installer.rs:1003
msgid "This Mac (space prepared in macOS)"
msgstr "Bu Mac (macOS-da hazırlanmış yer)"

#: installer.rs:1004
msgid "Custom partitions"
msgstr "Fərdi bölmələr"

#: installer.rs:1005
msgid "Reinstall, keeping /home"
msgstr "/home saxlanmaqla yenidən quraşdır"

#: installer.rs:1006
