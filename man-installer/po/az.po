msgid "Standard Install"
msgstr "Standart quraşdırma"

#: appinstaller.rs:842
msgid "_Install"
msgstr "_Quraşdır"

#: appinstaller.rs:855
msgid "Debian package (.deb)"
msgstr "Debian paketi (.deb)"

#: appinstaller.rs:856
msgid "Flatpak app"
msgstr "Flatpak tətbiqi"

#: appinstaller.rs:857
msgid "Flatpak app from {source}"
msgstr "{source} mənbəyindən Flatpak tətbiqi"

#: appinstaller.rs:858
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:876
msgid "You will be guided through the steps necessary to install this software."
msgstr "Bu proqramı quraşdırmaq üçün lazım olan addımlarda sizə bələdçilik ediləcək."

#: appinstaller.rs:887
msgid "Version"
msgstr "Versiya"

#: appinstaller.rs:890
msgid "Publisher"
msgstr "Nəşriyyatçı"

#: appinstaller.rs:892
msgid "Type"
msgstr "Növ"

#: appinstaller.rs:894
msgid "Size"
msgstr "Ölçü"

#: appinstaller.rs:900
msgid "Website"
msgstr "Vebsayt"

#: appinstaller.rs:902
msgid "File"
msgstr "Fayl"

#: appinstaller.rs:912
msgid "This app is installed already. Installing it again replaces it."
msgstr "Bu tətbiq artıq quraşdırılıb. Yenidən quraşdırmaq onu əvəz edir."

#: appinstaller.rs:915
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr ".deb paketlərindən olan tətbiqlər sistemin bir hissəsi olur. MAN yeniləməsi sistemi əvəz edir, ona görə də onlar yeniləmədən sonra yalnız saxlasanız yenidən quraşdırılır (növbəti addımlar)."

#: appinstaller.rs:918
msgid "Only install apps from sources you trust."
msgstr "Tətbiqləri yalnız etibar etdiyiniz mənbələrdən quraşdırın."

#: appinstaller.rs:924
msgid "Where do you want to install {name}?"
msgstr "{name} tətbiqini harada quraşdırmaq istəyirsiniz?"

#: appinstaller.rs:929
msgid "Only your account can use the app."
msgstr "Tətbiqdən yalnız sizin hesabınız istifadə edə bilər."

#: appinstaller.rs:930
msgid "Needs administrator rights."
msgstr "İnzibatçı hüquqları tələb olunur."

#: appinstaller.rs:937
msgid "Only for Me"
msgstr "Yalnız mənim üçün"

#: appinstaller.rs:937
msgid "For All Users of This Computer"
msgstr "Bu kompüterin bütün istifadəçiləri üçün"

#: appinstaller.rs:952
msgid "This will take {size} of space on your computer."
msgstr "Bu, kompüterinizdə {size} yer tutacaq."

#: appinstaller.rs:954
msgid "The app is downloaded from {source}."
msgstr "Tətbiq {source} mənbəyindən endirilir."

#: appinstaller.rs:956
msgid "The app is installed for all users of this computer."
msgstr "Tətbiq bu kompüterin bütün istifadəçiləri üçün quraşdırılır."

#: appinstaller.rs:956
msgid "The app is installed only for you."
msgstr "Tətbiq yalnız sizin üçün quraşdırılır."

#: appinstaller.rs:959
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage {folder} qovluğuna köçürülür və tətbiqlərinizə əlavə edilir."

#: appinstaller.rs:965
msgid "Keep After MAN Updates"
msgstr "MAN yeniləmələrindən sonra saxla"

#: appinstaller.rs:966
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "MAN hər yeniləmədən sonra tətbiqi yenidən quraşdırır. Bunun üçün paket faylları saxlanılır."

#: appinstaller.rs:974
msgid "Click Install to install {name}."
msgstr "{name} quraşdırmaq üçün Quraşdır düyməsini basın."

#: appinstaller.rs:980
msgid "Checking what else the app needs…"
msgstr "Tətbiqin daha nəyə ehtiyacı olduğu yoxlanılır…"

#: appinstaller.rs:990
msgid "Also installs the packages it needs: {list}"
msgstr "Lazım olan paketləri də quraşdırır: {list}"

#: appinstaller.rs:996
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Tətbiqə lazım olan bəzi paketlər hələ əlçatan deyil. Quraşdırma əvvəlcə ən yeni paket siyahılarını alır; hələ də çatışmırsa, tətbiq quraşdırıla bilməz."

#: appinstaller.rs:1057
msgid "Installing {name}…"
msgstr "{name} quraşdırılır…"

#: appinstaller.rs:1063
msgid "Preparing…"
msgstr "Hazırlanır…"

#: appinstaller.rs:1070
msgid "Details"
msgstr "Təfərrüatlar"

#: appinstaller.rs:1110
msgid "Installing the package…"
msgstr "Paket quraşdırılır…"

#: appinstaller.rs:1129
msgid "Moving the app to its folder…"
msgstr "Tətbiq öz qovluğuna köçürülür…"

#: appinstaller.rs:1138
msgid "The app could not be installed."
msgstr "Tətbiq quraşdırıla bilmədi."

#: appinstaller.rs:1142
msgid "Installing the app with Flatpak…"
msgstr "Tətbiq Flatpak ilə quraşdırılır…"

#: appinstaller.rs:1166
msgid "Log"
msgstr "Jurnal"

#: appinstaller.rs:1196
msgid "_Close"
msgstr "_Bağla"

#: appinstaller.rs:1206
msgid "The Installation Was Successful"
msgstr "Quraşdırma uğurlu oldu"

#: appinstaller.rs:1206
msgid "The app was installed."
msgstr "Tətbiq quraşdırıldı."

#: appinstaller.rs:1211
msgid "The Installation Failed"
msgstr "Quraşdırma alınmadı"

#: appinstaller.rs:1222
msgid "_Open"
msgstr "_Aç"

#: appinstaller.rs:1232
msgid "_Show Details"
msgstr "Təfərrüatları _göstər"

#: appinstaller.rs:1235
msgid "Installation Log"
msgstr "Quraşdırma jurnalı"

#: appinstaller.rs:1262
msgid "App Installer"
msgstr "Tətbiq quraşdırıcısı"

#: appinstaller.rs:1283
msgid "Go _Back"
msgstr "_Geri"

#: appinstaller.rs:1356
msgid "Reading the app…"
msgstr "Tətbiq oxunur…"

#: appinstaller.rs:1365
msgid "Install {name}"
msgstr "{name} quraşdır"

#: appinstaller.rs:1384
msgid "Apps"
msgstr "Tətbiqlər"

#: appinstaller.rs:1390
msgid "Choose an App to Install"
msgstr "Quraşdırmaq üçün tətbiq seçin"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "Sistem köməkçisini başlatmaq mümkün olmadı."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "Sistem köməkçisi ilə əlaqə qurmaq mümkün olmadı."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Sistem köməkçisi ilə əlaqə kəsildi."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Səlahiyyətləndirmə ləğv edildi."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Bu əməliyyat üçün administrator hüquqları lazımdır."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "Sistem köməkçisi gözlənilmədən dayandı."

#: installer.rs:89
msgid "No EFI system partition"
msgstr "EFI sistem bölməsi yoxdur"

#: installer.rs:93
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Yalnız {free} boşdur, MAN-a {need} lazımdır. Windows-da DUHACH! ilə yer açın."

#: installer.rs:94
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Boş yer yoxdur. MAN üçün yer açmaq üçün Windows-da DUHACH!-ı başladın."

#: installer.rs:103
msgid "MAN is running from this disk"
msgstr "MAN bu diskdən işləyir"

#: installer.rs:107
msgid "In use: a partition is mounted"
msgstr "İstifadədədir: bölmə qoşulub"

#: installer.rs:109
msgid "Too small, MAN needs {need}"
msgstr "Çox kiçikdir, MAN-a {need} lazımdır"

#: installer.rs:119
msgid "Install MAN"
msgstr "MAN-ı quraşdır"

#: installer.rs:137
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN quraşdırılır. Bitənə qədər gözləyin."

#: installer.rs:154
msgid "Language"
msgstr "Dil"

#: installer.rs:166
msgid "_Restart in This Language"
msgstr "Bu dildə _yenidən başlat"

#: installer.rs:178
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Canlı sessiya seçilmiş dildə yenidən başlayır və MAN həmin dildə quraşdırılır."

#: installer.rs:224
msgid "Welcome to MAN"
msgstr "MAN-a xoş gəlmisiniz"

#: installer.rs:225
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Sürətli, açıq və tam fərdiləşdirilə bilən GNOME sistemi.\n"
"Onu bu kompüterə quraşdırın və ya canlı sessiyanı kəşf etməyə davam edin."

#: installer.rs:229
msgid "_Install MAN…"
msgstr "MAN-ı _quraşdır…"

#: installer.rs:231
msgid "_Keep Trying MAN"
msgstr "MAN-ı sınamağa _davam et"

#: installer.rs:234
msgid "Looking for disks…"
msgstr "Disklər axtarılır…"

#: installer.rs:261
msgid "Welcome"
msgstr "Xoş gəlmisiniz"

#: installer.rs:276
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Bu kompüter köhnə BIOS rejimində başladılıb. MAN yalnız UEFI kompüterlərə quraşdırıla bilər: yenidən başladın və UEFI yükləmə seçimini seçin."

#: installer.rs:294
msgid "The system helper returned no disk information."
msgstr "Sistem köməkçisi disk məlumatı qaytarmadı."

#: installer.rs:372
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:380
msgid "_Next"
msgstr "_İrəli"

#: installer.rs:388
msgid "Erase Disk and Install MAN"
msgstr "Diski sil və MAN-ı quraşdır"

#: installer.rs:389
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Seçilmiş diskdəki hər şey silinir, Windows da daxil olmaqla."

#: installer.rs:389
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Tövsiyə edilir. Seçilmiş diskdəki hər şey silinir."

#: installer.rs:393
msgid "Install Alongside Windows"
msgstr "Windows-un yanına quraşdır"

#: installer.rs:394
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Tövsiyə edilir. MAN Windows-un yanındakı boş yerdən istifadə edir; Windows və faylları qalır. Hər başlanğıcda sistemi seçirsiniz."

#: installer.rs:401
msgid "Reinstall MAN"
msgstr "MAN-ı yenidən quraşdır"

#: installer.rs:402
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Sistemi əvəz edir, amma /home daxilindəki şəxsi faylları saxlayır. Cari sistem snapşot kimi saxlanır."

#: installer.rs:407
msgid "Custom Partitions"
msgstr "Fərdi bölmələr"

#: installer.rs:407
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Mütəxəssislər üçün: bölmələri özünüz seçin və ya Disklər ilə yaradın."

#: installer.rs:418
msgid "Erase an External Disk and Install MAN"
msgstr "Xarici diski silib MAN qur"

#: installer.rs:419
msgid "Everything on the chosen external disk is deleted. The Mac's internal disk is not shown and not changed."
msgstr "Seçilmiş xarici diskdəki hər şey silinir. Mac-ın daxili diski göstərilmir və dəyişdirilmir."

#: installer.rs:420
msgid "Install on This Mac"
msgstr "Bu Mac-a qur"

#: installer.rs:422
msgid "Recommended. Into the {size} prepared in macOS. macOS and its partitions are not changed."
msgstr "Tövsiyə olunur. macOS-da hazırlanmış {size} sahəyə. macOS və onun bölmələri dəyişdirilmir."

#: installer.rs:427
msgid "No space for MAN was prepared yet. In macOS, run MAN-Mac/install-man.sh from the MAN USB stick and choose “MAN boot loader + space for MAN”."
msgstr "MAN üçün hələ yer hazırlanmayıb. macOS-da MAN USB yaddaşından MAN-Mac/install-man.sh işə salın və “MAN boot loader + space for MAN” seçin."

#: installer.rs:433
msgid "Disk"
msgstr "Disk"

#: installer.rs:433
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Silinəcək diski seçin. İstifadə edilə bilməyən disklər səbəbi ilə göstərilir."

#: installer.rs:459
msgid "No disks were found"
msgstr "Disk tapılmadı"

#: installer.rs:466
msgid "Free Space Next to Windows"
msgstr "Windows-un yanındakı boş yer"

#: installer.rs:467
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows bölmələrinə toxunulmur. MAN EFI sistem bölməsini paylaşır və Windows-u yükləmə menyusuna əlavə edir."

#: installer.rs:473
msgid "{size} free"
msgstr "{size} boş"

#: installer.rs:473
msgid "no free space"
msgstr "boş yer yoxdur"

#: installer.rs:478
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:497
msgid "Installation to Replace"
msgstr "Əvəz ediləcək quraşdırma"

#: installer.rs:518
msgid "no home folders"
msgstr "ev qovluğu yoxdur"

#: installer.rs:520
msgid "home folders: {list}"
msgstr "ev qovluqları: {list}"

#: installer.rs:522
msgid "snapshots: {n}"
msgstr "snapşotlar: {n}"

#: installer.rs:526
msgid "MAN on {model}"
msgstr "{model} üzərində MAN"

#: installer.rs:540
msgid "Passphrase for {device}"
msgstr "{device} üçün parol ifadəsi"

#: installer.rs:541
msgid "Unlock"
msgstr "Kilidi aç"

#: installer.rs:578
msgid "The installation could not be inspected."
msgstr "Quraşdırmanı yoxlamaq mümkün olmadı."

#: installer.rs:595
msgid "Partitions"
msgstr "Bölmələr"

#: installer.rs:596
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Sistem bölməsi Btrfs ilə formatlanır və @system, @home və @snapshots ehtiva edir. MAN-ın işlədiyi diskin bölmələri göstərilmir."

#: installer.rs:598
msgid "Open Disks to create or resize partitions"
msgstr "Bölmə yaratmaq və ya ölçüsünü dəyişmək üçün Diskləri aç"

#: installer.rs:600
msgid "Refresh the partition list"
msgstr "Bölmə siyahısını yenilə"

#: installer.rs:608
msgid "Choose a partition"
msgstr "Bölmə seçin"

#: installer.rs:620
msgid "EFI System Partition"
msgstr "EFI sistem bölməsi"

#: installer.rs:621
msgid "Format EFI System Partition"
msgstr "EFI sistem bölməsini formatla"

#: installer.rs:621
msgid "Leave off to keep boot loaders of other systems"
msgstr "Digər sistemlərin yükləyicilərini saxlamaq üçün söndürülmüş qoyun"

#: installer.rs:623
msgid "System Partition (formatted as Btrfs)"
msgstr "Sistem bölməsi (Btrfs kimi formatlanır)"

#: installer.rs:624
msgid "Boot Partition (needed with encryption)"
msgstr "Yükləmə bölməsi (şifrələmə üçün lazımdır)"

#: installer.rs:683
msgid "Partition list refreshed"
msgstr "Bölmə siyahısı yeniləndi"

#: installer.rs:691
msgid "Security"
msgstr "Təhlükəsizlik"

#: installer.rs:693
msgid "Encrypt the System"
msgstr "Sistemi şifrələ"

#: installer.rs:694
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Kompüter itsə və ya oğurlansa, məlumatlarınızı qoruyur. Hər başlanğıcda parol ifadəsi soruşulur."

#: installer.rs:697
msgid "Passphrase"
msgstr "Parol ifadəsi"

#: installer.rs:698
msgid "Confirm Passphrase"
msgstr "Parol ifadəsini təsdiqlə"

#: installer.rs:700
msgid "Keep this passphrase safe"
msgstr "Bu parol ifadəsini etibarlı yerdə saxlayın"

#: installer.rs:701
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "İtsə, heç kim məlumatları bərpa edə bilməz. Nüvə və yükləmə faylları kiçik, şifrələnməmiş yükləmə bölməsində qalır."

#: installer.rs:774
msgid "The passphrase needs at least 8 characters."
msgstr "Parol ifadəsi ən azı 8 simvol olmalıdır."

#: installer.rs:776
msgid "The passphrases do not match."
msgstr "Parol ifadələri uyğun gəlmir."

#: installer.rs:790
msgid "Choose a disk."
msgstr "Disk seçin."

#: installer.rs:800
msgid "Choose the disk with Windows."
msgstr "Windows olan diski seçin."

#: installer.rs:809
msgid "Choose the installation to replace."
msgstr "Əvəz ediləcək quraşdırmanı seçin."

#: installer.rs:810
msgid "Unlock the encrypted installation first."
msgstr "Əvvəlcə şifrələnmiş quraşdırmanın kilidini açın."

#: installer.rs:811
msgid "This partition holds no MAN system."
msgstr "Bu bölmədə MAN sistemi yoxdur."

#: installer.rs:818
msgid "Choose an EFI system partition."
msgstr "EFI sistem bölməsi seçin."

#: installer.rs:820
msgid "Choose the system partition."
msgstr "Sistem bölməsini seçin."

#: installer.rs:822
msgid "The EFI and system partitions must be different."
msgstr "EFI və sistem bölmələri fərqli olmalıdır."

#: installer.rs:824
msgid "Encryption needs a separate boot partition."
msgstr "Şifrələmə üçün ayrıca yükləmə bölməsi lazımdır."

#: installer.rs:833
msgid "The system partition must be at least {size}."
msgstr "Sistem bölməsi ən azı {size} olmalıdır."

#: installer.rs:835
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI bölməsi FAT ilə formatlanmayıb; formatlamanı yandırın."

#: installer.rs:837
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Sistem bölməsi qoşulub; əvvəlcə onu Disklər-də ayırın."

#: installer.rs:859
msgid "Where Should MAN Be Installed?"
msgstr "MAN hara quraşdırılsın?"

