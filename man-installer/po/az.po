msgid "Passphrase"
msgstr "Parol ifadəsi"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Parol ifadəsini təsdiqlə"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Bu parol ifadəsini etibarlı yerdə saxlayın"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "İtsə, heç kim məlumatları bərpa edə bilməz. Nüvə və yükləmə faylları kiçik, şifrələnməmiş yükləmə bölməsində qalır."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Parol ifadəsi ən azı 8 simvol olmalıdır."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Parol ifadələri uyğun gəlmir."

