msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Sistem bölməsi Btrfs ilə formatlanır və @system, @home və @snapshots ehtiva edir. MAN-ın işlədiyi diskin bölmələri göstərilmir."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Bölmə yaratmaq və ya ölçüsünü dəyişmək üçün Diskləri aç"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Bölmə siyahısını yenilə"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Bölmə seçin"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI sistem bölməsi"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI sistem bölməsini formatla"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Digər sistemlərin yükləyicilərini saxlamaq üçün söndürülmüş qoyun"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Sistem bölməsi (Btrfs kimi formatlanır)"

