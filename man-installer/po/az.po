msgstr "EFI sistem bölməsi yoxdur"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Yalnız {free} boşdur, MAN-a {need} lazımdır. Windows-da DUHACH! ilə yer açın."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Boş yer yoxdur. MAN üçün yer açmaq üçün Windows-da DUHACH!-ı başladın."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN bu diskdən işləyir"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "İstifadədədir: bölmə qoşulub"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Çox kiçikdir, MAN-a {need} lazımdır"

