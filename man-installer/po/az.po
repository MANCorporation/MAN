#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Bu fayl burada quraşdırıla bilən tətbiq deyil (.deb, .flatpak, .flatpakref və ya AppImage)."

#: appinstaller.rs:128
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Bu tətbiq {arch} kompüterləri üçün hazırlanıb və bu kompüterdə (x86-64) işləmir."

#: appinstaller.rs:313
msgid "The file could not be read. It may be damaged."
