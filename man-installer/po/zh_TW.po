msgstr "開機分割區"

#: installer.rs:980
msgid "Space for MAN"
msgstr "MAN 的空間"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} 可用空間（將建立開機分割區和系統分割區）"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
