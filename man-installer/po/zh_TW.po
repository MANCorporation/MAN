msgid "_Close"
msgstr "關閉(_C)"

#: appinstaller.rs:1199
msgid "The Installation Was Successful"
msgstr "安裝成功"

#: appinstaller.rs:1199
msgid "The app was installed."
msgstr "應用程式已安裝。"

#: appinstaller.rs:1204
msgid "The Installation Failed"
msgstr "安裝失敗"

#: appinstaller.rs:1215
msgid "_Open"
msgstr "開啟(_O)"

#: appinstaller.rs:1225
msgid "_Show Details"
msgstr "顯示詳細資訊(_S)"

#: appinstaller.rs:1228
msgid "Installation Log"
msgstr "安裝紀錄"

#: appinstaller.rs:1255
msgid "App Installer"
msgstr "應用程式安裝程式"

#: appinstaller.rs:1276
msgid "Go _Back"
msgstr "返回(_B)"

