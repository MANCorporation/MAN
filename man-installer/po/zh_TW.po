msgid "no home folders"
msgstr "無家目錄"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "家目錄：{list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "快照：{n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "{model} 上的 MAN"

