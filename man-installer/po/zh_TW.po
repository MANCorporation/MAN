msgstr "安裝(_I)"

#: appinstaller.rs:848
msgid "Debian package (.deb)"
msgstr "Debian 套件（.deb）"

#: appinstaller.rs:849
msgid "Flatpak app"
msgstr "Flatpak 應用程式"

