"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "이 파일은 여기서 설치할 수 있는 앱(.deb, .flatpak, .flatpakref 또는 AppImage)이 아닙니다."

#: appinstaller.rs:128
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "이 앱은 {arch} 컴퓨터용이며 이 컴퓨터(x86-64)에서는 작동하지 않습니다."

#: appinstaller.rs:313
msgid "The file could not be read. It may be damaged."
msgstr "파일을 읽을 수 없습니다. 손상되었을 수 있습니다."

#: appinstaller.rs:485
msgid "This is not an AppImage."
msgstr "AppImage가 아닙니다."

#: appinstaller.rs:679
msgid "Introduction"
msgstr "소개"

#: appinstaller.rs:680
msgid "License"
msgstr "사용권"

#: appinstaller.rs:681
msgid "Destination Select"
msgstr "설치 위치 선택"

#: appinstaller.rs:682
msgid "Installation Type"
msgstr "설치 유형"

#: appinstaller.rs:683
msgid "Installation"
msgstr "설치"

#: appinstaller.rs:684
msgid "Summary"
msgstr "요약"

#: appinstaller.rs:790
msgid "_Continue"
msgstr "계속(_C)"

#: appinstaller.rs:799
msgid "Welcome to the {name} Installer"
msgstr "{name} 설치 프로그램에 오신 것을 환영합니다"

#: appinstaller.rs:803
msgid "Software License Agreement"
msgstr "소프트웨어 사용권 계약"

#: appinstaller.rs:813
msgid "Do You Agree to the License?"
msgstr "사용권에 동의하십니까?"

#: appinstaller.rs:814
msgid "To continue installing, you must agree to the terms of the software license agreement."
msgstr "설치를 계속하려면 소프트웨어 사용권 계약 조건에 동의해야 합니다."

#: appinstaller.rs:816
msgid "_Read License"
msgstr "사용권 읽기(_R)"

#: appinstaller.rs:817
msgid "_Agree"
msgstr "동의(_A)"

#: appinstaller.rs:830
msgid "Select a Destination"
msgstr "설치 위치 선택"

#: appinstaller.rs:834
msgid "Standard Install"
msgstr "표준 설치"

#: appinstaller.rs:835
msgid "_Install"
msgstr "설치(_I)"

#: appinstaller.rs:848
msgid "Debian package (.deb)"
msgstr "데비안 패키지(.deb)"

#: appinstaller.rs:849
msgid "Flatpak app"
msgstr "Flatpak 앱"

#: appinstaller.rs:850
msgid "Flatpak app from {source}"
msgstr "{source}의 Flatpak 앱"

#: appinstaller.rs:851
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:869
msgid "You will be guided through the steps necessary to install this software."
msgstr "이 소프트웨어를 설치하는 데 필요한 단계를 안내합니다."

#: appinstaller.rs:880
msgid "Version"
msgstr "버전"

#: appinstaller.rs:883
msgid "Publisher"
msgstr "게시자"

#: appinstaller.rs:885
msgid "Type"
msgstr "종류"

#: appinstaller.rs:887
msgid "Size"
msgstr "크기"

#: appinstaller.rs:893
msgid "Website"
msgstr "웹사이트"

#: appinstaller.rs:895
msgid "File"
msgstr "파일"

#: appinstaller.rs:905
msgid "This app is installed already. Installing it again replaces it."
msgstr "이 앱은 이미 설치되어 있습니다. 다시 설치하면 교체됩니다."

#: appinstaller.rs:908
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr ".deb 패키지의 앱은 시스템의 일부가 됩니다. MAN 업데이트는 시스템을 교체하므로 유지하도록 선택한 경우에만 업데이트 후 다시 설치됩니다(다음 단계)."

#: appinstaller.rs:911
msgid "Only install apps from sources you trust."
msgstr "신뢰할 수 있는 출처의 앱만 설치하십시오."

#: appinstaller.rs:917
msgid "Where do you want to install {name}?"
msgstr "{name}을(를) 어디에 설치하시겠습니까?"

#: appinstaller.rs:922
msgid "Only your account can use the app."
msgstr "내 계정만 이 앱을 사용할 수 있습니다."

#: appinstaller.rs:923
msgid "Needs administrator rights."
msgstr "관리자 권한이 필요합니다."

#: appinstaller.rs:930
msgid "Only for Me"
msgstr "나만 사용"

#: appinstaller.rs:930
msgid "For All Users of This Computer"
msgstr "이 컴퓨터의 모든 사용자"

#: appinstaller.rs:945
msgid "This will take {size} of space on your computer."
msgstr "컴퓨터에서 {size}의 공간을 사용합니다."

#: appinstaller.rs:947
msgid "The app is downloaded from {source}."
msgstr "앱을 {source}에서 다운로드합니다."

#: appinstaller.rs:949
msgid "The app is installed for all users of this computer."
msgstr "이 컴퓨터의 모든 사용자를 위해 앱을 설치합니다."

#: appinstaller.rs:949
msgid "The app is installed only for you."
msgstr "나만을 위해 앱을 설치합니다."

#: appinstaller.rs:952
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage를 {folder}(으)로 옮기고 앱 목록에 추가합니다."

#: appinstaller.rs:958
msgid "Keep After MAN Updates"
msgstr "MAN 업데이트 후에도 유지"

#: appinstaller.rs:959
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "MAN은 업데이트할 때마다 앱을 다시 설치합니다. 이를 위해 패키지 파일을 보관합니다."

#: appinstaller.rs:967
msgid "Click Install to install {name}."
msgstr "{name}을(를) 설치하려면 설치를 누르십시오."

#: appinstaller.rs:973
msgid "Checking what else the app needs…"
msgstr "앱에 더 필요한 것을 확인하는 중…"

#: appinstaller.rs:983
msgid "Also installs the packages it needs: {list}"
msgstr "필요한 패키지도 함께 설치합니다: {list}"

#: appinstaller.rs:989
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "앱에 필요한 일부 패키지를 아직 사용할 수 없습니다. 설치할 때 먼저 최신 패키지 목록을 가져오며, 그래도 없으면 앱을 설치할 수 없습니다."

#: appinstaller.rs:1050
msgid "Installing {name}…"
msgstr "{name} 설치 중…"

#: appinstaller.rs:1056
msgid "Preparing…"
msgstr "준비 중…"

#: appinstaller.rs:1063
msgid "Details"
msgstr "자세히"

#: appinstaller.rs:1103
msgid "Installing the package…"
msgstr "패키지 설치 중…"

#: appinstaller.rs:1122
msgid "Moving the app to its folder…"
msgstr "앱을 해당 폴더로 옮기는 중…"

#: appinstaller.rs:1131
msgid "The app could not be installed."
msgstr "앱을 설치할 수 없습니다."

#: appinstaller.rs:1135
msgid "Installing the app with Flatpak…"
msgstr "Flatpak으로 앱 설치 중…"

#: appinstaller.rs:1159
msgid "Log"
msgstr "로그"

#: appinstaller.rs:1189
msgid "_Close"
msgstr "닫기(_C)"

#: appinstaller.rs:1199
msgid "The Installation Was Successful"
msgstr "설치에 성공했습니다"

#: appinstaller.rs:1199
msgid "The app was installed."
msgstr "앱을 설치했습니다."

#: appinstaller.rs:1204
msgid "The Installation Failed"
msgstr "설치에 실패했습니다"

#: appinstaller.rs:1215
msgid "_Open"
msgstr "열기(_O)"

#: appinstaller.rs:1225
msgid "_Show Details"
msgstr "자세히 보기(_S)"

#: appinstaller.rs:1228
msgid "Installation Log"
msgstr "설치 로그"

#: appinstaller.rs:1255
msgid "App Installer"
msgstr "앱 설치 프로그램"

#: appinstaller.rs:1276
msgid "Go _Back"
msgstr "뒤로(_B)"

#: appinstaller.rs:1349
msgid "Reading the app…"
msgstr "앱을 읽는 중…"

#: appinstaller.rs:1358
msgid "Install {name}"
msgstr "{name} 설치"

#: appinstaller.rs:1377
msgid "Apps"
msgstr "앱"

#: appinstaller.rs:1383
msgid "Choose an App to Install"
msgstr "설치할 앱 선택"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "시스템 도우미를 시작할 수 없습니다."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "시스템 도우미와 통신할 수 없습니다."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "시스템 도우미와의 연결이 끊어졌습니다."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "인증이 취소되었습니다."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "이 작업에는 관리자 권한이 필요합니다."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "시스템 도우미가 예기치 않게 중지되었습니다."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "EFI 시스템 파티션이 없음"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "여유 공간이 {free}뿐이며 MAN에는 {need}가 필요합니다. Windows에서 DUHACH!로 공간을 확보하세요."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "여유 공간이 없습니다. Windows에서 DUHACH!를 실행해 MAN을 위한 공간을 만드세요."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN이 이 디스크에서 실행 중"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "사용 중: 파티션이 마운트되어 있음"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "너무 작음, MAN에는 {need}가 필요함"

#: installer.rs:108
msgid "Install MAN"
msgstr "MAN 설치"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN을 설치하는 중입니다. 끝날 때까지 기다려 주세요."

#: installer.rs:143
msgid "Language"
msgstr "언어"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "이 언어로 다시 시작(_R)"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "라이브 세션이 선택한 언어로 다시 시작되며, MAN도 이 언어로 설치됩니다."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "MAN에 오신 것을 환영합니다"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"빠르고 개방적이며 자유롭게 꾸밀 수 있는 GNOME 시스템입니다.\n"
"이 컴퓨터에 설치하거나 라이브 세션을 계속 둘러보세요."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "MAN 설치(_I)…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "MAN 계속 체험(_K)"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "디스크를 찾는 중…"

#: installer.rs:250
msgid "Welcome"
msgstr "환영합니다"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "이 컴퓨터는 레거시 BIOS 모드로 시작되었습니다. MAN은 UEFI 컴퓨터에만 설치할 수 있습니다. 다시 시작한 뒤 UEFI 부팅 옵션을 선택하세요."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "시스템 도우미가 디스크 정보를 반환하지 않았습니다."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "다음(_N)"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "디스크를 지우고 MAN 설치"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "선택한 디스크의 모든 내용이 삭제되며, Windows도 포함됩니다."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "권장. 선택한 디스크의 모든 내용이 삭제됩니다."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Windows와 함께 설치"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "권장. MAN은 Windows 옆의 여유 공간을 사용하며, Windows와 그 파일은 그대로 남습니다. 시작할 때마다 시스템을 고릅니다."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "MAN 다시 설치"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "시스템을 교체하지만 /home의 개인 파일은 유지합니다. 현재 시스템은 스냅샷으로 저장됩니다."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "사용자 지정 파티션"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "전문가용: 파티션을 직접 고르거나 디스크 앱으로 만드세요."

#: installer.rs:392
msgid "Disk"
msgstr "디스크"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "지울 디스크를 선택하세요. 사용할 수 없는 디스크는 이유와 함께 표시됩니다."

#: installer.rs:418
msgid "No disks were found"
msgstr "디스크를 찾을 수 없음"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Windows 옆의 여유 공간"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows 파티션은 건드리지 않습니다. MAN은 EFI 시스템 파티션을 공유하고 시작 메뉴에 Windows를 추가합니다."

#: installer.rs:432
msgid "{size} free"
msgstr "여유 {size}"

#: installer.rs:432
msgid "no free space"
msgstr "여유 공간 없음"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "교체할 설치"

#: installer.rs:477
msgid "no home folders"
msgstr "홈 폴더 없음"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "홈 폴더: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "스냅샷: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "{model}의 MAN"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "{device}의 암호"

#: installer.rs:500
msgid "Unlock"
msgstr "잠금 해제"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "설치를 검사할 수 없습니다."

#: installer.rs:554
msgid "Partitions"
msgstr "파티션"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "시스템 파티션은 Btrfs로 포맷되며 @system, @home, @snapshots를 포함합니다. MAN이 실행 중인 디스크의 파티션은 표시되지 않습니다."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "디스크 앱을 열어 파티션 만들기 또는 크기 조정"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "파티션 목록 새로 고침"

#: installer.rs:567
msgid "Choose a partition"
msgstr "파티션 선택"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI 시스템 파티션"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI 시스템 파티션 포맷"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "다른 시스템의 부트로더를 유지하려면 끈 상태로 두세요"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "시스템 파티션 (Btrfs로 포맷)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "부트 파티션 (암호화 시 필요)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "파티션 목록을 새로 고쳤습니다"

#: installer.rs:650
msgid "Security"
msgstr "보안"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "시스템 암호화"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "컴퓨터를 잃어버리거나 도난당해도 데이터를 보호합니다. 시작할 때마다 암호를 묻습니다."

#: installer.rs:656
msgid "Passphrase"
msgstr "암호"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "암호 확인"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "이 암호를 안전하게 보관하세요"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "잃어버리면 누구도 데이터를 복구할 수 없습니다. 커널과 부팅 파일은 암호화되지 않은 작은 부트 파티션에 남습니다."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "암호는 8자 이상이어야 합니다."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "암호가 일치하지 않습니다."

#: installer.rs:748
msgid "Choose a disk."
msgstr "디스크를 선택하세요."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Windows가 있는 디스크를 선택하세요."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "교체할 설치를 선택하세요."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "먼저 암호화된 설치의 잠금을 해제하세요."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "이 파티션에는 MAN 시스템이 없습니다."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "EFI 시스템 파티션을 선택하세요."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "시스템 파티션을 선택하세요."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI 파티션과 시스템 파티션은 서로 달라야 합니다."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "암호화에는 별도의 부트 파티션이 필요합니다."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "시스템 파티션은 {size} 이상이어야 합니다."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI 파티션이 FAT로 포맷되어 있지 않습니다. 포맷을 켜세요."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
