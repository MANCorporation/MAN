msgstr "Apache Lisansı 2.0"

#: oobe.rs:592
msgid "Libraries and tools"
msgstr "Kütüphaneler ve araçlar"

#: oobe.rs:597
msgid "License Agreement"
msgstr "Lisans sözleşmesi"

#: oobe.rs:597
msgid "Please read and accept the terms under which MAN is provided."
msgstr "MAN'ın sunulduğu koşulları okuyup kabul edin."

#: oobe.rs:608
msgid "Licenses"
msgstr "Lisanslar"

