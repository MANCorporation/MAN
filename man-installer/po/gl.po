msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Seguinte"

#: installer.rs:361
msgid "Installation Type"
msgstr "Tipo de instalación"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Borrar o disco e instalar MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Bórrase todo o que hai no disco escollido, Windows incluído."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Recomendado. Bórrase todo o que hai no disco escollido."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Instalar xunto a Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Recomendado. MAN usa o espazo libre xunto a Windows; Windows e os seus ficheiros mantéñense. Escolla o sistema en cada arranque."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Reinstalar MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Substitúe o sistema pero conserva os ficheiros persoais de /home. O sistema actual gárdase como instantánea."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Particións personalizadas"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Para expertos: escolla vostede as particións ou créeas con Discos."

