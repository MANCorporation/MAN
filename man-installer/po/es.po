msgstr "Bienvenido"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Este equipo se inició en modo BIOS heredado. MAN solo se puede instalar en equipos UEFI: reinicie y elija la opción de arranque UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "El asistente del sistema no devolvió información de los discos."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

