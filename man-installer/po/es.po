msgid "EFI System Partition"
msgstr "Partición del sistema EFI"

#: installer.rs:621
msgid "Format EFI System Partition"
msgstr "Formatear la partición del sistema EFI"

#: installer.rs:621
msgid "Leave off to keep boot loaders of other systems"
msgstr "Déjelo desactivado para conservar los cargadores de arranque de otros sistemas"

#: installer.rs:623
msgid "System Partition (formatted as Btrfs)"
msgstr "Partición del sistema (se formatea con Btrfs)"

#: installer.rs:624
msgid "Boot Partition (needed with encryption)"
msgstr "Partición de arranque (necesaria para el cifrado)"

#: installer.rs:683
msgid "Partition list refreshed"
msgstr "Lista de particiones actualizada"

#: installer.rs:691
msgid "Security"
msgstr "Seguridad"

#: installer.rs:693
msgid "Encrypt the System"
msgstr "Cifrar el sistema"

#: installer.rs:694
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Protege sus datos si pierde el equipo o se lo roban. Se pide una frase de contraseña en cada arranque."

#: installer.rs:697
msgid "Passphrase"
msgstr "Frase de contraseña"

#: installer.rs:698
msgid "Confirm Passphrase"
msgstr "Confirmar la frase de contraseña"

#: installer.rs:700
msgid "Keep this passphrase safe"
msgstr "Guarde bien esta frase de contraseña"

#: installer.rs:701
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Si la pierde, nadie podrá recuperar los datos. El núcleo y los archivos de arranque quedan en una pequeña partición de arranque sin cifrar."

#: installer.rs:774
msgid "The passphrase needs at least 8 characters."
msgstr "La frase de contraseña debe tener al menos 8 caracteres."

#: installer.rs:776
msgid "The passphrases do not match."
msgstr "Las frases de contraseña no coinciden."

#: installer.rs:790
msgid "Choose a disk."
msgstr "Elija un disco."

#: installer.rs:800
msgid "Choose the disk with Windows."
msgstr "Elija el disco con Windows."

#: installer.rs:809
msgid "Choose the installation to replace."
msgstr "Elija la instalación que se sustituirá."

#: installer.rs:810
msgid "Unlock the encrypted installation first."
msgstr "Desbloquee primero la instalación cifrada."

#: installer.rs:811
msgid "This partition holds no MAN system."
msgstr "Esta partición no contiene ningún sistema MAN."

#: installer.rs:818
msgid "Choose an EFI system partition."
msgstr "Elija una partición del sistema EFI."

#: installer.rs:820
msgid "Choose the system partition."
msgstr "Elija la partición del sistema."

#: installer.rs:822
msgid "The EFI and system partitions must be different."
msgstr "Las particiones EFI y del sistema deben ser distintas."

#: installer.rs:824
msgid "Encryption needs a separate boot partition."
msgstr "El cifrado necesita una partición de arranque aparte."

#: installer.rs:833
msgid "The system partition must be at least {size}."
msgstr "La partición del sistema debe tener al menos {size}."

#: installer.rs:835
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "La partición EFI no tiene formato FAT; active el formateo."

#: installer.rs:837
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "La partición del sistema está montada; desmóntela primero en Discos."

