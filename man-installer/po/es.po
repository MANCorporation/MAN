msgstr "Elija una partición del sistema EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Elija la partición del sistema."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Las particiones EFI y del sistema deben ser distintas."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "El cifrado necesita una partición de arranque aparte."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "La partición del sistema debe tener al menos {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "La partición EFI no tiene formato FAT; active el formateo."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "La partición del sistema está montada; desmóntela primero en Discos."

