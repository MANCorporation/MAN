#: update.rs:184
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "El archivo de actualización está dañado (la suma de comprobación no coincide). Descárguelo de nuevo."

#: update.rs:187
msgid "The update file could not be read completely."
msgstr "No se pudo leer completo el archivo de actualización."

#: update.rs:416
msgid "The update contains no kernel."
msgstr "La actualización no contiene ningún núcleo."

#: update.rs:470
msgid "Updates must be installed by the system helper."
msgstr "Las actualizaciones las debe instalar el asistente del sistema."

#: update.rs:480
msgid "The chosen installation was not found."
msgstr "No se encontró la instalación elegida."

#: update.rs:482
msgid "Only the running MAN installation can be updated."
msgstr "Solo se puede actualizar la instalación de MAN en ejecución."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Este no es un archivo de actualización de MAN (no tiene manifiesto)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "La actualización no está firmada, así que no es de confianza."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "La firma de la actualización está dañada."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "La actualización no está firmada por MAN. Puede que se haya modificado o que proceda de una fuente no fiable."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "El manifiesto de la actualización no es válido."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "La frase de contraseña no es correcta o no se puede abrir la partición cifrada."

