#: installer.rs:650
msgid "Security"
msgstr "Seguridad"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Cifrar el sistema"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Protege sus datos si pierde el equipo o se lo roban. Se pide una frase de contraseña en cada arranque."

#: installer.rs:656
msgid "Passphrase"
msgstr "Frase de contraseña"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Confirmar la frase de contraseña"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Guarde bien esta frase de contraseña"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Si la pierde, nadie podrá recuperar los datos. El núcleo y los archivos de arranque quedan en una pequeña partición de arranque sin cifrar."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "La frase de contraseña debe tener al menos 8 caracteres."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Las frases de contraseña no coinciden."

