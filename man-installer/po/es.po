msgstr "Solo para mí"

#: appinstaller.rs:930
msgid "For All Users of This Computer"
msgstr "Para todos los usuarios de este equipo"

#: appinstaller.rs:945
msgid "This will take {size} of space on your computer."
msgstr "Ocupará {size} de espacio en su equipo."

#: appinstaller.rs:947
msgid "The app is downloaded from {source}."
msgstr "La aplicación se descarga de {source}."

