#: backend.rs:46
msgid "Could not start the system helper."
msgstr "ਸਿਸਟਮ ਸਹਾਇਕ ਸ਼ੁਰੂ ਨਹੀਂ ਹੋ ਸਕਿਆ।"

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "ਸਿਸਟਮ ਸਹਾਇਕ ਨਾਲ ਸੰਪਰਕ ਨਹੀਂ ਹੋ ਸਕਿਆ।"

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "ਸਿਸਟਮ ਸਹਾਇਕ ਨਾਲ ਕਨੈਕਸ਼ਨ ਟੁੱਟ ਗਿਆ।"

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "ਅਧਿਕਾਰ ਰੱਦ ਕੀਤਾ ਗਿਆ।"

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "ਇਸ ਕਾਰਵਾਈ ਲਈ ਪ੍ਰਬੰਧਕ ਦੇ ਅਧਿਕਾਰ ਲੋੜੀਂਦੇ ਹਨ।"

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "ਸਿਸਟਮ ਸਹਾਇਕ ਅਚਾਨਕ ਰੁਕ ਗਿਆ।"

#: installer.rs:78
msgid "No EFI system partition"
msgstr "ਕੋਈ EFI ਸਿਸਟਮ ਪਾਰਟੀਸ਼ਨ ਨਹੀਂ"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "ਸਿਰਫ਼ {free} ਖਾਲੀ ਹੈ, MAN ਨੂੰ {need} ਚਾਹੀਦਾ ਹੈ। Windows ਵਿੱਚ DUHACH! ਨਾਲ ਥਾਂ ਖਾਲੀ ਕਰੋ।"

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "ਕੋਈ ਖਾਲੀ ਥਾਂ ਨਹੀਂ। MAN ਲਈ ਥਾਂ ਬਣਾਉਣ ਲਈ Windows ਵਿੱਚ DUHACH! ਚਲਾਓ।"

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN ਇਸੇ ਡਿਸਕ ਤੋਂ ਚੱਲ ਰਿਹਾ ਹੈ"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "ਵਰਤੋਂ ਵਿੱਚ: ਇੱਕ ਪਾਰਟੀਸ਼ਨ ਮਾਊਂਟ ਹੈ"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "ਬਹੁਤ ਛੋਟੀ, MAN ਨੂੰ {need} ਚਾਹੀਦਾ ਹੈ"

#: installer.rs:108
msgid "Install MAN"
msgstr "MAN ਇੰਸਟਾਲ ਕਰੋ"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN ਇੰਸਟਾਲ ਹੋ ਰਿਹਾ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਪੂਰਾ ਹੋਣ ਤੱਕ ਉਡੀਕ ਕਰੋ।"

#: installer.rs:143
msgid "Language"
msgstr "ਭਾਸ਼ਾ"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "ਇਸ ਭਾਸ਼ਾ ਵਿੱਚ ਮੁੜ ਸ਼ੁਰੂ ਕਰੋ(_R)"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "ਲਾਈਵ ਸੈਸ਼ਨ ਚੁਣੀ ਭਾਸ਼ਾ ਵਿੱਚ ਮੁੜ ਸ਼ੁਰੂ ਹੋਵੇਗਾ, ਅਤੇ MAN ਉਸੇ ਭਾਸ਼ਾ ਵਿੱਚ ਇੰਸਟਾਲ ਹੋਵੇਗਾ।"

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "MAN ਵਿੱਚ ਜੀ ਆਇਆਂ ਨੂੰ"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"ਤੇਜ਼, ਖੁੱਲ੍ਹਾ ਅਤੇ ਪੂਰੀ ਤਰ੍ਹਾਂ ਅਨੁਕੂਲ ਬਣਾਉਣਯੋਗ GNOME ਸਿਸਟਮ।\n"
"ਇਸਨੂੰ ਇਸ ਕੰਪਿਊਟਰ ਉੱਤੇ ਇੰਸਟਾਲ ਕਰੋ, ਜਾਂ ਲਾਈਵ ਸੈਸ਼ਨ ਵੇਖਦੇ ਰਹੋ।"

#: installer.rs:218
msgid "_Install MAN…"
msgstr "MAN ਇੰਸਟਾਲ ਕਰੋ(_I)…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "MAN ਅਜ਼ਮਾਉਂਦੇ ਰਹੋ(_K)"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "ਡਿਸਕਾਂ ਲੱਭ ਰਹੇ ਹਾਂ…"

#: installer.rs:250
msgid "Welcome"
msgstr "ਜੀ ਆਇਆਂ ਨੂੰ"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "ਇਹ ਕੰਪਿਊਟਰ ਪੁਰਾਣੇ BIOS ਮੋਡ ਵਿੱਚ ਸ਼ੁਰੂ ਹੋਇਆ ਹੈ। MAN ਸਿਰਫ਼ UEFI ਕੰਪਿਊਟਰਾਂ ਉੱਤੇ ਇੰਸਟਾਲ ਹੋ ਸਕਦਾ ਹੈ: ਮੁੜ ਸ਼ੁਰੂ ਕਰੋ ਅਤੇ UEFI ਬੂਟ ਵਿਕਲਪ ਚੁਣੋ।"

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "ਸਿਸਟਮ ਸਹਾਇਕ ਨੇ ਡਿਸਕਾਂ ਦੀ ਕੋਈ ਜਾਣਕਾਰੀ ਨਹੀਂ ਦਿੱਤੀ।"

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "ਅੱਗੇ(_N)"

#: installer.rs:361
msgid "Installation Type"
msgstr "ਇੰਸਟਾਲੇਸ਼ਨ ਦੀ ਕਿਸਮ"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "ਡਿਸਕ ਮਿਟਾਓ ਅਤੇ MAN ਇੰਸਟਾਲ ਕਰੋ"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "ਚੁਣੀ ਡਿਸਕ ਉੱਤੇ ਸਭ ਕੁਝ ਮਿਟ ਜਾਵੇਗਾ, Windows ਸਮੇਤ।"

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "ਸਿਫ਼ਾਰਸ਼ੀ। ਚੁਣੀ ਡਿਸਕ ਉੱਤੇ ਸਭ ਕੁਝ ਮਿਟ ਜਾਵੇਗਾ।"

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Windows ਦੇ ਨਾਲ ਇੰਸਟਾਲ ਕਰੋ"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "ਸਿਫ਼ਾਰਸ਼ੀ। MAN, Windows ਦੇ ਨਾਲ ਦੀ ਖਾਲੀ ਥਾਂ ਵਰਤਦਾ ਹੈ; Windows ਅਤੇ ਉਸ ਦੀਆਂ ਫ਼ਾਈਲਾਂ ਰਹਿੰਦੀਆਂ ਹਨ। ਹਰ ਵਾਰ ਸ਼ੁਰੂ ਕਰਨ ਵੇਲੇ ਸਿਸਟਮ ਚੁਣੋ।"

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "MAN ਮੁੜ ਇੰਸਟਾਲ ਕਰੋ"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "ਸਿਸਟਮ ਬਦਲਦਾ ਹੈ ਪਰ /home ਦੀਆਂ ਨਿੱਜੀ ਫ਼ਾਈਲਾਂ ਰੱਖਦਾ ਹੈ। ਮੌਜੂਦਾ ਸਿਸਟਮ ਸਨੈਪਸ਼ਾਟ ਵਜੋਂ ਸੰਭਾਲਿਆ ਜਾਂਦਾ ਹੈ।"

#: installer.rs:383
msgid "Custom Partitions"
msgstr "ਆਪਣੇ ਪਾਰਟੀਸ਼ਨ"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "ਮਾਹਿਰਾਂ ਲਈ: ਪਾਰਟੀਸ਼ਨ ਆਪ ਚੁਣੋ, ਜਾਂ Disks ਨਾਲ ਬਣਾਓ।"

#: installer.rs:392
msgid "Disk"
msgstr "ਡਿਸਕ"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "ਮਿਟਾਉਣ ਲਈ ਡਿਸਕ ਚੁਣੋ। ਜੋ ਡਿਸਕਾਂ ਵਰਤੀਆਂ ਨਹੀਂ ਜਾ ਸਕਦੀਆਂ ਉਹ ਕਾਰਨ ਸਮੇਤ ਦਿਖਾਈਆਂ ਜਾਂਦੀਆਂ ਹਨ।"

#: installer.rs:418
msgid "No disks were found"
msgstr "ਕੋਈ ਡਿਸਕ ਨਹੀਂ ਮਿਲੀ"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Windows ਦੇ ਨਾਲ ਖਾਲੀ ਥਾਂ"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows ਦੇ ਪਾਰਟੀਸ਼ਨਾਂ ਨੂੰ ਛੂਹਿਆ ਨਹੀਂ ਜਾਂਦਾ। MAN, EFI ਸਿਸਟਮ ਪਾਰਟੀਸ਼ਨ ਸਾਂਝਾ ਕਰਦਾ ਹੈ ਅਤੇ Windows ਨੂੰ ਆਪਣੇ ਬੂਟ ਮੀਨੂ ਵਿੱਚ ਜੋੜਦਾ ਹੈ।"

#: installer.rs:432
msgid "{size} free"
msgstr "{size} ਖਾਲੀ"

#: installer.rs:432
msgid "no free space"
msgstr "ਕੋਈ ਖਾਲੀ ਥਾਂ ਨਹੀਂ"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "ਬਦਲੀ ਜਾਣ ਵਾਲੀ ਇੰਸਟਾਲੇਸ਼ਨ"

#: installer.rs:477
msgid "no home folders"
msgstr "ਕੋਈ ਘਰ ਫੋਲਡਰ ਨਹੀਂ"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "ਘਰ ਫੋਲਡਰ: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "ਸਨੈਪਸ਼ਾਟ: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "{model} ਉੱਤੇ MAN"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "{device} ਲਈ ਪਾਸਫ਼ਰੇਜ਼"

#: installer.rs:500
msgid "Unlock"
msgstr "ਅਨਲੌਕ ਕਰੋ"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "ਇੰਸਟਾਲੇਸ਼ਨ ਜਾਂਚੀ ਨਹੀਂ ਜਾ ਸਕੀ।"

#: installer.rs:554
msgid "Partitions"
msgstr "ਪਾਰਟੀਸ਼ਨ"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "ਸਿਸਟਮ ਪਾਰਟੀਸ਼ਨ Btrfs ਵਿੱਚ ਫਾਰਮੈਟ ਹੁੰਦਾ ਹੈ ਅਤੇ ਇਸ ਵਿੱਚ @system, @home ਅਤੇ @snapshots ਹੁੰਦੇ ਹਨ। ਜਿਸ ਡਿਸਕ ਤੋਂ MAN ਚੱਲ ਰਿਹਾ ਹੈ ਉਸਦੇ ਪਾਰਟੀਸ਼ਨ ਸੂਚੀ ਵਿੱਚ ਨਹੀਂ ਹਨ।"

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "ਪਾਰਟੀਸ਼ਨ ਬਣਾਉਣ ਜਾਂ ਆਕਾਰ ਬਦਲਣ ਲਈ Disks ਖੋਲ੍ਹੋ"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "ਪਾਰਟੀਸ਼ਨ ਸੂਚੀ ਤਾਜ਼ਾ ਕਰੋ"

#: installer.rs:567
msgid "Choose a partition"
msgstr "ਇੱਕ ਪਾਰਟੀਸ਼ਨ ਚੁਣੋ"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI ਸਿਸਟਮ ਪਾਰਟੀਸ਼ਨ"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI ਸਿਸਟਮ ਪਾਰਟੀਸ਼ਨ ਫਾਰਮੈਟ ਕਰੋ"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "ਹੋਰ ਸਿਸਟਮਾਂ ਦੇ ਬੂਟ ਲੋਡਰ ਰੱਖਣ ਲਈ ਬੰਦ ਰਹਿਣ ਦਿਓ"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "ਸਿਸਟਮ ਪਾਰਟੀਸ਼ਨ (Btrfs ਵਜੋਂ ਫਾਰਮੈਟ ਹੋਵੇਗਾ)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "ਬੂਟ ਪਾਰਟੀਸ਼ਨ (ਇਨਕ੍ਰਿਪਸ਼ਨ ਲਈ ਲੋੜੀਂਦਾ)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "ਪਾਰਟੀਸ਼ਨ ਸੂਚੀ ਤਾਜ਼ਾ ਹੋਈ"

#: installer.rs:650
msgid "Security"
msgstr "ਸੁਰੱਖਿਆ"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "ਸਿਸਟਮ ਇਨਕ੍ਰਿਪਟ ਕਰੋ"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "ਕੰਪਿਊਟਰ ਗੁੰਮ ਜਾਂ ਚੋਰੀ ਹੋਣ ਉੱਤੇ ਤੁਹਾਡਾ ਡਾਟਾ ਸੁਰੱਖਿਅਤ ਰੱਖਦਾ ਹੈ। ਹਰ ਸ਼ੁਰੂਆਤ ਉੱਤੇ ਪਾਸਫ਼ਰੇਜ਼ ਪੁੱਛਿਆ ਜਾਂਦਾ ਹੈ।"

#: installer.rs:656
msgid "Passphrase"
msgstr "ਪਾਸਫ਼ਰੇਜ਼"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "ਪਾਸਫ਼ਰੇਜ਼ ਦੀ ਪੁਸ਼ਟੀ ਕਰੋ"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "ਇਹ ਪਾਸਫ਼ਰੇਜ਼ ਸੁਰੱਖਿਅਤ ਰੱਖੋ"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "ਜੇ ਇਹ ਗੁੰਮ ਹੋ ਗਿਆ ਤਾਂ ਕੋਈ ਵੀ ਡਾਟਾ ਵਾਪਸ ਨਹੀਂ ਲਿਆ ਸਕੇਗਾ। ਕਰਨਲ ਅਤੇ ਬੂਟ ਫ਼ਾਈਲਾਂ ਇੱਕ ਛੋਟੇ ਗੈਰ-ਇਨਕ੍ਰਿਪਟ ਬੂਟ ਪਾਰਟੀਸ਼ਨ ਉੱਤੇ ਰਹਿੰਦੀਆਂ ਹਨ।"

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "ਪਾਸਫ਼ਰੇਜ਼ ਵਿੱਚ ਘੱਟੋ-ਘੱਟ 8 ਅੱਖਰ ਹੋਣੇ ਚਾਹੀਦੇ ਹਨ।"

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "ਪਾਸਫ਼ਰੇਜ਼ ਮੇਲ ਨਹੀਂ ਖਾਂਦੇ।"

#: installer.rs:748
msgid "Choose a disk."
msgstr "ਇੱਕ ਡਿਸਕ ਚੁਣੋ।"

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Windows ਵਾਲੀ ਡਿਸਕ ਚੁਣੋ।"

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "ਬਦਲੀ ਜਾਣ ਵਾਲੀ ਇੰਸਟਾਲੇਸ਼ਨ ਚੁਣੋ।"

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "ਪਹਿਲਾਂ ਇਨਕ੍ਰਿਪਟ ਇੰਸਟਾਲੇਸ਼ਨ ਅਨਲੌਕ ਕਰੋ।"

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "ਇਸ ਪਾਰਟੀਸ਼ਨ ਵਿੱਚ ਕੋਈ MAN ਸਿਸਟਮ ਨਹੀਂ ਹੈ।"

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "ਇੱਕ EFI ਸਿਸਟਮ ਪਾਰਟੀਸ਼ਨ ਚੁਣੋ।"

#: installer.rs:778
msgid "Choose the system partition."
msgstr "ਸਿਸਟਮ ਪਾਰਟੀਸ਼ਨ ਚੁਣੋ।"

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI ਅਤੇ ਸਿਸਟਮ ਪਾਰਟੀਸ਼ਨ ਵੱਖਰੇ ਹੋਣੇ ਚਾਹੀਦੇ ਹਨ।"

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "ਇਨਕ੍ਰਿਪਸ਼ਨ ਲਈ ਵੱਖਰਾ ਬੂਟ ਪਾਰਟੀਸ਼ਨ ਲੋੜੀਂਦਾ ਹੈ।"

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "ਸਿਸਟਮ ਪਾਰਟੀਸ਼ਨ ਘੱਟੋ-ਘੱਟ {size} ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ।"

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI ਪਾਰਟੀਸ਼ਨ FAT ਵਿੱਚ ਫਾਰਮੈਟ ਨਹੀਂ; ਫਾਰਮੈਟਿੰਗ ਚਾਲੂ ਕਰੋ।"

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "ਸਿਸਟਮ ਪਾਰਟੀਸ਼ਨ ਮਾਊਂਟ ਹੈ; ਪਹਿਲਾਂ ਇਸਨੂੰ Disks ਵਿੱਚ ਅਨਮਾਊਂਟ ਕਰੋ।"

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "MAN ਕਿੱਥੇ ਇੰਸਟਾਲ ਕਰਨਾ ਹੈ?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "ਸਮਾਂ ਅਤੇ ਕੀਬੋਰਡ"

#: installer.rs:829
msgid "Time Zone"
msgstr "ਸਮਾਂ ਖੇਤਰ"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "ਕੀਬੋਰਡ ਖਾਕਾ"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "ਆਪਣਾ ਕੀਬੋਰਡ ਜਾਂਚੋ"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "ਕੁੰਜੀਆਂ ਸਹੀ ਅੱਖਰ ਲਿਖਦੀਆਂ ਹਨ ਜਾਂ ਨਹੀਂ ਇਹ ਜਾਂਚਣ ਲਈ ਇੱਥੇ ਟਾਈਪ ਕਰੋ।"

#: installer.rs:844
msgid "Type here"
msgstr "ਇੱਥੇ ਟਾਈਪ ਕਰੋ"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "ਸਮਾਂ ਖੇਤਰ ਅਤੇ ਕੀਬੋਰਡ"

#: installer.rs:920
