msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "اپ ڈیٹ پر MAN کے دستخط نہیں۔ ممکن ہے اسے بدلا گیا ہو یا یہ ناقابلِ اعتماد ذریعے سے آئی ہو۔"

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "اپ ڈیٹ کا مینیفیسٹ غلط ہے۔"

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "پاس فریز درست نہیں، یا انکرپٹڈ پارٹیشن نہیں کھل سکتا۔"

