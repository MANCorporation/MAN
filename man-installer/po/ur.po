msgid "Log"
msgstr "لاگ"

#: appinstaller.rs:1196
msgid "_Close"
msgstr "_بند کریں"

#: appinstaller.rs:1206
msgid "The Installation Was Successful"
msgstr "انسٹالیشن کامیاب رہی"

#: appinstaller.rs:1206
msgid "The app was installed."
msgstr "ایپ انسٹال ہو گئی۔"

#: appinstaller.rs:1211
msgid "The Installation Failed"
msgstr "انسٹالیشن ناکام ہو گئی"

#: appinstaller.rs:1222
msgid "_Open"
msgstr "_کھولیں"

#: appinstaller.rs:1232
msgid "_Show Details"
msgstr "_تفصیلات دکھائیں"

#: appinstaller.rs:1235
msgid "Installation Log"
msgstr "انسٹالیشن لاگ"

#: appinstaller.rs:1262
msgid "App Installer"
msgstr "ایپ انسٹالر"

#: appinstaller.rs:1283
msgid "Go _Back"
msgstr "_واپس"

#: appinstaller.rs:1356
msgid "Reading the app…"
msgstr "ایپ پڑھی جا رہی ہے…"

#: appinstaller.rs:1365
msgid "Install {name}"
msgstr "{name} انسٹال کریں"

#: appinstaller.rs:1384
msgid "Apps"
msgstr "ایپس"

#: appinstaller.rs:1390
msgid "Choose an App to Install"
msgstr "انسٹال کرنے کے لیے ایپ منتخب کریں"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "سسٹم معاون شروع نہیں ہو سکا۔"

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "سسٹم معاون سے رابطہ نہیں ہو سکا۔"

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "سسٹم معاون سے رابطہ ٹوٹ گیا۔"

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "اجازت منسوخ کر دی گئی۔"

#: backend.rs:87
