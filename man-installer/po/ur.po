msgstr ""
"Project-Id-Version: man-installer\n"
"Language: ur\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: backend.rs:46
msgid "Could not start the system helper."
msgstr "سسٹم معاون شروع نہیں ہو سکا۔"

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "سسٹم معاون سے رابطہ نہیں ہو سکا۔"

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "سسٹم معاون سے رابطہ ٹوٹ گیا۔"

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "اجازت منسوخ کر دی گئی۔"

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "اس کام کے لیے منتظم کے اختیارات درکار ہیں۔"

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "سسٹم معاون اچانک رک گیا۔"

#: installer.rs:78
msgid "No EFI system partition"
msgstr "کوئی EFI سسٹم پارٹیشن نہیں"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "صرف {free} خالی ہے، MAN کو {need} چاہیے۔ Windows میں DUHACH! سے جگہ خالی کریں۔"

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "کوئی خالی جگہ نہیں۔ MAN کے لیے جگہ بنانے کو Windows میں DUHACH! چلائیں۔"

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN اسی ڈسک سے چل رہا ہے"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "زیرِ استعمال: ایک پارٹیشن ماؤنٹ ہے"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "بہت چھوٹی، MAN کو {need} چاہیے"

#: installer.rs:108
msgid "Install MAN"
msgstr "MAN انسٹال کریں"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN انسٹال ہو رہا ہے۔ براہ کرم مکمل ہونے تک انتظار کریں۔"

#: installer.rs:143
msgid "Language"
msgstr "زبان"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_اس زبان میں دوبارہ شروع کریں"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "لائیو سیشن منتخب زبان میں دوبارہ شروع ہوگا، اور MAN اسی زبان میں انسٹال ہوگا۔"

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "MAN میں خوش آمدید"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"ایک تیز، کھلا اور مکمل طور پر قابلِ ترتیب GNOME سسٹم۔\n"
"اسے اس کمپیوٹر پر انسٹال کریں، یا لائیو سیشن کو آزماتے رہیں۔"

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_MAN انسٹال کریں…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_MAN آزماتے رہیں"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "ڈسکیں تلاش ہو رہی ہیں…"

#: installer.rs:250
msgid "Welcome"
msgstr "خوش آمدید"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "یہ کمپیوٹر پرانے BIOS موڈ میں شروع ہوا ہے۔ MAN صرف UEFI کمپیوٹرز پر انسٹال ہو سکتا ہے: دوبارہ شروع کریں اور UEFI بوٹ آپشن منتخب کریں۔"

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "سسٹم معاون نے ڈسکوں کی کوئی معلومات نہیں دی۔"

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_اگلا"

#: installer.rs:361
msgid "Installation Type"
msgstr "انسٹالیشن کی قسم"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "ڈسک مٹائیں اور MAN انسٹال کریں"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "منتخب ڈسک پر سب کچھ مٹا دیا جائے گا، Windows بھی۔"

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "تجویز کردہ۔ منتخب ڈسک پر سب کچھ مٹا دیا جائے گا۔"

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Windows کے ساتھ انسٹال کریں"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "تجویز کردہ۔ MAN، Windows کے برابر والی خالی جگہ استعمال کرتا ہے؛ Windows اور اس کی فائلیں رہتی ہیں۔ ہر بار شروع کرتے وقت سسٹم منتخب کریں۔"

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "MAN دوبارہ انسٹال کریں"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "سسٹم بدل دیتا ہے مگر ‎/home کی ذاتی فائلیں رکھتا ہے۔ موجودہ سسٹم اسنیپ شاٹ کے طور پر محفوظ ہوتا ہے۔"

#: installer.rs:383
msgid "Custom Partitions"
msgstr "حسبِ منشا پارٹیشن"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "ماہرین کے لیے: پارٹیشن خود منتخب کریں، یا Disks سے بنائیں۔"

#: installer.rs:392
msgid "Disk"
msgstr "ڈسک"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "مٹانے کے لیے ڈسک منتخب کریں۔ جو ڈسکیں استعمال نہیں ہو سکتیں وہ وجہ کے ساتھ دکھائی جاتی ہیں۔"

#: installer.rs:418
msgid "No disks were found"
msgstr "کوئی ڈسک نہیں ملی"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Windows کے برابر خالی جگہ"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows کے پارٹیشنز کو نہیں چھیڑا جاتا۔ MAN، EFI سسٹم پارٹیشن شیئر کرتا ہے اور Windows کو اپنے بوٹ مینو میں شامل کرتا ہے۔"

#: installer.rs:432
msgid "{size} free"
msgstr "{size} خالی"

#: installer.rs:432
msgid "no free space"
msgstr "کوئی خالی جگہ نہیں"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "بدلی جانے والی انسٹالیشن"

#: installer.rs:477
msgid "no home folders"
msgstr "کوئی ہوم فولڈر نہیں"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "ہوم فولڈر: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "اسنیپ شاٹ: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "{model} پر MAN"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "{device} کا پاس فریز"

#: installer.rs:500
msgid "Unlock"
msgstr "کھولیں"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "انسٹالیشن کی جانچ نہیں ہو سکی۔"

#: installer.rs:554
msgid "Partitions"
msgstr "پارٹیشنز"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "سسٹم پارٹیشن Btrfs میں فارمیٹ ہوتا ہے اور اس میں ‎@system، ‎@home اور ‎@snapshots ہوتے ہیں۔ جس ڈسک سے MAN چل رہا ہے اس کے پارٹیشن فہرست میں نہیں ہیں۔"

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "پارٹیشن بنانے یا سائز بدلنے کے لیے Disks کھولیں"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "پارٹیشن فہرست تازہ کریں"

#: installer.rs:567
msgid "Choose a partition"
msgstr "ایک پارٹیشن منتخب کریں"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI سسٹم پارٹیشن"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI سسٹم پارٹیشن فارمیٹ کریں"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "دوسرے سسٹمز کے بوٹ لوڈر رکھنے کے لیے بند رہنے دیں"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "سسٹم پارٹیشن (Btrfs میں فارمیٹ ہوگا)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "بوٹ پارٹیشن (انکرپشن کے لیے ضروری)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "پارٹیشن فہرست تازہ ہو گئی"

#: installer.rs:650
msgid "Security"
msgstr "سیکیورٹی"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "سسٹم انکرپٹ کریں"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "کمپیوٹر گم یا چوری ہونے پر آپ کا ڈیٹا محفوظ رکھتا ہے۔ ہر بار شروع ہونے پر پاس فریز پوچھا جاتا ہے۔"

#: installer.rs:656
msgid "Passphrase"
msgstr "پاس فریز"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "پاس فریز کی تصدیق کریں"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "یہ پاس فریز محفوظ رکھیں"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "اگر یہ کھو گیا تو کوئی بھی ڈیٹا واپس نہیں لا سکے گا۔ کرنل اور بوٹ فائلیں ایک چھوٹے غیر انکرپٹڈ بوٹ پارٹیشن پر رہتی ہیں۔"

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "پاس فریز میں کم از کم 8 حروف ہونے چاہئیں۔"

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "پاس فریز آپس میں نہیں ملتے۔"

#: installer.rs:748
msgid "Choose a disk."
msgstr "ایک ڈسک منتخب کریں۔"

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Windows والی ڈسک منتخب کریں۔"

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "بدلی جانے والی انسٹالیشن منتخب کریں۔"

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "پہلے انکرپٹڈ انسٹالیشن کھولیں۔"

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "اس پارٹیشن میں کوئی MAN سسٹم نہیں ہے۔"

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "ایک EFI سسٹم پارٹیشن منتخب کریں۔"

#: installer.rs:778
msgid "Choose the system partition."
msgstr "سسٹم پارٹیشن منتخب کریں۔"

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI اور سسٹم پارٹیشن مختلف ہونے چاہئیں۔"

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "انکرپشن کے لیے الگ بوٹ پارٹیشن ضروری ہے۔"

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "سسٹم پارٹیشن کم از کم {size} ہونا چاہیے۔"

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI پارٹیشن FAT میں فارمیٹ نہیں؛ فارمیٹنگ آن کریں۔"

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "سسٹم پارٹیشن ماؤنٹ ہے؛ پہلے اسے Disks میں ان ماؤنٹ کریں۔"

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "MAN کہاں انسٹال کیا جائے؟"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "وقت اور کی بورڈ"

#: installer.rs:829
msgid "Time Zone"
msgstr "ٹائم زون"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "کی بورڈ لے آؤٹ"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "اپنا کی بورڈ آزمائیں"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "یہاں ٹائپ کر کے جانچیں کہ کلیدیں درست حروف لکھتی ہیں۔"

#: installer.rs:844
msgid "Type here"
msgstr "یہاں ٹائپ کریں"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "ٹائم زون اور کی بورڈ"

#: installer.rs:920
msgid "No disk chosen"
msgstr "کوئی ڈسک منتخب نہیں"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "کوئی سسٹم پارٹیشن منتخب نہیں"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "سسٹم پارٹیشن غائب ہو گیا"

#: installer.rs:933
msgid "No installation chosen"
msgstr "کوئی انسٹالیشن منتخب نہیں"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "ڈسک غائب ہو گئی"

#: installer.rs:955
msgid "Review"
msgstr "جائزہ"

#: installer.rs:958
msgid "Destination"
msgstr "منزل"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "ڈسک مٹائیں اور انسٹال کریں"

#: installer.rs:961
msgid "Custom partitions"
msgstr "حسبِ منشا پارٹیشن"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "‎/home رکھتے ہوئے دوبارہ انسٹال کریں"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Windows کے ساتھ"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (فارمیٹ ہوگا)"

#: installer.rs:969
msgid " (kept)"
msgstr " (رکھا جائے گا)"

#: installer.rs:970
msgid "System Partition"
msgstr "سسٹم پارٹیشن"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (فارمیٹ ہوگا)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "بوٹ پارٹیشن"

#: installer.rs:976
msgid "Installation"
msgstr "انسٹالیشن"

#: installer.rs:980
msgid "Space for MAN"
msgstr "MAN کے لیے جگہ"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} خالی جگہ (ایک بوٹ پارٹیشن اور سسٹم پارٹیشن بنائے جائیں گے)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "کوئی تبدیلی نہیں۔ یہ MAN کے بوٹ مینو میں دکھائی دے گا؛ EFI سسٹم پارٹیشن مشترک ہے۔"

#: installer.rs:983
msgid "Encryption"
msgstr "انکرپشن"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "آن (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "آف"

#: installer.rs:985
msgid "File System"
msgstr "فائل سسٹم"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: ‏MAN کے لیے ‎@system، آپ کی فائلوں کے لیے ‎@home، بحالی کے نقاط کے لیے ‎@snapshots۔ سب خالی جگہ شیئر کرتے ہیں۔"

#: installer.rs:991
msgid "System"
msgstr "سسٹم"

#: installer.rs:993
msgid "Your Account"
msgstr "آپ کا اکاؤنٹ"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "کمپیوٹر کے پہلی بار شروع ہونے پر MAN Setup میں کمپیوٹر کے نام، ظاہری شکل اور رازداری کی ترتیبات کے ساتھ بنایا جاتا ہے۔"

#: installer.rs:998
msgid "Keyboard"
msgstr "کی بورڈ"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "{model} ({path}) کا سارا ڈیٹا مٹا دیا جائے گا۔"

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_مٹائیں اور انسٹال کریں"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "منتخب پارٹیشن فارمیٹ ہوں گے۔ دوسرے پارٹیشن نہیں بدلیں گے۔"

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_فارمیٹ کریں اور انسٹال کریں"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "موجودہ سسٹم بدل دیا جائے گا۔ ‎/home میں آپ کی فائلیں رہیں گی اور پرانا سسٹم اسنیپ شاٹ کے طور پر محفوظ ہوگا۔"

#: installer.rs:1004
msgid "_Reinstall"
msgstr "_دوبارہ انسٹال کریں"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN خالی جگہ میں انسٹال ہوگا۔ Windows اور اس کی فائلیں نہیں بدلیں گی۔"

#: installer.rs:1005
msgid "_Install"
msgstr "_انسٹال کریں"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "انسٹال کے لیے تیار"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "{model} مٹائیں؟"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "{path} ({size}) کی تمام فائلیں اور پارٹیشن ہمیشہ کے لیے حذف ہو جائیں گے۔ اسے واپس نہیں کیا جا سکتا۔"

#: installer.rs:1031
msgid "Erase and Install"
msgstr "مٹائیں اور انسٹال کریں"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "منتخب پارٹیشن فارمیٹ کریں؟"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "منتخب پارٹیشنز کا سارا ڈیٹا ہمیشہ کے لیے حذف ہو جائے گا۔ دوسرے پارٹیشن نہیں بدلیں گے۔"

#: installer.rs:1037
msgid "Format and Install"
msgstr "فارمیٹ کریں اور انسٹال کریں"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
msgstr "MAN کو Windows کے ساتھ انسٹال کریں؟"

#: installer.rs:1042
msgid "MAN goes into the {free} of free space on {model} ({path}). Windows and its files are not changed."
msgstr "MAN، {model} ({path}) کی {free} خالی جگہ میں انسٹال ہوگا۔ Windows اور اس کی فائلیں نہیں بدلیں گی۔"

#: installer.rs:1046
msgid "Install"
msgstr "انسٹال کریں"

#: installer.rs:1050
msgid "Reinstall MAN?"
