msgid ""
msgstr ""
"Project-Id-Version: man-installer\n"
"Language: ne\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: backend.rs:46
msgid "Could not start the system helper."
msgstr "प्रणाली सहायक सुरु गर्न सकिएन।"

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "प्रणाली सहायकसँग सञ्चार गर्न सकिएन।"

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "प्रणाली सहायकसँगको जडान टुट्यो।"

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "अधिकार रद्द गरियो।"

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "यो कार्यका लागि प्रशासकको अधिकार चाहिन्छ।"

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "प्रणाली सहायक अप्रत्याशित रूपमा रोकियो।"

#: installer.rs:78
msgid "No EFI system partition"
msgstr "EFI प्रणाली विभाजन छैन"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "केवल {free} खाली छ, MAN लाई {need} चाहिन्छ। Windows मा DUHACH! ले ठाउँ खाली गर्नुहोस्।"

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "खाली ठाउँ छैन। MAN का लागि ठाउँ बनाउन Windows मा DUHACH! चलाउनुहोस्।"

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN यही डिस्कबाट चलिरहेको छ"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "प्रयोगमा: एउटा विभाजन माउन्ट छ"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "धेरै सानो, MAN लाई {need} चाहिन्छ"

#: installer.rs:108
msgid "Install MAN"
msgstr "MAN स्थापना गर्नुहोस्"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN स्थापना हुँदैछ। कृपया पूरा नभएसम्म पर्खनुहोस्।"

#: installer.rs:143
msgid "Language"
msgstr "भाषा"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "यो भाषामा पुनः सुरु गर्नुहोस्(_R)"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "लाइभ सत्र छानिएको भाषामा पुनः सुरु हुनेछ, र MAN त्यही भाषामा स्थापना हुनेछ।"

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "MAN मा स्वागत छ"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"छिटो, खुला र पूर्ण रूपमा अनुकूलन गर्न मिल्ने GNOME प्रणाली।\n"
"यसलाई यो कम्प्युटरमा स्थापना गर्नुहोस्, वा लाइभ सत्र हेरिरहनुहोस्।"

#: installer.rs:218
msgid "_Install MAN…"
msgstr "MAN स्थापना गर्नुहोस्(_I)…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "MAN प्रयोग गरिरहनुहोस्(_K)"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "डिस्कहरू खोजिँदैछ…"

#: installer.rs:250
msgid "Welcome"
msgstr "स्वागत छ"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "यो कम्प्युटर पुरानो BIOS मोडमा सुरु भयो। MAN केवल UEFI कम्प्युटरमा स्थापना हुन सक्छ: पुनः सुरु गरी UEFI बुट विकल्प छान्नुहोस्।"

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "प्रणाली सहायकले डिस्कको कुनै जानकारी दिएन।"

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "अर्को(_N)"

#: installer.rs:361
msgid "Installation Type"
msgstr "स्थापनाको प्रकार"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "डिस्क मेटाएर MAN स्थापना गर्नुहोस्"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "छानिएको डिस्कका सबै कुरा मेटिनेछन्, Windows पनि।"

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "सिफारिस गरिएको। छानिएको डिस्कका सबै कुरा मेटिनेछन्।"

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Windows को छेउमा स्थापना गर्नुहोस्"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "सिफारिस गरिएको। MAN ले Windows छेउको खाली ठाउँ प्रयोग गर्छ; Windows र यसका फाइलहरू रहन्छन्। हरेक पटक सुरु गर्दा प्रणाली छान्नुहोस्।"

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "MAN पुनः स्थापना गर्नुहोस्"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "प्रणाली बदल्छ तर /home का व्यक्तिगत फाइलहरू राख्छ। हालको प्रणाली स्न्यापसटको रूपमा सुरक्षित हुन्छ।"

#: installer.rs:383
msgid "Custom Partitions"
msgstr "आफ्नै विभाजनहरू"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "विज्ञहरूका लागि: विभाजनहरू आफैँ छान्नुहोस्, वा Disks ले बनाउनुहोस्।"

#: installer.rs:392
msgid "Disk"
msgstr "डिस्क"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "मेटाउने डिस्क छान्नुहोस्। प्रयोग गर्न नमिल्ने डिस्कहरू कारणसहित देखाइन्छन्।"

#: installer.rs:418
msgid "No disks were found"
msgstr "कुनै डिस्क फेला परेन"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Windows छेउको खाली ठाउँ"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows का विभाजनहरू छोइँदैनन्। MAN ले EFI प्रणाली विभाजन साझा गर्छ र Windows लाई आफ्नो बुट मेनुमा थप्छ।"

#: installer.rs:432
msgid "{size} free"
msgstr "{size} खाली"

#: installer.rs:432
msgid "no free space"
msgstr "खाली ठाउँ छैन"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "बदलिने स्थापना"

#: installer.rs:477
msgid "no home folders"
msgstr "गृह फोल्डर छैनन्"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "गृह फोल्डरहरू: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "स्न्यापसटहरू: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "{model} मा MAN"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "{device} को पासफ्रेज"

#: installer.rs:500
msgid "Unlock"
msgstr "खोल्नुहोस्"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "स्थापना जाँच गर्न सकिएन।"

#: installer.rs:554
msgid "Partitions"
msgstr "विभाजनहरू"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "प्रणाली विभाजन Btrfs मा फर्म्याट हुन्छ र यसमा @system, @home र @snapshots हुन्छन्। MAN चलिरहेको डिस्कका विभाजनहरू सूचीमा छैनन्।"

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "विभाजन बनाउन वा आकार बदल्न Disks खोल्नुहोस्"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "विभाजन सूची ताजा गर्नुहोस्"

#: installer.rs:567
msgid "Choose a partition"
msgstr "एउटा विभाजन छान्नुहोस्"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI प्रणाली विभाजन"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI प्रणाली विभाजन फर्म्याट गर्नुहोस्"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "अन्य प्रणालीका बुट लोडरहरू राख्न बन्द राख्नुहोस्"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "प्रणाली विभाजन (Btrfs मा फर्म्याट हुनेछ)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "बुट विभाजन (इन्क्रिप्सनका लागि आवश्यक)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "विभाजन सूची ताजा भयो"

#: installer.rs:650
msgid "Security"
msgstr "सुरक्षा"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "प्रणाली इन्क्रिप्ट गर्नुहोस्"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "कम्प्युटर हराए वा चोरी भए तपाईंको डाटा सुरक्षित राख्छ। हरेक पटक सुरु गर्दा पासफ्रेज सोधिन्छ।"

#: installer.rs:656
msgid "Passphrase"
msgstr "पासफ्रेज"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "पासफ्रेज पुष्टि गर्नुहोस्"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "यो पासफ्रेज सुरक्षित राख्नुहोस्"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "यो हराए कसैले पनि डाटा फिर्ता ल्याउन सक्दैन। कर्नेल र बुट फाइलहरू सानो इन्क्रिप्ट नगरिएको बुट विभाजनमा रहन्छन्।"

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "पासफ्रेजमा कम्तीमा 8 अक्षर हुनुपर्छ।"

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "पासफ्रेजहरू मिलेनन्।"

#: installer.rs:748
msgid "Choose a disk."
msgstr "एउटा डिस्क छान्नुहोस्।"

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Windows भएको डिस्क छान्नुहोस्।"

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "बदलिने स्थापना छान्नुहोस्।"

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "पहिले इन्क्रिप्ट गरिएको स्थापना खोल्नुहोस्।"

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "यो विभाजनमा MAN प्रणाली छैन।"

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "EFI प्रणाली विभाजन छान्नुहोस्।"

#: installer.rs:778
msgid "Choose the system partition."
msgstr "प्रणाली विभाजन छान्नुहोस्।"

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI र प्रणाली विभाजन फरक हुनुपर्छ।"

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "इन्क्रिप्सनका लागि छुट्टै बुट विभाजन चाहिन्छ।"

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "प्रणाली विभाजन कम्तीमा {size} हुनुपर्छ।"

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI विभाजन FAT मा फर्म्याट छैन; फर्म्याटिङ सक्रिय गर्नुहोस्।"

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "प्रणाली विभाजन माउन्ट छ; पहिले Disks मा अनमाउन्ट गर्नुहोस्।"

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "MAN कहाँ स्थापना गर्ने?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "समय र किबोर्ड"

#: installer.rs:829
msgid "Time Zone"
msgstr "समय क्षेत्र"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "किबोर्ड लेआउट"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "आफ्नो किबोर्ड जाँच्नुहोस्"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "कुञ्जीहरूले सही अक्षर लेख्छन् कि भनी जाँच्न यहाँ टाइप गर्नुहोस्।"

#: installer.rs:844
msgid "Type here"
msgstr "यहाँ टाइप गर्नुहोस्"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "समय क्षेत्र र किबोर्ड"

#: installer.rs:920
msgid "No disk chosen"
msgstr "डिस्क छानिएको छैन"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "प्रणाली विभाजन छानिएको छैन"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "प्रणाली विभाजन हरायो"

#: installer.rs:933
msgid "No installation chosen"
msgstr "स्थापना छानिएको छैन"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "डिस्क हरायो"

#: installer.rs:955
msgid "Review"
msgstr "समीक्षा"

#: installer.rs:958
msgid "Destination"
msgstr "गन्तव्य"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "डिस्क मेटाएर स्थापना गर्नुहोस्"

#: installer.rs:961
msgid "Custom partitions"
msgstr "आफ्नै विभाजनहरू"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "/home राखेर पुनः स्थापना गर्नुहोस्"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Windows को छेउमा"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (फर्म्याट हुनेछ)"

#: installer.rs:969
msgid " (kept)"
msgstr " (राखिनेछ)"

#: installer.rs:970
msgid "System Partition"
msgstr "प्रणाली विभाजन"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (फर्म्याट हुनेछ)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "बुट विभाजन"

#: installer.rs:976
msgid "Installation"
msgstr "स्थापना"

#: installer.rs:980
msgid "Space for MAN"
msgstr "MAN का लागि ठाउँ"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} खाली ठाउँ (बुट विभाजन र प्रणाली विभाजन बनाइनेछन्)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "परिवर्तन छैन। यो MAN को बुट मेनुमा देखिन्छ; EFI प्रणाली विभाजन साझा छ।"

#: installer.rs:983
msgid "Encryption"
msgstr "इन्क्रिप्सन"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "सक्रिय (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "निष्क्रिय"

#: installer.rs:985
msgid "File System"
msgstr "फाइल प्रणाली"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: MAN का लागि @system, तपाईंका फाइलका लागि @home, पुनर्स्थापना बिन्दुका लागि @snapshots। सबैले खाली ठाउँ साझा गर्छन्।"

#: installer.rs:991
msgid "System"
msgstr "प्रणाली"

#: installer.rs:993
msgid "Your Account"
msgstr "तपाईंको खाता"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "कम्प्युटर पहिलो पटक सुरु हुँदा MAN Setup मा कम्प्युटरको नाम, रूप र गोपनीयता सेटिङसँगै बनाइन्छ।"

#: installer.rs:998
msgid "Keyboard"
msgstr "किबोर्ड"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "{model} ({path}) का सबै डाटा मेटिनेछन्।"

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "मेटाएर स्थापना गर्नुहोस्(_E)"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "छानिएका विभाजनहरू फर्म्याट हुनेछन्। अन्य विभाजनहरू बदलिँदैनन्।"

#: installer.rs:1003
msgid "_Format and Install"
msgstr "फर्म्याट गरेर स्थापना गर्नुहोस्(_F)"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "हालको प्रणाली बदलिनेछ। /home का तपाईंका फाइलहरू रहनेछन्, र पुरानो प्रणाली स्न्यापसटको रूपमा सुरक्षित हुनेछ।"

#: installer.rs:1004
msgid "_Reinstall"
msgstr "पुनः स्थापना गर्नुहोस्(_R)"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN खाली ठाउँमा स्थापना हुनेछ। Windows र यसका फाइलहरू बदलिँदैनन्।"

#: installer.rs:1005
msgid "_Install"
msgstr "स्थापना गर्नुहोस्(_I)"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "स्थापनाका लागि तयार"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "{model} मेटाउने?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "{path} ({size}) का सबै फाइल र विभाजनहरू स्थायी रूपमा मेटिनेछन्। यसलाई पूर्ववत गर्न सकिँदैन।"

#: installer.rs:1031
msgid "Erase and Install"
msgstr "मेटाएर स्थापना गर्नुहोस्"

#: installer.rs:1035
