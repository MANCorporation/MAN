#: install.rs:138
msgid "Choose a system partition."
msgstr "सिस्टम विभाजन निवडा."

#: install.rs:145
msgid "The confirmed disk does not hold the chosen system partition."
msgstr "पुष्टी केलेल्या डिस्कवर निवडलेले सिस्टम विभाजन नाही."

#: install.rs:157
msgid "The boot partition must be separate from the EFI and system partitions."
msgstr "बूट विभाजन EFI आणि सिस्टम विभाजनांपासून वेगळे असावे."

#: install.rs:160
msgid "The boot partition must be at least 512 MB."
msgstr "बूट विभाजन किमान 512 MB असावे."

#: install.rs:175
msgid "No installation chosen."
msgstr "स्थापना निवडलेली नाही."

#: install.rs:179
msgid "The confirmed disk does not hold the chosen installation."
msgstr "पुष्टी केलेल्या डिस्कवर निवडलेली स्थापना नाही."

#: install.rs:337
msgid "The encrypted installation has no MAN_BOOT partition."
msgstr "एन्क्रिप्ट केलेल्या स्थापनेत MAN_BOOT विभाजन नाही."

#: install.rs:695
msgid "No kernel with matching modules was found in /boot."
msgstr "/boot मध्ये जुळणाऱ्या मॉड्यूलसह कर्नेल सापडला नाही."

#: locale.rs:180
msgid "The language must be changed by the system helper."
msgstr "भाषा सिस्टम सहाय्यकानेच बदलली पाहिजे."

#: oobe.rs:204
msgid "Applying your settings"
msgstr "तुमच्या सेटिंग्ज लागू करत आहे"

#: oobe.rs:212
msgid "Preparing disk encryption"
msgstr "डिस्क एन्क्रिप्शन तयार करत आहे"

#: oobe.rs:216
msgid "Finishing"
msgstr "पूर्ण करत आहे"

#: oobe.rs:100
msgid "MAN Setup must be finished by the system helper."
msgstr "MAN Setup सिस्टम सहाय्यकानेच पूर्ण केले पाहिजे."

#: oobe.rs:103
msgid "MAN Setup has already been completed on this computer."
msgstr "या संगणकावर MAN Setup आधीच पूर्ण झाले आहे."

#: oobe.rs:124
msgid "Unknown accent color."
msgstr "अज्ञात अॅक्सेंट रंग."

#: oobe.rs:128
msgid "The chosen wallpaper is not available."
msgstr "निवडलेला वॉलपेपर उपलब्ध नाही."

#: oobe.rs:146
msgid "This system cannot be encrypted."
msgstr "ही प्रणाली एन्क्रिप्ट करता येत नाही."

#: oobe.rs:257
msgid "The setup key is missing, so encryption cannot continue in the background."
msgstr "सेटअप की गहाळ आहे, त्यामुळे एन्क्रिप्शन पार्श्वभूमीत सुरू राहू शकत नाही."

#: snapshots.rs:48
msgid "The system is not installed on Btrfs, so snapshots are not available."
msgstr "प्रणाली Btrfs वर स्थापित नाही, त्यामुळे स्नॅपशॉट उपलब्ध नाहीत."

#: snapshots.rs:50
msgid "A snapshot restore is waiting for a restart. Restart the computer to finish it first."
msgstr "एक स्नॅपशॉट पुनर्संचय पुन्हा सुरू होण्याची वाट पाहत आहे. पूर्ण करण्यासाठी आधी संगणक पुन्हा सुरू करा."

#: snapshots.rs:99
msgid "Invalid snapshot id."
msgstr "अवैध स्नॅपशॉट ID."

#: update.rs:32
msgid "Checking the update"
msgstr "अद्यतन तपासत आहे"

#: update.rs:32
msgid "Creating a snapshot"
msgstr "स्नॅपशॉट तयार करत आहे"

#: update.rs:32
msgid "Preparing the update area"
msgstr "अद्यतन क्षेत्र तयार करत आहे"

#: update.rs:32
msgid "Unpacking the new system"
msgstr "नवी प्रणाली उघडत आहे"

#: update.rs:32
msgid "Moving your accounts and settings"
msgstr "तुमची खाती आणि सेटिंग्ज हलवत आहे"

#: update.rs:32
msgid "Preparing the restart"
msgstr "पुन्हा सुरू करण्याची तयारी"

#: update.rs:179
msgid "Unpacked"
msgstr "उघडले"

#: update.rs:261
msgid "Accounts"
msgstr "खाती"

#: update.rs:301
msgid "Removing installer-only software"
msgstr "फक्त इंस्टॉलरचे सॉफ्टवेअर काढत आहे"

#: update.rs:340
msgid "Building the update boot image"
msgstr "अद्यतनाची बूट प्रतिमा तयार करत आहे"

#: update.rs:343
msgid "Adding the one-time boot entry"
msgstr "एकदाची बूट नोंद जोडत आहे"

#: update.rs:377
msgid "The update is genuine"
msgstr "अद्यतन खरे आहे"

#: update.rs:383
msgid "Snapshot created"
msgstr "स्नॅपशॉट तयार झाला"

#: update.rs:385
msgid "Skipped"
msgstr "वगळले"

#: update.rs:394
msgid "Update area ready"
msgstr "अद्यतन क्षेत्र तयार"

#: update.rs:410
msgid "Preparing the new system"
msgstr "नवी प्रणाली तयार करत आहे"

#: update.rs:168
msgid "The update file is damaged (checksum mismatch). Download it again."
msgstr "अद्यतन फाइल खराब आहे (चेकसम जुळत नाही). ती पुन्हा डाउनलोड करा."

#: update.rs:171
msgid "The update file could not be read completely."
msgstr "अद्यतन फाइल पूर्ण वाचता आली नाही."

#: update.rs:312
msgid "The update contains no kernel."
msgstr "अद्यतनात कर्नेल नाही."

#: update.rs:360
msgid "Updates must be installed by the system helper."
msgstr "अद्यतने सिस्टम सहाय्यकानेच स्थापित केली पाहिजेत."

#: update.rs:369
msgid "The chosen installation was not found."
msgstr "निवडलेली स्थापना सापडली नाही."

#: update.rs:371
msgid "Only the running MAN installation can be updated."
msgstr "फक्त चालू MAN स्थापना अद्ययावत करता येते."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "ही MAN अद्यतन फाइल नाही (मॅनिफेस्ट नाही)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "अद्यतनावर स्वाक्षरी नाही, त्यामुळे त्यावर विश्वास ठेवता येत नाही."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "अद्यतनाची स्वाक्षरी खराब आहे."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "अद्यतनावर MAN ची स्वाक्षरी नाही. ते बदललेले असू शकते किंवा अविश्वसनीय स्रोतातून आलेले असू शकते."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "अद्यतनाचा मॅनिफेस्ट अवैध आहे."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "पासफ्रेज चुकीचा आहे, किंवा एन्क्रिप्ट केलेले विभाजन उघडता येत नाही."

