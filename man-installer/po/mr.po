msgstr ""
"Project-Id-Version: man-installer\n"
"Language: mr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: backend.rs:46
msgid "Could not start the system helper."
msgstr "सिस्टम सहाय्यक सुरू करता आला नाही."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "सिस्टम सहाय्यकाशी संवाद साधता आला नाही."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "सिस्टम सहाय्यकाशी संपर्क तुटला."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "अधिकृतता रद्द केली."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "या क्रियेसाठी प्रशासकाचे अधिकार आवश्यक आहेत."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "सिस्टम सहाय्यक अनपेक्षितपणे थांबला."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "EFI सिस्टम विभाजन नाही"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "फक्त {free} रिकामे, MAN ला {need} हवे. Windows मध्ये DUHACH! ने जागा मोकळी करा."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "रिकामी जागा नाही. MAN साठी जागा करण्यासाठी Windows मध्ये DUHACH! सुरू करा."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN याच डिस्कवरून चालू आहे"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "वापरात: एक विभाजन माउंट आहे"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "खूप लहान, MAN ला {need} हवे"

#: installer.rs:108
msgid "Install MAN"
msgstr "MAN स्थापित करा"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN स्थापित होत आहे. कृपया पूर्ण होईपर्यंत थांबा."

#: installer.rs:143
msgid "Language"
msgstr "भाषा"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "या भाषेत पुन्हा सुरू करा(_R)"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "लाइव्ह सत्र निवडलेल्या भाषेत पुन्हा सुरू होईल, आणि MAN त्याच भाषेत स्थापित होईल."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "MAN मध्ये आपले स्वागत आहे"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"वेगवान, मुक्त आणि पूर्णपणे सानुकूल करता येणारी GNOME प्रणाली.\n"
"ती या संगणकावर स्थापित करा, किंवा लाइव्ह सत्र पाहत राहा."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "MAN स्थापित करा(_I)…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "MAN वापरून पाहत राहा(_K)"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "डिस्क शोधत आहे…"

#: installer.rs:250
msgid "Welcome"
msgstr "स्वागत आहे"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "हा संगणक जुन्या BIOS मोडमध्ये सुरू झाला. MAN फक्त UEFI संगणकांवर स्थापित होऊ शकतो: पुन्हा सुरू करा आणि UEFI बूट पर्याय निवडा."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "सिस्टम सहाय्यकाने डिस्कची माहिती दिली नाही."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "पुढे(_N)"

#: installer.rs:361
msgid "Installation Type"
msgstr "स्थापनेचा प्रकार"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "डिस्क पुसा आणि MAN स्थापित करा"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "निवडलेल्या डिस्कवरील सर्व काही पुसले जाईल, Windows सुद्धा."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "शिफारस केलेले. निवडलेल्या डिस्कवरील सर्व काही पुसले जाईल."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Windows च्या बाजूला स्थापित करा"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "शिफारस केलेले. MAN, Windows च्या बाजूची रिकामी जागा वापरतो; Windows आणि त्याच्या फायली तशाच राहतात. प्रत्येक सुरुवातीला प्रणाली निवडा."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "MAN पुन्हा स्थापित करा"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "प्रणाली बदलते पण /home मधील वैयक्तिक फायली ठेवते. सध्याची प्रणाली स्नॅपशॉट म्हणून जतन होते."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "सानुकूल विभाजने"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "तज्ञांसाठी: विभाजने स्वतः निवडा, किंवा Disks ने तयार करा."

#: installer.rs:392
msgid "Disk"
msgstr "डिस्क"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "पुसायची डिस्क निवडा. वापरता न येणाऱ्या डिस्क कारणासह दाखवल्या जातात."

#: installer.rs:418
msgid "No disks were found"
msgstr "डिस्क सापडल्या नाहीत"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Windows च्या बाजूची रिकामी जागा"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Windows ची विभाजने बदलली जात नाहीत. MAN, EFI सिस्टम विभाजन वाटून घेतो आणि Windows ला आपल्या बूट मेनूमध्ये जोडतो."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} रिकामे"

#: installer.rs:432
msgid "no free space"
msgstr "रिकामी जागा नाही"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "बदलायची स्थापना"

#: installer.rs:477
msgid "no home folders"
msgstr "होम फोल्डर नाहीत"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "होम फोल्डर: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "स्नॅपशॉट: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "{model} वरील MAN"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "{device} साठी पासफ्रेज"

#: installer.rs:500
msgid "Unlock"
msgstr "उघडा"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "स्थापना तपासता आली नाही."

#: installer.rs:554
msgid "Partitions"
msgstr "विभाजने"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "सिस्टम विभाजन Btrfs मध्ये फॉरमॅट होते आणि त्यात @system, @home आणि @snapshots असतात. MAN ज्या डिस्कवरून चालू आहे तिची विभाजने यादीत नाहीत."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "विभाजने तयार करण्यासाठी किंवा आकार बदलण्यासाठी Disks उघडा"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "विभाजन यादी ताजी करा"

#: installer.rs:567
msgid "Choose a partition"
msgstr "एक विभाजन निवडा"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI सिस्टम विभाजन"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI सिस्टम विभाजन फॉरमॅट करा"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "इतर प्रणालींचे बूट लोडर ठेवण्यासाठी बंद ठेवा"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "सिस्टम विभाजन (Btrfs मध्ये फॉरमॅट होईल)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "बूट विभाजन (एन्क्रिप्शनसाठी आवश्यक)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "विभाजन यादी ताजी केली"

#: installer.rs:650
msgid "Security"
msgstr "सुरक्षा"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "प्रणाली एन्क्रिप्ट करा"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "संगणक हरवला किंवा चोरीला गेला तर तुमचा डेटा सुरक्षित ठेवतो. प्रत्येक सुरुवातीला पासफ्रेज विचारला जातो."

#: installer.rs:656
msgid "Passphrase"
msgstr "पासफ्रेज"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "पासफ्रेजची पुष्टी करा"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "हा पासफ्रेज सुरक्षित ठेवा"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "तो हरवला तर कोणीही डेटा परत मिळवू शकणार नाही. कर्नेल आणि बूट फायली एका लहान एन्क्रिप्ट न केलेल्या बूट विभाजनावर राहतात."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "पासफ्रेजमध्ये किमान 8 अक्षरे असावीत."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "पासफ्रेज जुळत नाहीत."

#: installer.rs:748
msgid "Choose a disk."
msgstr "एक डिस्क निवडा."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Windows असलेली डिस्क निवडा."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "बदलायची स्थापना निवडा."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "आधी एन्क्रिप्ट केलेली स्थापना उघडा."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "या विभाजनात MAN प्रणाली नाही."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "EFI सिस्टम विभाजन निवडा."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "सिस्टम विभाजन निवडा."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI आणि सिस्टम विभाजन वेगवेगळे असावेत."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "एन्क्रिप्शनसाठी वेगळे बूट विभाजन आवश्यक आहे."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "सिस्टम विभाजन किमान {size} असावे."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI विभाजन FAT मध्ये फॉरमॅट नाही; फॉरमॅटिंग चालू करा."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "सिस्टम विभाजन माउंट आहे; आधी Disks मध्ये ते अनमाउंट करा."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "MAN कुठे स्थापित करायचा?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "वेळ आणि कीबोर्ड"

#: installer.rs:829
msgid "Time Zone"
msgstr "वेळ क्षेत्र"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "कीबोर्ड मांडणी"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "तुमचा कीबोर्ड तपासा"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "कळा योग्य अक्षरे लिहितात का हे पाहण्यासाठी येथे टाइप करा."

#: installer.rs:844
msgid "Type here"
msgstr "येथे टाइप करा"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "वेळ क्षेत्र आणि कीबोर्ड"

#: installer.rs:920
msgid "No disk chosen"
msgstr "डिस्क निवडलेली नाही"

#: installer.rs:926
msgid "No system partition chosen"
msgstr "सिस्टम विभाजन निवडलेले नाही"

#: installer.rs:928
msgid "The system partition disappeared"
msgstr "सिस्टम विभाजन गायब झाले"

#: installer.rs:933
msgid "No installation chosen"
msgstr "स्थापना निवडलेली नाही"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "डिस्क गायब झाली"

#: installer.rs:955
msgid "Review"
msgstr "आढावा"

#: installer.rs:958
msgid "Destination"
msgstr "गंतव्य"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "डिस्क पुसा आणि स्थापित करा"

#: installer.rs:961
msgid "Custom partitions"
msgstr "सानुकूल विभाजने"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "/home ठेवून पुन्हा स्थापित करा"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Windows च्या बाजूला"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (फॉरमॅट होईल)"

#: installer.rs:969
msgid " (kept)"
msgstr " (ठेवले जाईल)"

#: installer.rs:970
msgid "System Partition"
msgstr "सिस्टम विभाजन"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (फॉरमॅट होईल)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "बूट विभाजन"

#: installer.rs:976
msgid "Installation"
msgstr "स्थापना"

#: installer.rs:980
msgid "Space for MAN"
msgstr "MAN साठी जागा"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} रिकामी जागा (बूट विभाजन आणि सिस्टम विभाजन तयार होतील)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "बदल नाही. ते MAN च्या बूट मेनूमध्ये दिसेल; EFI सिस्टम विभाजन सामायिक आहे."

#: installer.rs:983
msgid "Encryption"
msgstr "एन्क्रिप्शन"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "चालू (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "बंद"

#: installer.rs:985
msgid "File System"
msgstr "फाइल प्रणाली"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: MAN साठी @system, तुमच्या फायलींसाठी @home, पुनर्संचय बिंदूंसाठी @snapshots. सर्व रिकामी जागा वाटून घेतात."

#: installer.rs:991
msgid "System"
msgstr "प्रणाली"

#: installer.rs:993
msgid "Your Account"
msgstr "तुमचे खाते"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "संगणक पहिल्यांदा सुरू झाल्यावर MAN Setup मध्ये संगणकाचे नाव, स्वरूप आणि गोपनीयता सेटिंग्जसह तयार होते."

#: installer.rs:998
msgid "Keyboard"
msgstr "कीबोर्ड"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "{model} ({path}) वरील सर्व डेटा पुसला जाईल."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "पुसा आणि स्थापित करा(_E)"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "निवडलेली विभाजने फॉरमॅट होतील. इतर विभाजने बदलणार नाहीत."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "फॉरमॅट करा आणि स्थापित करा(_F)"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "सध्याची प्रणाली बदलली जाईल. /home मधील तुमच्या फायली राहतील, आणि जुनी प्रणाली स्नॅपशॉट म्हणून जतन होईल."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "पुन्हा स्थापित करा(_R)"

#: installer.rs:1005
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN रिकाम्या जागेत स्थापित होईल. Windows आणि त्याच्या फायली बदलणार नाहीत."

#: installer.rs:1005
msgid "_Install"
msgstr "स्थापित करा(_I)"

#: installer.rs:1019
msgid "Ready to Install"
msgstr "स्थापनेसाठी तयार"

#: installer.rs:1029
msgid "Erase {model}?"
msgstr "{model} पुसायची?"

#: installer.rs:1030
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "{path} ({size}) वरील सर्व फायली आणि विभाजने कायमची हटवली जातील. हे पूर्ववत करता येणार नाही."

#: installer.rs:1031
msgid "Erase and Install"
msgstr "पुसा आणि स्थापित करा"

#: installer.rs:1035
msgid "Format the Chosen Partitions?"
msgstr "निवडलेली विभाजने फॉरमॅट करायची?"

#: installer.rs:1036
msgid "All data on the chosen partitions will be permanently deleted. Other partitions are not changed."
msgstr "निवडलेल्या विभाजनांवरील सर्व डेटा कायमचा हटवला जाईल. इतर विभाजने बदलणार नाहीत."

#: installer.rs:1037
msgid "Format and Install"
msgstr "फॉरमॅट करा आणि स्थापित करा"

#: installer.rs:1041
msgid "Install MAN Alongside Windows?"
