msgid "Confirm Passphrase"
msgstr "Bekræft adgangsfrase"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Opbevar adgangsfrasen sikkert"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Hvis den mistes, kan ingen gendanne dataene. Kernen og opstartsfilerne ligger på en lille ukrypteret opstartspartition."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Adgangsfrasen skal have mindst 8 tegn."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Adgangsfraserne er ikke ens."

