msgid "The EFI and system partitions must be different."
msgstr "EFI-partitionen og systempartitionen skal være forskellige."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Kryptering kræver en separat opstartspartition."

#: installer.rs:791
