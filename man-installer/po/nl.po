#: appinstaller.rs:876
msgid "You will be guided through the steps necessary to install this software."
msgstr "Je wordt door de stappen geleid die nodig zijn om deze software te installeren."

#: appinstaller.rs:887
msgid "Version"
msgstr "Versie"

#: appinstaller.rs:890
msgid "Publisher"
