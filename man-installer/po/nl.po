msgid "Destination"
msgstr "Bestemming"

#: installer.rs:1002
msgid "Erase disk and install"
msgstr "Schijf wissen en installeren"

#: installer.rs:1003
msgid "This Mac (space prepared in macOS)"
msgstr "Deze Mac (ruimte voorbereid in macOS)"

#: installer.rs:1004
msgid "Custom partitions"
msgstr "Eigen partities"

#: installer.rs:1005
msgid "Reinstall, keeping /home"
msgstr "Opnieuw installeren, /home behouden"

#: installer.rs:1006
msgid "Alongside Windows"
msgstr "Naast Windows"

#: installer.rs:1012
msgid " (will be formatted)"
msgstr " (wordt geformatteerd)"

#: installer.rs:1012
msgid " (kept)"
msgstr " (behouden)"

#: installer.rs:1013
msgid "System Partition"
msgstr "Systeempartitie"

#: installer.rs:1013
msgid "{partition} (will be formatted)"
msgstr "{partition} (wordt geformatteerd)"

#: installer.rs:1015
msgid "Boot Partition"
msgstr "Opstartpartitie"

#: installer.rs:1023
msgid "Space for MAN"
msgstr "Ruimte voor MAN"

#: installer.rs:1023
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} vrije ruimte (er worden een opstartpartitie en de systeempartitie gemaakt)"

#: installer.rs:1024
msgid "Windows"
msgstr "Windows"

#: installer.rs:1024
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Ongewijzigd. Het verschijnt in het opstartmenu van MAN; de EFI-systeempartitie wordt gedeeld."

#: installer.rs:1026
msgid "Encryption"
msgstr "Versleuteling"

#: installer.rs:1026
msgid "On (LUKS2)"
msgstr "Aan (LUKS2)"

#: installer.rs:1026
msgid "Off"
msgstr "Uit"

#: installer.rs:1028
msgid "File System"
msgstr "Bestandssysteem"

#: installer.rs:1029
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system voor MAN, @home voor uw bestanden, @snapshots voor herstelpunten. Ze delen allemaal de vrije ruimte."

#: installer.rs:1034
msgid "System"
msgstr "Systeem"

#: installer.rs:1036
msgid "Your Account"
msgstr "Uw account"

#: installer.rs:1037
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Wordt gemaakt in MAN Setup bij de eerste start van de computer, samen met de computernaam, het uiterlijk en de privacyinstellingen."

#: installer.rs:1041
msgid "Keyboard"
msgstr "Toetsenbord"

#: installer.rs:1045
msgid "All data on {model} ({path}) will be erased."
msgstr "Alle gegevens op {model} ({path}) worden gewist."

#: installer.rs:1045
msgid "_Erase and Install"
msgstr "_Wissen en installeren"

#: installer.rs:1046
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "De gekozen partities worden geformatteerd. Andere partities veranderen niet."

#: installer.rs:1046
msgid "_Format and Install"
msgstr "_Formatteren en installeren"

#: installer.rs:1047
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "Het huidige systeem wordt vervangen. Uw bestanden in /home blijven bewaard en het oude systeem wordt als momentopname bewaard."

#: installer.rs:1047
msgid "_Reinstall"
msgstr "Opnieuw _installeren"

#: installer.rs:1048
msgid "MAN is installed into the free space. Windows and its files are not changed."
msgstr "MAN wordt in de vrije ruimte geïnstalleerd. Windows en zijn bestanden veranderen niet."

#: installer.rs:1062
msgid "Ready to Install"
msgstr "Klaar om te installeren"

#: installer.rs:1072
msgid "Erase {model}?"
msgstr "{model} wissen?"

#: installer.rs:1073
msgid "Every file and partition on {path} ({size}) will be permanently deleted. This cannot be undone."
msgstr "Alle bestanden en partities op {path} ({size}) worden definitief verwijderd. Dit kan niet ongedaan worden gemaakt."

#: installer.rs:1074
msgid "Erase and Install"
msgstr "Wissen en installeren"

