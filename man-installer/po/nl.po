msgid "Choose the disk with Windows."
msgstr "Kies de schijf met Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Kies de te vervangen installatie."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Ontgrendel eerst de versleutelde installatie."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Deze partitie bevat geen MAN-systeem."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Kies een EFI-systeempartitie."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Kies de systeempartitie."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "De EFI- en systeempartitie moeten verschillend zijn."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Versleuteling heeft een aparte opstartpartitie nodig."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "De systeempartitie moet minstens {size} zijn."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "De EFI-partitie is niet FAT-geformatteerd; zet formatteren aan."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "De systeempartitie is aangekoppeld; ontkoppel haar eerst in Schijven."

