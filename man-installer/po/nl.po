#: installer.rs:554
msgid "Partitions"
msgstr "Partities"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "De systeempartitie wordt met Btrfs geformatteerd en bevat @system, @home en @snapshots. Partities op de schijf waar MAN vanaf draait, worden niet getoond."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Schijven openen om partities te maken of te vergroten/verkleinen"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Partitielijst vernieuwen"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Kies een partitie"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI-systeempartitie"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "EFI-systeempartitie formatteren"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Laat uit om opstartladers van andere systemen te behouden"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Systeempartitie (geformatteerd als Btrfs)"

#: installer.rs:583
