msgstr "Test uw toetsenbord"

#: installer.rs:885
msgid "Type here to check that your keys produce the right characters."
msgstr "Typ hier om te controleren of uw toetsen de juiste tekens geven."

#: installer.rs:886
msgid "Type here"
msgstr "Typ hier"

#: installer.rs:919
msgid "Time Zone and Keyboard"
msgstr "Tijdzone en toetsenbord"

