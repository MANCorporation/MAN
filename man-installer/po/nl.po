msgid "_Open"
msgstr "_Openen"

#: appinstaller.rs:1232
msgid "_Show Details"
msgstr "Details _tonen"

#: appinstaller.rs:1235
msgid "Installation Log"
msgstr "Installatielogboek"

#: appinstaller.rs:1262
msgid "App Installer"
msgstr "App-installatie"

#: appinstaller.rs:1283
msgid "Go _Back"
msgstr "_Terug"

#: appinstaller.rs:1356
msgid "Reading the app…"
msgstr "App lezen…"

#: appinstaller.rs:1365
msgid "Install {name}"
msgstr "{name} installeren"

#: appinstaller.rs:1384
msgid "Apps"
msgstr "Apps"

#: appinstaller.rs:1390
msgid "Choose an App to Install"
msgstr "Kies een app om te installeren"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "De systeemhulp kon niet worden gestart."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "Kan niet communiceren met de systeemhulp."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Verbinding met de systeemhulp verbroken."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Autorisatie geannuleerd."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Voor deze actie zijn beheerdersrechten nodig."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "De systeemhulp is onverwacht gestopt."

#: installer.rs:89
msgid "No EFI system partition"
msgstr "Geen EFI-systeempartitie"

#: installer.rs:93
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Slechts {free} vrij, MAN heeft {need} nodig. Maak meer ruimte met DUHACH! in Windows."

#: installer.rs:94
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Geen vrije ruimte. Start DUHACH! in Windows om ruimte te maken voor MAN."

#: installer.rs:103
msgid "MAN is running from this disk"
msgstr "MAN draait vanaf deze schijf"

#: installer.rs:107
msgid "In use: a partition is mounted"
msgstr "In gebruik: er is een partitie aangekoppeld"

#: installer.rs:109
msgid "Too small, MAN needs {need}"
msgstr "Te klein, MAN heeft {need} nodig"

#: installer.rs:119
msgid "Install MAN"
msgstr "MAN installeren"

#: installer.rs:137
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN wordt geïnstalleerd. Wacht tot dit klaar is."

#: installer.rs:154
msgid "Language"
msgstr "Taal"

#: installer.rs:166
msgid "_Restart in This Language"
msgstr "_Herstarten in deze taal"

#: installer.rs:178
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "De live-sessie herstart in de gekozen taal, en MAN wordt in die taal geïnstalleerd."

#: installer.rs:224
msgid "Welcome to MAN"
msgstr "Welkom bij MAN"

#: installer.rs:225
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Een snel, open en volledig aanpasbaar GNOME-systeem.\n"
"Installeer het op deze computer, of blijf de live-sessie verkennen."

#: installer.rs:229
msgid "_Install MAN…"
msgstr "MAN _installeren…"

#: installer.rs:231
msgid "_Keep Trying MAN"
msgstr "MAN verder _uitproberen"

#: installer.rs:234
msgid "Looking for disks…"
msgstr "Schijven zoeken…"

#: installer.rs:261
msgid "Welcome"
msgstr "Welkom"

#: installer.rs:276
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Deze computer is gestart in legacy-BIOS-modus. MAN kan alleen op UEFI-computers worden geïnstalleerd: herstart en kies de UEFI-opstartoptie."

#: installer.rs:294
msgid "The system helper returned no disk information."
msgstr "De systeemhulp gaf geen schijfinformatie terug."

#: installer.rs:372
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:380
msgid "_Next"
msgstr "_Volgende"

#: installer.rs:388
msgid "Erase Disk and Install MAN"
msgstr "Schijf wissen en MAN installeren"

#: installer.rs:389
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Alles op de gekozen schijf wordt gewist, ook Windows."

#: installer.rs:389
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Aanbevolen. Alles op de gekozen schijf wordt gewist."

#: installer.rs:393
msgid "Install Alongside Windows"
msgstr "Naast Windows installeren"

#: installer.rs:394
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Aanbevolen. MAN gebruikt de vrije ruimte naast Windows; Windows en zijn bestanden blijven. Kies bij elke start het systeem."

#: installer.rs:401
msgid "Reinstall MAN"
msgstr "MAN opnieuw installeren"

#: installer.rs:402
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Vervangt het systeem maar behoudt persoonlijke bestanden in /home. Het huidige systeem wordt als momentopname bewaard."

#: installer.rs:407
msgid "Custom Partitions"
msgstr "Eigen partities"

#: installer.rs:407
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Voor experts: kies zelf partities, of maak ze met Schijven."

#: installer.rs:418
msgid "Erase an External Disk and Install MAN"
msgstr "Een externe schijf wissen en MAN installeren"

#: installer.rs:419
msgid "Everything on the chosen external disk is deleted. The Mac's internal disk is not shown and not changed."
msgstr "Alles op de gekozen externe schijf wordt gewist. De interne schijf van de Mac wordt niet getoond en niet gewijzigd."

#: installer.rs:420
msgid "Install on This Mac"
msgstr "Installeren op deze Mac"

#: installer.rs:422
msgid "Recommended. Into the {size} prepared in macOS. macOS and its partitions are not changed."
msgstr "Aanbevolen. In de {size} die in macOS is voorbereid. macOS en zijn partities worden niet gewijzigd."

#: installer.rs:427
msgid "No space for MAN was prepared yet. In macOS, run MAN-Mac/install-man.sh from the MAN USB stick and choose “MAN boot loader + space for MAN”."
msgstr "Er is nog geen ruimte voor MAN voorbereid. Voer in macOS MAN-Mac/install-man.sh uit vanaf de MAN-USB-stick en kies “MAN boot loader + space for MAN”."

#: installer.rs:433
msgid "Disk"
msgstr "Schijf"

#: installer.rs:433
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Kies de schijf die gewist wordt. Schijven die niet bruikbaar zijn, worden met de reden getoond."

#: installer.rs:459
msgid "No disks were found"
msgstr "Geen schijven gevonden"

#: installer.rs:466
msgid "Free Space Next to Windows"
msgstr "Vrije ruimte naast Windows"

#: installer.rs:467
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "De partities van Windows worden niet aangeraakt. MAN deelt de EFI-systeempartitie en voegt Windows toe aan zijn opstartmenu."

#: installer.rs:473
msgid "{size} free"
msgstr "{size} vrij"

#: installer.rs:473
msgid "no free space"
msgstr "geen vrije ruimte"

#: installer.rs:478
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:497
msgid "Installation to Replace"
msgstr "Te vervangen installatie"

#: installer.rs:518
msgid "no home folders"
msgstr "geen persoonlijke mappen"

#: installer.rs:520
msgid "home folders: {list}"
msgstr "persoonlijke mappen: {list}"

#: installer.rs:522
msgid "snapshots: {n}"
msgstr "momentopnamen: {n}"

#: installer.rs:526
msgid "MAN on {model}"
msgstr "MAN op {model}"

#: installer.rs:540
msgid "Passphrase for {device}"
msgstr "Wachtwoordzin voor {device}"

#: installer.rs:541
msgid "Unlock"
msgstr "Ontgrendelen"

#: installer.rs:578
msgid "The installation could not be inspected."
msgstr "De installatie kon niet worden onderzocht."

#: installer.rs:595
msgid "Partitions"
msgstr "Partities"

#: installer.rs:596
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "De systeempartitie wordt met Btrfs geformatteerd en bevat @system, @home en @snapshots. Partities op de schijf waar MAN vanaf draait, worden niet getoond."

#: installer.rs:598
msgid "Open Disks to create or resize partitions"
msgstr "Schijven openen om partities te maken of te vergroten/verkleinen"

#: installer.rs:600
msgid "Refresh the partition list"
msgstr "Partitielijst vernieuwen"

#: installer.rs:608
msgid "Choose a partition"
msgstr "Kies een partitie"

#: installer.rs:620
msgid "EFI System Partition"
msgstr "EFI-systeempartitie"

#: installer.rs:621
msgid "Format EFI System Partition"
msgstr "EFI-systeempartitie formatteren"

#: installer.rs:621
msgid "Leave off to keep boot loaders of other systems"
msgstr "Laat uit om opstartladers van andere systemen te behouden"

#: installer.rs:623
msgid "System Partition (formatted as Btrfs)"
msgstr "Systeempartitie (geformatteerd als Btrfs)"

#: installer.rs:624
msgid "Boot Partition (needed with encryption)"
msgstr "Opstartpartitie (nodig bij versleuteling)"

#: installer.rs:683
msgid "Partition list refreshed"
msgstr "Partitielijst vernieuwd"

#: installer.rs:691
msgid "Security"
msgstr "Beveiliging"

#: installer.rs:693
msgid "Encrypt the System"
msgstr "Systeem versleutelen"

#: installer.rs:694
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Beschermt uw gegevens als de computer verloren gaat of gestolen wordt. Bij elke start wordt een wachtwoordzin gevraagd."

#: installer.rs:697
msgid "Passphrase"
msgstr "Wachtwoordzin"

#: installer.rs:698
msgid "Confirm Passphrase"
msgstr "Wachtwoordzin bevestigen"

#: installer.rs:700
msgid "Keep this passphrase safe"
msgstr "Bewaar deze wachtwoordzin goed"

#: installer.rs:701
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Als u hem kwijtraakt, kan niemand de gegevens herstellen. De kernel en opstartbestanden staan op een kleine, onversleutelde opstartpartitie."

#: installer.rs:774
msgid "The passphrase needs at least 8 characters."
msgstr "De wachtwoordzin moet minstens 8 tekens hebben."

#: installer.rs:776
msgid "The passphrases do not match."
msgstr "De wachtwoordzinnen komen niet overeen."

#: installer.rs:790
msgid "Choose a disk."
msgstr "Kies een schijf."

#: installer.rs:800
msgid "Choose the disk with Windows."
msgstr "Kies de schijf met Windows."

#: installer.rs:809
msgid "Choose the installation to replace."
msgstr "Kies de te vervangen installatie."

#: installer.rs:810
msgid "Unlock the encrypted installation first."
msgstr "Ontgrendel eerst de versleutelde installatie."

#: installer.rs:811
msgid "This partition holds no MAN system."
msgstr "Deze partitie bevat geen MAN-systeem."

#: installer.rs:818
msgid "Choose an EFI system partition."
msgstr "Kies een EFI-systeempartitie."

#: installer.rs:820
msgid "Choose the system partition."
msgstr "Kies de systeempartitie."

#: installer.rs:822
msgid "The EFI and system partitions must be different."
msgstr "De EFI- en systeempartitie moeten verschillend zijn."

#: installer.rs:824
msgid "Encryption needs a separate boot partition."
msgstr "Versleuteling heeft een aparte opstartpartitie nodig."

#: installer.rs:833
msgid "The system partition must be at least {size}."
msgstr "De systeempartitie moet minstens {size} zijn."

#: installer.rs:835
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "De EFI-partitie is niet FAT-geformatteerd; zet formatteren aan."

#: installer.rs:837
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "De systeempartitie is aangekoppeld; ontkoppel haar eerst in Schijven."

#: installer.rs:859
msgid "Where Should MAN Be Installed?"
msgstr "Waar moet MAN worden geïnstalleerd?"

#: installer.rs:866
