msgid "Apps from .deb packages become part of the system. When MAN is updated they are removed and need to be installed again. Flatpak apps and AppImages are kept."
msgstr "Apps uit .deb-pakketten worden deel van het systeem. Bij een update van MAN worden ze verwijderd en moeten ze opnieuw worden geïnstalleerd. Flatpak-apps en AppImages blijven behouden."

#: appinstaller.rs:909
msgid "Only install apps from sources you trust."
msgstr "Installeer alleen apps uit bronnen die je vertrouwt."

#: appinstaller.rs:915
msgid "Where do you want to install {name}?"
msgstr "Waar wil je {name} installeren?"

#: appinstaller.rs:920
msgid "Only your account can use the app."
msgstr "Alleen jouw account kan de app gebruiken."

#: appinstaller.rs:921
msgid "Needs administrator rights."
msgstr "Beheerdersrechten nodig."

#: appinstaller.rs:928
msgid "Only for Me"
msgstr "Alleen voor mij"

#: appinstaller.rs:928
msgid "For All Users of This Computer"
msgstr "Voor alle gebruikers van deze computer"

#: appinstaller.rs:943
msgid "This will take {size} of space on your computer."
msgstr "Dit neemt {size} ruimte in op je computer."

