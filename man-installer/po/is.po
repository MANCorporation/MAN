msgid "Flatpak app from {source}"
msgstr "Flatpak-forrit frá {source}"

#: appinstaller.rs:851
msgid "AppImage"
msgstr "AppImage"

#: appinstaller.rs:869
msgid "You will be guided through the steps necessary to install this software."
msgstr "Þér verður leiðbeint í gegnum skrefin sem þarf til að setja upp þennan hugbúnað."

#: appinstaller.rs:880
msgid "Version"
msgstr "Útgáfa"

#: appinstaller.rs:883
msgid "Publisher"
msgstr "Útgefandi"

#: appinstaller.rs:885
msgid "Type"
msgstr "Tegund"

#: appinstaller.rs:887
msgid "Size"
msgstr "Stærð"

#: appinstaller.rs:893
msgid "Website"
msgstr "Vefsvæði"

#: appinstaller.rs:895
msgid "File"
msgstr "Skrá"

#: appinstaller.rs:905
msgid "This app is installed already. Installing it again replaces it."
msgstr "Þetta forrit er þegar uppsett. Ef þú setur það upp aftur kemur það í staðinn."

#: appinstaller.rs:908
msgid "Apps from .deb packages become part of the system. A MAN update replaces the system, so they are only installed again after an update if you keep them (next steps)."
msgstr "Forrit úr .deb-pökkum verða hluti af kerfinu. MAN-uppfærsla skiptir kerfinu út, svo þau eru aðeins sett upp aftur eftir uppfærslu ef þú heldur þeim (næstu skref)."

#: appinstaller.rs:911
msgid "Only install apps from sources you trust."
msgstr "Settu aðeins upp forrit frá traustum uppruna."

#: appinstaller.rs:917
msgid "Where do you want to install {name}?"
msgstr "Hvar viltu setja upp {name}?"

#: appinstaller.rs:922
msgid "Only your account can use the app."
msgstr "Aðeins aðgangurinn þinn getur notað forritið."

#: appinstaller.rs:923
msgid "Needs administrator rights."
msgstr "Krefst stjórnandaréttinda."

#: appinstaller.rs:930
msgid "Only for Me"
msgstr "Aðeins fyrir mig"

#: appinstaller.rs:930
msgid "For All Users of This Computer"
msgstr "Fyrir alla notendur þessarar tölvu"

#: appinstaller.rs:945
msgid "This will take {size} of space on your computer."
msgstr "Þetta tekur {size} pláss á tölvunni þinni."

#: appinstaller.rs:947
msgid "The app is downloaded from {source}."
msgstr "Forritið er sótt frá {source}."

#: appinstaller.rs:949
msgid "The app is installed for all users of this computer."
msgstr "Forritið er sett upp fyrir alla notendur þessarar tölvu."

#: appinstaller.rs:949
msgid "The app is installed only for you."
msgstr "Forritið er aðeins sett upp fyrir þig."

#: appinstaller.rs:952
msgid "The AppImage is moved to {folder} and added to your apps."
msgstr "AppImage-skráin er færð í {folder} og bætt við forritin þín."

#: appinstaller.rs:958
msgid "Keep After MAN Updates"
msgstr "Halda eftir MAN-uppfærslur"

#: appinstaller.rs:959
msgid "MAN installs the app again after each update. Its package files are kept for that."
msgstr "MAN setur forritið aftur upp eftir hverja uppfærslu. Pakkaskrár þess eru geymdar til þess."

#: appinstaller.rs:967
msgid "Click Install to install {name}."
msgstr "Smelltu á Setja upp til að setja upp {name}."

#: appinstaller.rs:973
msgid "Checking what else the app needs…"
msgstr "Athugar hvað annað forritið þarf…"

#: appinstaller.rs:983
msgid "Also installs the packages it needs: {list}"
msgstr "Setur einnig upp pakkana sem það þarf: {list}"

#: appinstaller.rs:989
msgid "Some packages the app needs are not available yet. Installing gets the newest package lists first; if they are still missing, the app cannot be installed."
msgstr "Sumir pakkar sem forritið þarf eru ekki enn tiltækir. Uppsetningin sækir fyrst nýjustu pakkalistana; ef þá vantar enn er ekki hægt að setja forritið upp."

#: appinstaller.rs:1050
msgid "Installing {name}…"
msgstr "Set upp {name}…"

#: appinstaller.rs:1056
msgid "Preparing…"
msgstr "Undirbý…"

#: appinstaller.rs:1063
msgid "Details"
msgstr "Nánar"

#: appinstaller.rs:1103
msgid "Installing the package…"
msgstr "Set upp pakkann…"

#: appinstaller.rs:1122
msgid "Moving the app to its folder…"
msgstr "Færi forritið í möppuna sína…"

#: appinstaller.rs:1131
msgid "The app could not be installed."
msgstr "Ekki tókst að setja forritið upp."

#: appinstaller.rs:1135
msgid "Installing the app with Flatpak…"
msgstr "Set upp forritið með Flatpak…"

