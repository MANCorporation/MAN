msgstr "Kerfissneiðin hvarf"

#: installer.rs:933
msgid "No installation chosen"
msgstr "Engin uppsetning valin"

#: installer.rs:944
msgid "The disk disappeared"
msgstr "Diskurinn hvarf"

#: installer.rs:955
msgid "Review"
msgstr "Yfirlit"

#: installer.rs:958
msgid "Destination"
msgstr "Áfangastaður"

#: installer.rs:960
msgid "Erase disk and install"
msgstr "Hreinsa disk og setja upp"

#: installer.rs:961
msgid "Custom partitions"
msgstr "Sérsniðnar sneiðar"

#: installer.rs:962
msgid "Reinstall, keeping /home"
msgstr "Setja upp aftur, halda /home"

#: installer.rs:963
msgid "Alongside Windows"
msgstr "Við hlið Windows"

#: installer.rs:969
msgid " (will be formatted)"
msgstr " (verður forsniðin)"

#: installer.rs:969
msgid " (kept)"
msgstr " (haldið)"

#: installer.rs:970
msgid "System Partition"
msgstr "Kerfissneið"

#: installer.rs:970
msgid "{partition} (will be formatted)"
msgstr "{partition} (verður forsniðin)"

#: installer.rs:972
msgid "Boot Partition"
msgstr "Ræsisneið"

#: installer.rs:980
msgid "Space for MAN"
msgstr "Pláss fyrir MAN"

#: installer.rs:980
msgid "{free} of free space (a boot partition and the system partition are created)"
msgstr "{free} laust pláss (ræsisneið og kerfissneið verða búnar til)"

#: installer.rs:981
msgid "Windows"
msgstr "Windows"

#: installer.rs:981
msgid "Not changed. It appears in MAN's start menu; the EFI system partition is shared."
msgstr "Óbreytt. Það birtist í ræsivalmynd MAN; EFI-kerfissneiðinni er deilt."

#: installer.rs:983
msgid "Encryption"
msgstr "Dulritun"

#: installer.rs:983
msgid "On (LUKS2)"
msgstr "Kveikt (LUKS2)"

#: installer.rs:983
msgid "Off"
msgstr "Slökkt"

#: installer.rs:985
msgid "File System"
msgstr "Skráakerfi"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system fyrir MAN, @home fyrir skrárnar þínar, @snapshots fyrir endurheimtarpunkta. Öll deila lausa plássinu."

#: installer.rs:991
msgid "System"
msgstr "Kerfi"

#: installer.rs:993
msgid "Your Account"
msgstr "Aðgangurinn þinn"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Búinn til í MAN Setup þegar tölvan ræsist í fyrsta sinn, ásamt heiti tölvunnar, útliti og persónuverndarstillingum."

#: installer.rs:998
msgid "Keyboard"
msgstr "Lyklaborð"

#: installer.rs:1002
msgid "All data on {model} ({path}) will be erased."
msgstr "Öllum gögnum á {model} ({path}) verður eytt."

#: installer.rs:1002
msgid "_Erase and Install"
msgstr "_Hreinsa og setja upp"

#: installer.rs:1003
msgid "The chosen partitions will be formatted. Other partitions are not changed."
msgstr "Valdar sneiðar verða forsniðnar. Aðrar sneiðar breytast ekki."

#: installer.rs:1003
msgid "_Format and Install"
msgstr "_Forsníða og setja upp"

#: installer.rs:1004
msgid "The current system is replaced. Your files in /home are kept, and the old system is saved as a snapshot."
msgstr "Núverandi kerfi er skipt út. Skrárnar þínar í /home haldast og gamla kerfið er vistað sem skyndimynd."

#: installer.rs:1004
msgid "_Reinstall"
msgstr "Setja _upp aftur"

#: installer.rs:1005
