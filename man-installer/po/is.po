msgid "_Close"
msgstr "_Loka"

#: appinstaller.rs:1199
msgid "The Installation Was Successful"
msgstr "Uppsetningin tókst"

#: appinstaller.rs:1199
msgid "The app was installed."
msgstr "Forritið var sett upp."

#: appinstaller.rs:1204
msgid "The Installation Failed"
msgstr "Uppsetningin mistókst"

#: appinstaller.rs:1215
msgid "_Open"
msgstr "_Opna"

#: appinstaller.rs:1225
msgid "_Show Details"
msgstr "_Sýna nánar"

#: appinstaller.rs:1228
msgid "Installation Log"
msgstr "Atvikaskrá uppsetningar"

#: appinstaller.rs:1255
msgid "App Installer"
msgstr "Forritauppsetning"

#: appinstaller.rs:1276
msgid "Go _Back"
msgstr "_Til baka"

#: appinstaller.rs:1349
msgid "Reading the app…"
msgstr "Les forritið…"

#: appinstaller.rs:1358
msgid "Install {name}"
msgstr "Setja upp {name}"

#: appinstaller.rs:1377
msgid "Apps"
msgstr "Forrit"

#: appinstaller.rs:1383
msgid "Choose an App to Install"
msgstr "Veldu forrit til að setja upp"

#: backend.rs:53
msgid "Could not start the system helper."
msgstr "Ekki tókst að ræsa kerfishjálparann."

#: backend.rs:57
msgid "Could not talk to the system helper."
msgstr "Ekki tókst að eiga samskipti við kerfishjálparann."

#: backend.rs:77
msgid "Lost contact with the system helper."
msgstr "Samband við kerfishjálparann rofnaði."

#: backend.rs:87
msgid "Authorization was cancelled."
msgstr "Hætt var við auðkenningu."

#: backend.rs:87
msgid "Administrator rights are needed for this action."
msgstr "Þessi aðgerð krefst stjórnandaréttinda."

#: backend.rs:89
msgid "The system helper stopped unexpectedly."
msgstr "Kerfishjálparinn stöðvaðist óvænt."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Engin EFI-kerfissneið"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Aðeins {free} laust, MAN þarf {need}. Losaðu pláss með DUHACH! í Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Ekkert laust pláss. Ræstu DUHACH! í Windows til að búa til pláss fyrir MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN keyrir af þessum diski"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Í notkun: sneið er tengd"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Of lítið, MAN þarf {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Setja upp MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "Verið er að setja upp MAN. Bíddu þar til því lýkur."

#: installer.rs:143
msgid "Language"
msgstr "Tungumál"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Endurræsa á þessu tungumáli"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Lifandi setan endurræsist á valda tungumálinu og MAN er sett upp á því."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Velkomin í MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Hratt, opið og fullkomlega sérsníðanlegt GNOME-kerfi.\n"
"Settu það upp á þessa tölvu eða haltu áfram að skoða lifandi setuna."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Setja upp MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Halda áfram að prófa MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Leita að diskum…"

#: installer.rs:250
msgid "Welcome"
msgstr "Velkomin"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Þessi tölva var ræst í gömlum BIOS-ham. Aðeins er hægt að setja MAN upp á UEFI-tölvur: endurræstu og veldu UEFI-ræsingarkostinn."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Kerfishjálparinn skilaði engum upplýsingum um diska."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Næsta"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Hreinsa disk og setja upp MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Allt á valda diskinum verður eytt, Windows meðtalið."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Mælt með. Allt á valda diskinum verður eytt."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Setja upp við hlið Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Mælt með. MAN notar lausa plássið við hlið Windows; Windows og skrárnar þess haldast. Þú velur kerfi við hverja ræsingu."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Setja MAN upp aftur"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Skiptir út kerfinu en heldur persónulegum skrám í /home. Núverandi kerfi er vistað sem skyndimynd."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Sérsniðnar sneiðar"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Fyrir sérfræðinga: veldu sneiðar sjálf(ur) eða búðu þær til með Diskum."

#: installer.rs:392
msgid "Disk"
msgstr "Diskur"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Veldu diskinn sem á að hreinsa. Diskar sem ekki er hægt að nota eru sýndir með ástæðunni."

#: installer.rs:418
msgid "No disks were found"
msgstr "Engir diskar fundust"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Laust pláss við hlið Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Sneiðum Windows er ekki breytt. MAN deilir EFI-kerfissneiðinni og bætir Windows við ræsivalmynd sína."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} laust"

#: installer.rs:432
msgid "no free space"
msgstr "ekkert laust pláss"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

