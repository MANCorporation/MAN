#: appinstaller.rs:119
msgid "This file is not an app that can be installed here (.deb, .flatpak, .flatpakref or AppImage)."
msgstr "Þessi skrá er ekki forrit sem hægt er að setja upp hér (.deb, .flatpak, .flatpakref eða AppImage)."

#: appinstaller.rs:128
msgid "This app is made for {arch} computers and does not work on this one (x86-64)."
msgstr "Þetta forrit er gert fyrir {arch}-tölvur og virkar ekki á þessari (x86-64)."

#: appinstaller.rs:313
msgid "The file could not be read. It may be damaged."
msgstr "Ekki tókst að lesa skrána. Hún gæti verið skemmd."

