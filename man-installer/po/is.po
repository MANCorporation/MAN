msgid "Installation to Replace"
msgstr "Uppsetning sem skipt er út"

#: installer.rs:477
msgid "no home folders"
msgstr "engar heimamöppur"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "heimamöppur: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "skyndimyndir: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN á {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Lykilfrasi fyrir {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Aflæsa"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Ekki tókst að skoða uppsetninguna."

#: installer.rs:554
msgid "Partitions"
msgstr "Sneiðar"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Kerfissneiðin er forsniðin með Btrfs og inniheldur @system, @home og @snapshots. Sneiðar á diskinum sem MAN keyrir af eru ekki sýndar."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Opna Diska til að búa til eða breyta stærð sneiða"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Uppfæra lista yfir sneiðar"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Veldu sneið"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "EFI-kerfissneið"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Forsníða EFI-kerfissneið"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Hafðu slökkt til að halda ræsiforritum annarra kerfa"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Kerfissneið (forsniðin sem Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Ræsisneið (þarf við dulritun)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Listi yfir sneiðar uppfærður"

#: installer.rs:650
msgid "Security"
msgstr "Öryggi"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Dulrita kerfið"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Verndar gögnin þín ef tölvan týnist eða henni er stolið. Beðið er um lykilfrasa við hverja ræsingu."

#: installer.rs:656
msgid "Passphrase"
msgstr "Lykilfrasi"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Staðfesta lykilfrasa"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Geymdu þennan lykilfrasa á öruggum stað"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Ef hann glatast getur enginn endurheimt gögnin. Kjarninn og ræsiskrárnar eru á lítilli ódulritaðri ræsisneið."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Lykilfrasinn verður að vera minnst 8 stafir."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Lykilfrasarnir stemma ekki."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Veldu disk."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Veldu diskinn með Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Veldu uppsetninguna sem skipt er út."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Aflæstu fyrst dulrituðu uppsetningunni."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Þessi sneið inniheldur ekkert MAN-kerfi."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Veldu EFI-kerfissneið."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Veldu kerfissneiðina."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "EFI-sneiðin og kerfissneiðin verða að vera ólíkar."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Dulritun þarfnast sérstakrar ræsisneiðar."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Kerfissneiðin verður að vera minnst {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "EFI-sneiðin er ekki FAT-forsniðin; kveiktu á forsníðingu."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Kerfissneiðin er tengd; aftengdu hana fyrst í Diskum."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Hvar á að setja MAN upp?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Tími og lyklaborð"

#: installer.rs:829
msgid "Time Zone"
msgstr "Tímabelti"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Lyklaborðsuppsetning"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Prófaðu lyklaborðið"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Skrifaðu hér til að ganga úr skugga um að lyklarnir skili réttum stöfum."

#: installer.rs:844
msgid "Type here"
msgstr "Skrifaðu hér"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Tímabelti og lyklaborð"

