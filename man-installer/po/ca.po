msgid "no home folders"
msgstr "cap carpeta personal"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "carpetes personals: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "instantànies: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN a {model}"

#: installer.rs:499
msgid "Passphrase for {device}"
msgstr "Frase de pas de {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Desbloqueja"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "No s'ha pogut examinar la instal·lació."

#: installer.rs:554
msgid "Partitions"
msgstr "Particions"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "La partició del sistema es formata amb Btrfs i conté @system, @home i @snapshots. No es mostren les particions del disc des del qual s'executa MAN."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Obre Discs per crear o redimensionar particions"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Actualitza la llista de particions"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Trieu una partició"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "Partició del sistema EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Formata la partició del sistema EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Deixeu-ho desactivat per conservar els carregadors d'arrencada d'altres sistemes"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Partició del sistema (formatada com a Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Partició d'arrencada (necessària amb xifratge)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "S'ha actualitzat la llista de particions"

#: installer.rs:650
msgid "Security"
msgstr "Seguretat"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Xifra el sistema"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Protegeix les vostres dades si perdeu l'ordinador o us el roben. Es demana una frase de pas a cada arrencada."

#: installer.rs:656
msgid "Passphrase"
msgstr "Frase de pas"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Confirmeu la frase de pas"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Guardeu bé aquesta frase de pas"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Si es perd, ningú no podrà recuperar les dades. El nucli i els fitxers d'arrencada es queden en una petita partició d'arrencada sense xifrar."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "La frase de pas ha de tenir com a mínim 8 caràcters."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Les frases de pas no coincideixen."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Trieu un disc."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Trieu el disc amb el Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Trieu la instal·lació que es substituirà."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Primer desbloquegeu la instal·lació xifrada."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Aquesta partició no conté cap sistema MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Trieu una partició del sistema EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Trieu la partició del sistema."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Les particions EFI i del sistema han de ser diferents."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "El xifratge necessita una partició d'arrencada separada."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "La partició del sistema ha de tenir com a mínim {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "La partició EFI no té format FAT; activeu el formatatge."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "La partició del sistema està muntada; primer desmunteu-la a Discs."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "On s'ha d'instal·lar MAN?"

#: installer.rs:824
msgid "Time and Keyboard"
msgstr "Hora i teclat"

#: installer.rs:829
msgid "Time Zone"
msgstr "Fus horari"

#: installer.rs:833
msgid "Keyboard Layout"
msgstr "Disposició del teclat"

#: installer.rs:843
msgid "Test Your Keyboard"
msgstr "Proveu el teclat"

#: installer.rs:843
msgid "Type here to check that your keys produce the right characters."
msgstr "Escriviu aquí per comprovar que les tecles produeixen els caràcters correctes."

#: installer.rs:844
msgid "Type here"
msgstr "Escriviu aquí"

#: installer.rs:877
msgid "Time Zone and Keyboard"
msgstr "Fus horari i teclat"

#: installer.rs:920
msgid "No disk chosen"
msgstr "No s'ha triat cap disc"

#: installer.rs:926
