msgid "no home folders"
msgstr "tidak ada folder rumah"

#: installer.rs:479
msgid "home folders: {list}"
msgstr "folder rumah: {list}"

#: installer.rs:481
msgid "snapshots: {n}"
msgstr "snapshot: {n}"

#: installer.rs:485
msgid "MAN on {model}"
msgstr "MAN di {model}"

