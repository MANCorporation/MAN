#: backend.rs:46
msgid "Could not start the system helper."
msgstr "Pembantu sistem tidak dapat dijalankan."

#: backend.rs:51
msgid "Could not talk to the system helper."
msgstr "Tidak dapat berkomunikasi dengan pembantu sistem."

#: backend.rs:71
msgid "Lost contact with the system helper."
msgstr "Koneksi dengan pembantu sistem terputus."

#: backend.rs:81
msgid "Authorization was cancelled."
msgstr "Otorisasi dibatalkan."

#: backend.rs:81
msgid "Administrator rights are needed for this action."
msgstr "Tindakan ini memerlukan hak administrator."

#: backend.rs:83
msgid "The system helper stopped unexpectedly."
msgstr "Pembantu sistem berhenti secara tak terduga."

#: installer.rs:78
msgid "No EFI system partition"
msgstr "Tidak ada partisi sistem EFI"

#: installer.rs:82
msgid "Only {free} free, MAN needs {need}. Make more room with DUHACH! in Windows."
msgstr "Hanya {free} yang kosong, MAN memerlukan {need}. Kosongkan ruang dengan DUHACH! di Windows."

#: installer.rs:83
msgid "No free space. Start DUHACH! in Windows to make room for MAN."
msgstr "Tidak ada ruang kosong. Jalankan DUHACH! di Windows untuk memberi ruang bagi MAN."

#: installer.rs:92
msgid "MAN is running from this disk"
msgstr "MAN berjalan dari disk ini"

#: installer.rs:96
msgid "In use: a partition is mounted"
msgstr "Sedang dipakai: ada partisi yang terkait"

#: installer.rs:98
msgid "Too small, MAN needs {need}"
msgstr "Terlalu kecil, MAN memerlukan {need}"

#: installer.rs:108
msgid "Install MAN"
msgstr "Pasang MAN"

#: installer.rs:126
msgid "MAN is being installed. Please wait until it finishes."
msgstr "MAN sedang dipasang. Harap tunggu sampai selesai."

#: installer.rs:143
msgid "Language"
msgstr "Bahasa"

#: installer.rs:155
msgid "_Restart in This Language"
msgstr "_Mulai ulang dalam bahasa ini"

#: installer.rs:167
msgid "The live session restarts in the chosen language, and MAN is installed in it."
msgstr "Sesi live akan dimulai ulang dalam bahasa yang dipilih, dan MAN dipasang dalam bahasa itu."

#: installer.rs:213
msgid "Welcome to MAN"
msgstr "Selamat datang di MAN"

#: installer.rs:214
msgid ""
"A fast, open and fully customizable GNOME system.\n"
"Install it on this computer, or keep exploring the live session."
msgstr ""
"Sistem GNOME yang cepat, terbuka, dan sepenuhnya dapat disesuaikan.\n"
"Pasang di komputer ini, atau terus jelajahi sesi live."

#: installer.rs:218
msgid "_Install MAN…"
msgstr "_Pasang MAN…"

#: installer.rs:220
msgid "_Keep Trying MAN"
msgstr "_Terus coba MAN"

#: installer.rs:223
msgid "Looking for disks…"
msgstr "Mencari disk…"

#: installer.rs:250
msgid "Welcome"
msgstr "Selamat datang"

#: installer.rs:265
msgid "This computer was started in legacy BIOS mode. MAN can only be installed on UEFI computers: restart and choose the UEFI boot option."
msgstr "Komputer ini dimulai dalam mode BIOS lama. MAN hanya dapat dipasang di komputer UEFI: mulai ulang dan pilih opsi boot UEFI."

#: installer.rs:283
msgid "The system helper returned no disk information."
msgstr "Pembantu sistem tidak mengembalikan informasi disk."

#: installer.rs:348
msgid "  ·  EFI"
msgstr "  ·  EFI"

#: installer.rs:356
msgid "_Next"
msgstr "_Berikutnya"

#: installer.rs:361
msgid "Installation Type"
msgstr "Jenis pemasangan"

#: installer.rs:364
msgid "Erase Disk and Install MAN"
msgstr "Hapus disk dan pasang MAN"

#: installer.rs:365
msgid "Everything on the chosen disk is deleted, Windows included."
msgstr "Semua isi disk yang dipilih akan dihapus, termasuk Windows."

#: installer.rs:365
msgid "Recommended. Everything on the chosen disk is deleted."
msgstr "Disarankan. Semua isi disk yang dipilih akan dihapus."

#: installer.rs:369
msgid "Install Alongside Windows"
msgstr "Pasang berdampingan dengan Windows"

#: installer.rs:370
msgid "Recommended. MAN uses the free space next to Windows; Windows and its files stay. Choose the system at every start."
msgstr "Disarankan. MAN memakai ruang kosong di samping Windows; Windows dan berkasnya tetap ada. Pilih sistem setiap kali mulai."

#: installer.rs:377
msgid "Reinstall MAN"
msgstr "Pasang ulang MAN"

#: installer.rs:378
msgid "Replaces the system but keeps personal files in /home. The current system is saved as a snapshot."
msgstr "Mengganti sistem tetapi mempertahankan berkas pribadi di /home. Sistem saat ini disimpan sebagai snapshot."

#: installer.rs:383
msgid "Custom Partitions"
msgstr "Partisi khusus"

#: installer.rs:383
msgid "For experts: choose partitions yourself, or create them with Disks."
msgstr "Untuk ahli: pilih partisi sendiri, atau buat dengan Disk."

#: installer.rs:392
msgid "Disk"
msgstr "Disk"

#: installer.rs:392
msgid "Choose the disk to erase. Disks that cannot be used are shown with the reason."
msgstr "Pilih disk yang akan dihapus. Disk yang tidak dapat dipakai ditampilkan beserta alasannya."

#: installer.rs:418
msgid "No disks were found"
msgstr "Tidak ada disk yang ditemukan"

#: installer.rs:425
msgid "Free Space Next to Windows"
msgstr "Ruang kosong di samping Windows"

#: installer.rs:426
msgid "Windows' partitions are not touched. MAN shares the EFI system partition and adds Windows to its start menu."
msgstr "Partisi Windows tidak disentuh. MAN berbagi partisi sistem EFI dan menambahkan Windows ke menu boot-nya."

#: installer.rs:432
msgid "{size} free"
msgstr "{size} kosong"

#: installer.rs:432
msgid "no free space"
msgstr "tidak ada ruang kosong"

#: installer.rs:437
msgid "{model} (Windows)"
msgstr "{model} (Windows)"

#: installer.rs:456
msgid "Installation to Replace"
msgstr "Pemasangan yang akan diganti"

