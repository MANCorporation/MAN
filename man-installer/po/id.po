msgid "File System"
msgstr "Sistem berkas"

#: installer.rs:986
msgid "Btrfs: @system for MAN, @home for your files, @snapshots for restore points. All share the free space."
msgstr "Btrfs: @system untuk MAN, @home untuk berkas Anda, @snapshots untuk titik pemulihan. Semuanya berbagi ruang kosong."

#: installer.rs:991
msgid "System"
msgstr "Sistem"

#: installer.rs:993
msgid "Your Account"
msgstr "Akun Anda"

#: installer.rs:994
msgid "Created in MAN Setup when the computer starts for the first time, together with the computer name, look and privacy settings."
msgstr "Dibuat di MAN Setup saat komputer pertama kali dimulai, bersama nama komputer, tampilan, dan pengaturan privasi."

#: installer.rs:998
msgid "Keyboard"
msgstr "Papan ketik"

#: installer.rs:1002
