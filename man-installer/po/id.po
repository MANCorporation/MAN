msgid "Only the running MAN installation can be updated."
msgstr "Hanya pemasangan MAN yang sedang berjalan yang dapat diperbarui."

#: updfile.rs:78
msgid "This is not a MAN update file (no manifest)."
msgstr "Ini bukan berkas pembaruan MAN (tidak ada manifest)."

#: updfile.rs:79
msgid "The update is not signed, so it cannot be trusted."
msgstr "Pembaruan tidak ditandatangani, sehingga tidak dapat dipercaya."

#: updfile.rs:81
msgid "The update signature is damaged."
msgstr "Tanda tangan pembaruan rusak."

#: updfile.rs:86
msgid "The update is not signed by MAN. It may have been modified or come from an untrusted source."
msgstr "Pembaruan tidak ditandatangani oleh MAN. Mungkin telah diubah atau berasal dari sumber yang tidak tepercaya."

#: updfile.rs:92
msgid "The update manifest is invalid."
msgstr "Manifest pembaruan tidak valid."

#: util.rs:167
msgid "The passphrase is not correct, or the encrypted partition cannot be opened."
msgstr "Frasa sandi salah, atau partisi terenkripsi tidak dapat dibuka."

