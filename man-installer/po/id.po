msgid "Passphrase for {device}"
msgstr "Frasa sandi untuk {device}"

#: installer.rs:500
msgid "Unlock"
msgstr "Buka kunci"

#: installer.rs:537
msgid "The installation could not be inspected."
msgstr "Pemasangan tidak dapat diperiksa."

#: installer.rs:554
msgid "Partitions"
msgstr "Partisi"

#: installer.rs:555
msgid "The system partition is formatted with Btrfs and holds @system, @home and @snapshots. Partitions on the disk MAN is running from are not listed."
msgstr "Partisi sistem diformat dengan Btrfs dan berisi @system, @home, dan @snapshots. Partisi pada disk tempat MAN berjalan tidak dicantumkan."

#: installer.rs:557
msgid "Open Disks to create or resize partitions"
msgstr "Buka Disk untuk membuat atau mengubah ukuran partisi"

#: installer.rs:559
msgid "Refresh the partition list"
msgstr "Segarkan daftar partisi"

#: installer.rs:567
msgid "Choose a partition"
msgstr "Pilih partisi"

#: installer.rs:579
msgid "EFI System Partition"
msgstr "Partisi sistem EFI"

#: installer.rs:580
msgid "Format EFI System Partition"
msgstr "Format partisi sistem EFI"

#: installer.rs:580
msgid "Leave off to keep boot loaders of other systems"
msgstr "Biarkan mati untuk mempertahankan boot loader sistem lain"

#: installer.rs:582
msgid "System Partition (formatted as Btrfs)"
msgstr "Partisi sistem (diformat sebagai Btrfs)"

#: installer.rs:583
msgid "Boot Partition (needed with encryption)"
msgstr "Partisi boot (diperlukan untuk enkripsi)"

#: installer.rs:642
msgid "Partition list refreshed"
msgstr "Daftar partisi disegarkan"

#: installer.rs:650
msgid "Security"
msgstr "Keamanan"

#: installer.rs:652
msgid "Encrypt the System"
msgstr "Enkripsi sistem"

#: installer.rs:653
msgid "Protects your data if the computer is lost or stolen. A passphrase is asked at every start."
msgstr "Melindungi data Anda jika komputer hilang atau dicuri. Frasa sandi diminta setiap kali mulai."

#: installer.rs:656
msgid "Passphrase"
msgstr "Frasa sandi"

#: installer.rs:657
msgid "Confirm Passphrase"
msgstr "Konfirmasi frasa sandi"

#: installer.rs:659
msgid "Keep this passphrase safe"
msgstr "Simpan frasa sandi ini dengan aman"

#: installer.rs:660
msgid "If it is lost, the data cannot be recovered by anyone. The kernel and boot files stay on a small unencrypted boot partition."
msgstr "Jika hilang, tidak ada yang dapat memulihkan data. Kernel dan berkas boot tetap berada di partisi boot kecil yang tidak dienkripsi."

#: installer.rs:732
msgid "The passphrase needs at least 8 characters."
msgstr "Frasa sandi minimal 8 karakter."

#: installer.rs:734
msgid "The passphrases do not match."
msgstr "Frasa sandi tidak cocok."

#: installer.rs:748
msgid "Choose a disk."
msgstr "Pilih disk."

#: installer.rs:758
msgid "Choose the disk with Windows."
msgstr "Pilih disk yang berisi Windows."

#: installer.rs:767
msgid "Choose the installation to replace."
msgstr "Pilih pemasangan yang akan diganti."

#: installer.rs:768
msgid "Unlock the encrypted installation first."
msgstr "Buka kunci pemasangan terenkripsi terlebih dahulu."

#: installer.rs:769
msgid "This partition holds no MAN system."
msgstr "Partisi ini tidak berisi sistem MAN."

#: installer.rs:776
msgid "Choose an EFI system partition."
msgstr "Pilih partisi sistem EFI."

#: installer.rs:778
msgid "Choose the system partition."
msgstr "Pilih partisi sistem."

#: installer.rs:780
msgid "The EFI and system partitions must be different."
msgstr "Partisi EFI dan partisi sistem harus berbeda."

#: installer.rs:782
msgid "Encryption needs a separate boot partition."
msgstr "Enkripsi memerlukan partisi boot terpisah."

#: installer.rs:791
msgid "The system partition must be at least {size}."
msgstr "Partisi sistem minimal {size}."

#: installer.rs:793
msgid "The EFI partition is not FAT formatted; turn on formatting."
msgstr "Partisi EFI tidak berformat FAT; aktifkan pemformatan."

#: installer.rs:795
msgid "The system partition is mounted; unmount it in Disks first."
msgstr "Partisi sistem sedang terkait; lepaskan dulu di Disk."

#: installer.rs:817
msgid "Where Should MAN Be Installed?"
msgstr "Di mana MAN akan dipasang?"

