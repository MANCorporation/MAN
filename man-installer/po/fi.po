msgstr "Kirjastot ja työkalut"

#: oobe.rs:597
msgid "License Agreement"
msgstr "Käyttöoikeussopimus"

#: oobe.rs:597
msgid "Please read and accept the terms under which MAN is provided."
msgstr "Lue ja hyväksy ehdot, joilla MAN tarjotaan."

#: oobe.rs:608
msgid "Licenses"
msgstr "Lisenssit"

#: oobe.rs:616
msgid "The license text is not available ({path})."
msgstr "Lisenssin teksti ei ole saatavilla ({path})."

#: oobe.rs:622
msgid "I have read and accept the license terms"
msgstr "Olen lukenut lisenssiehdot ja hyväksyn ne"

#: oobe.rs:692
msgid "Wired"
msgstr "Langallinen"

#: oobe.rs:698
msgid "Not connected"
msgstr "Ei yhdistetty"

#: oobe.rs:732
msgid "Connect to the Internet"
msgstr "Yhdistä internetiin"

#: oobe.rs:732
msgid "Connecting lets MAN set the time and keep your software up to date. You can also do this later."
msgstr "Yhteyden avulla MAN voi asettaa kellonajan ja pitää ohjelmistosi ajan tasalla. Voit tehdä tämän myös myöhemmin."

#: oobe.rs:734
msgid "Checking the connection…"
msgstr "Tarkistetaan yhteyttä…"

#: oobe.rs:740
msgid "Wi-Fi Networks"
msgstr "Wi-Fi-verkot"

#: oobe.rs:742
msgid "Search Again"
msgstr "Hae uudelleen"

#: oobe.rs:753
msgid "_Skip"
msgstr "_Ohita"

#: oobe.rs:754
msgid "You can connect later in Settings."
msgstr "Voit yhdistää myöhemmin Asetuksissa."

