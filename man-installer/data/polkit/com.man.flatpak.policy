<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>MAN</vendor>
  <action id="com.man.flatpak.sandbox">
    <description>Change the sandbox of Flatpak apps</description>
    <message>Authentication is required to change the sandbox of an app</message>
    <icon_name>org.gnome.Settings</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/man/man-flatpak-sandbox</annotate>
  </action>
</policyconfig>
