[Desktop Entry]
Name=MAN Update
GenericName=System Update Installer
Comment=Install a MAN system update file
Keywords=update;upgrade;upd;system;
Exec=man-update %f
Icon=com.man.Updater
Terminal=false
Type=Application
Categories=GNOME;GTK;System;
MimeType=application/x-man-update;
StartupNotify=true
