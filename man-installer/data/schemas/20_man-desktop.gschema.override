# MAN desktop defaults (man-system-tools).
[org.gnome.shell]
# PCD is MAN's web browser.
favorite-apps=['org.gnome.Epiphany.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Calculator.desktop', 'org.gnome.Yelp.desktop']

[org.gnome.settings-daemon.plugins.housekeeping]
# GNOME's yearly "donate to GNOME" notification; MAN asks in Settings > About.
donation-reminder-enabled=false
