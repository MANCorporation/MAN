#!/bin/sh
# One-time boot entry that installs a staged MAN update (see man-update in the initramfs).
set -e
prefix="/usr"
exec_prefix="/usr"
datarootdir="/usr/share"
. "${pkgdatadir:-/usr/share/grub}/grub-mkconfig_lib"

STAGED=/var/lib/man/update-staged
[ -f "$STAGED" ] && [ -f /boot/man-update/vmlinuz ] && [ -f /boot/man-update/initrd.img ] || exit 0
[ -n "${GRUB_DEVICE_UUID}" ] || exit 0
id=$(sed -n 's/^ID=//p' "$STAGED" | tr -cd 'A-Za-z0-9.+~-')
version=$(sed -n 's/^VERSION=//p' "$STAGED" | tr -cd 'A-Za-z0-9.+~ -')
[ -n "$id" ] || exit 0
echo "Found staged MAN update $version" >&2
rel_kernel=$(make_system_path_relative_to_its_root /boot/man-update/vmlinuz)
rel_initrd=$(make_system_path_relative_to_its_root /boot/man-update/initrd.img)
echo "menuentry 'Install MAN update $version' --class recovery \$menuentry_id_option 'man-update' {"
prepare_grub_to_access_device "${GRUB_DEVICE_BOOT}" | sed 's/^/  /'
echo "  echo 'Installing MAN $version...'"
echo "  linux ${rel_kernel} root=UUID=${GRUB_DEVICE_UUID} ro rootflags=subvol=@system ${GRUB_CMDLINE_LINUX} quiet man.update=$id"
echo "  initrd ${rel_initrd}"
echo "}"
