#!/bin/sh
# MAN: a "Windows" entry in the boot menu when Windows Boot Manager is on an
# EFI system partition of this computer (MAN installed alongside Windows).
# Its title and icon follow the Windows version (Windows 11, Windows 10, ...).
set -e
. /usr/lib/man/grub/bootmenu-lib.sh
w=$(man_windows) || exit 0
set -- $w
uuid=$1 cls=$2
shift 2
title=$*
echo "Found $title (Windows Boot Manager, partition $uuid)" >&2
cat <<ENTRY
menuentry '$title' --class $cls --class windows --class os --id man-windows {
	insmod part_gpt
	insmod fat
	insmod chain
	search --no-floppy --fs-uuid --set=root $uuid
	chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}
ENTRY
